<Project>

	<Target Name="InvalidateStaleVersionMetadata" BeforeTargets="CoreGenerateAssemblyInfo" Condition="'$(GenerateAssemblyInfo)' == 'true' And Exists('$(GeneratedAssemblyInfoFile)')">
		<PropertyGroup>
			<_VoidstrapVersionMetadataStale>!$([System.IO.File]::ReadAllText('$(GeneratedAssemblyInfoFile)').Contains('AssemblyFileVersionAttribute(&quot;$(FileVersion)&quot;)'))</_VoidstrapVersionMetadataStale>
		</PropertyGroup>
		<Delete Files="$(GeneratedAssemblyInfoFile);@(IntermediateAssembly)" Condition="$(_VoidstrapVersionMetadataStale)" />
		<Delete Files="$(AppHostIntermediatePath);$(TargetDir)$(TargetName)$(_NativeExecutableExtension)" Condition="$(_VoidstrapVersionMetadataStale) And '$(UseAppHost)' == 'true'" />
	</Target>

	<PropertyGroup Condition="'$(MSBuildRuntimeType)' == 'Full'">
		<AlwaysCompileMarkupFilesInSeparateDomain>true</AlwaysCompileMarkupFilesInSeparateDomain>
	</PropertyGroup>

	<ItemGroup Condition="'$(EnableDefaultItems)' != 'false'">
		<Compile Remove="obj/**/*AssemblyInfo.cs" />
		<Compile Remove="obj/**/*AssemblyAttributes.cs" />
		<Compile Remove="obj-*/**/*AssemblyInfo.cs" />
		<Compile Remove="obj-*/**/*AssemblyAttributes.cs" />
	</ItemGroup>

	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$(VoidstrapLinuxPackagingRoot)' != ''">
		<ProGpuWpfEnableWin32CompatShim>false</ProGpuWpfEnableWin32CompatShim>
	</PropertyGroup>

	<Target Name="BuildLinuxWin32Compatibility" BeforeTargets="CoreCompile" Condition="$(RuntimeIdentifier.StartsWith('linux')) And $([MSBuild]::IsOSPlatform('Linux')) And '$(ProGpuWpfUsePortableFrameworkReferences)' == 'true' And Exists('$(_ProGpuWpfWin32CompatSource)')">
		<PropertyGroup>
			<_VoidstrapWin32CompatDirectory>$(BaseIntermediateOutputPath)win32compat/$(RuntimeIdentifier)/</_VoidstrapWin32CompatDirectory>
			<_VoidstrapWin32CompatLibrary>$(_VoidstrapWin32CompatDirectory)libwin32compat.so</_VoidstrapWin32CompatLibrary>
		</PropertyGroup>
		<Exec Command="bash &quot;$(MSBuildThisFileDirectory)build/Packaging/Linux/build-native-compat.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(_VoidstrapWin32CompatLibrary)&quot; &quot;$(_ProGpuWpfWin32CompatSource)&quot;" />
		<ItemGroup>
			<_VoidstrapWin32CompatAlias Include="kernel32.dll.so;libkernel32.dll.so;user32.dll.so;libuser32.dll.so;gdi32.dll.so;libgdi32.dll.so;dwmapi.dll.so;libdwmapi.dll.so;uxtheme.dll.so;libuxtheme.dll.so;shell32.dll.so;libshell32.dll.so;gdiplus.dll.so;libgdiplus.dll.so;comdlg32.dll.so;libcomdlg32.dll.so" />
		</ItemGroup>
		<Copy SourceFiles="@(_VoidstrapWin32CompatAlias->'$(_VoidstrapWin32CompatLibrary)')" DestinationFiles="@(_VoidstrapWin32CompatAlias->'$(TargetDir)%(Identity)')" SkipUnchangedFiles="true" />
	</Target>


	<ItemGroup Condition="('$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe') And '$(MSBuildProjectName)' != 'Voidstrap' And !$(RuntimeIdentifier.StartsWith('win'))">
		<Content Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.txt" Link="licenses/THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
		<Content Include="$(MSBuildThisFileDirectory)legal/sources/*.tar.gz" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
	</ItemGroup>

	<ItemGroup Condition="'$(MSBuildProjectName)' == 'Voidstrap.Cross'">
		<EmbeddedResource Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.txt" LogicalName="Voidstrap.Licenses.Notices" />
	</ItemGroup>

	<ItemGroup Condition="'$(MSBuildProjectName)' == 'Voidstrap'">
		<EmbeddedResource Include="$(IntermediateOutputPath)license-notices/THIRD-PARTY-NOTICES.txt.br" LogicalName="Voidstrap.Licenses.Notices.br" />
		<EmbeddedResource Include="$(MSBuildThisFileDirectory)legal/sources/*.tar.gz" LogicalName="Voidstrap.Licenses.%(Filename)%(Extension)" />
	</ItemGroup>

	<UsingTask TaskName="CompressVoidstrapLicenseNotices" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<Source ParameterType="System.String" Required="true" />
			<Destination ParameterType="System.String" Required="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System" />
			<Using Namespace="System.IO" />
			<Using Namespace="System.IO.Compression" />
			<Code Type="Fragment" Language="cs"><![CDATA[
				Directory.CreateDirectory(Path.GetDirectoryName(Destination));
				using (FileStream input = File.OpenRead(Source))
				using (FileStream output = File.Create(Destination))
				using (Stream compressed = (Stream)Activator.CreateInstance(Type.GetType("System.IO.Compression.BrotliStream, System.IO.Compression.Brotli", true), output, (CompressionLevel)3))
					input.CopyTo(compressed);
			]]></Code>
		</Task>
	</UsingTask>

	<Target Name="BuildCompressedLicenseNotices" BeforeTargets="AssignTargetPaths" Condition="'$(MSBuildProjectName)' == 'Voidstrap'" Inputs="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.txt;$(MSBuildThisFileFullPath)" Outputs="$(IntermediateOutputPath)license-notices/THIRD-PARTY-NOTICES.txt.br">
		<CompressVoidstrapLicenseNotices Source="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.txt" Destination="$(IntermediateOutputPath)license-notices/THIRD-PARTY-NOTICES.txt.br" />
		<ItemGroup>
			<FileWrites Include="$(IntermediateOutputPath)license-notices/THIRD-PARTY-NOTICES.txt.br" />
		</ItemGroup>
	</Target>

	<Target Name="RemoveWindowsLicenseSidecars" BeforeTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(MSBuildProjectName)' == 'Voidstrap'">
		<RemoveDir Directories="$(OutDir)licenses" Condition="'$(OutDir)' != ''" />
		<RemoveDir Directories="$(PublishDir)licenses" Condition="'$(PublishDir)' != ''" />
	</Target>

	<UsingTask TaskName="PackVoidstrapAppSource" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<SourceRoot ParameterType="System.String" Required="true" />
			<OutputFile ParameterType="System.String" Required="true" />
			<Level ParameterType="System.Int32" Required="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System" />
			<Using Namespace="System.IO" />
			<Using Namespace="System.IO.Compression" />
			<Code Type="Fragment" Language="cs"><![CDATA[
				string[] extensions = { ".cs", ".xaml", ".csproj", ".props", ".targets", ".editorconfig", ".manifest", ".config" };
				string[] skipFolders = { "obj", "bin", "jsmodules" };
				string root = SourceRoot.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar) + Path.DirectorySeparatorChar;
				Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
				string temporary = OutputFile + ".tmp";
				if (File.Exists(temporary))
					File.Delete(temporary);
				MemoryStream stream = new MemoryStream();
				using (ZipArchive archive = new ZipArchive(stream, ZipArchiveMode.Create, true))
				{
					foreach (string file in Directory.EnumerateFiles(SourceRoot, "*", SearchOption.AllDirectories))
					{
						string relative = file.Length > root.Length && file.StartsWith(root, StringComparison.OrdinalIgnoreCase) ? file.Substring(root.Length) : Path.GetFileName(file);
						string[] parts = relative.Split(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
						bool skipped = false;
						foreach (string part in parts)
						{
							string lower = part.ToLowerInvariant();
							if (Array.IndexOf(skipFolders, lower) >= 0 || lower.StartsWith("obj-") || lower.StartsWith("bin-"))
							{
								skipped = true;
								break;
							}
						}
						if (skipped)
							continue;
						string extension = Path.GetExtension(file).ToLowerInvariant();
						if (Array.IndexOf(extensions, extension) < 0)
							continue;
						if (extension == ".cs" && (file.EndsWith(".g.cs", StringComparison.OrdinalIgnoreCase) || file.EndsWith(".g.i.cs", StringComparison.OrdinalIgnoreCase)))
							continue;
						FileInfo info = new FileInfo(file);
						if (info.Length <= 0 || info.Length > 4L * 1024 * 1024)
							continue;
						string entryName = relative.Replace(Path.DirectorySeparatorChar, '/').Replace(Path.AltDirectorySeparatorChar, '/');
						archive.CreateEntryFromFile(file, entryName, CompressionLevel.NoCompression);
					}
				}
				stream.Position = 0;
				using (FileStream output = File.Create(temporary))
				using (Stream brotli = (Stream)Activator.CreateInstance(Type.GetType("System.IO.Compression.BrotliStream, System.IO.Compression.Brotli", true), output, (CompressionLevel)Level))
					stream.CopyTo(brotli);
				if (File.Exists(OutputFile))
					File.Delete(OutputFile);
				File.Move(temporary, OutputFile);
				if (File.Exists(OutputFile + ".tmp"))
					File.Delete(OutputFile + ".tmp");
			]]></Code>
		</Task>
	</UsingTask>

	<ItemGroup Condition="('$(MSBuildProjectName)' == 'Voidstrap' Or '$(MSBuildProjectName)' == 'Voidstrap.Cross') And ('$(IncludeAppSource)' == 'true' Or '$(Configuration)' == 'Debug')">
		<AppSourceInputs Include="$(MSBuildThisFileDirectory)src/**/*.cs;$(MSBuildThisFileDirectory)src/**/*.xaml;$(MSBuildThisFileDirectory)src/**/*.csproj;$(MSBuildThisFileDirectory)src/**/*.props;$(MSBuildThisFileDirectory)src/**/*.targets"
			Exclude="$(MSBuildThisFileDirectory)src/**/obj/**;$(MSBuildThisFileDirectory)src/**/bin/**;$(MSBuildThisFileDirectory)src/**/obj-*/**;$(MSBuildThisFileDirectory)src/**/bin-*/**;$(MSBuildThisFileDirectory)src/**/*.g.cs;$(MSBuildThisFileDirectory)src/**/*.g.i.cs" />
	</ItemGroup>

	<Target Name="PackVoidstrapAppSourceArchive" BeforeTargets="AssignTargetPaths" Condition="('$(MSBuildProjectName)' == 'Voidstrap' Or '$(MSBuildProjectName)' == 'Voidstrap.Cross') And ('$(IncludeAppSource)' == 'true' Or '$(Configuration)' == 'Debug')"
		Inputs="@(AppSourceInputs);$(MSBuildThisFileFullPath)"
		Outputs="$(IntermediateOutputPath)app-source/Voidstrap.AppSource.br">
		<PropertyGroup>
			<AppSourceBrotliLevel Condition="'$(Configuration)' == 'Debug'">0</AppSourceBrotliLevel>
			<AppSourceBrotliLevel Condition="'$(Configuration)' != 'Debug'">3</AppSourceBrotliLevel>
		</PropertyGroup>
		<PackVoidstrapAppSource SourceRoot="$(MSBuildThisFileDirectory)src" OutputFile="$(IntermediateOutputPath)app-source/Voidstrap.AppSource.br" Level="$(AppSourceBrotliLevel)" />
		<ItemGroup>
			<FileWrites Include="$(IntermediateOutputPath)app-source/Voidstrap.AppSource.br" />
		</ItemGroup>
	</Target>

	<ItemGroup Condition="('$(MSBuildProjectName)' == 'Voidstrap' Or '$(MSBuildProjectName)' == 'Voidstrap.Cross') And ('$(IncludeAppSource)' == 'true' Or '$(Configuration)' == 'Debug')">
		<EmbeddedResource Include="$(IntermediateOutputPath)app-source/Voidstrap.AppSource.br" LogicalName="Voidstrap.AppSource.br" />
	</ItemGroup>

</Project>
