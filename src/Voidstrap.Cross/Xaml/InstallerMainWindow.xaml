<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.Installer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dmodels="clr-namespace:Voidstrap.UI.ViewModels.Installer" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:pages="clr-namespace:Voidstrap.UI.Elements.Installer.Pages" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="{x:Static resources:Strings.Installer_Title}" Width="680" Height="430" MinWidth="640" MinHeight="400" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowStartupLocation="CenterScreen" xmlns:installer="clr-namespace:Voidstrap.UI.Elements.Installer" Background="{ui:ThemeResource ApplicationBackgroundBrush}">
  <Grid>
    <Panel.Background>
      <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
        <GradientStop Offset="0.00" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        <GradientStop Offset="0.70" Color="{DynamicResource WindowBackgroundColorSecondary}" />
        <GradientStop Offset="1.00" Color="{DynamicResource WindowBackgroundColorThird}" />
      </LinearGradientBrush>
    </Panel.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Name="RootTitleBar" Title="{x:Static resources:Strings.Installer_Title}" Grid.Row="0" Padding="4" ForceShutdown="False" Icon="pack://application:,,,/Voidstrap.png" MinimizeToTray="False" UseSnapLayout="True" />
    <Grid Name="RootGrid" Row="1" Margin="8,8,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Name="SidebarHost" Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
        <ui:NavigationFluent Name="RootNavigation" IsEnabled="False" SelectedPageIndex="0" Frame="{Binding ElementName=RootFrame}">
          <ui:NavigationBase.Items>
            <ui:NavigationItem BorderThickness="1,1,1,1" Content="{x:Static resources:Strings.Installer_Welcome_Title}" Icon="NumberCircle116" PageType="{x:Type pages:WelcomePage}" />
            <ui:NavigationItem Content="{x:Static resources:Strings.Installer_Install_Title}" Icon="NumberCircle216" PageType="{x:Type pages:InstallPage}" />
            <ui:NavigationItem Content="{x:Static resources:Strings.Installer_Completion_Title}" Icon="NumberCircle316" PageType="{x:Type pages:CompletionPage}" />
          </ui:NavigationBase.Items>
        </ui:NavigationFluent>
      </Border>
      <Grid Row="0" RowSpan="2" Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <TextBlock Name="StepHeadingText" Margin="0,0,0,4" FontSize="24" FontWeight="Bold" Text="{Binding StepHeading, Mode=OneWay}" />
          <ui:Breadcrumb Margin="0,0,0,4" Navigation="{Binding ElementName=RootNavigation}" />
        </StackPanel>
        <Frame Name="RootFrame" Grid.Row="1" Margin="0,2,8,0" Content="This installation process will be quick and simple, and you will be able to configure any of Voidstrap's settings after installation." Navigated="RootFrame_Navigated" />
      </Grid>
    </Grid>
    <StatusBar Name="NavButtonBar" Grid.Row="2" Padding="8,6" BorderThickness="0,1,0,0" Background="{DynamicResource PrimaryBackgroundColor}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
          </Grid>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <StatusBarItem Grid.Column="1" Padding="0,0,2,0">
        <ui:Button Width="80" Content="{x:Static resources:Strings.Common_Navigation_Back}" Command="{Binding BackPageCommand, Mode=OneWay}" IsEnabled="{Binding BackButtonEnabled, Mode=OneWay}" />
      </StatusBarItem>
      <StatusBarItem Grid.Column="2" Padding="2,0,2,0">
        <ui:Button Name="NextButton" Width="80" Command="{Binding NextPageCommand, Mode=OneWay}" Content="{Binding NextButtonText, Mode=OneWay}" IsEnabled="{Binding NextButtonEnabled, Mode=OneWay}" />
      </StatusBarItem>
      <StatusBarItem Grid.Column="3" Padding="8,0,2,0">
        <ui:Button MinWidth="80" Content="{x:Static resources:Strings.Common_Close}" Width="{Binding ButtonWidth, Mode=OneTime}" Command="{Binding CloseWindowCommand}" />
      </StatusBarItem>
    </StatusBar>
  </Grid>
</base:WpfUiWindow>
