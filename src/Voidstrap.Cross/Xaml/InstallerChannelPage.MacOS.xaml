<ui:UiPage x:Class="Voidstrap.UI.Elements.Installer.Pages.ChannelPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Roblox" Loaded="UiPage_Loaded" Unloaded="UiPage_Unloaded">
  <Grid Margin="24">
    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="620">
      <Image Width="72" Height="72" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Resources/RobloxPlayerIcon.png" />
      <TextBlock Margin="0,20,0,0" FontSize="20" FontWeight="SemiBold" Text="{x:Static resources:Strings.Installer_MacOS_Roblox_Title}" TextWrapping="Wrap" />
      <TextBlock Margin="0,8,0,0" FontSize="16" LineHeight="24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Installer_MacOS_Roblox_Text}" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</ui:UiPage>
