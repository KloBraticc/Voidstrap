<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.Installer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base" xmlns:pages="clr-namespace:Voidstrap.UI.Elements.Installer.Pages" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="{x:Static resources:Strings.Installer_Title}" Width="960" Height="600" MinWidth="880" MinHeight="520" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowStartupLocation="CenterScreen" Background="{ui:ThemeResource ApplicationBackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar Name="RootTitleBar" Grid.Row="0" Padding="8" Title="{x:Static resources:Strings.Installer_Title}" Icon="pack://application:,,,/Voidstrap.png" ForceShutdown="False" MinimizeToTray="False" ShowMaximize="False" UseSnapLayout="True" />
    <Grid Name="RootGrid" Grid.Row="1" Margin="32,18,32,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ui:NavigationStore Name="RootNavigation" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False" SelectedPageIndex="0" Frame="{Binding ElementName=RootFrame}">
        <ui:NavigationBase.Items>
          <ui:NavigationItem Content="{x:Static resources:Strings.Installer_Install_Title}" Icon="ArrowDownload24" PageType="{x:Type pages:InstallPage}" />
          <ui:NavigationItem Content="Channel" Icon="Globe24" PageType="{x:Type pages:ChannelPage}" />
          <ui:NavigationItem Content="{x:Static resources:Strings.Installer_Completion_Title}" Icon="CheckmarkCircle24" PageType="{x:Type pages:CompletionPage}" />
        </ui:NavigationBase.Items>
      </ui:NavigationStore>
      <Grid Name="ArtStage" Grid.Row="0" Grid.RowSpan="2" Width="220" Height="220" Margin="0,0,20,40" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
      <TextBlock Name="StepHeadingText" Grid.Row="0" Grid.Column="1" Margin="0,0,0,20" FontSize="28" FontWeight="SemiBold" Text="{Binding StepHeading, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
      <Frame Name="RootFrame" Grid.Row="1" Grid.Column="1" NavigationUIVisibility="Hidden" Navigated="RootFrame_Navigated" />
      <Grid Name="NavButtonBar" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,20,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="3" Height="1" Margin="0,-20,0,0" VerticalAlignment="Top" Background="{DynamicResource ControlElevationBorderBrush}" />
        <ui:Button Grid.Column="0" MinWidth="{Binding ButtonWidth, Mode=OneTime}" Height="36" Margin="0,20,0,0" HorizontalContentAlignment="Center" Content="{x:Static resources:Strings.Common_Close}" Command="{Binding CloseWindowCommand}" />
        <StackPanel Grid.Column="2" Margin="0,20,0,0" Orientation="Horizontal">
          <ui:Button MinWidth="{Binding ButtonWidth, Mode=OneTime}" Height="36" HorizontalContentAlignment="Center" Content="{x:Static resources:Strings.Common_Navigation_Back}" Command="{Binding BackPageCommand, Mode=OneWay}" IsEnabled="{Binding BackButtonEnabled, Mode=OneWay}" />
          <ui:Button Name="NextButton" MinWidth="120" Height="36" Margin="8,0,0,0" HorizontalContentAlignment="Center" Appearance="Primary" Command="{Binding NextPageCommand, Mode=OneWay}" Content="{Binding NextButtonText, Mode=OneWay}" IsEnabled="{Binding NextButtonEnabled, Mode=OneWay}" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</base:WpfUiWindow>
