<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.ContextMenu.MeshViewerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Width="720" Height="640" MinWidth="480" MinHeight="420" ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterScreen" xmlns:contextmenu="clr-namespace:Voidstrap.UI.Elements.ContextMenu" Background="{ui:ThemeResource ApplicationBackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Name="RootTitleBar" Grid.Row="0" Title="Mesh Viewer" Padding="8" Icon="pack://application:,,,/Voidstrap.png" MinimizeToTray="False" ShowMaximize="True" />
    <Border Name="ViewportHost" Grid.Row="1" Margin="10,4,10,4" CornerRadius="6" ClipToBounds="True" Background="#FF161616" MouseLeftButtonDown="ViewportHost_MouseLeftButtonDown" MouseLeftButtonUp="ViewportHost_MouseLeftButtonUp" MouseMove="ViewportHost_MouseMove" MouseWheel="ViewportHost_MouseWheel">
      <Viewport3D Name="Viewport">
        <Viewport3D.Camera>
          <PerspectiveCamera x:Name="Camera" Position="0,0,12" LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="45" />
        </Viewport3D.Camera>
        <ModelVisual3D>
          <ModelVisual3D.Content>
            <Model3DGroup>
              <AmbientLight Color="#555555" />
              <DirectionalLight Color="#FFFFFF" Direction="-0.6,-0.7,-1" />
              <DirectionalLight Color="#808080" Direction="0.8,0.6,0.7" />
            </Model3DGroup>
          </ModelVisual3D.Content>
        </ModelVisual3D>
        <ModelVisual3D x:Name="MeshVisual" />
      </Viewport3D>
    </Border>
    <Border Grid.Row="2" Padding="12,8" Background="{DynamicResource PrimaryBackgroundColor}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="   •   Drag to rotate, scroll to zoom" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
      </StackPanel>
    </Border>
  </Grid>
</base:WpfUiWindow>