          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="CrosshairInspector" Margin="0,12,0,0" Visibility="Collapsed">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{resources:Loc Ui_OverlayStudio_EnableCrosshair}" Style="{StaticResource Label}" />
                  <TextBlock Text="{resources:Loc Ui_OverlayStudio_EnableCrosshairHint}" Style="{StaticResource Hint}" />
                </StackPanel>
                <ui:ToggleSwitch x:Name="CrosshairEnableToggle" Grid.Column="1" VerticalAlignment="Center" Checked="CrosshairControl_Changed" Unchecked="CrosshairControl_Changed" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{resources:Loc Ui_OverlayStudio_CrosshairShape}" Style="{StaticResource Label}" />
                <Border Grid.Column="1" Style="{StaticResource SegmentTray}">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="CrosshairShapeCross" Content="{resources:Loc Ui_OverlayStudio_ShapeCross}" GroupName="StudioCrosshairShape" Style="{StaticResource Segment}" Checked="CrosshairShape_Changed" />
                    <RadioButton x:Name="CrosshairShapeDot" Content="{resources:Loc Ui_OverlayStudio_ShapeDot}" GroupName="StudioCrosshairShape" Style="{StaticResource Segment}" Checked="CrosshairShape_Changed" />
                    <RadioButton x:Name="CrosshairShapeCircle" Content="{resources:Loc Ui_OverlayStudio_ShapeCircle}" GroupName="StudioCrosshairShape" Style="{StaticResource Segment}" Checked="CrosshairShape_Changed" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{resources:Loc Ui_Mods_Colors}" Style="{StaticResource Label}" />
                  <TextBlock Text="{resources:Loc Ui_Mods_FillAndOutline}" Style="{StaticResource Hint}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Border x:Name="CrosshairColorSwatch" Width="20" Height="20" CornerRadius="4" Margin="0,0,6,0" VerticalAlignment="Center" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="PickCrosshairFillColor_Click" />
                  <TextBox x:Name="CrosshairColorHexBox" Width="92" VerticalAlignment="Center" LostFocus="CrosshairColorHexBox_LostFocus" KeyDown="CrosshairColorHexBox_KeyDown" />
                  <ui:Button Content="{resources:Loc Ui_Mods_Pick}" Appearance="Secondary" Margin="4,0,12,0" Padding="10,5" Focusable="False" Click="PickCrosshairFillColor_Click" />
                  <Border x:Name="CrosshairOutlineSwatch" Width="20" Height="20" CornerRadius="4" Margin="0,0,6,0" VerticalAlignment="Center" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="PickCrosshairOutlineColor_Click" />
                  <TextBox x:Name="CrosshairOutlineColorHexBox" Width="92" VerticalAlignment="Center" LostFocus="CrosshairOutlineColorHexBox_LostFocus" KeyDown="CrosshairOutlineColorHexBox_KeyDown" />
                  <ui:Button Content="{resources:Loc Ui_Mods_Pick}" Appearance="Secondary" Margin="4,0,0,0" Padding="10,5" Focusable="False" Click="PickCrosshairOutlineColor_Click" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{resources:Loc Ui_OverlayStudio_CrosshairSize}" Style="{StaticResource Label}" />
                <Slider x:Name="CrosshairSizeSlider" Grid.Column="1" Minimum="4" Maximum="60" TickFrequency="1" Style="{StaticResource RowSlider}" ValueChanged="CrosshairSlider_Changed" />
                <TextBlock x:Name="CrosshairSizeText" Grid.Column="2" Style="{StaticResource Value}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{resources:Loc Ui_OverlayStudio_CrosshairThickness}" Style="{StaticResource Label}" />
                <Slider x:Name="CrosshairThicknessSlider" Grid.Column="1" Minimum="1" Maximum="12" TickFrequency="1" Style="{StaticResource RowSlider}" ValueChanged="CrosshairSlider_Changed" />
                <TextBlock x:Name="CrosshairThicknessText" Grid.Column="2" Style="{StaticResource Value}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{resources:Loc Ui_OverlayStudio_CrosshairGap}" Style="{StaticResource Label}" />
                <Slider x:Name="CrosshairGapSlider" Grid.Column="1" Minimum="0" Maximum="30" TickFrequency="1" Style="{StaticResource RowSlider}" ValueChanged="CrosshairSlider_Changed" />
                <TextBlock x:Name="CrosshairGapText" Grid.Column="2" Style="{StaticResource Value}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{resources:Loc Ui_Appearance_Background}" Style="{StaticResource Label}" />
                <Slider x:Name="CrosshairOpacitySlider" Grid.Column="1" Minimum="10" Maximum="100" TickFrequency="5" Style="{StaticResource RowSlider}" ValueChanged="CrosshairSlider_Changed" />
                <TextBlock x:Name="CrosshairOpacityText" Grid.Column="2" Style="{StaticResource Value}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{resources:Loc Ui_OverlayStudio_CrosshairOffsetX}" Style="{StaticResource Label}" />
                <Slider x:Name="CrosshairOffsetXSlider" Grid.Column="1" Minimum="-200" Maximum="200" TickFrequency="1" Style="{StaticResource RowSlider}" ValueChanged="CrosshairSlider_Changed" />
                <TextBlock x:Name="CrosshairOffsetXText" Grid.Column="2" Style="{StaticResource Value}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{resources:Loc Ui_OverlayStudio_CrosshairOffsetY}" Style="{StaticResource Label}" />
                <Slider x:Name="CrosshairOffsetYSlider" Grid.Column="1" Minimum="-200" Maximum="200" TickFrequency="1" Style="{StaticResource RowSlider}" ValueChanged="CrosshairSlider_Changed" />
                <TextBlock x:Name="CrosshairOffsetYText" Grid.Column="2" Style="{StaticResource Value}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource LastRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{resources:Loc Ui_OverlayStudio_CenterCrosshair}" Style="{StaticResource Label}" />
                <ui:Button Grid.Column="1" Content="{resources:Loc Ui_OverlayStudio_CenterCrosshair}" Appearance="Secondary" Padding="14,6" Focusable="False" Click="RecenterCrosshair_Click" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="KeystrokesInspector" Margin="0,12,0,0" Visibility="Collapsed">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{resources:Loc Ui_Keystrokes_Title}" Style="{StaticResource Label}" />
                  <TextBlock Text="{resources:Loc Ui_Keystrokes_Description}" Style="{StaticResource Hint}" />
                </StackPanel>
                <ui:ToggleSwitch x:Name="KeystrokesEnableToggle" Grid.Column="1" VerticalAlignment="Center" Checked="KeystrokesControl_Changed" Unchecked="KeystrokesControl_Changed" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{resources:Loc Ui_Keystrokes_ShowKeys}" Style="{StaticResource Label}" />
                  <TextBlock Text="{resources:Loc Ui_Keystrokes_ShowKeysHint}" Style="{StaticResource Hint}" />
                </StackPanel>
                <ui:ToggleSwitch x:Name="KeystrokesShowKeysToggle" Grid.Column="1" VerticalAlignment="Center" Checked="KeystrokesControl_Changed" Unchecked="KeystrokesControl_Changed" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{resources:Loc Ui_Keystrokes_ShowMouseButtons}" Style="{StaticResource Label}" />
                  <TextBlock Text="{resources:Loc Ui_Keystrokes_ShowMouseButtonsHint}" Style="{StaticResource Hint}" />
                </StackPanel>
                <ui:ToggleSwitch x:Name="KeystrokesShowMouseToggle" Grid.Column="1" VerticalAlignment="Center" Checked="KeystrokesControl_Changed" Unchecked="KeystrokesControl_Changed" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{resources:Loc Ui_Keystrokes_ShowSpaceAndShift}" Style="{StaticResource Label}" />
                  <TextBlock Text="{resources:Loc Ui_Keystrokes_ShowSpaceAndShiftHint}" Style="{StaticResource Hint}" />
                </StackPanel>
                <ui:ToggleSwitch x:Name="KeystrokesShowSpaceToggle" Grid.Column="1" VerticalAlignment="Center" Checked="KeystrokesControl_Changed" Unchecked="KeystrokesControl_Changed" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{resources:Loc Ui_Keystrokes_ShowCps}" Style="{StaticResource Label}" />
                  <TextBlock Text="{resources:Loc Ui_Keystrokes_ShowCpsHint}" Style="{StaticResource Hint}" />
                </StackPanel>
                <ui:ToggleSwitch x:Name="KeystrokesShowCpsToggle" Grid.Column="1" VerticalAlignment="Center" Checked="KeystrokesControl_Changed" Unchecked="KeystrokesControl_Changed" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{resources:Loc Ui_OverlayStudio_KeystrokesScale}" Style="{StaticResource Label}" />
                <Slider x:Name="KeystrokesScaleSlider" Grid.Column="1" Minimum="70" Maximum="150" TickFrequency="5" Style="{StaticResource RowSlider}" ValueChanged="KeystrokesSlider_Changed" />
                <TextBlock x:Name="KeystrokesScaleText" Grid.Column="2" Style="{StaticResource Value}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{resources:Loc Ui_OverlayStudio_KeystrokesOpacity}" Style="{StaticResource Label}" />
                <Slider x:Name="KeystrokesOpacitySlider" Grid.Column="1" Minimum="35" Maximum="100" TickFrequency="5" Style="{StaticResource RowSlider}" ValueChanged="KeystrokesSlider_Changed" />
                <TextBlock x:Name="KeystrokesOpacityText" Grid.Column="2" Style="{StaticResource Value}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource LastRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{resources:Loc Ui_OverlayStudio_KeystrokesEdgeSpacing}" Style="{StaticResource Label}" />
                <Slider x:Name="KeystrokesEdgeSlider" Grid.Column="1" Minimum="0" Maximum="64" TickFrequency="2" Style="{StaticResource RowSlider}" ValueChanged="KeystrokesSlider_Changed" />
                <TextBlock x:Name="KeystrokesEdgeText" Grid.Column="2" Style="{StaticResource Value}" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="PanelsInspector" Margin="0,12,0,0" Visibility="Collapsed">
        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{resources:Loc Ui_OverlayStudio_PanelsDescription}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ui:Button Grid.Column="1" Content="{resources:Loc Ui_OverlayStudio_ResetAllPanels}" Appearance="Secondary" Padding="12,6" Focusable="False" Click="ResetAllPanels_Click" />
          </Grid>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel x:Name="PanelRowsHost" />
        </Border>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</Window>
