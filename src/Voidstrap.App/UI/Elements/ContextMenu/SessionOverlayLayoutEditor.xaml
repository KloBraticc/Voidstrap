<Window xmlns:resources="clr-namespace:Voidstrap.Resources"
        x:Class="Voidstrap.UI.Elements.Overlay.SessionOverlayLayoutEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{resources:Loc Ui_OverlayStudio_Title}" Width="680" Height="740" MinWidth="560" MinHeight="480"
        WindowStyle="None" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="2,18,0,10" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Width" Value="62" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    </Style>
    <Style x:Key="Row" TargetType="Border">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="16,8,14,8" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    </Style>
    <Style x:Key="LastRow" TargetType="Border" BasedOn="{StaticResource Row}">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="RowSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IsSnapToTickEnabled" Value="True" />
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Chip" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="Transparent">
              <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LayerTabSegment" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="6,5" />
    </Style>
    <Style x:Key="SegmentTray" TargetType="Border">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="AnchorDot" TargetType="Button">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="DotBorder" CornerRadius="6" BorderThickness="1"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
              <Ellipse x:Name="DotCore" Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Fill="{DynamicResource TextFillColorSecondaryBrush}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="DotBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter TargetName="DotCore" Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <ScrollViewer x:Name="TitleScrollHost" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,0,16,16">

      <TextBlock Text="{resources:Loc Ui_OverlayStudio_Title}" Style="{StaticResource Section}" Margin="2,10,0,10" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Border Style="{StaticResource Row}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{resources:Loc Ui_OverlayStudio_LiveScreenDragTitle}" Style="{StaticResource Label}" />
                <TextBlock Text="{resources:Loc Ui_OverlayStudio_Subtitle}" Style="{StaticResource Hint}" />
              </StackPanel>
              <ui:Button x:Name="ScreenDragButton" Grid.Column="1" Appearance="Secondary" Padding="14,7" VerticalAlignment="Center" Focusable="False" Click="ScreenDragButton_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE759;" Style="{StaticResource Glyph}" Margin="0,0,7,0" />
                  <TextBlock Text="{resources:Loc Ui_OverlayStudio_LiveScreenDrag}" FontSize="13" FontWeight="SemiBold" />
                </StackPanel>
              </ui:Button>
            </Grid>
          </Border>
          <Border Style="{StaticResource LastRow}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{resources:Loc Ui_OverlayStudio_QuickPresets}" Style="{StaticResource Label}" Margin="0,0,14,0" />
              <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:Button Content="{resources:Loc Ui_OverlayStudio_PresetDefault}" Tag="default" Margin="0,2,6,2" Padding="10,5" Appearance="Secondary" Focusable="False" Click="Preset_Click" />
                <ui:Button Content="{resources:Loc Ui_OverlayStudio_PresetTopBar}" Tag="tophud" Margin="0,2,6,2" Padding="10,5" Appearance="Secondary" Focusable="False" Click="Preset_Click" />
                <ui:Button Content="{resources:Loc Ui_OverlayStudio_PresetCompetitive}" Tag="competitive" Margin="0,2,6,2" Padding="10,5" Appearance="Secondary" Focusable="False" Click="Preset_Click" />
                <ui:Button Content="{resources:Loc Ui_OverlayStudio_PresetStreamer}" Tag="streamer" Margin="0,2,6,2" Padding="10,5" Appearance="Secondary" Focusable="False" Click="Preset_Click" />
                <ui:Button Content="{resources:Loc Ui_OverlayStudio_PresetTopDock}" Tag="topdock" Margin="0,2,6,2" Padding="10,5" Appearance="Secondary" Focusable="False" Click="Preset_Click" />
                <ui:Button Content="{resources:Loc Ui_OverlayStudio_ResetLayer}" Margin="0,2,6,2" Padding="10,5" Appearance="Secondary" Focusable="False" Click="ResetLayer_Click" />
                <ui:Button Content="{resources:Loc Ui_OverlayStudio_ResetAll}" Margin="0,2,0,2" Padding="10,5" Appearance="Secondary" Focusable="False" Click="ResetAll_Click" />
              </WrapPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <Grid Margin="2,18,2,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{resources:Loc Ui_OverlayStudio_StagePreview}" FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <TextBlock Text="{resources:Loc Ui_OverlayStudio_StageHint}" Style="{StaticResource Hint}" />
        </StackPanel>
        <Border Grid.Column="1" VerticalAlignment="Bottom" CornerRadius="6" Padding="10,4"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <TextBlock x:Name="StageCoordBadge" Text="X: 100%  Y: 0%" FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Border>
      </Grid>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Height="220" CornerRadius="8" BorderThickness="1" ClipToBounds="True"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
          <Grid>
            <Border x:Name="StageImageHost" CornerRadius="7" Opacity="0.28">
              <Border.Background>
                <ImageBrush x:Name="StageBackgroundBrush" Stretch="UniformToFill" />
              </Border.Background>
            </Border>
            <Border CornerRadius="7" Background="#66000000" />
            <Canvas x:Name="StageCanvas" ClipToBounds="True" SizeChanged="StageCanvas_SizeChanged">
              <Line x:Name="StageGuideVThird1" Stroke="#1CFFFFFF" StrokeThickness="1" StrokeDashArray="3 4" IsHitTestVisible="False" />
              <Line x:Name="StageGuideVThird2" Stroke="#1CFFFFFF" StrokeThickness="1" StrokeDashArray="3 4" IsHitTestVisible="False" />
              <Line x:Name="StageGuideHThird1" Stroke="#1CFFFFFF" StrokeThickness="1" StrokeDashArray="3 4" IsHitTestVisible="False" />
              <Line x:Name="StageGuideHThird2" Stroke="#1CFFFFFF" StrokeThickness="1" StrokeDashArray="3 4" IsHitTestVisible="False" />
              <Line x:Name="StageGuideVCenter" Stroke="#34FFFFFF" StrokeThickness="1" StrokeDashArray="4 3" IsHitTestVisible="False" />
              <Line x:Name="StageGuideHCenter" Stroke="#34FFFFFF" StrokeThickness="1" StrokeDashArray="4 3" IsHitTestVisible="False" />
            </Canvas>
          </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10,10" VerticalAlignment="Stretch">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{resources:Loc Ui_OverlayStudio_QuickAnchor}" FontSize="11.5" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <UniformGrid Rows="3" Columns="3" HorizontalAlignment="Center">
              <Button Style="{StaticResource AnchorDot}" Tag="0,0" Click="QuickAnchor_Click" />
              <Button Style="{StaticResource AnchorDot}" Tag="50,0" Click="QuickAnchor_Click" />
              <Button Style="{StaticResource AnchorDot}" Tag="100,0" Click="QuickAnchor_Click" />
              <Button Style="{StaticResource AnchorDot}" Tag="0,50" Click="QuickAnchor_Click" />
              <Button Style="{StaticResource AnchorDot}" Tag="50,50" Click="QuickAnchor_Click" />
              <Button Style="{StaticResource AnchorDot}" Tag="100,50" Click="QuickAnchor_Click" />
              <Button Style="{StaticResource AnchorDot}" Tag="0,100" Click="QuickAnchor_Click" />
              <Button Style="{StaticResource AnchorDot}" Tag="50,100" Click="QuickAnchor_Click" />
              <Button Style="{StaticResource AnchorDot}" Tag="100,100" Click="QuickAnchor_Click" />
            </UniformGrid>
          </StackPanel>
        </Border>
      </Grid>

      <Border Style="{StaticResource SegmentTray}" HorizontalAlignment="Stretch" Margin="0,14,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="0.85*" />
            <ColumnDefinition Width="0.9*" />
            <ColumnDefinition Width="1.0*" />
          </Grid.ColumnDefinitions>
          <RadioButton x:Name="TabReadout" Grid.Column="0" Tag="Readout" Content="{resources:Loc Ui_OverlayStudio_LayerReadout}" GroupName="StudioLayerTab" Style="{StaticResource LayerTabSegment}" IsChecked="True" Checked="LayerTab_Click" />
          <RadioButton x:Name="TabNotifications" Grid.Column="1" Tag="Notifications" Content="{resources:Loc Ui_OverlayStudio_LayerNotifications}" GroupName="StudioLayerTab" Style="{StaticResource LayerTabSegment}" Checked="LayerTab_Click" />
          <RadioButton x:Name="TabDock" Grid.Column="2" Tag="Dock" Content="{resources:Loc Ui_OverlayStudio_LayerDock}" GroupName="StudioLayerTab" Style="{StaticResource LayerTabSegment}" Checked="LayerTab_Click" />
          <RadioButton x:Name="TabCrosshair" Grid.Column="3" Tag="Crosshair" Content="{resources:Loc Ui_OverlayStudio_LayerCrosshair}" GroupName="StudioLayerTab" Style="{StaticResource LayerTabSegment}" Checked="LayerTab_Click" />
          <RadioButton x:Name="TabKeystrokes" Grid.Column="4" Tag="Keystrokes" Content="{resources:Loc Ui_OverlayStudio_LayerKeystrokes}" GroupName="StudioLayerTab" Style="{StaticResource LayerTabSegment}" Checked="LayerTab_Click" />
          <RadioButton x:Name="TabPanels" Grid.Column="5" Tag="Panels" Content="{resources:Loc Ui_OverlayStudio_LayerPanels}" GroupName="StudioLayerTab" Style="{StaticResource LayerTabSegment}" Checked="LayerTab_Click" />
        </Grid>
      </Border>

      <StackPanel x:Name="ReadoutInspector" Margin="0,12,0,0">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{resources:Loc Ui_OverlayStudio_ShowServerLocation}" Style="{StaticResource Label}" />
                  <TextBlock Text="{resources:Loc Ui_OverlayStudio_ShowServerLocationHint}" Style="{StaticResource Hint}" />
                </StackPanel>
                <ui:ToggleSwitch x:Name="ReadoutLocationToggle" Grid.Column="1" VerticalAlignment="Center" Checked="ReadoutControl_Changed" Unchecked="ReadoutControl_Changed" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{resources:Loc Ui_OverlayStudio_ShowClock}" Style="{StaticResource Label}" />
                  <TextBlock Text="{resources:Loc Ui_OverlayStudio_ShowClockHint}" Style="{StaticResource Hint}" />
                </StackPanel>
                <ui:ToggleSwitch x:Name="ReadoutClockToggle" Grid.Column="1" VerticalAlignment="Center" Checked="ReadoutControl_Changed" Unchecked="ReadoutControl_Changed" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{resources:Loc Ui_OverlayStudio_Clock24Hour}" Style="{StaticResource Label}" />
                  <TextBlock Text="{resources:Loc Ui_OverlayStudio_Clock24HourHint}" Style="{StaticResource Hint}" />
                </StackPanel>
                <ui:ToggleSwitch x:Name="Readout24HourToggle" Grid.Column="1" VerticalAlignment="Center" Checked="ReadoutControl_Changed" Unchecked="ReadoutControl_Changed" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{resources:Loc Ui_OverlayStudio_SingleLinePill}" Style="{StaticResource Label}" />
                  <TextBlock Text="{resources:Loc Ui_OverlayStudio_SingleLinePillHint}" Style="{StaticResource Hint}" />
                </StackPanel>
                <ui:ToggleSwitch x:Name="ReadoutPillToggle" Grid.Column="1" VerticalAlignment="Center" Checked="ReadoutControl_Changed" Unchecked="ReadoutControl_Changed" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{resources:Loc Ui_SessionNotify_Horizontal}" Style="{StaticResource Label}" />
                <Slider x:Name="ReadoutHorizontalSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" Style="{StaticResource RowSlider}" ValueChanged="ReadoutSlider_Changed" />
                <TextBlock x:Name="ReadoutHorizontalText" Grid.Column="2" Style="{StaticResource Value}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{resources:Loc Ui_SessionNotify_Vertical}" Style="{StaticResource Label}" />
                <Slider x:Name="ReadoutVerticalSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" Style="{StaticResource RowSlider}" ValueChanged="ReadoutSlider_Changed" />
                <TextBlock x:Name="ReadoutVerticalText" Grid.Column="2" Style="{StaticResource Value}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{resources:Loc Ui_SessionNotify_SpaceFromEdge}" Style="{StaticResource Label}" />
                <Slider x:Name="ReadoutSpacingSlider" Grid.Column="1" Minimum="0" Maximum="64" TickFrequency="1" Style="{StaticResource RowSlider}" ValueChanged="ReadoutSlider_Changed" />
                <TextBlock x:Name="ReadoutSpacingText" Grid.Column="2" Style="{StaticResource Value}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{resources:Loc Ui_OverlayStudio_ReadoutSize}" Style="{StaticResource Label}" />
                <Slider x:Name="ReadoutScaleSlider" Grid.Column="1" Minimum="70" Maximum="150" TickFrequency="5" Style="{StaticResource RowSlider}" ValueChanged="ReadoutSlider_Changed" />
                <TextBlock x:Name="ReadoutScaleText" Grid.Column="2" Style="{StaticResource Value}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{resources:Loc Ui_Appearance_Background}" Style="{StaticResource Label}" />
                <Slider x:Name="ReadoutOpacitySlider" Grid.Column="1" Minimum="35" Maximum="100" TickFrequency="5" Style="{StaticResource RowSlider}" ValueChanged="ReadoutSlider_Changed" />
                <TextBlock x:Name="ReadoutOpacityText" Grid.Column="2" Style="{StaticResource Value}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource LastRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{resources:Loc Ui_SessionNotify_CornerRadius}" Style="{StaticResource Label}" />
                <Slider x:Name="ReadoutCornerSlider" Grid.Column="1" Minimum="0" Maximum="20" TickFrequency="1" Style="{StaticResource RowSlider}" ValueChanged="ReadoutSlider_Changed" />
                <TextBlock x:Name="ReadoutCornerText" Grid.Column="2" Style="{StaticResource Value}" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="NotificationsInspector" Margin="0,12,0,0" Visibility="Collapsed">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{resources:Loc Notifications_Title}" Style="{StaticResource Label}" />
                  <TextBlock Text="{resources:Loc Ui_SessionNotify_ThisIsHowVoidstrapNotificationsLook}" Style="{StaticResource Hint}" />
                </StackPanel>
                <ui:Button Grid.Column="1" Appearance="Secondary" Padding="14,7" VerticalAlignment="Center" Focusable="False" Click="OpenNotificationSettings_Click">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" Margin="0,0,7,0" />
                    <TextBlock Text="{resources:Loc Ui_Nav_Settings}" FontSize="13" FontWeight="SemiBold" />
                  </StackPanel>
                </ui:Button>
              </Grid>
            </Border>
            <Border Style="{StaticResource LastRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{resources:Loc Ui_SessionNotify_SendATestNotification}" Style="{StaticResource Label}" />
                  <TextBlock Text="{resources:Loc Ui_SessionNotify_ClickToPlayTheAnimation}" Style="{StaticResource Hint}" />
                </StackPanel>
                <ui:Button Grid.Column="1" Content="{resources:Loc Ui_SessionNotify_SendATestNotification}" Appearance="Secondary" Padding="14,6" VerticalAlignment="Center" Focusable="False" Click="SendTestNotification_Click" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="DockInspector" Margin="0,12,0,0" Visibility="Collapsed">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{resources:Loc Ui_OverlayStudio_DockEdge}" Style="{StaticResource Label}" />
                  <TextBlock Text="{resources:Loc Ui_OverlayStudio_DockEdgeHint}" Style="{StaticResource Hint}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentTray}" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="DockBottomEdgeRadio" Content="{resources:Loc Ui_OverlayStudio_BottomEdge}" GroupName="StudioDockEdge" Style="{StaticResource Segment}" Checked="DockEdge_Changed" />
                    <RadioButton x:Name="DockTopEdgeRadio" Content="{resources:Loc Ui_OverlayStudio_TopEdge}" GroupName="StudioDockEdge" Style="{StaticResource Segment}" Checked="DockEdge_Changed" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{resources:Loc Ui_SessionNotify_Horizontal}" Style="{StaticResource Label}" />
                <Slider x:Name="DockHorizontalSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" Style="{StaticResource RowSlider}" ValueChanged="DockSlider_Changed" />
                <TextBlock x:Name="DockHorizontalText" Grid.Column="2" Style="{StaticResource Value}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{resources:Loc Ui_SessionNotify_SpaceFromEdge}" Style="{StaticResource Label}" />
                <Slider x:Name="DockSpacingSlider" Grid.Column="1" Minimum="4" Maximum="48" TickFrequency="1" Style="{StaticResource RowSlider}" ValueChanged="DockSlider_Changed" />
                <TextBlock x:Name="DockSpacingText" Grid.Column="2" Style="{StaticResource Value}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{resources:Loc Ui_OverlayStudio_DockScale}" Style="{StaticResource Label}" />
                <Slider x:Name="DockScaleSlider" Grid.Column="1" Minimum="80" Maximum="120" TickFrequency="5" Style="{StaticResource RowSlider}" ValueChanged="DockSlider_Changed" />
                <TextBlock x:Name="DockScaleText" Grid.Column="2" Style="{StaticResource Value}" />
              </Grid>
            </Border>
            <Border Style="{StaticResource LastRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                  <TextBlock Text="{resources:Loc Ui_OverlayStudio_DockDimmer}" Style="{StaticResource Label}" />
                  <TextBlock Text="{resources:Loc Ui_OverlayStudio_DockDimmerHint}" Style="{StaticResource Hint}" />
