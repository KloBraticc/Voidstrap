<Window x:Class="Voidstrap.UI.Elements.Overlay.SessionWebBrowser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Browser" Width="960" Height="640" MinWidth="520" MinHeight="360"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chip" CornerRadius="6" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Grid x:Name="BrowserRoot" PreviewKeyDown="BrowserRoot_PreviewKeyDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Tabs: icon, title and close; middle click closes, the plus opens a new one -->
    <Grid Margin="8,6,8,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ScrollViewer x:Name="TabScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                    PreviewMouseWheel="TabScroller_PreviewMouseWheel">
        <ItemsControl x:Name="TabStrip" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border x:Name="Chip" Width="190" Height="32" Margin="0,0,4,0" CornerRadius="8" Padding="10,0,4,0" Cursor="Hand"
                      ToolTip="{Binding Title}" MouseLeftButtonUp="Tab_Click" MouseDown="Tab_MouseDown">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                      </Trigger>
                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                  </Grid>
                  <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  <Button Grid.Column="2" Width="24" Height="24" Margin="4,0,0,0" Style="{StaticResource NavButton}" ToolTip="Close tab (Ctrl+W)"
                          Click="CloseTab_Click">
                    <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="10" />
                  </Button>
                  <!-- The open tab is underlined in the accent colour -->
                  <Border Grid.ColumnSpan="3" Height="2" Margin="4,0,4,0" VerticalAlignment="Bottom" CornerRadius="1"
                          Background="{DynamicResource SystemAccentColorPrimaryBrush}">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <Button Grid.Column="1" Style="{StaticResource NavButton}" Width="32" Height="32" Margin="4,0,0,0" ToolTip="New tab (Ctrl+T)" Click="NewTab_Click">
        <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" />
      </Button>
    </Grid>

    <!-- Our own toolbar: back, forward, reload, home and one box that searches Google or opens an address -->
    <Grid Grid.Row="1" Margin="10,6,10,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="BackButton" Style="{StaticResource NavButton}" ToolTip="Back (Alt+Left)" Click="Back_Click" IsEnabled="False">
          <TextBlock Text="&#xE72B;" Style="{StaticResource Glyph}" />
        </Button>
        <Button x:Name="ForwardButton" Style="{StaticResource NavButton}" ToolTip="Forward (Alt+Right)" Click="Forward_Click" IsEnabled="False">
          <TextBlock Text="&#xE72A;" Style="{StaticResource Glyph}" />
        </Button>
        <Button x:Name="ReloadButton" Style="{StaticResource NavButton}" ToolTip="Reload (F5)" Click="Reload_Click">
          <TextBlock x:Name="ReloadGlyph" Text="&#xE72C;" Style="{StaticResource Glyph}" />
        </Button>
        <Button Style="{StaticResource NavButton}" ToolTip="Google" Click="Home_Click" Margin="0,0,8,0">
          <TextBlock Text="&#xE80F;" Style="{StaticResource Glyph}" />
        </Button>
      </StackPanel>
      <!-- The search box gets an accent outline while typing in it -->
      <Border Grid.Column="1" Height="34" CornerRadius="17" Padding="14,0,8,0" BorderThickness="1"
              Background="{DynamicResource ControlFillColorDefaultBrush}">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Style.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="AddressIcon" Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,10,0"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <Grid Grid.Column="1">
            <TextBlock x:Name="Placeholder" Text="Search Google or type an address" FontSize="14" VerticalAlignment="Center"
                       IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBox x:Name="AddressBox" FontSize="14" VerticalAlignment="Center" BorderThickness="0" Background="Transparent" Padding="0"
                     SelectionBrush="{DynamicResource SystemAccentColorPrimaryBrush}" SelectionOpacity="0.55"
                     CaretBrush="{DynamicResource TextFillColorPrimaryBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     KeyDown="AddressBox_KeyDown" GotKeyboardFocus="AddressBox_GotFocus" LostKeyboardFocus="AddressBox_LostFocus"
                     TextChanged="AddressBox_TextChanged" />
          </Grid>
          <Button x:Name="GoButton" Grid.Column="2" Style="{StaticResource NavButton}" Width="28" Height="28" Margin="4,0,0,0"
                  ToolTip="Go" Click="Go_Click">
            <TextBlock Text="&#xE72A;" Style="{StaticResource Glyph}" FontSize="12" />
          </Button>
        </Grid>
      </Border>
    </Grid>

    <!-- A thin bar that fills while a page loads -->
    <Border Grid.Row="2" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
    <ProgressBar x:Name="LoadingBar" Grid.Row="2" Height="2" IsIndeterminate="True" Visibility="Collapsed" BorderThickness="0"
                 Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />

    <Grid x:Name="ViewHost" Grid.Row="3" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
      <StackPanel x:Name="Message" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
        <TextBlock x:Name="MessageTitle" Text="Starting the browser" FontSize="16" FontWeight="SemiBold" TextAlignment="Center"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock x:Name="MessageText" Margin="0,6,0,0" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <ui:Button x:Name="RetryButton" Margin="0,14,0,0" HorizontalAlignment="Center" Content="Try again" Appearance="Secondary"
                   Visibility="Collapsed" Click="Retry_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
