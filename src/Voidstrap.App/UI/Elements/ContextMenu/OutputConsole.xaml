<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.ContextMenu.OutputConsole" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:Voidstrap.UI.Elements.ContextMenu" xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:models="clr-namespace:Voidstrap.UI.ViewModels.ContextMenu" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:enums="clr-namespace:Voidstrap.Enums" Title="{x:Static resources:Strings.ContextMenu_PlayerLogs_Title}" MinWidth="420" MinHeight="420" Width="580" Height="420" ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterScreen" Background="{ui:ThemeResource ApplicationBackgroundBrush}">
  <Grid>
    <Panel.Background>
      <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
        <GradientStop Offset="0.00" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        <GradientStop Offset="0.70" Color="{DynamicResource WindowBackgroundColorSecondary}" />
        <GradientStop Offset="1.1" Color="{DynamicResource WindowBackgroundColorThird}" />
      </LinearGradientBrush>
    </Panel.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Name="RootTitleBar" Grid.Row="0" Grid.ColumnSpan="2" Padding="8" Title="{x:Static resources:Strings.ContextMenu_PlayerLogs_Title}" ShowMinimize="True" ShowMaximize="False" CanMaximize="False" KeyboardNavigation.TabNavigation="None" Icon="pack://application:,,,/Voidstrap.png" />
    <TextBlock Grid.Row="1" Margin="16,8,16,0" Text="{x:Static resources:Strings.Menu_Context_PlayerLogs_Description}" TextWrapping="Wrap" />
    <TextBlock Grid.Row="2" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="Player join and leave activity will appear here live.">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type TextBlock}">
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding HasEntries, Mode=OneWay}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
          <Setter Property="Visibility" Value="Visible" />
        </Style>
      </FrameworkElement.Style>
    </TextBlock>
    <DataGrid Name="PlayerLogsDataGrid" Grid.Row="2" HeadersVisibility="Column" GridLinesVisibility="Horizontal" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" IsReadOnly="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.IsDeferredScrollingEnabled="True" Margin="8" ItemsSource="{Binding PlayerLogsCollection}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type DataGrid}}" TargetType="{x:Type DataGrid}">
          <Setter Property="Background" Value="#00FFFFFF" />
          <Setter Property="BorderThickness" Value="0" />
        </Style>
      </FrameworkElement.Style>
      <DataGrid.ColumnHeaderStyle>
        <Style TargetType="{x:Type DataGridColumnHeader}">
          <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
          <Setter Property="Height" Value="32" />
          <Setter Property="Padding" Value="8,0,8,0" />
          <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
          <Setter Property="BorderThickness" Value="1" />
        </Style>
      </DataGrid.ColumnHeaderStyle>
      <DataGrid.CellStyle>
        <Style TargetType="{x:Type DataGridCell}">
          <Setter Property="UIElement.IsHitTestVisible" Value="True" />
          <Setter Property="Height" Value="32" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type DataGridCell}">
                <Border Background="{TemplateBinding Control.Background}" Padding="6,0,6,0">
                  <ContentPresenter VerticalAlignment="Top" IsHitTestVisible="True" />
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </DataGrid.CellStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="{x:Static resources:Strings.Common_UserId}" Binding="{Binding UserId}" />
        <DataGridTextColumn Header="{x:Static resources:Strings.Common_Username}" Binding="{Binding Username}" />
        <DataGridTextColumn Header="{x:Static resources:Strings.Common_Type}" Binding="{Binding Type}" />
        <DataGridTextColumn Header="{x:Static resources:Strings.Common_Time}" Width="*" Binding="{Binding Time}" />
      </DataGrid.Columns>
    </DataGrid>
	<Grid Grid.Row="3" Margin="8,0,8,8">
	  <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
	  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
	  <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,8,0" Padding="12,6" />
	  <Button Content="Download CSV" Command="{Binding ExportCommand}" Margin="0,0,8,0" Padding="12,6" />
	  <Button Content="Close" Command="{Binding CloseWindowCommand}" Padding="12,6" />
	  </StackPanel>
	</Grid>
  </Grid>
</base:WpfUiWindow>
