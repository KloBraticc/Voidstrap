<Window x:Class="Voidstrap.UI.Elements.Overlay.SessionNotificationSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Settings" Width="540" Height="680" MinWidth="440" MinHeight="420"
        WindowStyle="None" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="2,18,0,10" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Width" Value="56" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <!-- A rounded group of settings rows -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    </Style>
    <!-- One row inside a card, with a thin line under it -->
    <Style x:Key="Row" TargetType="Border">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="16,8,14,8" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    </Style>
    <Style x:Key="LastRow" TargetType="Border" BasedOn="{StaticResource Row}">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="RowSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IsSnapToTickEnabled" Value="True" />
    </Style>
    <!-- Segmented choice: a tray with the picked option raised -->
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Chip" CornerRadius="5" Padding="14,5" Background="Transparent">
              <TextBlock Text="{TemplateBinding Content}" FontSize="13" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SegmentTray" TargetType="Border">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <!-- Named so the panel lets it scroll up underneath its frosted title bar -->
  <ScrollViewer x:Name="TitleScrollHost" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,0,16,16">

      <TextBlock Text="Overlay" Style="{StaticResource Section}" Margin="2,10,0,10" />
      <Border Style="{StaticResource Card}">
        <Border Style="{StaticResource LastRow}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Text="Overlay shortcut" Style="{StaticResource Label}" />
              <TextBlock x:Name="ShortcutHint" Text="The key combination that opens the overlay." Style="{StaticResource Hint}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <!-- Click, then press the new combination; Esc cancels -->
              <Border x:Name="ShortcutBox" MinWidth="170" Height="36" CornerRadius="5" Cursor="Hand" Focusable="True"
                      BorderThickness="1" Padding="14,0" ToolTip="Click, then press a new combination"
                      MouseLeftButtonUp="ShortcutBox_Click" PreviewKeyDown="ShortcutBox_KeyDown" LostKeyboardFocus="ShortcutBox_LostFocus"
                      Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <TextBlock x:Name="ShortcutText" Text="Ctrl + Alt + L" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              </Border>
              <ui:Button x:Name="ShortcutClear" Margin="8,0,0,0" Width="38" Height="36" Padding="0" ToolTip="Remove the shortcut"
                         Appearance="Secondary" Focusable="False" Click="ShortcutClear_Click">
                <TextBlock Text="&#xE750;" Style="{StaticResource Glyph}" />
              </ui:Button>
            </StackPanel>
          </Grid>
        </Border>
      </Border>

      <TextBlock Text="Notifications" Style="{StaticResource Section}" />
      <!-- Preview: the game's art behind a half size copy of the real notification, click to play it -->
      <Border x:Name="PreviewFrame" Height="180" CornerRadius="8" ClipToBounds="True" Cursor="Hand"
              ToolTip="Click to play the animation" MouseLeftButtonUp="Preview_Click"
              Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
        <!-- Clipped to the frame's rounded corners in code, ClipToBounds alone leaves them square -->
        <Grid x:Name="PreviewClipHost" SizeChanged="PreviewClipHost_SizeChanged">
          <Border>
            <Border.Background>
              <ImageBrush x:Name="PreviewBackground" Stretch="UniformToFill" />
            </Border.Background>
          </Border>
          <Border Background="#66000000" />
          <Canvas x:Name="PreviewStage" ClipToBounds="True" SizeChanged="PreviewStage_SizeChanged">
            <Border x:Name="MockHost" ClipToBounds="True">
              <Border.LayoutTransform>
                <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
              </Border.LayoutTransform>
              <!-- The card and its shadow move together, like the real notification's root -->
              <Grid x:Name="MockLayer" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform x:Name="MockScale" />
                    <TranslateTransform x:Name="MockTranslate" />
                  </TransformGroup>
                </Grid.RenderTransform>
                <Grid x:Name="MockShadow" IsHitTestVisible="False" />
              <Border x:Name="MockCard" Padding="14,12,16,12" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
              <!-- Same layout as the real notification, so wrapping and height match it -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Image x:Name="MockIcon" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center"
                         Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel x:Name="MockHeader" Orientation="Horizontal" Margin="0,0,14,5" Visibility="Collapsed">
                      <Image Source="pack://application:,,,/Voidstrap.png" Width="14" Height="14" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality" />
                      <TextBlock x:Name="MockHeaderText" Text="Voidstrap" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="MockTitle" Text="Test notification" FontSize="14" FontWeight="SemiBold" Margin="0,0,14,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="MockText" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="64"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="This is how Voidstrap notifications look." />
                  </StackPanel>
                </Grid>
              </Border>
              </Grid>
            </Border>
          </Canvas>
        </Grid>
      </Border>
      <ui:Button HorizontalAlignment="Right" Margin="0,10,0,0" Appearance="Secondary" Focusable="False" Click="SendTest_Click">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xEA8F;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
          <TextBlock Text="Send a test notification" FontSize="14" VerticalAlignment="Center" />
        </StackPanel>
      </ui:Button>

      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
          <Border Style="{StaticResource Row}">
            <Grid>
              <TextBlock Text="Style" Style="{StaticResource Label}" />
              <Border Style="{StaticResource SegmentTray}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="CornerLayout" Content="Corner" GroupName="Layout" Style="{StaticResource Segment}" Checked="Layout_Checked" />
                  <RadioButton x:Name="FloatingLayout" Content="Floating" GroupName="Layout" Style="{StaticResource Segment}" Checked="Layout_Checked" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Horizontal" Style="{StaticResource Label}" />
              <Slider x:Name="HorizontalSlider" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1"
                      Style="{StaticResource RowSlider}" ValueChanged="Slider_Changed" />
              <TextBlock x:Name="HorizontalText" Grid.Column="2" Style="{StaticResource Value}" />
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Vertical" Style="{StaticResource Label}" />
              <Slider x:Name="VerticalSlider" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1"
                      Style="{StaticResource RowSlider}" ValueChanged="Slider_Changed" />
              <TextBlock x:Name="VerticalText" Grid.Column="2" Style="{StaticResource Value}" />
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Corner radius" Style="{StaticResource Label}" />
              <Slider x:Name="CornerSlider" Grid.Column="1" Minimum="0" Maximum="20" SmallChange="1" LargeChange="2" TickFrequency="1"
                      Style="{StaticResource RowSlider}" ValueChanged="Slider_Changed" />
              <TextBlock x:Name="CornerText" Grid.Column="2" Style="{StaticResource Value}" />
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Size" Style="{StaticResource Label}" />
              <Slider x:Name="SizeSlider" Grid.Column="1" Minimum="80" Maximum="130" SmallChange="1" LargeChange="5" TickFrequency="1"
                      Style="{StaticResource RowSlider}" ValueChanged="Slider_Changed" />
              <TextBlock x:Name="SizeText" Grid.Column="2" Style="{StaticResource Value}" />
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Text size" Style="{StaticResource Label}" />
              <Slider x:Name="TextSizeSlider" Grid.Column="1" Minimum="80" Maximum="140" SmallChange="1" LargeChange="5" TickFrequency="1"
                      Style="{StaticResource RowSlider}" ValueChanged="Slider_Changed" />
              <TextBlock x:Name="TextSizeText" Grid.Column="2" Style="{StaticResource Value}" />
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Background" Style="{StaticResource Label}" />
              <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="60" Maximum="100" SmallChange="1" LargeChange="5" TickFrequency="1"
                      Style="{StaticResource RowSlider}" ValueChanged="Slider_Changed" />
              <TextBlock x:Name="OpacityText" Grid.Column="2" Style="{StaticResource Value}" />
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Show for" Style="{StaticResource Label}" />
              <Slider x:Name="SecondsSlider" Grid.Column="1" Minimum="2" Maximum="20" SmallChange="1" LargeChange="2" TickFrequency="1"
                      Style="{StaticResource RowSlider}" ValueChanged="Slider_Changed" />
              <TextBlock x:Name="SecondsText" Grid.Column="2" Style="{StaticResource Value}" />
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="210" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Animation" Style="{StaticResource Label}" />
              <ComboBox x:Name="MotionBox" Grid.Column="1" SelectionChanged="Motion_Changed" />
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="Voidstrap header" Style="{StaticResource Label}" />
                <TextBlock Text="Badges and the shortcut reminder follow Server" Style="{StaticResource Hint}" />
              </StackPanel>
              <Border Grid.Column="1" Style="{StaticResource SegmentTray}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="HeaderOff" Content="Off" Tag="Off" GroupName="Header" Style="{StaticResource Segment}" Checked="Header_Checked" />
                  <RadioButton x:Name="HeaderServer" Content="Server" Tag="Server" GroupName="Header" Style="{StaticResource Segment}" Checked="Header_Checked" />
                  <RadioButton x:Name="HeaderFriends" Content="Friends" Tag="Friends" GroupName="Header" Style="{StaticResource Segment}" Checked="Header_Checked" />
                  <RadioButton x:Name="HeaderBoth" Content="Both" Tag="Both" GroupName="Header" Style="{StaticResource Segment}" Checked="Header_Checked" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid>
              <TextBlock Text="Pause while hovered" Style="{StaticResource Label}" />
              <ui:ToggleSwitch x:Name="PauseToggle" HorizontalAlignment="Right" Click="Toggle_Click" />
            </Grid>
          </Border>
          <Border Style="{StaticResource LastRow}">
            <Grid>
              <TextBlock Text="Close button on hover" Style="{StaticResource Label}" />
              <ui:ToggleSwitch x:Name="CloseToggle" HorizontalAlignment="Right" Click="Toggle_Click" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <TextBlock Text="Notify me about" Style="{StaticResource Section}" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Border Style="{StaticResource Row}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="Server details" Style="{StaticResource Label}" />
                <TextBlock Text="When off, these show as Windows notifications instead" Style="{StaticResource Hint}" />
              </StackPanel>
              <ui:ToggleSwitch x:Name="ServerToggle" Grid.Column="1" Click="Toggle_Click" />
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="Friends" Style="{StaticResource Label}" />
                <TextBlock Text="Starting a game, joining your game or joining your server. Needs cookie access." Style="{StaticResource Hint}" />
              </StackPanel>
              <ui:ToggleSwitch x:Name="FriendsToggle" Grid.Column="1" Click="Toggle_Click" />
            </Grid>
          </Border>
          <Border Style="{StaticResource Row}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="Badges" Style="{StaticResource Label}" />
                <TextBlock Text="When you earn one. Needs cookie access." Style="{StaticResource Hint}" />
              </StackPanel>
              <ui:ToggleSwitch x:Name="BadgesToggle" Grid.Column="1" Click="Toggle_Click" />
            </Grid>
          </Border>
          <Border Style="{StaticResource LastRow}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="The overlay shortcut when a game starts" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,12,0" />
              <ui:ToggleSwitch x:Name="ShortcutToggle" Grid.Column="1" Click="Toggle_Click" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <ui:Button HorizontalAlignment="Left" Margin="0,16,0,0" Appearance="Secondary" Focusable="False" Click="Reset_Click">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE7A7;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
          <TextBlock Text="Reset to defaults" FontSize="14" VerticalAlignment="Center" />
        </StackPanel>
      </ui:Button>
    </StackPanel>
  </ScrollViewer>
</Window>
