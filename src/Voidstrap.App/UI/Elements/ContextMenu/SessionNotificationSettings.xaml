<Window x:Class="Voidstrap.UI.Elements.Overlay.SessionNotificationSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Notification settings" Width="520" Height="660" MinWidth="440" MinHeight="420"
        WindowStyle="None" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="2,18,0,8" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Width" Value="52" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="Row" TargetType="Grid">
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="PositionButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="Appearance" Value="Secondary" />
      <Setter Property="Focusable" Value="False" />
    </Style>
  </Window.Resources>
  <Grid Margin="16,4,16,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Preview: the game's icon behind a half size copy of the real notification, click to play it -->
    <Border x:Name="PreviewFrame" Height="190" CornerRadius="10" ClipToBounds="True" Cursor="Hand"
            ToolTip="Click to play the animation" MouseLeftButtonUp="Preview_Click"
            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
      <Grid>
        <Border CornerRadius="10">
          <Border.Background>
            <ImageBrush x:Name="PreviewBackground" Stretch="UniformToFill" />
          </Border.Background>
        </Border>
        <Border CornerRadius="10" Background="#99000000" />
        <Canvas x:Name="PreviewStage" ClipToBounds="True" SizeChanged="PreviewStage_SizeChanged">
          <Border x:Name="MockHost" ClipToBounds="True">
            <Border.LayoutTransform>
              <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
            </Border.LayoutTransform>
            <Border x:Name="MockCard" Padding="14,12,16,12" RenderTransformOrigin="0.5,0.5"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
              <Border.RenderTransform>
                <TransformGroup>
                  <ScaleTransform x:Name="MockScale" />
                  <TranslateTransform x:Name="MockTranslate" />
                </TransformGroup>
              </Border.RenderTransform>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image x:Name="MockIcon" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="Connected to public server" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  <TextBlock x:Name="MockTitle" Text="Roblox" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  <TextBlock Text="Uptime: 1h 12m  •  12/20 players" FontSize="12" Margin="0,2,0,0"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
              </Grid>
            </Border>
          </Border>
        </Canvas>
        <TextBlock Text="Preview" Margin="12,10,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#E6FFFFFF"
                   HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,6,0">
        <TextBlock Text="Position" Style="{StaticResource Section}" />
        <UniformGrid x:Name="PositionGrid" Columns="3" Margin="-3,0,-3,0">
          <ui:Button Content="Top left" Tag="TopLeft" Click="Position_Click" Style="{StaticResource PositionButton}" />
          <ui:Button Content="Top" Tag="TopCenter" Click="Position_Click" Style="{StaticResource PositionButton}" />
          <ui:Button Content="Top right" Tag="TopRight" Click="Position_Click" Style="{StaticResource PositionButton}" />
          <ui:Button Content="Bottom left" Tag="BottomLeft" Click="Position_Click" Style="{StaticResource PositionButton}" />
          <ui:Button Content="Bottom" Tag="BottomCenter" Click="Position_Click" Style="{StaticResource PositionButton}" />
          <ui:Button Content="Bottom right" Tag="BottomRight" Click="Position_Click" Style="{StaticResource PositionButton}" />
        </UniformGrid>

        <TextBlock Text="Animation" Style="{StaticResource Section}" />
        <Grid Style="{StaticResource Row}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Entrance" Style="{StaticResource Label}" />
          <ComboBox x:Name="IntroBox" Grid.Column="1" SelectionChanged="Motion_Changed" />
        </Grid>
        <Grid Style="{StaticResource Row}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Exit" Style="{StaticResource Label}" />
          <ComboBox x:Name="OutroBox" Grid.Column="1" SelectionChanged="Motion_Changed" />
        </Grid>
        <Grid Style="{StaticResource Row}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Entrance speed" Style="{StaticResource Label}" />
          <Slider x:Name="IntroSpeed" Grid.Column="1" Minimum="100" Maximum="1000" SmallChange="10" LargeChange="100"
                  IsSnapToTickEnabled="True" TickFrequency="10" VerticalAlignment="Center" ValueChanged="Slider_Changed" />
          <TextBlock x:Name="IntroSpeedText" Grid.Column="2" Style="{StaticResource Value}" />
        </Grid>
        <Grid Style="{StaticResource Row}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Exit speed" Style="{StaticResource Label}" />
          <Slider x:Name="OutroSpeed" Grid.Column="1" Minimum="100" Maximum="1000" SmallChange="10" LargeChange="100"
                  IsSnapToTickEnabled="True" TickFrequency="10" VerticalAlignment="Center" ValueChanged="Slider_Changed" />
          <TextBlock x:Name="OutroSpeedText" Grid.Column="2" Style="{StaticResource Value}" />
        </Grid>

        <TextBlock Text="Look" Style="{StaticResource Section}" />
        <Grid Style="{StaticResource Row}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Corner roundness" Style="{StaticResource Label}" />
          <Slider x:Name="CornerSlider" Grid.Column="1" Minimum="0" Maximum="20" SmallChange="1" LargeChange="2"
                  IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="Slider_Changed" />
          <TextBlock x:Name="CornerText" Grid.Column="2" Style="{StaticResource Value}" />
        </Grid>
        <Grid Style="{StaticResource Row}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Space from edge" Style="{StaticResource Label}" />
          <Slider x:Name="SpacingSlider" Grid.Column="1" Minimum="0" Maximum="48" SmallChange="1" LargeChange="4"
                  IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="Slider_Changed" />
          <TextBlock x:Name="SpacingText" Grid.Column="2" Style="{StaticResource Value}" />
        </Grid>
        <Grid Style="{StaticResource Row}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Width" Style="{StaticResource Label}" />
          <Slider x:Name="WidthSlider" Grid.Column="1" Minimum="320" Maximum="480" SmallChange="4" LargeChange="16"
                  IsSnapToTickEnabled="True" TickFrequency="4" VerticalAlignment="Center" ValueChanged="Slider_Changed" />
          <TextBlock x:Name="WidthText" Grid.Column="2" Style="{StaticResource Value}" />
        </Grid>
        <Grid Style="{StaticResource Row}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Background opacity" Style="{StaticResource Label}" />
          <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="60" Maximum="100" SmallChange="1" LargeChange="5"
                  IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="Slider_Changed" />
          <TextBlock x:Name="OpacityText" Grid.Column="2" Style="{StaticResource Value}" />
        </Grid>

        <TextBlock Text="Behavior" Style="{StaticResource Section}" />
        <Grid Style="{StaticResource Row}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Time on screen" Style="{StaticResource Label}" />
          <Slider x:Name="SecondsSlider" Grid.Column="1" Minimum="2" Maximum="20" SmallChange="1" LargeChange="2"
                  IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="Slider_Changed" />
          <TextBlock x:Name="SecondsText" Grid.Column="2" Style="{StaticResource Value}" />
        </Grid>
        <Grid Style="{StaticResource Row}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Pause while hovered" Style="{StaticResource Label}" />
          <ui:ToggleSwitch x:Name="PauseToggle" Grid.Column="1" Click="Toggle_Click" />
        </Grid>
        <Grid Style="{StaticResource Row}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Close button on hover" Style="{StaticResource Label}" />
          <ui:ToggleSwitch x:Name="CloseToggle" Grid.Column="1" Click="Toggle_Click" />
        </Grid>

        <ui:Button Content="Reset to defaults" Appearance="Secondary" HorizontalAlignment="Right" Margin="0,10,0,0" Click="Reset_Click" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
