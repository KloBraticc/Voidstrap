<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.ContextMenu.MusicPlayer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:models="clr-namespace:Voidstrap.UI.ViewModels.ContextMenu" xmlns:converters="clr-namespace:Voidstrap.UI.Converters" Title="Music Player" Width="1024" Height="680" MinWidth="800" MinHeight="520" WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" UseLayoutRounding="True" SnapsToDevicePixels="True" xmlns:contextmenu="clr-namespace:Voidstrap.UI.Elements.ContextMenu" Background="{ui:ThemeResource ApplicationBackgroundBrush}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Panel.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        <GradientStop Offset="0.35" Color="{DynamicResource WindowBackgroundColorSecondary}" />
        <GradientStop Offset="0.75" Color="{DynamicResource WindowBackgroundColorThird}" />
        <GradientStop Offset="1.0" Color="{DynamicResource WindowBackgroundColorPrimary}" />
      </LinearGradientBrush>
    </Panel.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Name="RootTitleBar" Grid.Row="0" Title="Music Player" ShowMinimize="True" ShowMaximize="True" Icon="pack://application:,,,/Voidstrap.png" Background="{DynamicResource WindowTitleBarBackgroundBrush}" />
    <Grid Row="1" Margin="16,12,16,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Library" FontSize="18" FontWeight="Medium" Margin="0,0,0,8" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
          <ui:Button Icon="DocumentAdd24" Content="Import" Appearance="Secondary" Command="{Binding OpenFilesCommand}" />
          <ui:Button Name="RpcButton" Icon="PlugConnected24" Appearance="Secondary" Margin="6,0,0,0" Content="{Binding RpcButtonLabel}" Command="{Binding ConnectRpcCommand}" />
          <ui:Button Icon="Delete24" Content="Clear" Appearance="Danger" Margin="6,0,0,0" Command="{Binding ClearLibraryCommand}" />
        </StackPanel>
        <ui:TextBox Name="SearchBox" Grid.Row="2" PlaceholderText="Search library by title, artist, or type..." Icon="Search24" Margin="0,0,0,8" Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Grid Row="3">
          <ListView BorderThickness="0" Background="#00FFFFFF" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ItemsSource="{Binding FilteredMusicLibrary}" SelectedItem="{Binding SelectedTrack, Mode=TwoWay}">
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="{x:Type ListViewItem}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="#00FFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
                <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
                <Style.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                  </Trigger>
                  <Trigger Property="ListBoxItem.IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type models:TrackItem}">
                <Border CornerRadius="6" Padding="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="44" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Width="36" Height="36" Margin="4,0" Stretch="UniformToFill" ClipToBounds="True" Source="{Binding Icon, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="6,0,0,0">
                      <TextBox FontWeight="SemiBold" FontSize="14" BorderThickness="0" Background="#00FFFFFF" Padding="2,0" IsReadOnly="True" MaxLength="60" TextWrapping="NoWrap" VerticalAlignment="Center" Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding Title}" KeyDown="TrackTitleEdit_KeyDown" MouseDoubleClick="TrackTitle_DoubleClick" />
                      <TextBlock Opacity="0.7" FontSize="12" Text="{Binding FileType}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <TextBlock Opacity="0.8" Margin="0,0,8,0" Text="{Binding DurationString}" />
                      <ui:Button Icon="Delete24" ToolTip="Remove Track" Appearance="Danger" Width="28" Height="28" Command="{Binding DataContext.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ListView>
          <TextBlock Text="No tracks. Click Import to add audio." HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" FontSize="14" Visibility="{Binding HasNoTracks, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="No tracks match your search." HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" FontSize="14" Visibility="{Binding HasNoSearchMatches, Converter={StaticResource BoolToVis}}" />
        </Grid>
      </Grid>
      <Grid Column="1" />
      <TabControl Grid.Column="2">
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="MusicNote224" Margin="0,0,6,0" />
              <TextBlock Text="Now Playing" />
            </StackPanel>
          </TabItem.Header>
          <StackPanel Margin="10">
            <Border CornerRadius="8" Padding="16" Margin="0,4,0,16" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <Image Width="72" Height="72" Margin="0,0,12,0" Stretch="UniformToFill" ClipToBounds="True" Source="{Binding NowPlaying.Icon, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding NowPlaying.Title}" />
                    <TextBlock Opacity="0.7" Text="{Binding NowPlaying.FileType}" />
                    <TextBlock FontSize="11" Opacity="0.6" MaxWidth="500" TextTrimming="CharacterEllipsis" Text="{Binding NowPlaying.FilePath}" />
                  </StackPanel>
                </StackPanel>
                <Slider Name="PositionSlider" Minimum="0" Margin="0,4,0,0" Maximum="{Binding NowPlayingDurationSeconds}" Value="{Binding PositionSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Thumb.DragStarted="PositionSlider_DragStarted" Thumb.DragCompleted="PositionSlider_DragCompleted" />
                <DockPanel Margin="0,4,0,0">
                  <TextBlock DockPanel.Dock="Left" FontSize="12" Opacity="0.85" Text="{Binding PositionString}" />
                  <TextBlock DockPanel.Dock="Right" FontSize="12" Opacity="0.85" HorizontalAlignment="Right" Text="{Binding DurationString}" />
                  <TextBlock />
                </DockPanel>
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,12">
              <ui:Button Icon="Previous24" Content="Previous" Width="100" Command="{Binding PreviousCommand}" />
              <ui:Button Margin="4,0,0,0" Appearance="Primary" Width="120" Content="{Binding PlayPauseLabel}" Command="{Binding PlayPauseCommand}" />
              <ui:Button Icon="Next24" Margin="4,0,0,0" Content="Next" Width="80" Command="{Binding NextCommand}" />
              <ui:Button Icon="Stop24" Margin="4,0,0,0" Content="Stop" Width="80" Command="{Binding StopCommand}" />
            </StackPanel>
            <Border CornerRadius="6" Padding="10" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Icon="Speaker224" ToolTip="Mute / Unmute" Margin="0,0,8,0" Content="{Binding MuteLabel}" Command="{Binding ToggleMuteCommand}" />
                <Slider Name="VolumeSlider" Width="180" Minimum="0" Maximum="1.0" SmallChange="0.02" LargeChange="0.1" VerticalAlignment="Center" Value="{Binding Volume, Mode=TwoWay}" MouseWheel="VolumeSlider_MouseWheel" />
                <TextBlock Margin="8,0,16,0" VerticalAlignment="Center" Width="44" Text="{Binding VolumePercent}" />
                <ui:Button Icon="ArrowRepeatAll24" Margin="0,0,4,0" Content="{Binding LoopLabel}" Command="{Binding ToggleLoopCommand}" />
                <ui:Button Icon="ArrowShuffle24" Content="{Binding ShuffleLabel}" Command="{Binding ToggleShuffleCommand}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Options24" Margin="0,0,6,0" />
              <TextBlock Text="Equalizer" />
            </StackPanel>
          </TabItem.Header>
          <StackPanel Margin="10">
            <TextBlock Text="Equalizer" FontSize="18" FontWeight="Medium" Margin="0,0,0,4" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12" Text="Tune how your audio sounds. Pick a preset or drag the bands, then it applies live and saves automatically." />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
              <ui:ToggleSwitch Content="Enable Equalizer" IsChecked="{Binding EqualizerEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
              <TextBlock Text="Preset" VerticalAlignment="Center" Margin="24,0,8,0" Opacity="0.85" />
              <ComboBox Width="170" ItemsSource="{Binding EqPresets}" SelectedItem="{Binding SelectedEqPreset, Mode=TwoWay}" VerticalAlignment="Center" />
              <ui:Button Content="Reset" Margin="12,0,0,0" Appearance="Secondary" Command="{Binding ResetEqualizerCommand}" VerticalAlignment="Center" />
            </StackPanel>
            <Border CornerRadius="8" Padding="16,20" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
              <ItemsControl ItemsSource="{Binding EqBands}" IsEnabled="{Binding EqualizerEnabled}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel HorizontalAlignment="Center" Margin="2,0">
                      <TextBlock Text="{Binding GainLabel}" FontSize="11" HorizontalAlignment="Center" Opacity="0.85" Margin="0,0,0,6" />
                      <Slider Orientation="Vertical" Height="200" Minimum="-12" Maximum="12" TickFrequency="3" SmallChange="1" LargeChange="3" IsSnapToTickEnabled="False" HorizontalAlignment="Center" Value="{Binding Gain, Mode=TwoWay}" />
                      <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" Opacity="0.7" Margin="0,6,0,0" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <TextBlock Margin="0,10,0,0" FontSize="12" Opacity="0.55" Text="Bands are in Hz. 0 dB is neutral, up to plus or minus 12 dB." />
          </StackPanel>
        </TabItem>
      </TabControl>
    </Grid>
        <DockPanel Grid.Row="2" Margin="16,0,16,12">
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Opacity="0.8" Text="{Binding Tracks.Count, StringFormat=Tracks: {0}}" />
    </DockPanel>
  </Grid>
</base:WpfUiWindow>
