<Window x:Class="Voidstrap.UI.Elements.Overlay.SessionDock"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Voidstrap Session" Width="770" Height="70" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="Segoe UI" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Window.Resources>
    <Style x:Key="DockAction" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="MinWidth" Value="42" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Appearance" Value="Transparent" />
      <Setter Property="Border.CornerRadius" Value="8" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <!-- Windows' own icon font, present on every Windows 10 and 11 install, so every icon always renders -->
    <Style x:Key="DockGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
  </Window.Resources>
  <Grid x:Name="DockRoot" Margin="0">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="DockShift" />
    </Grid.RenderTransform>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="70" />
    </Grid.RowDefinitions>
    <Border x:Name="ServerPanel" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,12" CornerRadius="12"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="150" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- The game's main thumbnail as a banner, with a fade so the title stays readable -->
        <Border CornerRadius="11,11,0,0" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
        <Border CornerRadius="11,11,0,0">
          <Border.Background>
            <ImageBrush x:Name="BannerBrush" Stretch="UniformToFill" AlignmentY="Center" />
          </Border.Background>
        </Border>
        <Border CornerRadius="11,11,0,0">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Offset="0.35" Color="#00000000" />
              <GradientStop Offset="1" Color="#D0000000" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <StackPanel VerticalAlignment="Bottom" Margin="20,0,20,14">
          <TextBlock x:Name="BannerTitle" Text="Roblox" FontSize="20" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="BannerSubtitle" Margin="0,2,0,0" FontSize="12" Foreground="#DDFFFFFF" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="20,14,20,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="1.3*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Server" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="ServerReadout" Margin="0,6,0,0" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="FriendCountText" Margin="0,10,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="FriendsHeader" Text="Friends in this server" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ScrollViewer Grid.Row="1" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="FriendsList">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,8,8" Padding="4,4,12,4" CornerRadius="18" Background="{DynamicResource SubtleFillColorSecondaryBrush}" ToolTip="{Binding Username}">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="14" ClipToBounds="True" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                          <Border.OpacityMask>
                            <VisualBrush>
                              <VisualBrush.Visual>
                                <Ellipse Width="28" Height="28" Fill="Black" />
                              </VisualBrush.Visual>
                            </VisualBrush>
                          </Border.OpacityMask>
                          <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="FriendsStatus" Grid.Row="1" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Looking for friends" />
          </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,8,12,12">
          <ui:Button Content="Server details" Tag="details" Click="OnAction" Style="{StaticResource DockAction}" />
          <ui:Button Content="Copy invite" Tag="invite" Click="OnAction" Style="{StaticResource DockAction}" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Padding="14,10" CornerRadius="14" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" SnapsToDevicePixels="True">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- Clickable like an option card, opens the game and server popout above the dock -->
        <Border x:Name="GameCard" Grid.ColumnSpan="2" Margin="-6,-4,8,-4" Padding="6,4" CornerRadius="8" Cursor="Hand"
                ToolTip="Game and server" MouseLeftButtonUp="GameCard_MouseLeftButtonUp">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="Transparent" />
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image x:Name="GamePicture" Width="42" Height="42" Margin="0,0,12,0"
                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
              <TextBlock x:Name="GameTitle" Text="Roblox" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                <!-- Live server indicator: a dot with a short heartbeat every couple of seconds -->
                <Grid Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                  <Ellipse x:Name="PulseRing" Width="8" Height="8" Opacity="0" RenderTransformOrigin="0.5,0.5"
                           Fill="{DynamicResource SystemFillColorSuccessBrush}">
                    <Ellipse.RenderTransform>
                      <ScaleTransform x:Name="PulseRingScale" />
                    </Ellipse.RenderTransform>
                  </Ellipse>
                  <Ellipse x:Name="PulseDot" Width="8" Height="8" RenderTransformOrigin="0.5,0.5"
                           Fill="{DynamicResource SystemFillColorSuccessBrush}">
                    <Ellipse.RenderTransform>
                      <ScaleTransform x:Name="PulseDotScale" />
                    </Ellipse.RenderTransform>
                  </Ellipse>
                </Grid>
                <TextBlock x:Name="SessionTimes" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </StackPanel>
            <TextBlock x:Name="GameChevron" Grid.Column="2" Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </Grid>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <ui:Button ToolTip="Browse servers" Tag="browser" Click="OnAction" Style="{StaticResource DockAction}">
            <TextBlock Text="&#xE774;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
          <ui:Button ToolTip="Games" Tag="games" Click="OnAction" Style="{StaticResource DockAction}">
            <TextBlock Text="&#xE7FC;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
          <ui:Button ToolTip="Chat with friends" Tag="chat" Click="OnAction" Style="{StaticResource DockAction}">
            <TextBlock Text="&#xE8BD;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
          <ui:Button ToolTip="Game history" Tag="history" Click="OnAction" Style="{StaticResource DockAction}">
            <TextBlock Text="&#xE81C;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
          <ui:Button ToolTip="Music" Tag="music" Click="OnAction" Style="{StaticResource DockAction}">
            <TextBlock Text="&#xE8D6;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
          <ui:Button ToolTip="Settings" Tag="adjustments" Click="OnAction" Style="{StaticResource DockAction}">
            <TextBlock Text="&#xE713;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
          <ui:Button ToolTip="Copy invite" Tag="invite" Click="OnAction" Style="{StaticResource DockAction}">
            <TextBlock Text="&#xE71B;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
          <ui:Button ToolTip="Close, Ctrl+Alt+L" Tag="close" Click="OnAction" Style="{StaticResource DockAction}">
            <TextBlock Text="&#xE711;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
