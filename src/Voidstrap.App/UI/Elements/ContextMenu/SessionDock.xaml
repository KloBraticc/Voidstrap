<Window x:Class="Voidstrap.UI.Elements.Overlay.SessionDock"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Voidstrap Session" Width="1120" Height="96" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="Segoe UI" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Window.Resources>
    <Style x:Key="DockAction" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="MinWidth" Value="42" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Appearance" Value="Transparent" />
      <Setter Property="Border.CornerRadius" Value="8" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style x:Key="DockIcon" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="Appearance" Value="Transparent" />
      <Setter Property="Border.CornerRadius" Value="18" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style x:Key="DockRound" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="Appearance" Value="Secondary" />
      <Setter Property="Border.CornerRadius" Value="20" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style x:Key="DockDivider" TargetType="Rectangle">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="10,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="#2EFFFFFF" />
    </Style>
    <Style x:Key="DockChevron" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="Margin" Value="12,0,2,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <!-- A section that reads as one big button: highlights on hover -->
    <Style x:Key="DockCard" TargetType="Border">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="CornerRadius" Value="26" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- Windows' own icon font, present on every Windows 10 and 11 install, so every icon always renders -->
    <Style x:Key="DockGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
  </Window.Resources>
  <!-- The margins are room for the pill's shadow; the transparent area around the pill lets clicks through to the game -->
  <Grid x:Name="DockRoot" Margin="20,18,20,14">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="DockShift" />
    </Grid.RenderTransform>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="64" />
    </Grid.RowDefinitions>
    <Border x:Name="ServerPanel" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,12" CornerRadius="12"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="150" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- The game's main thumbnail as a banner, with a fade so the title stays readable -->
        <Border CornerRadius="11,11,0,0" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
        <Border CornerRadius="11,11,0,0">
          <Border.Background>
            <ImageBrush x:Name="BannerBrush" Stretch="UniformToFill" AlignmentY="Center" />
          </Border.Background>
        </Border>
        <Border CornerRadius="11,11,0,0">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Offset="0.35" Color="#00000000" />
              <GradientStop Offset="1" Color="#D0000000" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <StackPanel VerticalAlignment="Bottom" Margin="20,0,20,14">
          <TextBlock x:Name="BannerTitle" Text="Roblox" FontSize="20" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="BannerSubtitle" Margin="0,2,0,0" FontSize="12" Foreground="#DDFFFFFF" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="20,14,20,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="1.3*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Server" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="ServerReadout" Margin="0,6,0,0" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="FriendCountText" Margin="0,10,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="FriendsHeader" Text="Friends in this server" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ScrollViewer Grid.Row="1" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="FriendsList">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,8,8" Padding="4,4,12,4" CornerRadius="18" Background="{DynamicResource SubtleFillColorSecondaryBrush}" ToolTip="{Binding Username}">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="14" ClipToBounds="True" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                          <Border.OpacityMask>
                            <VisualBrush>
                              <VisualBrush.Visual>
                                <Ellipse Width="28" Height="28" Fill="Black" />
                              </VisualBrush.Visual>
                            </VisualBrush>
                          </Border.OpacityMask>
                          <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="FriendsStatus" Grid.Row="1" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Looking for friends" />
          </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,8,12,12">
          <ui:Button Content="Server details" Tag="details" Click="OnAction" Style="{StaticResource DockAction}" />
          <ui:Button Content="Copy invite" Tag="invite" Click="OnAction" Style="{StaticResource DockAction}" />
        </StackPanel>
      </Grid>
    </Border>
    <!-- The dock itself: a pill with a thin outline and a soft shadow, -->
    <Border x:Name="Pill" Grid.Row="1" HorizontalAlignment="Center" Padding="14,0,12,0" CornerRadius="32" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="#33FFFFFF" BorderThickness="1" SnapsToDevicePixels="True">
      <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- You: avatar, display name and username -->
        <Border x:Name="ProfileCard" Style="{StaticResource DockCard}" ToolTip="Friends in this server" MouseLeftButtonUp="GameCard_MouseLeftButtonUp">
          <StackPanel Orientation="Horizontal">
            <Grid Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
              <Ellipse Fill="{DynamicResource ControlFillColorSecondaryBrush}" />
              <TextBlock x:Name="ProfileFallback" Text="&#xE77B;" Style="{StaticResource DockGlyph}" FontSize="16"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <Ellipse>
                <Ellipse.Fill>
                  <ImageBrush x:Name="ProfileAvatar" Stretch="UniformToFill" />
                </Ellipse.Fill>
              </Ellipse>
            </Grid>
            <StackPanel VerticalAlignment="Center" MaxWidth="150">
              <TextBlock x:Name="ProfileName" Text="Roblox" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="ProfileHandle" Margin="0,1,0,0" FontSize="12" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Signed out" />
            </StackPanel>
            <TextBlock x:Name="ProfileChevron" Text="&#xE70E;" Style="{StaticResource DockChevron}" />
          </StackPanel>
        </Border>
        <Rectangle Grid.Column="1" Style="{StaticResource DockDivider}" />

        <!-- The game, clickable like an option card, opens the game and server popout above the dock -->
        <Border x:Name="GameCard" Grid.Column="2" Style="{StaticResource DockCard}" ToolTip="Game and server" MouseLeftButtonUp="GameCard_MouseLeftButtonUp">
          <StackPanel Orientation="Horizontal">
            <Image x:Name="GamePicture" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center"
                   Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
              <Image.Clip>
                <RectangleGeometry Rect="0,0,40,40" RadiusX="8" RadiusY="8" />
              </Image.Clip>
            </Image>
            <StackPanel VerticalAlignment="Center" MaxWidth="250">
              <TextBlock x:Name="GameTitle" Text="Roblox" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <StackPanel Margin="0,1,0,0" Orientation="Horizontal">
                <!-- Live server indicator: a dot with a short heartbeat every couple of seconds -->
                <Grid Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                  <Ellipse x:Name="PulseRing" Width="8" Height="8" Opacity="0" RenderTransformOrigin="0.5,0.5"
                           Fill="{DynamicResource SystemFillColorSuccessBrush}">
                    <Ellipse.RenderTransform>
                      <ScaleTransform x:Name="PulseRingScale" />
                    </Ellipse.RenderTransform>
                  </Ellipse>
                  <Ellipse x:Name="PulseDot" Width="8" Height="8" RenderTransformOrigin="0.5,0.5"
                           Fill="{DynamicResource SystemFillColorSuccessBrush}">
                    <Ellipse.RenderTransform>
                      <ScaleTransform x:Name="PulseDotScale" />
                    </Ellipse.RenderTransform>
                  </Ellipse>
                </Grid>
                <TextBlock x:Name="SessionTimes" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                  <Run Text="Session " /><Run x:Name="SessionClock" Text="0:00" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource SystemFillColorSuccessBrush}" /><Run Text="  ·  Server " /><Run x:Name="ServerClock" Text="--" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                </TextBlock>
              </StackPanel>
            </StackPanel>
            <TextBlock x:Name="GameChevron" Text="&#xE70E;" Style="{StaticResource DockChevron}" />
          </StackPanel>
        </Border>
        <Rectangle Grid.Column="3" Style="{StaticResource DockDivider}" HorizontalAlignment="Left" />

        <StackPanel x:Name="ActionButtons" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,6,0">
          <ui:Button ToolTip="Chat with friends" Tag="chat" Click="OnAction" Style="{StaticResource DockIcon}">
            <TextBlock Text="&#xE8BD;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
          <ui:Button ToolTip="Servers" Tag="browser" Click="OnAction" Style="{StaticResource DockIcon}">
            <TextBlock Text="&#xE753;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
          <ui:Button ToolTip="Games" Tag="games" Click="OnAction" Style="{StaticResource DockIcon}">
            <TextBlock Text="&#xE7FC;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
          <ui:Button ToolTip="Game history" Tag="history" Click="OnAction" Style="{StaticResource DockIcon}">
            <TextBlock Text="&#xE81C;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
          <ui:Button ToolTip="Music" Tag="music" Click="OnAction" Style="{StaticResource DockIcon}">
            <TextBlock Text="&#xE8D6;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
          <ui:Button ToolTip="Server details" Tag="details" Click="OnAction" Style="{StaticResource DockIcon}">
            <TextBlock Text="&#xE968;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
          <ui:Button ToolTip="Settings" Tag="adjustments" Click="OnAction" Style="{StaticResource DockIcon}">
            <TextBlock Text="&#xE713;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
        </StackPanel>
        <Rectangle Grid.Column="5" Style="{StaticResource DockDivider}" />

        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
          <ui:Button ToolTip="Copy invite link" Tag="invite" Click="OnAction" Style="{StaticResource DockRound}">
            <TextBlock Text="&#xE71B;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
          <ui:Button ToolTip="Close, Ctrl+Alt+L" Tag="close" Click="OnAction" Style="{StaticResource DockRound}" Margin="8,0,0,0">
            <TextBlock Text="&#xE711;" Style="{StaticResource DockGlyph}" FontSize="14" />
          </ui:Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
