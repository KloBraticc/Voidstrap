<Window xmlns:resources="clr-namespace:Voidstrap.Resources" x:Class="Voidstrap.UI.Elements.Overlay.SessionDock"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:platform="clr-namespace:Voidstrap.UI"
        Title="{resources:Loc Ui_Session_VoidstrapSession}" Width="1060" Height="96" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="Segoe UI" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Window.Resources>
    <SolidColorBrush x:Key="IslandGreen" Color="#FF32D74B" />
    <Style TargetType="ToolTip">
      <Setter Property="Placement" Value="Custom" />
      <Setter Property="CustomPopupPlacementCallback" Value="{x:Static platform:OverlayToolTipPlacement.Above}" />
      <Setter Property="HasDropShadow" Value="False" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MaxWidth" Value="320" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Padding="12,7,12,7" BorderThickness="1" CornerRadius="14"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
              <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextWrapping="Wrap" Foreground="{TemplateBinding Foreground}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DockAction" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="MinWidth" Value="42" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Appearance" Value="Secondary" />
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Border.CornerRadius" Value="19" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style x:Key="DockIcon" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="Appearance" Value="Transparent" />
      <Setter Property="Border.CornerRadius" Value="18" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style x:Key="DockRound" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="Appearance" Value="Secondary" />
      <Setter Property="Border.CornerRadius" Value="20" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style x:Key="DockDivider" TargetType="Rectangle">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="10,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>
    <Style x:Key="DockChevron" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="Margin" Value="12,0,2,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <!-- A section that reads as one big button: highlights on hover -->
    <Style x:Key="DockCard" TargetType="Border">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- Windows' own icon font, present on every Windows 10 and 11 install, so every icon always renders -->
    <Style x:Key="DockGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="IslandBar" TargetType="Rectangle">
      <Setter Property="Width" Value="2.4" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Margin" Value="0.95,0" />
      <Setter Property="RadiusX" Value="1.2" />
      <Setter Property="RadiusY" Value="1.2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="Fill" Value="{StaticResource IslandGreen}" />
    </Style>
  </Window.Resources>
  <!-- The margins are room for the pill's shadow; the transparent area around the pill lets clicks through to the game -->
  <Grid x:Name="DockRoot" Margin="20,18,20,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="64" />
    </Grid.RowDefinitions>
    <Border x:Name="ServerPanel" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,12" CornerRadius="12"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="150" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- The game's main thumbnail as a banner, with a fade so the title stays readable -->
        <Border CornerRadius="11,11,0,0" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
        <Border x:Name="BannerImageHost" CornerRadius="11,11,0,0">
          <Border.Background>
            <ImageBrush x:Name="BannerBrush" Stretch="UniformToFill" AlignmentY="Center" />
          </Border.Background>
        </Border>
        <Border CornerRadius="11,11,0,0">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Offset="0.35" Color="#00000000" />
              <GradientStop Offset="1" Color="#D0000000" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <StackPanel VerticalAlignment="Bottom" Margin="20,0,20,14">
          <TextBlock x:Name="BannerTitle" Text="Roblox" FontSize="20" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="BannerSubtitle" Margin="0,2,0,0" FontSize="12" Foreground="#DDFFFFFF" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="20,14,20,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="1.3*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{resources:Loc Ui_SessionNotify_Server}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="ServerReadout" Margin="0,6,0,0" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="FriendCountText" Margin="0,10,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="FriendsHeader" Text="{resources:Loc Ui_Session_FriendsInThisServer}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ScrollViewer Grid.Row="1" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="FriendsList">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,8,8" Padding="4,4,12,4" CornerRadius="18" Background="{DynamicResource SubtleFillColorSecondaryBrush}" ToolTip="{Binding Username}">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="14" ClipToBounds="True" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                          <Border.OpacityMask>
                            <VisualBrush>
                              <VisualBrush.Visual>
                                <Ellipse Width="28" Height="28" Fill="Black" />
                              </VisualBrush.Visual>
                            </VisualBrush>
                          </Border.OpacityMask>
                          <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="FriendsStatus" Grid.Row="1" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Session_LookingForFriends}" />
          </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,8,12,12">
          <ui:Button Content="{resources:Loc Ui_SessionNotify_ServerDetails}" Tag="details" Click="OnAction" Style="{StaticResource DockAction}" />
          <ui:Button Content="{resources:Loc Ui_Session_CopyInvite}" Tag="invite" Click="OnAction" Style="{StaticResource DockAction}" />
        </StackPanel>
      </Grid>
    </Border>
    <!-- Your profile, shown in the same popout as the server when your avatar on the dock is clicked -->
    <Border x:Name="ProfilePanel" Grid.Row="0" Visibility="Collapsed" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="150" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="Black" ClipToBounds="True">
          <Border>
            <Border.Background>
              <ImageBrush x:Name="ProfileBannerBrush" Stretch="UniformToFill" AlignmentY="Center" />
            </Border.Background>
          </Border>
        </Border>
        <Border>
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Offset="0" Color="#40000000" />
              <GradientStop Offset="1" Color="#D0000000" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="20,0,20,14">
          <Grid Width="72" Height="72" Margin="0,0,14,0">
            <Ellipse Fill="{DynamicResource ControlStrongStrokeColorDisabledBrush}" />
            <Ellipse Margin="2" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
              <Ellipse.Fill>
                <ImageBrush x:Name="ProfileHeadshotBrush" Stretch="UniformToFill" />
              </Ellipse.Fill>
            </Ellipse>
            <Image Margin="2" Source="{Binding ImageSource, ElementName=ProfileHeadshotBrush}" Stretch="UniformToFill" Visibility="{x:Static platform:PlatformFeatureVisibility.PortableImages}">
              <Image.Clip>
                <EllipseGeometry Center="34,34" RadiusX="34" RadiusY="34" />
              </Image.Clip>
            </Image>
          </Grid>
          <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,2">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="ProfileBannerName" Text="Roblox" FontSize="20" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="460" />
              <TextBlock x:Name="ProfileVerified" Text="&#xE930;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Margin="8,3,0,0"
                         VerticalAlignment="Center" Visibility="Collapsed" Foreground="{DynamicResource AccentFillColorDefaultBrush}" ToolTip="{resources:Loc Ui_Session_Verified}" />
            </StackPanel>
            <TextBlock x:Name="ProfileBannerHandle" Margin="0,2,0,0" FontSize="12" Foreground="#DDFFFFFF" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
        <Grid Grid.Row="1" Margin="20,14,20,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="1.3*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{resources:Loc Ui_Session_Account}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="ProfileAccountText" Margin="0,6,0,0" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="{resources:Loc Ui_Session_Social}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="ProfileSocialText" Margin="0,6,0,0" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="ProfileAboutText" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <TextBlock x:Name="ProfileStatus" Grid.ColumnSpan="3" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,8,12,12">
          <ui:Button Content="{resources:Loc Ui_Session_OpenProfile}" Click="OpenProfile_Click" Style="{StaticResource DockAction}" />
          <ui:Button x:Name="CopyProfileButton" Content="{resources:Loc Ui_Session_CopyProfileLink}" Click="CopyProfile_Click" Style="{StaticResource DockAction}" />
        </StackPanel>
      </Grid>
    </Border>
    <!-- The dock itself: a pill with a thin outline and a soft shadow. The shadow is a few faint rings drawn once,
         a blur effect had to be recalculated on every change and made the dock and the game stutter -->
    <Grid Grid.Row="1" HorizontalAlignment="Center">
      <Border x:Name="DockShadow1" Margin="-2,-1,-2,-3" CornerRadius="34" Background="#12000000" />
      <Border x:Name="DockShadow2" Margin="-4,-2,-4,-6" CornerRadius="36" Background="#0F000000" />
      <Border x:Name="DockShadow3" Margin="-6,-3,-6,-8" CornerRadius="38" Background="#0C000000" />
      <Border x:Name="DockShadow4" Margin="-9,-5,-9,-11" CornerRadius="41" Background="#09000000" />
      <Border x:Name="DockShadow5" Margin="-12,-7,-12,-14" CornerRadius="44" Background="#06000000" />
    <Border x:Name="Pill" Padding="14,0,12,0" CornerRadius="32" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" SnapsToDevicePixels="True">
      <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
      <ScrollViewer x:Name="DockScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False" PreviewMouseWheel="DockScroll_PreviewMouseWheel">
      <Grid x:Name="DockContent" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- You: avatar, display name and username -->
        <Border x:Name="ProfileCard" Style="{StaticResource DockCard}" ToolTip="{resources:Loc Ui_Session_YourProfile}" MouseLeftButtonUp="ProfileCard_MouseLeftButtonUp">
          <StackPanel Orientation="Horizontal">
            <Grid Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
              <Ellipse Fill="{DynamicResource SubtleFillColorSecondaryBrush}" />
              <TextBlock x:Name="ProfileFallback" Text="&#xE77B;" Style="{StaticResource DockGlyph}" FontSize="16"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <Ellipse Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
                <Ellipse.Fill>
                  <ImageBrush x:Name="ProfileAvatar" Stretch="UniformToFill" />
                </Ellipse.Fill>
              </Ellipse>
              <Image Source="{Binding ImageSource, ElementName=ProfileAvatar}" Stretch="UniformToFill" Visibility="{x:Static platform:PlatformFeatureVisibility.PortableImages}">
                <Image.Clip>
                  <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20" />
                </Image.Clip>
              </Image>
            </Grid>
            <StackPanel VerticalAlignment="Center" MaxWidth="150">
              <TextBlock x:Name="ProfileName" Text="Roblox" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="ProfileHandle" Margin="0,1,0,0" FontSize="12" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Ui_Session_SignedOut}" />
            </StackPanel>
            <TextBlock x:Name="ProfileChevron" Text="&#xE70E;" Style="{StaticResource DockChevron}" />
          </StackPanel>
        </Border>
        <Rectangle Grid.Column="1" Style="{StaticResource DockDivider}" />

        <!-- The game, clickable like an option card, opens the game and server popout above the dock -->
        <Border x:Name="GameCard" Grid.Column="2" Style="{StaticResource DockCard}" ToolTip="{resources:Loc Ui_Session_GameAndServer}" MouseLeftButtonUp="GameCard_MouseLeftButtonUp">
          <StackPanel Orientation="Horizontal">
            <Image x:Name="GamePicture" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center"
                   Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
              <Image.Clip>
                <RectangleGeometry Rect="0,0,40,40" RadiusX="10" RadiusY="10" />
              </Image.Clip>
            </Image>
            <StackPanel VerticalAlignment="Center" MaxWidth="250">
              <TextBlock x:Name="GameTitle" Text="Roblox" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <StackPanel Margin="0,1,0,0" Orientation="Horizontal">
                <!-- Live server indicator: a dot with a short heartbeat every couple of seconds -->
                <Grid Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                  <Ellipse x:Name="PulseRing" Width="8" Height="8" Opacity="0" RenderTransformOrigin="0.5,0.5"
                           Fill="{StaticResource IslandGreen}">
                    <Ellipse.RenderTransform>
                      <ScaleTransform x:Name="PulseRingScale" />
                    </Ellipse.RenderTransform>
                  </Ellipse>
                  <Ellipse x:Name="PulseDot" Width="8" Height="8" RenderTransformOrigin="0.5,0.5"
                           Fill="{StaticResource IslandGreen}">
                    <Ellipse.RenderTransform>
                      <ScaleTransform x:Name="PulseDotScale" />
                    </Ellipse.RenderTransform>
                  </Ellipse>
                </Grid>
                <TextBlock x:Name="SessionTimes" FontSize="12" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                  <Run Text="{resources:Loc Ui_Session_Session}" /><Run x:Name="SessionClock" Text="0:00" FontWeight="SemiBold" Foreground="{StaticResource IslandGreen}" /><Run Text="{resources:Loc Ui_Session_Server}" /><Run x:Name="ServerClock" Text="--" FontWeight="SemiBold" Foreground="{StaticResource IslandGreen}" />
                </TextBlock>
              </StackPanel>
            </StackPanel>
            <TextBlock x:Name="GameChevron" Text="&#xE70E;" Style="{StaticResource DockChevron}" />
          </StackPanel>
        </Border>
        <Rectangle Grid.Column="3" Style="{StaticResource DockDivider}" HorizontalAlignment="Left" />

        <StackPanel x:Name="ActionButtons" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,6,0">
          <ui:Button ToolTip="{resources:Loc Ui_Session_ChatWithFriends}" Tag="chat" Click="OnAction" Style="{StaticResource DockIcon}">
            <TextBlock Text="&#xE8BD;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
          <ui:Button ToolTip="{resources:Loc Ui_Session_Servers}" Tag="browser" Click="OnAction" Style="{StaticResource DockIcon}">
            <TextBlock Text="&#xE753;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
          <ui:Button ToolTip="{resources:Loc Ui_Session_Games}" Tag="games" Click="OnAction" Style="{StaticResource DockIcon}">
            <TextBlock Text="&#xE7FC;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
          <ui:Button ToolTip="{resources:Loc ContextMenu_GameHistory_Title}" Tag="history" Click="OnAction" Style="{StaticResource DockIcon}">
            <TextBlock Text="&#xE81C;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
          <ui:Button ToolTip="{resources:Loc Ui_Session_Music}" Tag="music" Click="OnAction" Style="{StaticResource DockIcon}">
            <TextBlock Text="&#xE8D6;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
          <ui:Button ToolTip="{resources:Loc Ui_SessionNotify_ServerDetails}" Tag="details" Click="OnAction" Style="{StaticResource DockIcon}">
            <TextBlock Text="&#xE968;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
          <ui:Button x:Name="WebButton" ToolTip="{resources:Loc Ui_Session_Browser}" Tag="web" Click="OnAction" Style="{StaticResource DockIcon}">
            <TextBlock Text="&#xE774;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
          <ui:Button x:Name="ClipsButton" ToolTip="{resources:Loc Ui_Clipper_Title}" Tag="clips" Click="OnAction" Style="{StaticResource DockIcon}">
            <TextBlock Text="&#xE714;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
          <ui:Button ToolTip="{resources:Loc Ui_Session_OverlayLayout}" Tag="layout" Click="OnAction" Style="{StaticResource DockIcon}">
            <TextBlock Text="&#xE759;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
          <ui:Button ToolTip="{resources:Loc Ui_Nav_Settings}" Tag="adjustments" Click="OnAction" Style="{StaticResource DockIcon}">
            <TextBlock Text="&#xE713;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
        </StackPanel>
        <Rectangle Grid.Column="5" Style="{StaticResource DockDivider}" />

      </Grid>
      </ScrollViewer>
        <StackPanel x:Name="TrailingButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ui:Button ToolTip="{resources:Loc Ui_Session_CopyInviteLink}" Tag="invite" Click="OnAction" Style="{StaticResource DockRound}">
            <TextBlock Text="&#xE71B;" Style="{StaticResource DockGlyph}" />
          </ui:Button>
          <ui:Button x:Name="CloseButton" ToolTip="{resources:Loc Common_Close}" Tag="close" Click="OnAction" Style="{StaticResource DockRound}" Margin="8,0,0,0">
            <TextBlock Text="&#xE711;" Style="{StaticResource DockGlyph}" FontSize="14" />
          </ui:Button>
        </StackPanel>
      </Grid>
    </Border>
    </Grid>
    <Popup x:Name="NowPlayingPopup" Grid.Row="1" PlacementTarget="{Binding ElementName=Pill}" Placement="Custom" AllowsTransparency="True" Focusable="False" StaysOpen="True">
      <Grid x:Name="IslandStage" Width="460" Height="214">
        <Grid.Resources>
          <Storyboard x:Key="IslandMeter">
          <DoubleAnimation Storyboard.TargetName="MeterBar0" Storyboard.TargetProperty="ScaleY" From="0.25" To="0.5" Duration="0:0:0.41" AutoReverse="True" RepeatBehavior="Forever" />
          <DoubleAnimation Storyboard.TargetName="MeterBar1" Storyboard.TargetProperty="ScaleY" From="0.4" To="1" Duration="0:0:0.33" AutoReverse="True" RepeatBehavior="Forever" />
          <DoubleAnimation Storyboard.TargetName="MeterBar2" Storyboard.TargetProperty="ScaleY" From="0.3" To="0.7" Duration="0:0:0.47" AutoReverse="True" RepeatBehavior="Forever" />
          <DoubleAnimation Storyboard.TargetName="MeterBar3" Storyboard.TargetProperty="ScaleY" From="0.2" To="0.4" Duration="0:0:0.29" AutoReverse="True" RepeatBehavior="Forever" />
          <DoubleAnimation Storyboard.TargetName="MeterBar4" Storyboard.TargetProperty="ScaleY" From="0.3" To="0.6" Duration="0:0:0.37" AutoReverse="True" RepeatBehavior="Forever" />
          <DoubleAnimation Storyboard.TargetName="MeterBar5" Storyboard.TargetProperty="ScaleY" From="0.2" To="0.35" Duration="0:0:0.43" AutoReverse="True" RepeatBehavior="Forever" />
          <DoubleAnimation Storyboard.TargetName="LargeMeterBar0" Storyboard.TargetProperty="ScaleY" From="0.25" To="0.5" Duration="0:0:0.41" AutoReverse="True" RepeatBehavior="Forever" />
          <DoubleAnimation Storyboard.TargetName="LargeMeterBar1" Storyboard.TargetProperty="ScaleY" From="0.4" To="1" Duration="0:0:0.33" AutoReverse="True" RepeatBehavior="Forever" />
          <DoubleAnimation Storyboard.TargetName="LargeMeterBar2" Storyboard.TargetProperty="ScaleY" From="0.3" To="0.7" Duration="0:0:0.47" AutoReverse="True" RepeatBehavior="Forever" />
          <DoubleAnimation Storyboard.TargetName="LargeMeterBar3" Storyboard.TargetProperty="ScaleY" From="0.2" To="0.4" Duration="0:0:0.29" AutoReverse="True" RepeatBehavior="Forever" />
          <DoubleAnimation Storyboard.TargetName="LargeMeterBar4" Storyboard.TargetProperty="ScaleY" From="0.3" To="0.6" Duration="0:0:0.37" AutoReverse="True" RepeatBehavior="Forever" />
          <DoubleAnimation Storyboard.TargetName="LargeMeterBar5" Storyboard.TargetProperty="ScaleY" From="0.2" To="0.35" Duration="0:0:0.43" AutoReverse="True" RepeatBehavior="Forever" />
          </Storyboard>
          <Style x:Key="IslandRoundButton" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Margin" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </Grid.Resources>
        <Grid x:Name="NowPlayingIsland" Width="200" Height="37" HorizontalAlignment="Center" VerticalAlignment="Bottom" ClipToBounds="True"
              RenderTransformOrigin="0.5,1" Margin="0,0,0,28" MouseEnter="NowPlayingIsland_MouseEnter" MouseLeave="NowPlayingIsland_MouseLeave" PreviewMouseLeftButtonDown="NowPlayingIsland_PreviewMouseLeftButtonDown" PreviewMouseMove="NowPlayingIsland_PreviewMouseMove" PreviewMouseLeftButtonUp="NowPlayingIsland_PreviewMouseLeftButtonUp" LostMouseCapture="NowPlayingIsland_LostMouseCapture">
          <Grid.RenderTransform>
            <TransformGroup>
              <ScaleTransform x:Name="IslandScale" />
              <TranslateTransform x:Name="IslandPull" />
            </TransformGroup>
          </Grid.RenderTransform>
          <Rectangle x:Name="IslandShape" Fill="{DynamicResource SolidBackgroundFillColorBaseBrush}" Stroke="{DynamicResource SurfaceStrokeColorDefaultBrush}" StrokeThickness="1" RadiusX="18.5" RadiusY="18.5" />
          <StackPanel x:Name="IslandCompact" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Height="37" Margin="7,0,14,0">
            <Border Width="22" Height="22" CornerRadius="6" Background="#FF1ED760" VerticalAlignment="Center">
              <Border.Clip>
                <RectangleGeometry Rect="0,0,22,22" RadiusX="6" RadiusY="6" />
              </Border.Clip>
              <Grid>
                <TextBlock Style="{StaticResource DockGlyph}" FontSize="12" Foreground="Black" Text="&#xEC4F;" />
                <Image x:Name="NowPlayingCover" Stretch="UniformToFill" />
              </Grid>
            </Border>
            <TextBlock x:Name="NowPlayingTitle" Margin="10,0,0,0" MaxWidth="220" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="NowPlayingArtist" Margin="6,0,0,0" MaxWidth="150" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" Height="17" VerticalAlignment="Center">
                <Rectangle Style="{StaticResource IslandBar}" Height="14">
                  <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="MeterBar0" ScaleY="0.5" />
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Style="{StaticResource IslandBar}" Height="14">
                  <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="MeterBar1" ScaleY="1" />
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Style="{StaticResource IslandBar}" Height="14">
                  <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="MeterBar2" ScaleY="0.7" />
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Style="{StaticResource IslandBar}" Height="14">
                  <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="MeterBar3" ScaleY="0.4" />
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Style="{StaticResource IslandBar}" Height="14">
                  <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="MeterBar4" ScaleY="0.6" />
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Style="{StaticResource IslandBar}" Height="14">
                  <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="MeterBar5" ScaleY="0.35" />
                  </Rectangle.RenderTransform>
                </Rectangle>
            </StackPanel>
          </StackPanel>
          <Grid x:Name="IslandExpanded" Width="372" Height="172" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" Visibility="Collapsed">
            <Grid Margin="20,18,20,12">
              <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Width="60" Height="60" CornerRadius="14" Background="#FF1ED760">
                <Border.Clip>
                  <RectangleGeometry Rect="0,0,60,60" RadiusX="14" RadiusY="14" />
                </Border.Clip>
                <Grid>
                  <TextBlock Style="{StaticResource DockGlyph}" FontSize="24" Foreground="Black" Text="&#xEC4F;" />
                  <Image x:Name="NowPlayingCoverLarge" Stretch="UniformToFill" />
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="IslandTitle" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="IslandArtist" Margin="0,1,0,0" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Height="20" VerticalAlignment="Top" Margin="0,8,4,0">
                <Rectangle Style="{StaticResource IslandBar}" Height="20">
                  <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="LargeMeterBar0" ScaleY="0.5" />
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Style="{StaticResource IslandBar}" Height="20">
                  <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="LargeMeterBar1" ScaleY="1" />
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Style="{StaticResource IslandBar}" Height="20">
                  <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="LargeMeterBar2" ScaleY="0.7" />
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Style="{StaticResource IslandBar}" Height="20">
                  <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="LargeMeterBar3" ScaleY="0.4" />
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Style="{StaticResource IslandBar}" Height="20">
                  <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="LargeMeterBar4" ScaleY="0.6" />
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Style="{StaticResource IslandBar}" Height="20">
                  <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="LargeMeterBar5" ScaleY="0.35" />
                  </Rectangle.RenderTransform>
                </Rectangle>
              </StackPanel>
              <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="IslandElapsed" Text="0:00" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                <Grid Grid.Column="1" Height="6" VerticalAlignment="Center">
                  <Rectangle RadiusX="3" RadiusY="3" Fill="{DynamicResource ControlStrongStrokeColorDisabledBrush}" />
                  <Rectangle RadiusX="3" RadiusY="3" Fill="{DynamicResource TextFillColorPrimaryBrush}" RenderTransformOrigin="0,0.5">
                    <Rectangle.RenderTransform>
                      <ScaleTransform x:Name="IslandProgress" ScaleX="0" />
                    </Rectangle.RenderTransform>
                  </Rectangle>
                </Grid>
                <TextBlock x:Name="IslandRemaining" Grid.Column="2" Text="0:00" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Style="{StaticResource IslandRoundButton}" Tag="previous" ToolTip="{resources:Loc Ui_Island_Previous}" MouseLeftButtonUp="IslandTransport_MouseLeftButtonUp">
                  <TextBlock Text="&#xE892;" Style="{StaticResource DockGlyph}" FontSize="18" />
                </Border>
                <Border Style="{StaticResource IslandRoundButton}" Tag="toggle" ToolTip="{resources:Loc Ui_Island_PlayPause}" MouseLeftButtonUp="IslandTransport_MouseLeftButtonUp">
                  <TextBlock x:Name="IslandToggleGlyph" Text="&#xE769;" Style="{StaticResource DockGlyph}" FontSize="22" />
                </Border>
                <Border Style="{StaticResource IslandRoundButton}" Tag="next" ToolTip="{resources:Loc Ui_Island_Next}" MouseLeftButtonUp="IslandTransport_MouseLeftButtonUp">
                  <TextBlock Text="&#xE893;" Style="{StaticResource DockGlyph}" FontSize="18" />
                </Border>
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Popup>
  </Grid>
</Window>
