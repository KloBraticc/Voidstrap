<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.ContextMenu.GamePassConsole" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:Voidstrap.UI.Elements.ContextMenu" xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:models="clr-namespace:Voidstrap.UI.ViewModels.ContextMenu" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:enums="clr-namespace:Voidstrap.Enums" Title="Player Gamepasses" MinWidth="550" MinHeight="420" Width="850" Height="520" ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterScreen" Background="{ui:ThemeResource ApplicationBackgroundBrush}">
  <Grid>
    <Panel.Background>
      <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
        <GradientStop Offset="0.00" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        <GradientStop Offset="0.70" Color="{DynamicResource WindowBackgroundColorSecondary}" />
        <GradientStop Offset="1.1" Color="{DynamicResource WindowBackgroundColorThird}" />
      </LinearGradientBrush>
    </Panel.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Name="RootTitleBar" Grid.Row="0" Padding="8" Title="Player Gamepasses" ShowMinimize="True" ShowMaximize="False" CanMaximize="False" KeyboardNavigation.TabNavigation="None" Icon="pack://application:,,,/Voidstrap.png" />
    <TextBlock Grid.Row="1" Margin="16,8,16,0" Text="Displays all gamepasses owned or created by the player." TextWrapping="Wrap" />
    <Border Grid.Row="2" Margin="24" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
      <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding ErrorMessage, Mode=OneWay}">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type TextBlock}">
            <Style.Triggers>
              <DataTrigger Value="{x:Static enums:GenericTriState.Failed}" Binding="{Binding LoadState, Mode=OneWay}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
            <Setter Property="Visibility" Value="Collapsed" />
          </Style>
        </FrameworkElement.Style>
      </TextBlock>
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Border}">
          <Style.Triggers>
            <DataTrigger Value="{x:Static enums:GenericTriState.Failed}" Binding="{Binding LoadState, Mode=OneWay}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
          <Setter Property="Visibility" Value="Collapsed" />
        </Style>
      </FrameworkElement.Style>
    </Border>
    <Border Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Border}">
          <Style.Triggers>
            <DataTrigger Value="{x:Static enums:GenericTriState.Unknown}" Binding="{Binding LoadState, Mode=OneWay}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
          <Setter Property="Visibility" Value="Collapsed" />
        </Style>
      </FrameworkElement.Style>
      <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" />
    </Border>
    <DataGrid Name="GamePassesDataGrid" Grid.Row="2" HeadersVisibility="Column" GridLinesVisibility="Horizontal" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" IsReadOnly="True" Margin="8" ItemsSource="{Binding GamePassesCollection}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type DataGrid}}" TargetType="{x:Type DataGrid}">
          <Setter Property="Background" Value="#00FFFFFF" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Value="{x:Static enums:GenericTriState.Successful}" Binding="{Binding LoadState, Mode=OneWay}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <DataGrid.ColumnHeaderStyle>
        <Style TargetType="{x:Type DataGridColumnHeader}">
          <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
          <Setter Property="Height" Value="32" />
          <Setter Property="Padding" Value="8,0,8,0" />
          <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
          <Setter Property="BorderThickness" Value="1" />
        </Style>
      </DataGrid.ColumnHeaderStyle>
      <DataGrid.CellStyle>
        <Style TargetType="{x:Type DataGridCell}">
          <Setter Property="Height" Value="72" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type DataGridCell}">
                <Border Background="{TemplateBinding Control.Background}" Padding="6,4">
                  <ContentPresenter VerticalAlignment="Center" />
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </DataGrid.CellStyle>
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Icon" Width="64">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Image Width="48" Height="48" Stretch="UniformToFill" Margin="4" ClipToBounds="True" Source="{Binding IconUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Name" Width="2*" Binding="{Binding Name}" />
        <DataGridTextColumn Header="Description" Width="3*" Binding="{Binding Description}" />
        <DataGridTextColumn Header="Price (R$)" Width="*" Binding="{Binding DisplayPrice}" />
        <DataGridTextColumn Header="Creator" Width="*" Binding="{Binding CreatorName}" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</base:WpfUiWindow>
