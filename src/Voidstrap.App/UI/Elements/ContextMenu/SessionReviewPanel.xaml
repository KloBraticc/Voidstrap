<Window xmlns:resources="clr-namespace:Voidstrap.Resources" x:Class="Voidstrap.UI.Elements.Overlay.SessionReviewPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:util="clr-namespace:Voidstrap.Utility"
        Title="{resources:Loc Ui_Session_CommunityRating}" Width="440" Height="540" MinWidth="380" MinHeight="400"
        WindowStyle="None" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" FontFamily="Segoe UI">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>

  <Grid Margin="18,14,18,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel x:Name="HeaderPanel" Margin="2,0,2,4" Visibility="Collapsed">
      <TextBlock x:Name="GameNameText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
    </StackPanel>

    <Border Grid.Row="1" Margin="0,4,0,0" Padding="14,10" CornerRadius="8"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ui:Button x:Name="VoteUpButton" Appearance="Transparent" Padding="8,4"
                     Height="32" MinWidth="54" Focusable="False" Click="OnVoteUp">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="VoteUpIcon" Text="&#xE8E1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
              <TextBlock x:Name="UpCountText" Text="0" Margin="6,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </ui:Button>
          <ui:Button x:Name="VoteDownButton" Appearance="Transparent" Padding="8,4" Margin="6,0,0,0"
                     Height="32" MinWidth="54" Focusable="False" Click="OnVoteDown">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="VoteDownIcon" Text="&#xE8E0;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
              <TextBlock x:Name="DownCountText" Text="0" Margin="6,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </ui:Button>
          <TextBlock x:Name="ReviewCountText" Margin="14,0,0,0" FontSize="12.5" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <TextBlock x:Name="AuthStatus" Grid.Column="2" VerticalAlignment="Center" FontSize="11.5"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="0,10,0,0">
      <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
        <TextBlock Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="32"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,8" />
        <TextBlock Text="{resources:Loc Ui_Session_NoReviews}"
                   FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   HorizontalAlignment="Center" TextAlignment="Center" />
      </StackPanel>

      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
        <ItemsControl x:Name="ReviewList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="8"
                      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Grid Width="34" Height="34" VerticalAlignment="Center">
                        <Ellipse Fill="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding AvatarUrl}"
                               util:DynamicRenderSystem.LinuxImageSource="{Binding AvatarUrl}"
                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                          <Image.Clip>
                            <EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17" />
                          </Image.Clip>
                        </Image>
                      </Grid>

                      <TextBlock Text="{Binding AuthorName}" FontSize="13.5" FontWeight="Bold" Margin="10,0,0,0"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding CreatedAt}" FontSize="12" Margin="8,0,0,0"
                                 Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <ui:Button Grid.Column="1" Appearance="Transparent" Padding="4,2" Margin="0,-2,-2,-2"
                               Height="24" Width="24" Focusable="False"
                               Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                               Tag="{Binding}" Click="OnDeleteReview">
                      <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                 Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </ui:Button>
                  </Grid>

                  <TextBlock Text="{Binding Content}" FontSize="13.5" TextWrapping="Wrap" Margin="0,8,0,12"
                             LineHeight="19"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="{Binding UpAppearance}" Padding="8,3" Height="28" MinWidth="48"
                               Focusable="False" Tag="{Binding}" Click="OnReviewVoteUp">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8E1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding UpCount}" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                      </StackPanel>
                    </ui:Button>

                    <ui:Button Appearance="{Binding DownAppearance}" Padding="8,3" Margin="8,0,0,0" Height="28" MinWidth="48"
                               Focusable="False" Tag="{Binding}" Click="OnReviewVoteDown">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8E0;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DownCount}" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                      </StackPanel>
                    </ui:Button>

                    <TextBlock Text="{Binding RatingText}" Margin="12,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <Grid Grid.Row="3" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ui:TextBox x:Name="ReviewInput" FontSize="13" Padding="10,7" MaxLength="500"
                  ClearButtonEnabled="True" VerticalAlignment="Center"
                  KeyDown="OnInputKeyDown"
                  PlaceholderText="{resources:Loc Ui_Session_WriteReview}" />
      <ui:Button x:Name="SubmitButton" Grid.Column="1" Margin="8,0,0,0" Appearance="Primary"
                 Padding="16,7" Height="34" Focusable="False" Click="OnSubmitReview"
                 Content="{resources:Loc Ui_Session_SubmitReview}" />
    </Grid>

    <TextBlock Grid.Row="4" Margin="0,8,0,0" HorizontalAlignment="Center"
               FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
               Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OnRoReviewLinkClicked">
      <Run Text="Powered by " /><Run Text="RoReview" TextDecorations="Underline" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </TextBlock>
  </Grid>
</Window>
