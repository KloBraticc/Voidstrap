<Window xmlns:resources="clr-namespace:Voidstrap.Resources" x:Class="Voidstrap.UI.Elements.Overlay.SessionReviewPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{resources:Loc Ui_Session_CommunityRating}" Width="440" Height="540" MinWidth="380" MinHeight="400"
        WindowStyle="None" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" FontFamily="Segoe UI">
  <Grid Margin="18,14,18,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel x:Name="HeaderPanel" Margin="2,0,2,4" Visibility="Collapsed">
      <TextBlock x:Name="GameNameText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
    </StackPanel>

    <Border Grid.Row="1" Margin="0,4,0,0" Padding="14,10" CornerRadius="8"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <ui:Button x:Name="VoteUpButton" Appearance="Transparent" Padding="8,5"
                     Height="32" MinWidth="52" Focusable="False" Click="OnVoteUp">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8E1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                         Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
              <TextBlock x:Name="UpCountText" Text="0" Margin="6,0,0,0" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </ui:Button>
          <ui:Button x:Name="VoteDownButton" Appearance="Transparent" Padding="8,5" Margin="8,0,0,0"
                     Height="32" MinWidth="52" Focusable="False" Click="OnVoteDown">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8E0;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                         Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
              <TextBlock x:Name="DownCountText" Text="0" Margin="6,0,0,0" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </ui:Button>
          <TextBlock x:Name="ReviewCountText" Margin="14,0,0,0" FontSize="13" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <TextBlock x:Name="AuthStatus" Grid.Column="2" VerticalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
      </Grid>
    </Border>

    <Border Grid.Row="2" Margin="0,10,0,0" CornerRadius="8"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <Grid>
        <TextBlock x:Name="EmptyLabel" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="{resources:Loc Ui_Session_NoReviews}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,6">
          <ItemsControl x:Name="ReviewList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,4,0,4" Padding="12,10" CornerRadius="6"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                  <StackPanel>
                    <Grid>
                      <TextBlock Text="{Binding AuthorName}" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      <TextBlock Text="{Binding CreatedAt}" FontSize="11" HorizontalAlignment="Right"
                                 Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Grid>
                    <TextBlock Text="{Binding Content}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <Grid Grid.Row="3" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ui:TextBox x:Name="ReviewInput" FontSize="13" Padding="10,7" MaxLength="500"
                  ClearButtonEnabled="True" VerticalAlignment="Center"
                  PlaceholderText="{resources:Loc Ui_Session_WriteReview}" />
      <ui:Button x:Name="SubmitButton" Grid.Column="1" Margin="8,0,0,0" Appearance="Primary"
                 Padding="14,7" Height="34" Focusable="False" Click="OnSubmitReview"
                 Content="{resources:Loc Ui_Session_SubmitReview}" />
    </Grid>
  </Grid>
</Window>
