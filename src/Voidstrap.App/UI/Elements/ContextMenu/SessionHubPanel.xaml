<Window x:Class="Voidstrap.UI.Elements.Overlay.SessionHubPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:util="clr-namespace:Voidstrap.Utility"
        xmlns:resources="clr-namespace:Voidstrap.Resources"
        Title="{resources:Loc Ui_Nav_News}" Width="1040" Height="620" MinWidth="760" MinHeight="420"
        WindowStyle="None" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" FontFamily="Segoe UI">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="HubCard" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Name="CardRoot" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" ClipToBounds="True">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CardRoot" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HubHeading" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="2,0,0,8" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="HubEmpty" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="2,0,0,16" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>
  </Window.Resources>

  <Grid Margin="16,12,16,14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <ui:DynamicScrollViewer Grid.Column="0" Margin="0,0,8,0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Style="{StaticResource HubHeading}" Text="{resources:Loc Ui_Nav_News}" />
        <TextBlock x:Name="NewsEmpty" Style="{StaticResource HubEmpty}" Text="{resources:Loc Ui_Session_HubEmpty}" />
        <ItemsControl x:Name="NewsList" Margin="0,0,0,12">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                  <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding DateDisplay}" />
                  <TextBlock Margin="0,3,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Content}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource HubHeading}" Text="{resources:Loc Ui_Pages_Events}" />
        <TextBlock x:Name="EventsEmpty" Style="{StaticResource HubEmpty}" Text="{resources:Loc Ui_Session_HubEmpty}" />
        <ItemsControl x:Name="EventList" Margin="0,0,0,12">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource HubCard}" Margin="0,0,0,8" ToolTip="{resources:Loc Ui_Pages_ViewEvent}" Tag="{Binding EventUrl}" Click="OpenLink_Click">
                <StackPanel>
                  <Grid Height="120" ClipToBounds="True">
                    <Image util:DynamicRenderSystem.LazyImageSource="{Binding ThumbnailUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="UniformToFill" />
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" CornerRadius="10" Padding="8,3" Background="#CC101010">
                      <TextBlock Text="{Binding StartDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                  </Grid>
                  <StackPanel Margin="10,8,10,10">
                    <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" ToolTip="{Binding Title}" />
                    <TextBlock Margin="0,2,0,0" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding SubtitleDisplay}" />
                  </StackPanel>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource HubHeading}" Text="{resources:Loc Ui_Session_SocialLinks}" />
        <TextBlock x:Name="LinksEmpty" Style="{StaticResource HubEmpty}" Text="{resources:Loc Ui_Session_HubEmpty}" />
        <ItemsControl x:Name="LinkList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource HubCard}" Margin="0,0,0,8" ToolTip="{Binding Url}" Tag="{Binding Url}" Click="OpenLink_Click">
                <Grid Margin="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="44" Height="44" CornerRadius="6" Background="{Binding TileBrush}">
                    <ui:SymbolIcon Symbol="Link24" FontSize="22" Foreground="White" />
                  </Border>
                  <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Label}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ui:DynamicScrollViewer>

    <Grid Grid.Column="1" Margin="8,0,8,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Style="{StaticResource HubHeading}" Text="{resources:Loc Library_Badges_Tab}" />
      <Border x:Name="BadgeSummary" Grid.Row="1" Margin="0,0,0,10" Padding="12,10" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ui:SymbolIcon Symbol="Star24" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <Grid>
              <TextBlock x:Name="BadgeSummaryText" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              <TextBlock x:Name="BadgePercentText" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
            <ProgressBar x:Name="BadgeProgress" Height="8" MinHeight="8" Margin="0,8,0,0" Minimum="0" Maximum="100" />
          </StackPanel>
        </Grid>
      </Border>
      <StackPanel Grid.Row="2">
        <ProgressBar x:Name="BadgesLoading" Height="4" Margin="0,0,0,10" IsIndeterminate="True" />
        <TextBlock x:Name="BadgeStatus" Margin="2,0,0,10" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
      </StackPanel>
      <ui:DynamicScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="BadgeList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource HubCard}" Margin="0,0,0,8" AutomationProperties.Name="{Binding Name}" ToolTip="{resources:Loc Library_Badges_Open}" Tag="{Binding Id}" Click="OpenBadge_Click">
                <Grid Margin="10" Opacity="{Binding CardOpacity}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="48" Height="48" CornerRadius="24" ClipToBounds="True" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <Grid>
                      <ui:SymbolIcon Symbol="Star24" FontSize="20" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                      <Image util:DynamicRenderSystem.LazyImageSource="{Binding IconUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="UniformToFill" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Description}" Visibility="{Binding DescriptionVisibility}" />
                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding RarityText}" Visibility="{Binding RarityVisibility}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="16" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Visibility="{Binding EarnedVisibility}" />
                    <ui:SymbolIcon Symbol="LockClosed24" FontSize="16" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding LockedVisibility}" />
                    <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StateText}" />
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ui:DynamicScrollViewer>
    </Grid>

    <Grid Grid.Column="2" Margin="8,0,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Style="{StaticResource HubHeading}" Text="{resources:Loc Ui_Session_CommunityRating}" />
      <ContentPresenter x:Name="ReviewHost" Grid.Row="1" Margin="-18,-14,-18,-12" />
    </Grid>
  </Grid>
</Window>
