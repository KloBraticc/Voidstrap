<ui:UiPage x:Class="Voidstrap.UI.Elements.ContextMenu.InstancePages.InstancesPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
           xmlns:util="clr-namespace:Voidstrap.Utility"
           Title="Instances"
           Loaded="UiPage_Loaded"
           Unloaded="UiPage_Unloaded">
  <Grid Margin="0,0,14,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,12">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Running instances" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock x:Name="SummaryText" Margin="0,3,0,0" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="No instances running" />
      </StackPanel>
      <ui:Button x:Name="CloseAllButton" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Close all" Icon="Dismiss24" Appearance="Secondary" Click="CloseAll_Click" />
    </Grid>

    <Border Grid.Row="1" Margin="0,0,0,12" Padding="12" CornerRadius="10" Background="#0AFFFFFF" BorderThickness="1" BorderBrush="#1FFFFFFF">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
          <TextBlock Text="Launch as" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <TextBlock x:Name="AccountHint" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Saved accounts come from the account switcher" />
        </StackPanel>
        <ComboBox x:Name="AccountPicker" Grid.Column="1" MinWidth="160" VerticalAlignment="Center">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <Grid Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                  <Ellipse Fill="#1FFFFFFF" />
                  <ui:SymbolIcon Symbol="Person24" FontSize="12" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image Source="{Binding AvatarUrl, TargetNullValue={x:Null}}" util:DynamicRenderSystem.LinuxImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Clip>
                      <EllipseGeometry Center="11,11" RadiusX="11" RadiusY="11" />
                    </Image.Clip>
                  </Image>
                </Grid>
                <TextBlock VerticalAlignment="Center" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
          <ui:Button x:Name="LaunchButton" Content="Launch" Icon="Play24" Appearance="Primary" Background="{DynamicResource SystemAccentColorSecondaryBrush}" Click="Launch_Click" />
          <ui:Button x:Name="LaunchStudioButton" Margin="8,0,0,0" Content="Studio" Icon="WindowDevTools24" Appearance="Secondary" Click="LaunchStudio_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" CornerRadius="10" Background="#0A000000" BorderThickness="1" BorderBrush="#1FFFFFFF">
      <Grid>
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
          <Border Width="56" Height="56" CornerRadius="28" Background="#14FFFFFF" HorizontalAlignment="Center">
            <ui:SymbolIcon Symbol="Games28" FontSize="26" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Margin="0,14,0,5" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="No instances running" />
          <TextBlock HorizontalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Launch one above and it will show up here." />
        </StackPanel>

        <ui:DynamicScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="InstanceList" Margin="12">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="InstanceRow" Margin="0,0,0,10" Padding="12" CornerRadius="10" Background="#0FFFFFFF" BorderThickness="1" BorderBrush="#1FFFFFFF">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" Margin="0,0,12,0" CornerRadius="9" Background="#1FFFFFFF" VerticalAlignment="Center">
                      <ui:SymbolIcon Symbol="Games28" FontSize="17" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Product}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                      <TextBlock Margin="0,2,0,0" Text="{Binding Detail}" FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <ui:Button Content="Focus" Icon="Open24" Appearance="Secondary" Tag="{Binding ProcessId}" Click="FocusInstance_Click" />
                      <ui:Button Margin="8,0,0,0" Content="Close" Icon="Dismiss24" Appearance="Danger" Tag="{Binding ProcessId}" Click="CloseInstance_Click" />
                    </StackPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <Trigger SourceName="InstanceRow" Property="IsMouseOver" Value="True">
                    <Setter TargetName="InstanceRow" Property="Background" Value="#1AFFFFFF" />
                  </Trigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ui:DynamicScrollViewer>
      </Grid>
    </Border>

    <Border x:Name="StatusBar" Grid.Row="3" Margin="0,12,0,0" Padding="11,8" CornerRadius="8" Background="#0AFFFFFF" BorderThickness="1" BorderBrush="#1FFFFFFF">
      <StackPanel Orientation="Horizontal">
        <ui:SymbolIcon Symbol="Info24" FontSize="14" VerticalAlignment="Top" Margin="0,1,8,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Multi instance launching is off. Turn it on from the Deployment page!" />
      </StackPanel>
    </Border>
  </Grid>
</ui:UiPage>
