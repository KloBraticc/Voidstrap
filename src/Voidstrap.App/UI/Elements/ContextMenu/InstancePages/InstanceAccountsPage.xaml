<ui:UiPage x:Class="Voidstrap.UI.Elements.ContextMenu.InstancePages.InstanceAccountsPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
           xmlns:util="clr-namespace:Voidstrap.Utility"
           Title="Accounts"
           Loaded="UiPage_Loaded"
           Unloaded="UiPage_Unloaded">
  <Grid Margin="0,0,14,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="Accounts" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
      <TextBlock Margin="0,3,0,0" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Launching on an account signs Roblox in as that account first, so every instance can use a different one." />
    </StackPanel>

    <Border Grid.Row="1" CornerRadius="10" Background="#0A000000" BorderThickness="1" BorderBrush="#1FFFFFFF">
      <Grid>
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
          <Border Width="56" Height="56" CornerRadius="28" Background="#14FFFFFF" HorizontalAlignment="Center">
            <ui:SymbolIcon Symbol="Person28" FontSize="26" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Margin="0,14,0,5" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="No saved accounts" />
          <TextBlock HorizontalAlignment="Center" FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Add accounts in the account switcher and they will be ready to launch here." />
        </StackPanel>

        <ui:DynamicScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="AccountList" Margin="12">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="AccountRow" Margin="0,0,0,10" Padding="12" CornerRadius="10" Background="#0FFFFFFF" BorderThickness="1" BorderBrush="#1FFFFFFF">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                      <Ellipse Fill="#1FFFFFFF" />
                      <ui:SymbolIcon Symbol="Person28" FontSize="17" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Image Source="{Binding AvatarUrl, TargetNullValue={x:Null}}" util:DynamicRenderSystem.LinuxImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip>
                          <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20" />
                        </Image.Clip>
                      </Image>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                      <TextBlock Margin="0,2,0,0" Text="{Binding Subtitle}" FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" VerticalAlignment="Center" Content="Launch" Icon="Play24" Appearance="Secondary" Tag="{Binding}" Click="LaunchAccount_Click" />
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <Trigger SourceName="AccountRow" Property="IsMouseOver" Value="True">
                    <Setter TargetName="AccountRow" Property="Background" Value="#1AFFFFFF" />
                  </Trigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ui:DynamicScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Row="2" Margin="0,12,0,0" Padding="11,8" CornerRadius="8" Background="#0AFFFFFF" BorderThickness="1" BorderBrush="#1FFFFFFF">
      <StackPanel Orientation="Horizontal">
        <ui:SymbolIcon Symbol="Info24" FontSize="14" VerticalAlignment="Top" Margin="0,1,8,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Accounts are read from the account switcher." />
      </StackPanel>
    </Border>
  </Grid>
</ui:UiPage>
