<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.ContextMenu.BetterBloxDataCenterConsole" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:Voidstrap.UI.Elements.ContextMenu" xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:models="clr-namespace:Voidstrap.UI.ViewModels.ContextMenu" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:enums="clr-namespace:Voidstrap.Enums" Title="BetterBlox Datacenters" MinWidth="550" MinHeight="420" Width="850" Height="520" ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterScreen" Background="{ui:ThemeResource ApplicationBackgroundBrush}">
  <Grid>
    <Panel.Background>
      <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
        <GradientStop Offset="0.00" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        <GradientStop Offset="0.70" Color="{DynamicResource WindowBackgroundColorSecondary}" />
        <GradientStop Offset="1.1" Color="{DynamicResource WindowBackgroundColorThird}" />
      </LinearGradientBrush>
    </Panel.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar Name="RootTitleBar" Grid.Row="0" Padding="8" Title="BetterBlox Datacenters" ShowMinimize="True" ShowMaximize="False" CanMaximize="False" KeyboardNavigation.TabNavigation="None" Icon="pack://application:,,,/Voidstrap.png" />
    <TextBlock Grid.Row="1" Margin="16,8,16,0" Text="Displays all active Roblox datacenters from BetterBlox API." TextWrapping="Wrap" />
    <TextBlock Grid.Row="2" Margin="16,8,16,0" Foreground="#FFFF0000" TextWrapping="Wrap" Text="{Binding ErrorMessage, Mode=OneWay}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type TextBlock}">
          <Style.Triggers>
            <DataTrigger Value="{x:Static enums:GenericTriState.Failed}" Binding="{Binding LoadState, Mode=OneWay}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
          <Setter Property="Visibility" Value="Collapsed" />
        </Style>
      </FrameworkElement.Style>
    </TextBlock>
    <Border Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Border}">
          <Style.Triggers>
            <DataTrigger Value="{x:Static enums:GenericTriState.Unknown}" Binding="{Binding LoadState, Mode=OneWay}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
          <Setter Property="Visibility" Value="Collapsed" />
        </Style>
      </FrameworkElement.Style>
      <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" />
    </Border>
    <DataGrid Name="DatacentersDataGrid" Grid.Row="2" HeadersVisibility="Column" GridLinesVisibility="Horizontal" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" IsReadOnly="True" Margin="8" ItemsSource="{Binding DatacenterCollection}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource {x:Type DataGrid}}" TargetType="{x:Type DataGrid}">
          <Setter Property="Background" Value="#00FFFFFF" />
          <Setter Property="BorderThickness" Value="0" />
        </Style>
      </FrameworkElement.Style>
      <DataGrid.ColumnHeaderStyle>
        <Style TargetType="{x:Type DataGridColumnHeader}">
          <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
          <Setter Property="Height" Value="32" />
          <Setter Property="Padding" Value="8,0,8,0" />
          <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
          <Setter Property="BorderThickness" Value="1" />
        </Style>
      </DataGrid.ColumnHeaderStyle>
      <DataGrid.CellStyle>
        <Style TargetType="{x:Type DataGridCell}">
          <Setter Property="Height" Value="64" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type DataGridCell}">
                <Border Background="{TemplateBinding Control.Background}" Padding="6,4">
                  <ContentPresenter VerticalAlignment="Center" />
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </DataGrid.CellStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="ID" Width="Auto" Binding="{Binding Id}" />
        <DataGridTextColumn Header="Datacenter" Width="2*" Binding="{Binding Datacenter}" />
        <DataGridTextColumn Header="City" Width="*" Binding="{Binding City}" />
        <DataGridTextColumn Header="Region" Width="*" Binding="{Binding Region}" />
        <DataGridTextColumn Header="Country" Width="*" Binding="{Binding Country}" />
        <DataGridTextColumn Header="Organization" Width="2*" Binding="{Binding Organization}" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</base:WpfUiWindow>