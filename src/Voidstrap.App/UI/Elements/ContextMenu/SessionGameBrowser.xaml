<Window x:Class="Voidstrap.UI.Elements.Overlay.SessionGameBrowser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:Voidstrap.UI.Converters"
        Title="Games" Width="800" Height="560" MinWidth="460" MinHeight="340"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" FontFamily="Segoe UI">
  <Window.Resources>
    <converters:ContrastForegroundConverter x:Key="ContrastForeground" />
    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Tab" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Chip" CornerRadius="6" Padding="14,6" Background="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- A whole tile is one button: the art lifts a little and brightens on hover -->
    <Style x:Key="Tile" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Margin" Value="0,0,6,10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Padding="4" CornerRadius="10" Background="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Frame" Property="Opacity" Value="0.8" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="14,10,14,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border CornerRadius="8" Padding="3" Background="{DynamicResource ControlFillColorSecondaryBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="SearchTab" GroupName="Tabs" Style="{StaticResource Tab}" IsChecked="True" Checked="Tab_Checked">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
              <TextBlock Text="Search" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="FavoritesTab" GroupName="Tabs" Style="{StaticResource Tab}" Checked="Tab_Checked">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE734;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
              <TextBlock Text="Favorites" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </Border>
      <ui:TextBox x:Name="SearchBox" Grid.Column="1" Margin="10,0,0,0" VerticalContentAlignment="Center" FontSize="14"
                  PlaceholderText="Search experiences" ClearButtonEnabled="True" TextChanged="SearchBox_TextChanged" />
    </Grid>

    <TextBlock x:Name="SectionText" Grid.Row="1" Text="Continue" FontSize="16" FontWeight="SemiBold" Margin="2,14,0,10"
               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

    <Grid Grid.Row="2">
      <!-- Tiles share the width evenly, more columns as the panel gets wider, so there is never a gap on the right -->
      <ScrollViewer x:Name="TileScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="TileScroller_SizeChanged">
        <ItemsControl ItemsSource="{Binding Games}" Focusable="False" Margin="0,0,4,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" VerticalAlignment="Top" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource Tile}" Click="GameTile_Click" Tag="{Binding}" ToolTip="{Binding Name}">
                <StackPanel>
                  <!-- Square art: as tall as it is wide, rounded by the border itself -->
                  <Grid Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">
                    <Border CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                    <Border CornerRadius="8">
                      <Border.Background>
                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                      </Border.Background>
                    </Border>
                    <!-- On hover: the art dims a little and a play button appears in the accent colour -->
                    <Border CornerRadius="8" Background="#33000000" IsHitTestVisible="False">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Opacity" Value="0" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                              <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Border Width="46" Height="46" CornerRadius="23" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Background="{DynamicResource SystemAccentColorPrimaryBrush}">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Margin="3,0,0,0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource ContrastForeground}}" />
                      </Border>
                    </Border>
                    <!-- Favourite star: shows on hover, stays lit once the game is a favourite -->
                    <Button Width="32" Height="32" Margin="0,6,6,0" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand"
                            Focusable="False" Click="Favorite_Click" Tag="{Binding}" ToolTip="{Binding FavoriteTip}">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="Chip" CornerRadius="16" Background="#99000000">
                            <TextBlock Text="{Binding FavoriteGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Chip" Property="Background" Value="#CC000000" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                      <Button.Style>
                        <Style TargetType="Button">
                          <Setter Property="Opacity" Value="0" />
                          <Setter Property="Foreground" Value="White" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button, AncestorLevel=1}}" Value="True">
                              <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                              <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                              <Setter Property="Opacity" Value="1" />
                              <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                  </Grid>
                  <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="2,8,2,0" TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  <TextBlock Text="{Binding PlayingText}" FontSize="12" Margin="2,2,2,2" TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
        <ProgressBar x:Name="LoadingBar" Width="180" Height="4" IsIndeterminate="True" Visibility="Collapsed" />
        <TextBlock x:Name="StatusText" Margin="0,10,0,0" MaxWidth="400" TextAlignment="Center" TextWrapping="Wrap" FontSize="14"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
