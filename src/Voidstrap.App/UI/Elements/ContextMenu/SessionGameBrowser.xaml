<Window x:Class="Voidstrap.UI.Elements.Overlay.SessionGameBrowser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:resources="clr-namespace:Voidstrap.Resources"
        Title="{x:Static resources:Strings.ContextMenu_GameBrowser_Title}" Width="760" Height="570" MinWidth="460" MinHeight="340"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" FontFamily="Segoe UI">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="{x:Static resources:Strings.ContextMenu_GameBrowser_Title}" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,12" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
      <ui:Button Content="{x:Static resources:Strings.ContextMenu_GameBrowser_Continue}" Tag="continue" Appearance="Secondary" Click="ModeButton_Click" Margin="0,0,6,0" />
      <ui:Button Content="{x:Static resources:Strings.ContextMenu_GameBrowser_Favorites}" Tag="favorites" Appearance="Secondary" Click="ModeButton_Click" Margin="0,0,6,0" />
      <ui:Button Content="{x:Static resources:Strings.ContextMenu_GameBrowser_Search}" Tag="search" Appearance="Secondary" Click="ModeButton_Click" />
    </StackPanel>
    <TextBox x:Name="SearchBox" Grid.Row="2" Height="36" Padding="10,5" VerticalContentAlignment="Center" Margin="0,0,0,10"
             ToolTip="{x:Static resources:Strings.ContextMenu_GameBrowser_SearchPlaceholder}" TextChanged="SearchBox_TextChanged" Visibility="Collapsed" />
    <Grid Grid.Row="3">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Games}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Click="GameTile_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Padding="5" Margin="2" HorizontalContentAlignment="Stretch" ToolTip="{Binding Name}">
                <StackPanel>
                  <Border Width="148" Height="128" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ClipToBounds="True">
                      <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                      <Border Width="38" Height="38" CornerRadius="19" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.94">
                        <ui:SymbolIcon Symbol="Play24" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                  </Border>
                  <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Margin="2,7,2,0" TextWrapping="Wrap"
                             MaxHeight="36" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  <TextBlock Text="{Binding PlayingText}" FontSize="11" Margin="2,3,2,2" TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
        <ProgressBar x:Name="LoadingBar" Width="180" Height="4" IsIndeterminate="True" Visibility="Collapsed" />
        <TextBlock x:Name="StatusText" Margin="0,10,0,0" MaxWidth="400" TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </Grid>
    <TextBlock x:Name="CountText" Grid.Row="4" Margin="2,10,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
  </Grid>
</Window>
