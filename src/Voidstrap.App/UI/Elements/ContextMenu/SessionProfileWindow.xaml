<Window x:Class="Voidstrap.UI.Elements.Overlay.SessionProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Profile" Width="560" Height="560" MinWidth="440" MinHeight="380"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    </Style>
    <Style x:Key="StatNumber" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="StatLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Width" Value="110" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="RowValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
  </Window.Resources>

  <Grid>
    <ScrollViewer x:Name="ProfileContent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
      <StackPanel Margin="16,12,16,16">
        <!-- Header: the full avatar on a soft panel, names next to it -->
        <Border Style="{StaticResource Card}" Padding="16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="132" Height="132" CornerRadius="10" Background="{DynamicResource ControlFillColorSecondaryBrush}">
              <Border.Clip>
                <RectangleGeometry Rect="0,0,132,132" RadiusX="10" RadiusY="10" />
              </Border.Clip>
              <Image x:Name="AvatarImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="DisplayNameText" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="300"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="VerifiedGlyph" Text="&#xE930;" Style="{StaticResource Glyph}" FontSize="16" Margin="8,2,0,0" Visibility="Collapsed"
                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" ToolTip="Verified" />
              </StackPanel>
              <TextBlock x:Name="UsernameText" FontSize="14" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <TextBlock x:Name="PremiumText" Margin="0,8,0,0" FontSize="12" Visibility="Collapsed" Foreground="{DynamicResource AccentFillColorDefaultBrush}">
                <Run Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" /> <Run Text="Premium" />
              </TextBlock>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button Appearance="Primary" Focusable="False" Click="OpenProfile_Click">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                    <TextBlock Text="Open profile" FontSize="14" VerticalAlignment="Center" />
                  </StackPanel>
                </ui:Button>
                <ui:Button Margin="8,0,0,0" Appearance="Secondary" Focusable="False" Click="CopyLink_Click">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="CopyGlyph" Text="&#xE71B;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                    <TextBlock Text="Copy link" FontSize="14" VerticalAlignment="Center" />
                  </StackPanel>
                </ui:Button>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Counts -->
        <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="8,12">
          <UniformGrid Columns="4">
            <StackPanel>
              <TextBlock x:Name="FriendsText" Text="-" Style="{StaticResource StatNumber}" />
              <TextBlock Text="Friends" Style="{StaticResource StatLabel}" />
            </StackPanel>
            <StackPanel>
              <TextBlock x:Name="FollowersText" Text="-" Style="{StaticResource StatNumber}" />
              <TextBlock Text="Followers" Style="{StaticResource StatLabel}" />
            </StackPanel>
            <StackPanel>
              <TextBlock x:Name="FollowingText" Text="-" Style="{StaticResource StatNumber}" />
              <TextBlock Text="Following" Style="{StaticResource StatLabel}" />
            </StackPanel>
            <StackPanel>
              <TextBlock x:Name="RobuxText" Text="-" Style="{StaticResource StatNumber}" />
              <TextBlock Text="Robux" Style="{StaticResource StatLabel}" />
            </StackPanel>
          </UniformGrid>
        </Border>

        <!-- Details -->
        <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,10">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4">
              <TextBlock Text="User ID" Style="{StaticResource RowLabel}" />
              <TextBlock x:Name="UserIdText" Style="{StaticResource RowValue}" FontFamily="Cascadia Mono, Consolas" FontSize="13" />
              <ui:Button Margin="8,0,0,0" Padding="6,3" Appearance="Secondary" Focusable="False" ToolTip="Copy your user ID" Click="CopyId_Click">
                <TextBlock x:Name="CopyIdGlyph" Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="12" />
              </ui:Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4">
              <TextBlock Text="Joined" Style="{StaticResource RowLabel}" />
              <TextBlock x:Name="JoinedText" Style="{StaticResource RowValue}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4">
              <TextBlock Text="Playing" Style="{StaticResource RowLabel}" />
              <TextBlock x:Name="PlayingText" Style="{StaticResource RowValue}" MaxWidth="340" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- About -->
        <Border x:Name="AboutCard" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,12" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="About" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="AboutText" Margin="0,6,0,0" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel x:Name="Waiting" HorizontalAlignment="Center" VerticalAlignment="Center">
      <ProgressBar x:Name="LoadingBar" Width="180" Height="4" IsIndeterminate="True" />
      <TextBlock x:Name="StatusText" Margin="0,10,0,0" MaxWidth="380" TextAlignment="Center" TextWrapping="Wrap" FontSize="14"
                 Text="Loading your profile" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </StackPanel>
  </Grid>
</Window>
