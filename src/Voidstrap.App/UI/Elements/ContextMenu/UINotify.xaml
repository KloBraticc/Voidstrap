<Window x:Class="Voidstrap.UI.Elements.Overlay.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        AllowsTransparency="True" Background="Transparent" WindowStyle="None"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" Width="392" Height="146"
        SnapsToDevicePixels="True" UseLayoutRounding="True" FontFamily="Segoe UI">
  <Grid x:Name="NotificationRoot" Margin="6,6,6,8">
    <Grid.RenderTransform><TranslateTransform x:Name="RootTranslate" X="372" /></Grid.RenderTransform>
    <Border x:Name="NotificationBorder" CornerRadius="8" Padding="14,12,16,12" Opacity="0"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Image x:Name="NotificationImage" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center"
               Visibility="Collapsed" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="NotificationStatus" FontSize="12" Margin="0,0,14,1" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="NotificationTitle" FontSize="14" FontWeight="SemiBold" Margin="0,0,14,0"
                     TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <TextBlock x:Name="NotificationText" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                     TextTrimming="CharacterEllipsis" MaxHeight="64"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Rectangle x:Name="AccentStripe" Visibility="Collapsed" />
        <Grid x:Name="ProgressContainer" Height="2" Margin="0,0,0,-12" VerticalAlignment="Bottom" Visibility="Collapsed">
          <Rectangle x:Name="ProgressBar" RenderTransformOrigin="0,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="ProgressScale" ScaleX="0" /></Rectangle.RenderTransform></Rectangle>
        </Grid>
      </Grid>
    </Border>
    <!-- On its own layer above the card so nothing in the card's layout can cover or clip it -->
    <Border x:Name="DismissButton" Width="26" Height="26" Margin="0,6,6,0" CornerRadius="6" Panel.ZIndex="10"
            HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="Hand"
            Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" AutomationProperties.Name="Dismiss notification">
      <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
    </Border>
  </Grid>
</Window>
