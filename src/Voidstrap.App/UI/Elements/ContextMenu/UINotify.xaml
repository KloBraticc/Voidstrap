<Window x:Class="Voidstrap.UI.Elements.Overlay.NotificationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" AllowsTransparency="True" Background="#00FFFFFF" WindowStyle="None" Topmost="True" ShowInTaskbar="False" ShowActivated="False" Width="340" Height="88" SnapsToDevicePixels="True" UseLayoutRounding="True" xmlns:overlay="clr-namespace:Voidstrap.UI.Elements.Overlay;assembly=Voidstrap">
  <Grid Margin="6,6,6,8">
    <UIElement.RenderTransform>
      <TranslateTransform x:Name="RootTranslate" X="360" Y="0" />
    </UIElement.RenderTransform>
    <Border Name="NotificationBorder" CornerRadius="10" Padding="0" Opacity="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Border.Background>
        <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
          <GradientStop Offset="0.0" Color="{DynamicResource WindowBackgroundColorPrimary}" />
          <GradientStop Offset="0.7" Color="{DynamicResource WindowBackgroundColorSecondary}" />
          <GradientStop Offset="1.0" Color="{DynamicResource WindowBackgroundColorThird}" />
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="5" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Rectangle Name="AccentStripe" Grid.Column="0" RadiusX="2.5" RadiusY="2.5" Margin="0,8,0,8" HorizontalAlignment="Stretch" />
        <Grid Column="1" Margin="12,10,14,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image Name="NotificationImage" Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed" Stretch="Uniform" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Name="NotificationText" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="13" LineHeight="17" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42" />
            <Border Margin="0,8,0,0" CornerRadius="2" Height="3" Background="#22FFFFFF" ClipToBounds="True">
              <Grid Name="ProgressContainer" ClipToBounds="True">
                    <Rectangle Name="ProgressBar" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="3" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0,0.5">
                  <UIElement.RenderTransform>
                    <ScaleTransform x:Name="ProgressScale" ScaleX="0" ScaleY="1" />
                  </UIElement.RenderTransform>
                </Rectangle>
              </Grid>
            </Border>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
