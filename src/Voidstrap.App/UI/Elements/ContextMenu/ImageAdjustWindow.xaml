<ui:UiWindow x:Class="Voidstrap.UI.Elements.ContextMenu.ImageAdjustWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Image Adjust" Height="500" Width="700" WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" xmlns:contextmenu="clr-namespace:Voidstrap.UI.Elements.ContextMenu;assembly=Voidstrap">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="250" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Margin="0,0,20,0" Background="#11000000" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Image Name="PreviewImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality" />
        </ScrollViewer>
      </Border>
      <StackPanel Grid.Column="1">
        <TextBlock Text="Image Adjustments" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" />
        <TextBlock Text="Orientation" Margin="0,0,0,5" />
        <WrapPanel Margin="0,0,0,15">
          <ui:Button Content="Rotate 90" Margin="0,0,5,5" Click="Rotate_Click" />
          <ui:Button Content="Flip H" Margin="0,0,5,5" Click="FlipH_Click" />
          <ui:Button Content="Flip V" Margin="0,0,5,5" Click="FlipV_Click" />
        </WrapPanel>
        <TextBlock Text="Scale (Resize)" Margin="0,0,0,5" />
        <Grid Margin="0,0,0,15">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ui:TextBox Name="WidthInput" PlaceholderText="W" />
          <TextBlock Grid.Column="1" Text="x" VerticalAlignment="Center" Margin="5,0" />
          <ui:TextBox Name="HeightInput" Grid.Column="2" PlaceholderText="H" />
        </Grid>
        <ui:Button Content="Apply Resize" Margin="0,0,0,15" Click="ApplyResize_Click" />
        <ui:Button Content="Reset Adjustments" Icon="ArrowCounterclockwise24" HorizontalAlignment="Stretch" Margin="0,0,0,10" Click="Reset_Click" />
        <TextBlock Text="Tip: Use these to fix orientation or resize assets to fit perfectly." Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Bottom" />
      </StackPanel>
    </Grid>
    <Grid Row="1" Margin="0,20,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <ui:Button Content="Cancel" Margin="0,0,10,0" Click="Cancel_Click" />
        <ui:Button Content="Save as Mod" Appearance="Primary" Click="Save_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</ui:UiWindow>