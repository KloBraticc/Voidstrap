<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.ContextMenu.ServerHistory" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:Voidstrap.UI.Elements.ContextMenu" xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:models="clr-namespace:Voidstrap.UI.ViewModels.ContextMenu" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:enums="clr-namespace:Voidstrap.Enums" xmlns:util="clr-namespace:Voidstrap.Utility" xmlns:appUi="clr-namespace:Voidstrap.UI" Title="{x:Static resources:Strings.ContextMenu_GameHistory_Title}" MinWidth="600" MinHeight="500" Width="800" Height="600" ExtendsContentIntoTitleBar="True" ShowInTaskbar="False" WindowStartupLocation="CenterScreen" Background="{ui:ThemeResource ApplicationBackgroundBrush}">
  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CloseWindowCommand}" />
  </Window.InputBindings>
  <Grid>
    <Panel.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        <GradientStop Offset="0.5" Color="{DynamicResource WindowBackgroundColorSecondary}" />
        <GradientStop Offset="1.0" Color="{DynamicResource WindowBackgroundColorThird}" />
      </LinearGradientBrush>
    </Panel.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar x:Name="RootTitleBar" Grid.Row="0" Padding="8" Title="{x:Static resources:Strings.ContextMenu_GameHistory_Title}" Icon="pack://application:,,,/Voidstrap.png" ForceShutdown="False" MinimizeToTray="False" UseSnapLayout="True" />
    <TextBlock Grid.Row="1" Margin="20,8,20,4" FontSize="15" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{x:Static resources:Strings.ContextMenu_GameHistory_Description}" TextWrapping="Wrap" />
    <Grid Grid.Row="2" Margin="20,8,20,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Sort:" />
      <ComboBox Grid.Column="1" Margin="8,0,20,0" Padding="8,4,8,4" FontSize="13"
                ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                DisplayMemberPath="Display" />
      <TextBlock Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Filter:" />
      <ComboBox Grid.Column="4" Padding="8,4,8,4" FontSize="13"
                ItemsSource="{Binding ServerTypeFilters}" SelectedItem="{Binding SelectedServerTypeFilter, Mode=TwoWay}"
                DisplayMemberPath="Display" />
    </Grid>
    <TextBlock Grid.Row="3" Margin="20,8" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding Error}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type TextBlock}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Value="{x:Static enums:GenericTriState.Failed}" Binding="{Binding LoadState}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </TextBlock>
    <ui:ProgressRing Grid.Row="3" Margin="0,20" HorizontalAlignment="Center" VerticalAlignment="Top" IsIndeterminate="True" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type ui:ProgressRing}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Value="{x:Static enums:GenericTriState.Unknown}" Binding="{Binding LoadState}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </ui:ProgressRing>
    <TextBlock Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding EmptyText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding LoadState}" Value="{x:Static enums:GenericTriState.Successful}" />
                <Condition Binding="{Binding FilteredGameHistory.Count}" Value="0" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
    <ui:Button Grid.Row="4" Margin="20,0,20,16" HorizontalAlignment="Right" Content="{x:Static resources:Strings.Common_Close}" Command="{Binding CloseWindowCommand}" />
    <ListView Grid.Row="3" Margin="12" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ItemsSource="{Binding FilteredGameHistory}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type ListView}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Value="{x:Static enums:GenericTriState.Successful}" Binding="{Binding LoadState}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <ItemsControl.ItemContainerStyle>
        <Style TargetType="{x:Type ListViewItem}">
          <Setter Property="Margin" Value="0,4" />
          <Setter Property="Focusable" Value="False" />
          <Setter Property="Background" Value="#00FFFFFF" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ListViewItem}">
                <Border Background="{TemplateBinding Control.Background}" CornerRadius="6" Padding="4" SnapsToDevicePixels="True">
                  <ContentPresenter HorizontalAlignment="Stretch" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter Value="{DynamicResource SubtleFillColorSecondaryBrush}" Property="Background" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ItemsControl.ItemContainerStyle>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <ui:Card Margin="4" Padding="10" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundBrush}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Width="90" Height="90" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="4" ClipToBounds="True">
                <Border.Background>
                  <ImageBrush Stretch="UniformToFill" ImageSource="{Binding UniverseDetails.Thumbnail.ImageUrl, Converter={StaticResource WindowsOnlyImageSourceConverter}, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
                </Border.Background>
                <Image util:DynamicRenderSystem.LinuxImageSource="{Binding UniverseDetails.Thumbnail.ImageUrl}" Stretch="UniformToFill" Visibility="{x:Static appUi:PlatformFeatureVisibility.LinuxIntegration}" />
              </Border>
              <StackPanel Grid.Column="1" Margin="16,8,8,8" VerticalAlignment="Center">
                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding GameName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,4,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding GameHistoryDescription}" TextTrimming="CharacterEllipsis" />
                <UniformGrid Columns="2" Rows="1" Margin="0,0,0,8">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Joined: " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding DisplayTimeJoined}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Left: " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding DisplayTimeLeft}" />
                  </StackPanel>

                </UniformGrid>
                <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ServerStatus}" ToolTip="{Binding ServerStatusCheckedAt}" />
                <StackPanel Orientation="Horizontal">
                  <ui:Button Content="{x:Static resources:Strings.ContextMenu_GameHistory_Rejoin}" Appearance="Primary" Icon="Play28" Command="{Binding DataContext.LaunchDeeplinkCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                  <ui:Button Margin="8,0,0,0" Content="{Binding DataContext.CopyLinkText, RelativeSource={RelativeSource AncestorType=Window}}" Appearance="Secondary" Command="{Binding DataContext.CopyDeeplinkCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </ui:Card>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ListView>
  </Grid>
</base:WpfUiWindow>
