<base:WpfUiWindow
    x:Class="Voidstrap.UI.Elements.RiShade.RiShadeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="RiShade"
    Width="880"
    Height="680"
    MinWidth="700"
    MinHeight="480"
    Topmost="True"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="Manual">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="RiShade"
            Padding="8"
            Icon="pack://application:,,,/Voidstrap.png"
            MinimizeToTray="False"
            ShowMaximize="False" />

        <Border Grid.Row="1" Margin="14,2,14,10" Padding="12,10" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Preset" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding BuiltinPresets, Mode=OneTime}" SelectedItem="{Binding SelectedBuiltinPreset, Mode=TwoWay}" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="My presets" VerticalAlignment="Center" Margin="14,0,10,0" FontWeight="SemiBold" />
                <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding CustomPresets}" SelectedItem="{Binding SelectedCustomPreset, Mode=TwoWay}" />
                <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="14,0,0,0">
                        <ui:Button Icon="ArrowDownload24" Content="Import" Command="{Binding ImportPresetCommand}" />
                        <ui:Button Icon="ArrowUpload24" Content="Export" Margin="6,0,0,0" Command="{Binding ExportPresetCommand}" />
                        <ui:Button Icon="Document24" Content="ReShade ini" Margin="6,0,0,0" Command="{Binding ImportReShadeCommand}" />
                        <ui:Button Icon="Delete24" Content="Delete" Appearance="Danger" Margin="6,0,0,0" Command="{Binding DeletePresetCommand}" />
                    </StackPanel>
                    <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Icon="Save24" Content="Save" Command="{Binding SavePresetCommand}" />
                    <ui:TextBox PlaceholderText="Save current look as" Text="{Binding PresetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="14,0,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                <ListBox x:Name="GroupList" Margin="4" Background="Transparent" BorderThickness="0" SelectionChanged="GroupList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Margin="2,1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,12,16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="GroupTitle" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock x:Name="GroupHint" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:Button x:Name="GroupReset" Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center" Appearance="Secondary" Icon="ArrowReset24" Content="Reset" Click="GroupReset_Click" />
                        <ui:ToggleSwitch x:Name="GroupToggle" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>
                    <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource ControlElevationBorderBrush}" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,10,16,12">
                        <ContentControl x:Name="GroupHost" HorizontalContentAlignment="Stretch" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Padding="16,8" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="F8 opens and closes this window in game" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                <ui:Button HorizontalAlignment="Left" Padding="8,3" FontSize="12" Appearance="Secondary" Content="Turn everything off" Click="ResetAll_Click" />
            </DockPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
