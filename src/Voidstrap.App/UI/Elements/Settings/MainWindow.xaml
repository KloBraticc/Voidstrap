<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.Settings.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dmodels="clr-namespace:Voidstrap.UI.ViewModels.Settings" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:pages="clr-namespace:Voidstrap.UI.Elements.Settings.Pages" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:vscontrols="clr-namespace:Voidstrap.UI.Elements.Controls" xmlns:media="clr-namespace:System.Windows.Media.Animation;assembly=PresentationCore" xmlns:appUi="clr-namespace:Voidstrap.UI" Closed="WpfUiWindow_Closed" Closing="WpfUiWindow_Closing" Loaded="MainWindow_Loaded" PreviewMouseWheel="OnZoomWheel" Title="{x:Static resources:Strings.Menu_Title}" Width="1071" Height="690" MinWidth="850" MinHeight="550" AllowsTransparency="False" Background="#00FFFFFF" ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True" mc:Ignorable="d" xmlns:settings="clr-namespace:Voidstrap.UI.Elements.Settings">
    
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <BitmapImage x:Key="AppIconImage" UriSource="pack://application:,,,/Voidstrap.png" />
      <SolidColorBrush x:Key="LauncherMenuBrush" Color="#FF1C1C1E" />
      <SolidColorBrush x:Key="LauncherMenuHoverBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="LauncherMenuBorderBrush" Color="#1AFFFFFF" />
      <SolidColorBrush x:Key="LauncherDividerBrush" Color="#12FFFFFF" />
      <SolidColorBrush x:Key="LauncherControlBrush" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="LauncherControlHoverBrush" Color="#1AFFFFFF" />
      <SolidColorBrush x:Key="LauncherControlPressedBrush" Color="#10FFFFFF" />
      <SolidColorBrush x:Key="LauncherTextPrimaryBrush" Color="#FFEDEDED" />
      <SolidColorBrush x:Key="LauncherTextSecondaryBrush" Color="#FFB4B4B4" />
      <SolidColorBrush x:Key="LauncherTextTertiaryBrush" Color="#FF7C7C7C" />
      <Style x:Key="TopBarButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#0FFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Foreground" Value="{StaticResource LauncherTextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="ButtonBackground" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ButtonBackground" Property="Background" Value="{StaticResource LauncherControlHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="ButtonBackground" Property="Background" Value="{StaticResource LauncherControlPressedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TopBarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource TopBarButtonStyle}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#FFCACACA" />
      </Style>
      <Style x:Key="TopBarPillButtonStyle" TargetType="Button" BasedOn="{StaticResource TopBarButtonStyle}">
        <Setter Property="Padding" Value="10,0" />
      </Style>
      <Style x:Key="TopBarPopupButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Appearance" Value="Transparent" />
      </Style>
      <Style x:Key="TopSearchTextBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource LauncherTextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource LauncherTextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SystemAccentBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TopNavButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource LauncherTextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                <StackPanel>
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Rectangle x:Name="TabUnderline" Height="2" Margin="0,3,0,0" RadiusX="1" RadiusY="1" HorizontalAlignment="Stretch" Opacity="0" RenderTransformOrigin="0.5,0.5" Fill="{DynamicResource SystemAccentBrush}">
                    <Rectangle.RenderTransform>
                      <ScaleTransform ScaleX="0" />
                    </Rectangle.RenderTransform>
                  </Rectangle>
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="Tag" Value="Active">
                  <Trigger.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="TabUnderline" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                        <DoubleAnimation Storyboard.TargetName="TabUnderline" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.22">
                          <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.EnterActions>
                  <Trigger.ExitActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="TabUnderline" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                        <DoubleAnimation Storyboard.TargetName="TabUnderline" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0" Duration="0:0:0.12" />
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.ExitActions>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Foreground" Value="{StaticResource LauncherTextPrimaryBrush}" />
          </Trigger>
          <Trigger Property="Tag" Value="Active">
            <Setter Property="Foreground" Value="{StaticResource LauncherTextPrimaryBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="TopBarMenuSeparatorStyle" TargetType="{x:Type Separator}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Separator}">
              <Border Height="1" Margin="4,5" Background="{StaticResource LauncherDividerBrush}" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TopBarMenuItemStyle" TargetType="{x:Type MenuItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource LauncherTextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type MenuItem}">
              <Grid>
                <Border x:Name="MenuChrome" Background="Transparent" CornerRadius="6" Height="34" Padding="10,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="MenuIcon" ContentSource="Icon" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    <ui:SymbolIcon x:Name="MenuArrow" Grid.Column="2" Symbol="ChevronRight24" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource LauncherTextTertiaryBrush}" Visibility="Collapsed" />
                  </Grid>
                </Border>
                <vscontrols:AnimatedPopup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-6" VerticalOffset="-18" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsSubmenuOpen}">
                  <Border Margin="12" MinWidth="200" Background="{DynamicResource LauncherMenuBrush}" BorderBrush="{StaticResource LauncherMenuBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="6">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                  </Border>
                </vscontrols:AnimatedPopup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="Icon" Value="{x:Null}">
                  <Setter TargetName="MenuIcon" Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                  <Setter TargetName="MenuArrow" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="MenuChrome" Property="Background" Value="{StaticResource LauncherMenuHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                  <Setter TargetName="MenuChrome" Property="Background" Value="{StaticResource LauncherMenuHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TopNavArrowStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,4" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            <Setter Property="Cursor" Value="Arrow" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <media:CubicEase x:Key="SmoothEaseOut" EasingMode="EaseOut" />
      <media:QuinticEase x:Key="UltraSmoothEaseOut" EasingMode="EaseOut" />
      <Storyboard x:Key="IntroStoryboard">
        <media:DoubleAnimation Storyboard.TargetName="IntroContent" Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.25" EasingFunction="{StaticResource SmoothEaseOut}" />
        <media:DoubleAnimation Storyboard.TargetName="IntroOverlay" Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" BeginTime="0:0:0.45" Duration="0:0:0.3" EasingFunction="{StaticResource SmoothEaseOut}" />
      </Storyboard>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Name="BackgroundLayer" RowSpan="3" ZIndex="-10" ClipToBounds="True">
      <Image Name="BackgroundImage" Stretch="UniformToFill" Opacity="1" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" Visibility="Visible" />
      <Border Name="BackgroundBlackOverlay" Background="#FF000000" Opacity="0" IsHitTestVisible="False" />
      <Border Name="GradientLayer" IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush x:Name="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <Brush.RelativeTransform>
              <TransformGroup x:Name="BackgroundGradientTransform">
                <RotateTransform x:Name="BackgroundGradientRotate" CenterX="0.5" CenterY="0.5" />
                <TranslateTransform x:Name="BackgroundGradientTranslate" />
              </TransformGroup>
            </Brush.RelativeTransform>
            <GradientStop Offset="0.0" Color="{DynamicResource WindowBackgroundColorPrimary}" />
            <GradientStop Offset="0.35" Color="{DynamicResource WindowBackgroundColorSecondary}" />
            <GradientStop Offset="0.75" Color="{DynamicResource WindowBackgroundColorThird}" />
            <GradientStop Offset="1.0" Color="{DynamicResource WindowBackgroundColorPrimary}" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
    </Grid>
    <settings:SmoothSnowLayer x:Name="SnowCanvas" Grid.RowSpan="3" IsHitTestVisible="False" Panel.ZIndex="0" Visibility="Collapsed" />
    <Grid Name="IntroOverlay" RowSpan="3" ZIndex="999" Opacity="1" Background="#FF0C0C0C" d:Visibility="Collapsed">
      <Border>
        <Border.Background>
          <SolidColorBrush Color="{DynamicResource WindowBackgroundColorPrimary}" />
        </Border.Background>
      </Border>
      <Image Name="IntroContent" Width="120" Height="120" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{StaticResource AppIconImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
        <Image.Effect>
          <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Color="#FF000000" Opacity="0.8" />
        </Image.Effect>
      </Image>
    </Grid>
    <Border Name="RestartNotificationCard" Grid.RowSpan="3" Width="390" MinHeight="116" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,72" Padding="14" Panel.ZIndex="1200" Visibility="Collapsed" Opacity="0" CornerRadius="7" Background="{DynamicResource SystemFillColorSolidNeutralBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000" />
      </Border.Effect>
      <Border.RenderTransform>
        <TranslateTransform x:Name="RestartNotificationTranslate" X="28" />
      </Border.RenderTransform>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:SymbolIcon Grid.Column="0" Grid.RowSpan="2" Margin="0,1,12,0" VerticalAlignment="Top" FontSize="22" Symbol="ArrowClockwise24" />
        <TextBlock Name="RestartNotificationTitle" Grid.Column="1" FontSize="14" FontWeight="SemiBold" Text="Settings changed" TextWrapping="Wrap" />
        <ui:Button Name="RestartNotificationDismiss" Grid.Column="2" Width="30" Height="30" Margin="10,-5,-5,0" Padding="0" Appearance="Transparent" Icon="Dismiss24" ToolTip="Dismiss" Click="RestartNotificationDismiss_Click" />
        <TextBlock Name="RestartNotificationMessage" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Restart Voidstrap to apply this change." TextWrapping="Wrap" />
        <ui:Button Name="RestartNotificationAction" Grid.Column="1" Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Left" Appearance="Primary" Background="{DynamicResource SystemAccentBrush}" Content="Restart now" Click="RestartNotificationAction_Click" />
      </Grid>
    </Border>
    <vscontrols:DownloadNotificationCard x:Name="DownloadCard" Grid.RowSpan="3" Margin="0,0,24,72" Panel.ZIndex="1190" />
    <ui:Snackbar Name="AlreadyRunningSnackbar" Title="{x:Static resources:Strings.Menu_AlreadyRunning_Title}" Grid.RowSpan="10" Margin="200,0,200,20" Panel.ZIndex="10" Icon="Info20" Message="{x:Static resources:Strings.Menu_AlreadyRunning_Caption}" Timeout="10000">
      <Control.Background>
        <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
          <GradientStop Offset="0.00" Color="{DynamicResource WindowBackgroundColorPrimary}" />
          <GradientStop Offset="0.70" Color="{DynamicResource WindowBackgroundColorSecondary}" />
          <GradientStop Offset="1.00" Color="{DynamicResource WindowBackgroundColorThird}" />
        </LinearGradientBrush>
      </Control.Background>
    </ui:Snackbar>
    <ui:Snackbar Name="SettingsSavedSnackbar" Title="{x:Static resources:Strings.Menu_SettingsSaved_Title}" Grid.RowSpan="10" Margin="200,0,200,20" Panel.ZIndex="9" Icon="CheckboxChecked24" Message="{x:Static resources:Strings.Menu_SettingsSaved_Message}" Timeout="2100">
      <Control.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Offset="0.0" Color="{DynamicResource WindowBackgroundColorPrimary}" />
          <GradientStop Offset="0.35" Color="{DynamicResource WindowBackgroundColorSecondary}" />
          <GradientStop Offset="0.75" Color="{DynamicResource WindowBackgroundColorThird}" />
          <GradientStop Offset="1.0" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        </LinearGradientBrush>
      </Control.Background>
    </ui:Snackbar>
    <ui:Snackbar Name="SettingsSavedLaunchSnackbar" Title="Voidstrap Saved And Launched Roblox!" Grid.RowSpan="10" Margin="150,0,150,20" Panel.ZIndex="10" Icon="CheckboxChecked24" Message="Changes have been saved." Timeout="2000">
      <Control.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Offset="0.0" Color="{DynamicResource WindowBackgroundColorPrimary}" />
          <GradientStop Offset="0.35" Color="{DynamicResource WindowBackgroundColorSecondary}" />
          <GradientStop Offset="0.75" Color="{DynamicResource WindowBackgroundColorThird}" />
          <GradientStop Offset="1.0" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        </LinearGradientBrush>
      </Control.Background>
    </ui:Snackbar>
    <ui:Snackbar Name="SettingFailureSnackbar" Title="Setting not changed" Grid.RowSpan="10" Margin="180,0,180,20" Panel.ZIndex="11" Icon="ErrorCircle24" Timeout="5000" />
    <ui:TitleBar Name="RootTitleBar" Padding="8" Grid.Row="0" Panel.ZIndex="1000" ForceShutdown="False" MinimizeToTray="False" UseSnapLayout="True">
      <ui:TitleBar.Header>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" FlowDirection="LeftToRight" Margin="0,6,0,-6">
          <Grid Margin="0,0,2,0">
            <Button x:Name="TopSearchButton" Style="{StaticResource TopBarIconButtonStyle}" Click="TopSearchButton_Click">
              <Button.ToolTip>
                <StackPanel>
                  <TextBlock Text="Search" />
                  <TextBlock Text="Ctrl K" FontSize="11" Foreground="{StaticResource LauncherTextTertiaryBrush}" />
                </StackPanel>
              </Button.ToolTip>
              <ui:SymbolIcon Symbol="Search24" FontSize="16" />
            </Button>
            <vscontrols:AnimatedPopup x:Name="CommandPalettePopup" PlacementTarget="{Binding ElementName=TopSearchButton}" Placement="Bottom" LightDismiss="True" AllowsTransparency="True" HorizontalOffset="-362" VerticalOffset="-4" Opened="CommandPalettePopup_Opened">
              <Border Margin="12" Width="380" Padding="6" CornerRadius="10" Background="{DynamicResource LauncherMenuBrush}" BorderBrush="{StaticResource LauncherMenuBorderBrush}" BorderThickness="1" TextElement.Foreground="{StaticResource LauncherTextPrimaryBrush}">
