            </Button>
            <vscontrols:AnimatedPopup x:Name="NotificationPopup" PlacementTarget="{Binding ElementName=NotificationsButton}" Placement="Bottom" HorizontalOffset="-364" VerticalOffset="-4" LightDismiss="True" AllowsTransparency="True" Closed="NotificationPopup_Closed">
              <Border Margin="14" Width="380" Background="{DynamicResource LauncherMenuBrush}" BorderBrush="{StaticResource LauncherMenuBorderBrush}" BorderThickness="1" CornerRadius="12" TextElement.Foreground="{StaticResource LauncherTextPrimaryBrush}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Grid Margin="18,14,12,8">
                    <TextBlock Text="Notifications" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <ui:Button x:Name="NotificationMarkAllButton" Width="32" Height="32" Padding="0" Appearance="Transparent" Icon="CheckboxChecked24" ToolTip="Mark all as read" Click="NotificationMarkAll_Click" />
                      <ui:Button x:Name="NotificationClearButton" Width="32" Height="32" Margin="2,0,0,0" Padding="0" Appearance="Transparent" Icon="Delete24" ToolTip="Clear all" Click="NotificationClear_Click" />
