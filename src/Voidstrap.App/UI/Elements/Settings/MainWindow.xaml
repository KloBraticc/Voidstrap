                  <Border Height="34" CornerRadius="6" Background="#26000000" BorderBrush="#0FFFFFFF" BorderThickness="1">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <ui:SymbolIcon Symbol="Search24" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource LauncherTextTertiaryBrush}" />
                      <TextBlock x:Name="CommandPalettePlaceholder" Grid.Column="1" Margin="10,0" VerticalAlignment="Center" FontSize="13.5" Text="Search Voidstrap" Foreground="{StaticResource LauncherTextTertiaryBrush}" IsHitTestVisible="False" />
                      <TextBox x:Name="CommandPaletteSearchBox" Grid.Column="1" Margin="8,0,10,0" Style="{StaticResource TopSearchTextBoxStyle}" TextChanged="CommandPaletteSearchBox_TextChanged" PreviewKeyDown="CommandPaletteSearchBox_PreviewKeyDown" />
                    </Grid>
                  </Border>
                  <Grid x:Name="CommandPaletteResultsArea" Margin="0,6,0,0" Visibility="Collapsed">
                    <ScrollViewer x:Name="CommandPaletteResultsScroll" MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl x:Name="CommandPaletteResultsList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border x:Name="PaletteRow" Height="34" Padding="10,0" CornerRadius="6" Background="Transparent" Cursor="Hand" MouseEnter="CommandPaletteRow_MouseEnter" MouseLeftButtonUp="CommandPaletteRow_MouseLeftButtonUp">
                              <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource LauncherTextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Margin="10,0" VerticalAlignment="Center" FontSize="13.5" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" MaxWidth="140" VerticalAlignment="Center" FontSize="12" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource LauncherTextTertiaryBrush}" />
                              </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="PaletteRow" Property="Background" Value="{StaticResource LauncherMenuHoverBrush}" />
                              </DataTrigger>
                            </DataTemplate.Triggers>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="CommandPaletteEmpty" Margin="10,8" FontSize="13" Text="No results" Foreground="{StaticResource LauncherTextTertiaryBrush}" Visibility="Collapsed" />
                  </Grid>
                </StackPanel>
              </Border>
            </vscontrols:AnimatedPopup>
          </Grid>
          <Grid Margin="2,0,4,0">
            <Button x:Name="NotificationsButton" Style="{StaticResource TopBarIconButtonStyle}" ToolTip="Notifications" Click="NotificationsButton_Click">
