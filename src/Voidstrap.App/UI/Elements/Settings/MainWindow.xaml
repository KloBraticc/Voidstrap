    <Grid Name="RootGrid" Row="1" Margin="8,12,0,0" MouseMove="RootGrid_MouseMove" MouseLeave="RootGrid_MouseLeave">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ui:Button Name="SidebarToggle" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Width="40" Height="36" Margin="8,0,0,6" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="70" Style="{StaticResource HamburgerButton}" ToolTip="Collapse or expand the sidebar" Click="SidebarToggle_Click" />
      <Grid Name="SidebarHost" Row="1" Column="0" Margin="0,0,5,0" Panel.ZIndex="60">
        <ui:NavigationFluent Name="RootNavigation" ClipToBounds="True" Width="225" SelectedPageIndex="1" TransitionType="FadeInWithSlideLeft" TransitionDuration="150" Frame="{Binding ElementName=RootFrame}">
          <ui:NavigationFluent.Resources>
            <Style TargetType="{x:Type ui:NavigationItem}">
              <Setter Property="Cache" Value="False" />
              <Setter Property="ui:RinControlMotion.Enabled" Value="True" />
              <Setter Property="Margin" Value="0,0,0,4" />
              <Setter Property="Cursor" Value="Arrow" />
              <Setter Property="FontSize" Value="14" />
              <Setter Property="IconSize" Value="18" />
              <Setter Property="VerticalAlignment" Value="Center" />
              <Setter Property="HorizontalContentAlignment" Value="Left" />
              <Setter Property="Background">
                <Setter.Value>
                  <SolidColorBrush Color="{DynamicResource SubtleFillColorSecondary}" />
                </Setter.Value>
              </Setter>
              <Setter Property="Foreground">
                <Setter.Value>
                  <SolidColorBrush Color="{DynamicResource TextFillColorPrimary}" />
                </Setter.Value>
              </Setter>
              <Setter Property="IconForeground">
                <Setter.Value>
                  <SolidColorBrush Color="{DynamicResource TextFillColorPrimary}" />
                </Setter.Value>
              </Setter>
              <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentBrush}" />
              <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
              <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
              <Setter Property="Focusable" Value="True" />
              <Setter Property="SnapsToDevicePixels" Value="True" />
              <Setter Property="OverridesDefaultStyle" Value="True" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ui:NavigationItem}">
                    <Border x:Name="MainBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="1" CornerRadius="5">
                      <Grid>
                        <Rectangle x:Name="ActiveRectangle" Width="3" Height="0" Margin="-1,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0.0" RadiusX="1.5" RadiusY="1.5">
                          <Rectangle.Fill>
                            <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                          </Rectangle.Fill>
                        </Rectangle>
                        <Grid x:Name="InnerGrid" Margin="16,8" HorizontalAlignment="Left">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <ui:SymbolIcon x:Name="ItemIcon" Grid.Column="0" Width="18" Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center" Filled="{TemplateBinding IconFilled}" FontSize="{TemplateBinding IconSize}" Foreground="{TemplateBinding IconForeground}" Symbol="{TemplateBinding Icon}" />
                          <Image x:Name="ItemImage" Grid.Column="0" Width="18" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" Source="{TemplateBinding Image}" />
                          <ContentPresenter x:Name="Label" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ui:SymbolIcon x:Name="GroupChevron" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" Symbol="ChevronDown20" Filled="True" FontSize="14" Opacity="0.7" Foreground="{TemplateBinding IconForeground}" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                          <ui:SymbolIcon.RenderTransform>
                            <RotateTransform Angle="0" />
                          </ui:SymbolIcon.RenderTransform>
                        </ui:SymbolIcon>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsActive" Value="False">
                        <Setter TargetName="MainBorder" Property="Background">
                          <Setter.Value>
                            <SolidColorBrush Opacity="0" />
                          </Setter.Value>
                        </Setter>
                      </Trigger>
                      <Trigger Property="IsActive" Value="True">
                        <Setter TargetName="ActiveRectangle" Property="Height" Value="17" />
                        <Setter TargetName="ActiveRectangle" Property="Opacity" Value="1" />
                        <Trigger.EnterActions>
                          <BeginStoryboard x:Name="PillSelected">
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="ActiveRectangle" Storyboard.TargetProperty="(Rectangle.Opacity)" From="0.0" To="1.0" Duration="00:00:00.25">
                                <DoubleAnimation.EasingFunction>
                                  <QuadraticEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                              <DoubleAnimation Storyboard.TargetName="ActiveRectangle" Storyboard.TargetProperty="(Rectangle.Height)" From="0" To="17" Duration="00:00:00.667">
                                <DoubleAnimation.EasingFunction>
                                  <QuinticEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                            </Storyboard>
                          </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                          <RemoveStoryboard BeginStoryboardName="PillSelected" />
                        </Trigger.ExitActions>
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="vscontrols:SidebarGroup.HasActiveChild" Value="True" />
                          <Condition Property="vscontrols:SidebarGroup.IsExpanded" Value="False" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="ActiveRectangle" Property="Height" Value="17" />
                        <Setter TargetName="ActiveRectangle" Property="Opacity" Value="1" />
                        <Setter TargetName="MainBorder" Property="Background">
                          <Setter.Value>
                            <SolidColorBrush Color="{DynamicResource SubtleFillColorSecondary}" />
                          </Setter.Value>
                        </Setter>
                        <MultiTrigger.EnterActions>
                          <BeginStoryboard x:Name="PillParent">
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="ActiveRectangle" Storyboard.TargetProperty="(Rectangle.Opacity)" From="0.0" To="1.0" Duration="00:00:00.25">
                                <DoubleAnimation.EasingFunction>
                                  <QuadraticEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                              <DoubleAnimation Storyboard.TargetName="ActiveRectangle" Storyboard.TargetProperty="(Rectangle.Height)" From="0" To="17" Duration="00:00:00.667">
                                <DoubleAnimation.EasingFunction>
                                  <QuinticEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                            </Storyboard>
                          </BeginStoryboard>
                        </MultiTrigger.EnterActions>
                        <MultiTrigger.ExitActions>
                          <RemoveStoryboard BeginStoryboardName="PillParent" />
                        </MultiTrigger.ExitActions>
                      </MultiTrigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsMouseOver" Value="True" />
                          <Condition Property="IsEnabled" Value="True" />
                          <Condition Property="vscontrols:SidebarGroup.IsChild" Value="False" />
                        </MultiTrigger.Conditions>
                        <MultiTrigger.EnterActions>
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="Opacity" To="0.875" Duration="00:00:00.187">
                                <DoubleAnimation.EasingFunction>
                                  <QuarticEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                            </Storyboard>
                          </BeginStoryboard>
                        </MultiTrigger.EnterActions>
                        <MultiTrigger.ExitActions>
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="Opacity" Duration="00:00:00.187">
                                <DoubleAnimation.EasingFunction>
                                  <QuarticEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                            </Storyboard>
                          </BeginStoryboard>
                        </MultiTrigger.ExitActions>
                      </MultiTrigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsPressed" Value="True" />
                          <Condition Property="IsEnabled" Value="True" />
                          <Condition Property="vscontrols:SidebarGroup.IsChild" Value="False" />
                        </MultiTrigger.Conditions>
                        <MultiTrigger.EnterActions>
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="Opacity" To="0.65" Duration="00:00:00.187">
                                <DoubleAnimation.EasingFunction>
                                  <QuarticEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                            </Storyboard>
                          </BeginStoryboard>
                        </MultiTrigger.EnterActions>
                        <MultiTrigger.ExitActions>
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="Opacity" Duration="00:00:00.187">
                                <DoubleAnimation.EasingFunction>
                                  <QuarticEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                            </Storyboard>
                          </BeginStoryboard>
                        </MultiTrigger.ExitActions>
                      </MultiTrigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsMouseOver" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="MainBorder" Property="Background">
                          <Setter.Value>
                            <SolidColorBrush Color="{DynamicResource SubtleFillColorSecondary}" />
                          </Setter.Value>
                        </Setter>
                      </MultiTrigger>
                      <Trigger Property="vscontrols:SidebarGroup.IsHeader" Value="True">
                        <Setter TargetName="GroupChevron" Property="Visibility" Value="Visible" />
                      </Trigger>
                      <Trigger Property="vscontrols:SidebarGroup.IsExpanded" Value="True">
                        <Trigger.EnterActions>
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="GroupChevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="00:00:00.25">
                                <DoubleAnimation.EasingFunction>
                                  <QuinticEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                            </Storyboard>
                          </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="GroupChevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="00:00:00.25">
                                <DoubleAnimation.EasingFunction>
                                  <QuinticEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                            </Storyboard>
                          </BeginStoryboard>
                        </Trigger.ExitActions>
                      </Trigger>
                      <Trigger Property="vscontrols:SidebarGroup.IsChild" Value="True">
                        <Setter TargetName="ItemIcon" Property="Visibility" Value="Hidden" />
                        <Setter TargetName="MainBorder" Property="Margin" Value="0,0,0,4" />
                        <Setter TargetName="ActiveRectangle" Property="Margin" Value="37,0,0,0" />
                        <Setter TargetName="MainBorder" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
                      </Trigger>
                      <Trigger Property="Icon" Value="Empty">
                        <Setter TargetName="ItemIcon" Property="Width" Value="0" />
                        <Setter TargetName="ItemIcon" Property="Margin" Value="0" />
                        <Setter TargetName="ItemIcon" Property="Visibility" Value="Collapsed" />
                      </Trigger>
                      <Trigger Property="Image" Value="{x:Null}">
                        <Setter TargetName="ItemImage" Property="Width" Value="0" />
                        <Setter TargetName="ItemImage" Property="Margin" Value="0" />
                        <Setter TargetName="ItemImage" Property="Visibility" Value="Collapsed" />
                      </Trigger>
                      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ui:NavigationFluent}}}" Value="icons">
                        <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="InnerGrid" Property="HorizontalAlignment" Value="Center" />
                        <Setter TargetName="ItemIcon" Property="Margin" Value="0" />
                        <Setter TargetName="ItemImage" Property="Margin" Value="0" />
                        <Setter TargetName="GroupChevron" Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ui:NavigationFluent.Resources>
          <ui:NavigationFluent.Template>
            <ControlTemplate TargetType="{x:Type ui:NavigationFluent}">
              <Grid Width="{Binding Width, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" Margin="0" Padding="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                  <ItemsControl Focusable="False" ItemsSource="{TemplateBinding Items}" KeyboardNavigation.DirectionalNavigation="Contained" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Margin="0" IsItemsHost="True" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </ScrollViewer>
                <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,4,0,0">
                  <ItemsControl Focusable="False" ItemsSource="{TemplateBinding Footer}" KeyboardNavigation.DirectionalNavigation="Contained" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Margin="0" IsItemsHost="True" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </Border>
              </Grid>
            </ControlTemplate>
          </ui:NavigationFluent.Template>
          <ui:NavigationBase.Items>
            <ui:NavigationItem Content="Core" IsEnabled="False" Opacity="0.6" />
