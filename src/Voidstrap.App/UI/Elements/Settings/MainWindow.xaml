<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.Settings.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dmodels="clr-namespace:Voidstrap.UI.ViewModels.Settings" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:pages="clr-namespace:Voidstrap.UI.Elements.Settings.Pages" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:media="clr-namespace:System.Windows.Media.Animation;assembly=PresentationCore" Closed="WpfUiWindow_Closed" Closing="WpfUiWindow_Closing" Loaded="MainWindow_Loaded" PreviewMouseWheel="OnZoomWheel" Title="{x:Static resources:Strings.Menu_Title}" Width="1071" Height="690" MinWidth="850" MinHeight="550" AllowsTransparency="False" Background="#00FFFFFF" ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True" mc:Ignorable="d" xmlns:settings="clr-namespace:Voidstrap.UI.Elements.Settings">
    
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <BitmapImage x:Key="AppIconImage" UriSource="pack://application:,,,/Voidstrap.png" />
      <Style x:Key="TitleBarAvatarButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="AvatarButtonBg" Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="AvatarButtonBg" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="AvatarButtonBg" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TopNavButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                <StackPanel>
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Rectangle x:Name="TabUnderline" Height="2" Margin="0,3,0,0" RadiusX="1" RadiusY="1" HorizontalAlignment="Stretch" Opacity="0" RenderTransformOrigin="0.5,0.5" Fill="{DynamicResource SystemAccentBrush}">
                    <UIElement.RenderTransform>
                      <ScaleTransform ScaleX="0" />
                    </UIElement.RenderTransform>
                  </Rectangle>
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="Tag" Value="Active">
                  <Trigger.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <media:DoubleAnimation Storyboard.TargetName="TabUnderline" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                        <media:DoubleAnimation Storyboard.TargetName="TabUnderline" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.22">
                          <media:DoubleAnimation.EasingFunction>
                            <media:CubicEase EasingMode="EaseOut" />
                          </media:DoubleAnimation.EasingFunction>
                        </media:DoubleAnimation>
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.EnterActions>
                  <Trigger.ExitActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <media:DoubleAnimation Storyboard.TargetName="TabUnderline" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                        <media:DoubleAnimation Storyboard.TargetName="TabUnderline" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0" Duration="0:0:0.12" />
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.ExitActions>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
          </Trigger>
          <Trigger Property="Tag" Value="Active">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="TopNavArrowStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,4" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            <Setter Property="Cursor" Value="Arrow" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <media:CubicEase x:Key="SmoothEaseOut" EasingMode="EaseOut" />
      <media:QuinticEase x:Key="UltraSmoothEaseOut" EasingMode="EaseOut" />
      <Storyboard x:Key="IntroStoryboard">
        <media:DoubleAnimation Storyboard.TargetName="IntroContent" Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.4" EasingFunction="{StaticResource SmoothEaseOut}" />
        <media:DoubleAnimation Storyboard.TargetName="IntroOverlay" Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" BeginTime="0:0:1.0" Duration="0:0:0.45" EasingFunction="{StaticResource SmoothEaseOut}" />
      </Storyboard>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Name="BackgroundLayer" RowSpan="3" ZIndex="-10" ClipToBounds="True">
      <Image Name="BackgroundImage" Stretch="UniformToFill" Opacity="1" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" Visibility="Visible" />
      <Border Name="BackgroundBlackOverlay" Background="#FF000000" Opacity="0" IsHitTestVisible="False" />
      <Border Name="GradientLayer">
        <Border.Background>
          <LinearGradientBrush x:Name="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <Brush.RelativeTransform>
              <TransformGroup x:Name="BackgroundGradientTransform">
                <RotateTransform x:Name="BackgroundGradientRotate" CenterX="0.5" CenterY="0.5" />
                <TranslateTransform x:Name="BackgroundGradientTranslate" />
              </TransformGroup>
            </Brush.RelativeTransform>
            <GradientStop Offset="0.0" Color="{DynamicResource WindowBackgroundColorPrimary}" />
            <GradientStop Offset="0.35" Color="{DynamicResource WindowBackgroundColorSecondary}" />
            <GradientStop Offset="0.75" Color="{DynamicResource WindowBackgroundColorThird}" />
            <GradientStop Offset="1.0" Color="{DynamicResource WindowBackgroundColorPrimary}" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
    </Grid>
    <settings:SmoothSnowLayer x:Name="SnowCanvas" Grid.RowSpan="3" IsHitTestVisible="False" Panel.ZIndex="0" Visibility="Collapsed" />
    <Grid Name="IntroOverlay" RowSpan="3" ZIndex="999" Opacity="1" Background="#FF0C0C0C" d:Visibility="Collapsed">
      <Border>
        <Border.Background>
          <SolidColorBrush Color="{DynamicResource WindowBackgroundColorPrimary}" />
        </Border.Background>
      </Border>
      <Image Name="IntroContent" Width="120" Height="120" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{StaticResource AppIconImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
        <Image.Effect>
          <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Color="#FF000000" Opacity="0.8" />
        </Image.Effect>
      </Image>
    </Grid>
    <Border Name="RestartNotificationCard" Grid.RowSpan="3" Width="390" MinHeight="116" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,72" Padding="14" Panel.ZIndex="1200" Visibility="Collapsed" Opacity="0" CornerRadius="7" Background="{DynamicResource SystemFillColorSolidNeutralBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="#000000" />
      </Border.Effect>
      <Border.RenderTransform>
        <TranslateTransform x:Name="RestartNotificationTranslate" X="28" />
      </Border.RenderTransform>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:SymbolIcon Grid.Column="0" Grid.RowSpan="2" Margin="0,1,12,0" VerticalAlignment="Top" FontSize="22" Symbol="ArrowClockwise24" />
        <TextBlock Name="RestartNotificationTitle" Grid.Column="1" FontSize="14" FontWeight="SemiBold" Text="Settings changed" TextWrapping="Wrap" />
        <ui:Button Grid.Column="2" Width="30" Height="30" Margin="10,-5,-5,0" Padding="0" Appearance="Transparent" Icon="Dismiss24" ToolTip="Dismiss" Click="RestartNotificationDismiss_Click" />
        <TextBlock Name="RestartNotificationMessage" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Restart Voidstrap to apply this change." TextWrapping="Wrap" />
        <ui:Button Name="RestartNotificationAction" Grid.Column="1" Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Left" Appearance="Primary" Background="{DynamicResource SystemAccentBrush}" Content="Restart now" Click="RestartNotificationAction_Click" />
      </Grid>
    </Border>
    <ui:Snackbar Name="AlreadyRunningSnackbar" Title="{x:Static resources:Strings.Menu_AlreadyRunning_Title}" Grid.RowSpan="10" Margin="200,0,200,20" Panel.ZIndex="10" Icon="Info20" Message="{x:Static resources:Strings.Menu_AlreadyRunning_Caption}" Timeout="10000">
      <Control.Background>
        <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
          <GradientStop Offset="0.00" Color="{DynamicResource WindowBackgroundColorPrimary}" />
          <GradientStop Offset="0.70" Color="{DynamicResource WindowBackgroundColorSecondary}" />
          <GradientStop Offset="1.00" Color="{DynamicResource WindowBackgroundColorThird}" />
        </LinearGradientBrush>
      </Control.Background>
    </ui:Snackbar>
    <ui:Snackbar Name="SettingsSavedSnackbar" Title="{x:Static resources:Strings.Menu_SettingsSaved_Title}" Grid.RowSpan="10" Margin="200,0,200,20" Panel.ZIndex="9" Icon="CheckboxChecked24" Message="{x:Static resources:Strings.Menu_SettingsSaved_Message}" Timeout="2100">
      <Control.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Offset="0.0" Color="{DynamicResource WindowBackgroundColorPrimary}" />
          <GradientStop Offset="0.35" Color="{DynamicResource WindowBackgroundColorSecondary}" />
          <GradientStop Offset="0.75" Color="{DynamicResource WindowBackgroundColorThird}" />
          <GradientStop Offset="1.0" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        </LinearGradientBrush>
      </Control.Background>
    </ui:Snackbar>
    <ui:Snackbar Name="SettingsSavedLaunchSnackbar" Title="Voidstrap Saved And Launched Roblox!" Grid.RowSpan="10" Margin="150,0,150,20" Panel.ZIndex="10" Icon="CheckboxChecked24" Message="Changes have been saved." Timeout="2000">
      <Control.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Offset="0.0" Color="{DynamicResource WindowBackgroundColorPrimary}" />
          <GradientStop Offset="0.35" Color="{DynamicResource WindowBackgroundColorSecondary}" />
          <GradientStop Offset="0.75" Color="{DynamicResource WindowBackgroundColorThird}" />
          <GradientStop Offset="1.0" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        </LinearGradientBrush>
      </Control.Background>
    </ui:Snackbar>
    <ui:Snackbar Name="SettingFailureSnackbar" Title="Setting not changed" Grid.RowSpan="10" Margin="180,0,180,20" Panel.ZIndex="11" Icon="ErrorCircle24" Timeout="5000" />
    <ui:TitleBar Name="RootTitleBar" Padding="8" Grid.Row="0" Panel.ZIndex="1000" ForceShutdown="False" MinimizeToTray="False" UseSnapLayout="True">
      <ui:TitleBar.Header>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" FlowDirection="LeftToRight">
        <ui:AutoSuggestBox x:Name="TopSearchBox" Width="260" Height="32" VerticalAlignment="Center" Margin="0,0,8,0" PlaceholderText="Search settings and pages..." Icon="Search24" TextChanged="TopSearchBox_TextChanged" SuggestionChosen="TopSearchBox_SuggestionChosen" KeyDown="TopSearchBox_KeyDown" />
        <Button x:Name="NotificationsButton" Click="NotificationsButton_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" Style="{StaticResource TitleBarAvatarButtonStyle}">
          <Grid Width="30" Height="30" ClipToBounds="False" VerticalAlignment="Center" HorizontalAlignment="Center">
            <ui:SymbolIcon Symbol="Alert24" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border x:Name="NotificationsBadge" MinWidth="17" Height="17" Padding="3,0" CornerRadius="8.5" Background="#EF4444" BorderBrush="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-4,0" Panel.ZIndex="2" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
              <Border.RenderTransform>
                <ScaleTransform x:Name="NotificationsBadgeScale" ScaleX="1" ScaleY="1" />
              </Border.RenderTransform>
              <TextBlock x:Name="NotificationsBadgeText" Text="0" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
        </Button>
        <Button x:Name="QuestsButton" Click="QuestsButton_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" Style="{StaticResource TitleBarAvatarButtonStyle}">
          <Grid Width="30" Height="30" ClipToBounds="False" VerticalAlignment="Center" HorizontalAlignment="Center">
            <ui:SymbolIcon Symbol="TaskListSquareLtr24" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border x:Name="QuestsBadge" MinWidth="17" Height="17" Padding="3,0" CornerRadius="8.5" Background="#EF4444" BorderBrush="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-4,0" Panel.ZIndex="2" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
              <Border.RenderTransform>
                <ScaleTransform x:Name="QuestsBadgeScale" ScaleX="1" ScaleY="1" />
              </Border.RenderTransform>
              <TextBlock x:Name="QuestsBadgeText" Text="0" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
        </Button>
        <Button x:Name="ShopButton" Click="ShopButton_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" Style="{StaticResource TitleBarAvatarButtonStyle}">
          <Grid Width="30" Height="30" ClipToBounds="False" VerticalAlignment="Center" HorizontalAlignment="Center">
            <ui:SymbolIcon Symbol="Cart24" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Button x:Name="AccountAvatarButton" Click="AccountAvatarButton_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" Style="{StaticResource TitleBarAvatarButtonStyle}">
          <Grid Width="30" Height="30" ClipToBounds="False" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border x:Name="AccountAvatarRing" Width="20" Height="20" CornerRadius="10" Padding="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource ControlFillColorSecondaryBrush}">
              <Border CornerRadius="9" ClipToBounds="True">
                <Border.Background>
                  <ImageBrush x:Name="AccountAvatarBrush" Stretch="UniformToFill" />
                </Border.Background>
              </Border>
            </Border>
            <Image x:Name="AccountBorderImage" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
          </Grid>
        </Button>
        </StackPanel>
      </ui:TitleBar.Header>
    </ui:TitleBar>
    <StackPanel x:Name="TopNavPanel" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,5,0,0" Panel.ZIndex="5">
      <Image Width="19" Height="19" Margin="0,0,15,0" VerticalAlignment="Center" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" Source="{StaticResource AppIconImage}" />
      <Button x:Name="TopNavBack" Style="{StaticResource TopNavArrowStyle}" Margin="0" IsEnabled="False" ToolTip="Back" Click="TopNavBack_Click">
        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="22" FontWeight="Bold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      </Button>
      <Button x:Name="TopNavForward" Style="{StaticResource TopNavArrowStyle}" Margin="0,0,7,0" IsEnabled="False" ToolTip="Forward" Click="TopNavForward_Click">
        <ui:SymbolIcon Symbol="ArrowRight24" FontSize="22" FontWeight="Bold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      </Button>
      <Button x:Name="TopNavHome" FontWeight="SemiBold" Content="HOME" Style="{StaticResource TopNavButtonStyle}" Click="TopNavHome_Click" />
            <Button x:Name="TopNavLibrary" FontWeight="SemiBold" Content="LIBRARY" Style="{StaticResource TopNavButtonStyle}" Click="TopNavLibrary_Click" />
            <Button x:Name="TopNavCommunity" FontWeight="SemiBold" Content="COMMUNITY" Style="{StaticResource TopNavButtonStyle}" Click="TopNavCommunity_Click" />
    </StackPanel>
    <Popup x:Name="AccountPopup" PlacementTarget="{Binding ElementName=AccountAvatarButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None" HorizontalOffset="-170" VerticalOffset="2">
      <Border Margin="10" CornerRadius="12" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}">
        <Border.Effect>
          <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.4" Color="#000000" />
        </Border.Effect>
        <StackPanel Width="252">
          <Grid Margin="14,14,14,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" ClipToBounds="True">
              <Border.Background>
                <ImageBrush x:Name="AccountPopupAvatarBrush" Stretch="UniformToFill" />
              </Border.Background>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Name="AccountDisplayNameText" Text="" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              <TextBlock Name="AccountUsernameText" Text="" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
          </Grid>
          <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlElevationBorderBrush}" Padding="6">
            <StackPanel>
              <ui:Button x:Name="AccountFriendsButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" Appearance="Transparent" Icon="People24" Content="Friends" Click="AccountFriends_Click" />
              <ui:Button x:Name="AccountSignOutButton" Margin="0,2,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" Appearance="Transparent" Icon="SignOut24" Content="Sign out" Click="AccountSignOut_Click" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Popup>
    <Grid Name="RootGrid" Row="1" Margin="8,12,0,0" MouseMove="RootGrid_MouseMove" MouseLeave="RootGrid_MouseLeave">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid Name="SidebarHost" Row="1" Column="0" Margin="0,0,5,0" Panel.ZIndex="60">
        <ui:NavigationFluent Name="RootNavigation" Width="225" SelectedPageIndex="1" TransitionType="FadeInWithSlideLeft" TransitionDuration="520" Frame="{Binding ElementName=RootFrame}">
          <ui:NavigationFluent.Resources>
            <Style TargetType="{x:Type ui:NavigationItem}">
              <Setter Property="Cache" Value="False" />
              <Setter Property="Margin" Value="0,0,0,4" />
              <Setter Property="Cursor" Value="Arrow" />
              <Setter Property="FontSize" Value="14" />
              <Setter Property="IconSize" Value="18" />
              <Setter Property="VerticalAlignment" Value="Center" />
              <Setter Property="HorizontalContentAlignment" Value="Left" />
              <Setter Property="Background">
                <Setter.Value>
                  <SolidColorBrush Color="{DynamicResource SubtleFillColorSecondary}" />
                </Setter.Value>
              </Setter>
              <Setter Property="Foreground">
                <Setter.Value>
                  <SolidColorBrush Color="{DynamicResource TextFillColorPrimary}" />
                </Setter.Value>
              </Setter>
              <Setter Property="IconForeground">
                <Setter.Value>
                  <SolidColorBrush Color="{DynamicResource TextFillColorPrimary}" />
                </Setter.Value>
              </Setter>
              <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentBrush}" />
              <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
              <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
              <Setter Property="Focusable" Value="True" />
              <Setter Property="SnapsToDevicePixels" Value="True" />
              <Setter Property="OverridesDefaultStyle" Value="True" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ui:NavigationItem}">
                    <Border x:Name="MainBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="1" CornerRadius="5">
                      <Grid>
                        <Rectangle x:Name="ActiveRectangle" Width="3" Height="0" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0.0" RadiusX="1.5" RadiusY="1.5">
                          <Rectangle.Fill>
                            <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                          </Rectangle.Fill>
                        </Rectangle>
                        <Grid x:Name="InnerGrid" Margin="16,8" HorizontalAlignment="Left">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <ui:SymbolIcon x:Name="ItemIcon" Grid.Column="0" Width="18" Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center" Filled="{TemplateBinding IconFilled}" FontSize="{TemplateBinding IconSize}" Foreground="{TemplateBinding IconForeground}" Symbol="{TemplateBinding Icon}" />
                          <Image x:Name="ItemImage" Grid.Column="0" Width="18" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" Source="{TemplateBinding Image}" />
                          <ContentPresenter x:Name="Label" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsActive" Value="False">
                        <Setter TargetName="MainBorder" Property="Background">
                          <Setter.Value>
                            <SolidColorBrush Opacity="0" />
                          </Setter.Value>
                        </Setter>
                      </Trigger>
                      <Trigger Property="IsActive" Value="True">
                        <Setter TargetName="ActiveRectangle" Property="Height" Value="16" />
                        <Setter TargetName="ActiveRectangle" Property="Opacity" Value="1" />
                        <Trigger.EnterActions>
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="ActiveRectangle" Storyboard.TargetProperty="(Rectangle.Height)" From="0" To="16" Duration="00:00:00.25">
                                <DoubleAnimation.EasingFunction>
                                  <QuinticEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                              <DoubleAnimation Storyboard.TargetName="ActiveRectangle" Storyboard.TargetProperty="(Rectangle.Opacity)" From="0.0" To="1.0" Duration="00:00:00.175">
                                <DoubleAnimation.EasingFunction>
                                  <QuarticEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                            </Storyboard>
                          </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="ActiveRectangle" Storyboard.TargetProperty="(Rectangle.Height)" From="16" To="0" Duration="00:00:00.25">
                                <DoubleAnimation.EasingFunction>
                                  <QuinticEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                              <DoubleAnimation Storyboard.TargetName="ActiveRectangle" Storyboard.TargetProperty="(Rectangle.Opacity)" From="1.0" To="0.0" Duration="00:00:00.175">
                                <DoubleAnimation.EasingFunction>
                                  <QuarticEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                            </Storyboard>
                          </BeginStoryboard>
                        </Trigger.ExitActions>
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsMouseOver" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="MainBorder" Property="Background">
                          <Setter.Value>
                            <SolidColorBrush Color="{DynamicResource SubtleFillColorSecondary}" />
                          </Setter.Value>
                        </Setter>
                      </MultiTrigger>
                      <Trigger Property="Icon" Value="Empty">
                        <Setter TargetName="ItemIcon" Property="Width" Value="0" />
                        <Setter TargetName="ItemIcon" Property="Margin" Value="0" />
                      </Trigger>
                      <Trigger Property="Image" Value="{x:Null}">
                        <Setter TargetName="ItemImage" Property="Width" Value="0" />
                        <Setter TargetName="ItemImage" Property="Margin" Value="0" />
                        <Setter TargetName="ItemImage" Property="Visibility" Value="Collapsed" />
                      </Trigger>
                      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ui:NavigationFluent}}}" Value="icons">
                        <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="InnerGrid" Property="HorizontalAlignment" Value="Center" />
                        <Setter TargetName="ItemIcon" Property="Margin" Value="0" />
                      </DataTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ui:NavigationFluent.Resources>
          <ui:NavigationFluent.Template>
            <ControlTemplate TargetType="{x:Type ui:NavigationFluent}">
              <Grid Width="{Binding Width, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" Margin="0" Padding="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                  <ItemsControl Focusable="False" ItemsSource="{TemplateBinding Items}" KeyboardNavigation.DirectionalNavigation="Contained" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Margin="0" IsItemsHost="True" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </ScrollViewer>
                <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlElevationBorderBrush}" Padding="0,4,0,0">
                  <ItemsControl Focusable="False" ItemsSource="{TemplateBinding Footer}" KeyboardNavigation.DirectionalNavigation="Contained" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Margin="0" IsItemsHost="True" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </Border>
              </Grid>
            </ControlTemplate>
          </ui:NavigationFluent.Template>
          <ui:NavigationBase.Items>
            <ui:NavigationItem Content="Core" IsEnabled="False" Opacity="0.6" />
            <ui:NavigationItem Content="Home" Icon="Home24" Tag="Home20" PageType="{x:Type pages:HomePage}" />
            <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Integrations_Title}" Icon="Add12" Tag="Add16" PageType="{x:Type pages:IntegrationsPage}" />
            <ui:NavigationItem Content="Deployment" Icon="PlaySettings20" Tag="Play20" PageType="{x:Type pages:BehaviourPage}" />
            <ui:NavigationItem Name="SoberNavItem" Content="{x:Static resources:Strings.Menu_Sober_Title}" Icon="Settings28" Tag="Settings20" PageType="{x:Type pages:SoberPage}" />
            <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Appearance_Title}" Icon="PaintBucket24" Tag="PaintBucket20" PageType="{x:Type pages:AppearancePage}" />
            <ui:NavigationSeparator />
            <ui:NavigationItem Content="Configuration" IsEnabled="False" Opacity="0.6" />
            <ui:NavigationItem Content="FastFlag Settings" Icon="Settings28" Tag="SettingsChat24" PageType="{x:Type pages:FastFlagsPage}" />
            <ui:NavigationItem Name="FastFlagEditorNavItem" Content="FastFlag Editor" Icon="Flag28" Tag="Flag20" PageType="{x:Type pages:FastFlagEditorPage}" />
            <ui:NavigationItem Content="Global" Icon="GlobeLocation20" Tag="Globe20" PageType="{x:Type pages:GBSEditorPage}" />
            <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Mods_Title}" Icon="WrenchScrewdriver20" Tag="Wrench24" PageType="{x:Type pages:ModsPage}" />
            <ui:NavigationSeparator />
            <ui:NavigationItem IsEnabled="False" Opacity="0.6" />
            <ui:NavigationItem Name="NewsNavItem" Content="News" Icon="News16" Tag="News20" Margin="0,-40,0,0" PageType="{x:Type pages:NewsPage}" />
            <ui:NavigationItem Content="Manager" Icon="ArrowDownload24" Tag="ArrowDownload20" Margin="0,4,0,20" PageType="{x:Type pages:DownloadsPage}" />
          </ui:NavigationBase.Items>
          <ui:NavigationBase.Footer>
            <ui:NavigationItem Content="Extensions" Icon="CubeAdd20" Tag="CubeLink20" PageType="{x:Type pages:ExtensionPage}" />
            <ui:NavigationItem Name="ShortcutsNavItem" Content="{x:Static resources:Strings.Common_Shortcuts}" Icon="Apps32" Tag="Apps24" PageType="{x:Type pages:ShortcutsPage}" />
            <ui:NavigationItem Name="SettingsNavItem" Content="Settings" Icon="Settings28" Tag="Settings20" PageType="{x:Type pages:ChannelPage}" />
            <ui:NavigationItem Content="{x:Static resources:Strings.Menu_About_Title}" Icon="QuestionCircle32" Tag="QuestionCircle48" Command="{Binding OpenAboutCommand, Mode=OneTime}" />
          </ui:NavigationBase.Footer>
        </ui:NavigationFluent>
        <Border Name="SidebarResizer" Width="8" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" ToolTip="Drag to resize, double click to reset" MouseLeftButtonDown="SidebarResizer_MouseLeftButtonDown" MouseMove="SidebarResizer_MouseMove" MouseLeftButtonUp="SidebarResizer_MouseLeftButtonUp" />
      </Grid>
      <Grid Row="0" RowSpan="3" Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Row="0" Margin="0,0,0,5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" x:Name="BreadcrumbPanel" Orientation="Horizontal" VerticalAlignment="Center">
            <ui:SymbolIcon Name="BreadcrumbIcon" Symbol="Add12" FontSize="23" Margin="0,4,6,0" VerticalAlignment="Center" />
            <ui:Breadcrumb Navigation="{Binding ElementName=RootNavigation}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
            <ui:TextBox Name="GlobalSearchBox" Margin="0,0,6,0" HorizontalAlignment="Right" Visibility="Collapsed" PlaceholderText="Search..." ClearButtonEnabled="True" Icon="Search24" TextChanged="GlobalSearchBox_TextChanged" />
          </StackPanel>
          <ui:InfoBar Margin="0,0,28,0" Grid.Column="2" HorizontalAlignment="Right" Padding="3" IsClosable="True" IsOpen="True"  Message="{Binding AppVersion}" />
        </Grid>
        <Frame Name="RootFrame" Grid.Row="1" ClipToBounds="True" />
      </Grid>
    </Grid>
    <Border Name="ZoomIndicator"
            Grid.Row="1"
            Grid.RowSpan="2"
            Panel.ZIndex="900"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,30"
            Padding="6"
            CornerRadius="10"
            Visibility="Collapsed"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderThickness="1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ui:Button Width="34" Height="30" Padding="0" Content="-" FontSize="15" Click="ZoomOut_Click" ToolTip="Zoom out" />
        <TextBlock Name="ZoomIndicatorText" MinWidth="54" Margin="8,0" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" Text="100%" />
        <ui:Button Width="34" Height="30" Padding="0" Content="+" FontSize="15" Click="ZoomIn_Click" ToolTip="Zoom in" />
        <ui:Button Height="30" Margin="10,0,0,0" Padding="12,0" Content="Reset" Click="ZoomReset_Click" />
      </StackPanel>
    </Border>
    <Grid Row="1" Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TabControl Name="WorkspaceTabs" DisplayMemberPath="Title" Background="{x:Null}" BorderThickness="0" Height="34" HorizontalAlignment="Left" Grid.Column="0" Margin="275,5,0,0" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}" SelectionChanged="WorkspaceTabs_SelectionChanged">
        <Control.Template>
          <ControlTemplate TargetType="{x:Type TabControl}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <TabPanel Name="HeaderPanel" IsItemsHost="True" Background="{x:Null}" />
              </ScrollViewer>
              <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="{TemplateBinding Control.Padding}" />
            </Grid>
          </ControlTemplate>
        </Control.Template>
      </TabControl>
      <ui:Button Grid.Column="1" Width="34" Height="34" Appearance="Secondary" Icon="Add16" Margin="0,0,16,6" Click="AddTab_Click">
        <FrameworkElement.ToolTip>
          <ToolTip>Tabs - Beta</ToolTip>
        </FrameworkElement.ToolTip>
      </ui:Button>
    </Grid>
    <Border Grid.Row="2" VerticalAlignment="Bottom" Height="52" CornerRadius="12,12,0,0" Padding="16,0" Background="{ui:ThemeResource ControlFillColorDefaultBrush}">
      <StatusBar Name="RootStatusBar" Padding="14,10" BorderThickness="0,1,0,0">
        <Control.Background>
          <SolidColorBrush Opacity="0" Color="{ui:ThemeResource ApplicationBackgroundColor}" />
        </Control.Background>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
            </Grid>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <StatusBarItem Grid.Column="0" Margin="0,0,4,0">
          <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" Foreground="{DynamicResource SystemAccentBrush}" AutomationProperties.Name="{x:Static resources:Strings.Menu_TestMode}" IsChecked="{Binding TestModeEnabled, Mode=TwoWay}" />
            <TextBlock Padding="10,0,0,0" VerticalAlignment="Center" FontSize="14" Text="{x:Static resources:Strings.Menu_TestMode}" />
          </StackPanel>
        </StatusBarItem>
        <StatusBarItem Grid.Column="2" Padding="0,0,8,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid VerticalAlignment="Center" Margin="0,0,8,0">
              <ui:Button Name="LaunchTargetButton" Height="33" MinWidth="36" Padding="10,0" Appearance="Secondary" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="LaunchTargetButton_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding SelectedLaunchTargetName, Mode=OneWay}">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </TextBlock>
                  <ui:SymbolIcon FontSize="14" VerticalAlignment="Center" Symbol="ChevronUp24" />
                </StackPanel>
              </ui:Button>
              <Popup Name="LaunchTargetPopup" IsOpen="False" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None" Placement="Top" VerticalOffset="-6" PlacementTarget="{Binding ElementName=LaunchTargetButton}">
                <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" MinWidth="190" Padding="4" SnapsToDevicePixels="True">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.4" Color="#000000" />
                  </Border.Effect>
                  <ScrollViewer Name="LaunchTargetScroll" MaxHeight="132" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel Name="LaunchTargetList" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ui:Button Name="InstallLaunchButton" HorizontalAlignment="Center" Appearance="Primary" Background="{DynamicResource SystemAccentBrush}" Content="Install" Command="{Binding SaveAndLaunchSettingsCommand, Mode=OneWay}" />
          </StackPanel>
        </StatusBarItem>
        <StatusBarItem Grid.Column="3" Padding="0,0,9,0">
		  <ui:Button Width="56.587" Appearance="Primary" Background="{DynamicResource SystemAccentBrush}" Content="{x:Static resources:Strings.Menu_Save}" Command="{Binding SaveSettingsCommand, Mode=OneWay}" Click="Button_Click_1" />
        </StatusBarItem>
        <StatusBarItem Grid.Column="4" Padding="0,0,8,0">
		  <ui:Button Width="56.587" HorizontalAlignment="Center" Appearance="Secondary" Content="{x:Static resources:Strings.Common_Close}" Command="{Binding CloseWindowCommand, Mode=OneTime}" Click="Button_Click_2" />
        </StatusBarItem>
      </StatusBar>
    </Border>
  </Grid>
</base:WpfUiWindow>
