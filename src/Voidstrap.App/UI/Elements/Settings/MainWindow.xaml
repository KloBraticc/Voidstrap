    <StackPanel x:Name="TopNavPanel" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,5,0,0" Panel.ZIndex="1001">
      <Button x:Name="AppMenuButton" Margin="0,0,5,0" Style="{StaticResource TopBarButtonStyle}" Click="AppMenuButton_Click">
