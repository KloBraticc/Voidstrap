            <ui:NavigationItem Cache="True" Name="IntegrationsNavItem" Content="{x:Static resources:Strings.Menu_Integrations_Title}" Icon="Add12" Tag="Add16" PageType="{x:Type pages:IntegrationsPage}" />
            <ui:NavigationItem Cache="True" Name="DeploymentNavItem" Content="Deployment" Icon="PlaySettings20" Tag="Play20" PageType="{x:Type pages:BehaviourPage}" />
            <ui:NavigationItem Cache="True" Name="AppearanceNavItem" Content="{x:Static resources:Strings.Menu_Appearance_Title}" Icon="Color24" Tag="Color20" PageType="{x:Type pages:AppearancePage}" />
            <ui:NavigationSeparator />
            <ui:NavigationItem Content="Configuration" IsEnabled="False" Opacity="0.6" />
            <ui:NavigationItem Cache="True" Name="FastFlagSettingsNavItem" Content="FastFlag Settings" Icon="Settings28" Tag="SettingsChat24" PageType="{x:Type pages:FastFlagsPage}" />
            <ui:NavigationItem Cache="True" Name="FastFlagEditorNavItem" Content="FastFlag Editor" Icon="Flag28" Tag="Flag20" PageType="{x:Type pages:FastFlagEditorPage}" />
            <ui:NavigationItem Cache="True" Name="ModsNavItem" Content="{x:Static resources:Strings.Menu_Mods_Title}" Icon="WrenchScrewdriver20" Tag="Wrench24" PageType="{x:Type pages:ModsPage}" />
            <ui:NavigationItem Cache="True" Name="MoreNavItem" Content="More" Icon="MoreHorizontal24" Tag="MoreHorizontal20" PageType="{x:Type pages:MorePage}" vscontrols:SidebarGroup.IsHeader="True" />
            <ui:NavigationItem Cache="True" Name="GlobalNavItem" Margin="0" Content="Global" Icon="GlobeLocation20" Tag="Globe20" PageType="{x:Type pages:GBSEditorPage}" vscontrols:SidebarGroup.Header="{x:Reference MoreNavItem}" />
            <ui:NavigationItem Cache="True" Name="ShortcutsNavItem" Margin="0" Content="{x:Static resources:Strings.Common_Shortcuts}" Icon="Apps32" Tag="Apps24" PageType="{x:Type pages:ShortcutsPage}" vscontrols:SidebarGroup.Header="{x:Reference MoreNavItem}" />
            <ui:NavigationItem Cache="True" Name="NewsNavItem" Margin="0" Content="News" Icon="News16" Tag="News20" PageType="{x:Type pages:NewsPage}" vscontrols:SidebarGroup.Header="{x:Reference MoreNavItem}" />
          </ui:NavigationBase.Items>
          <ui:NavigationBase.Footer>
            <ui:NavigationItem Cache="True" Name="ExtensionsNavItem" Content="Extensions" Icon="CubeAdd20" Tag="CubeLink20" Visibility="{x:Static appUi:PlatformFeatureVisibility.WindowsIntegration}" PageType="{x:Type pages:ExtensionPage}" />
            <ui:NavigationItem Cache="True" Name="ManagerNavItem" Content="Manager" Icon="ArrowDownload24" Tag="ArrowDownload20" Visibility="{x:Static appUi:PlatformFeatureVisibility.WindowsIntegration}" PageType="{x:Type pages:DownloadsPage}" />
            <ui:NavigationItem Cache="True" Name="SettingsNavItem" Content="Settings" Icon="Settings28" Tag="Settings20" PageType="{x:Type pages:ChannelPage}" />
            <ui:NavigationItem Cache="True" Name="SoberNavItem" Content="{x:Static resources:Strings.Menu_Sober_Title}" Icon="Empty" Image="pack://application:,,,/Resources/SoberIcon.png" Tag="Settings20" PageType="{x:Type pages:SoberPage}" />
            <ui:NavigationItem Name="AboutNavItem" Content="{x:Static resources:Strings.Menu_About_Title}" Icon="QuestionCircle32" Tag="QuestionCircle48" Command="{Binding OpenAboutCommand, Mode=OneTime}" />
          </ui:NavigationBase.Footer>
        </ui:NavigationFluent>
        <Border Name="SidebarResizer" Width="8" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" ToolTip="Drag to resize, double click to reset" MouseLeftButtonDown="SidebarResizer_MouseLeftButtonDown" MouseMove="SidebarResizer_MouseMove" MouseLeftButtonUp="SidebarResizer_MouseLeftButtonUp" />
      </Grid>
      <Grid Row="0" RowSpan="3" Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Row="0" Margin="0,0,0,5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" x:Name="BreadcrumbPanel" Orientation="Horizontal" VerticalAlignment="Center">
            <ui:SymbolIcon Name="BreadcrumbIcon" Symbol="Add12" FontSize="23" Margin="0,4,6,0" VerticalAlignment="Center" />
            <ui:Breadcrumb Navigation="{Binding ElementName=RootNavigation}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
            <ui:TextBox Name="GlobalSearchBox" Margin="0,0,6,0" HorizontalAlignment="Right" Visibility="Collapsed" PlaceholderText="Search..." ClearButtonEnabled="True" Icon="Search24" TextChanged="GlobalSearchBox_TextChanged" />
          </StackPanel>
          <ui:InfoBar Margin="0,0,28,0" Grid.Column="2" HorizontalAlignment="Right" Padding="3" IsClosable="True" IsOpen="True" Message="{Binding AppVersion}" appUi:LinuxTextGuard.PreserveCompactLayout="True" />
        </Grid>
        <Border Name="PageSurface" Grid.Row="1" Margin="0" Padding="12,10,2,0" CornerRadius="8,0,0,0" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1,1,0,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
          <Frame Name="RootFrame" ClipToBounds="True" />
        </Border>
      </Grid>
    </Grid>
    <Border Name="ZoomIndicator"
            Grid.Row="1"
            Grid.RowSpan="2"
            Panel.ZIndex="900"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,30"
            Padding="6"
            CornerRadius="10"
            Visibility="Collapsed"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderThickness="1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ui:Button Width="34" Height="30" Padding="0" Content="-" FontSize="15" Click="ZoomOut_Click" ToolTip="Zoom out" />
        <TextBlock Name="ZoomIndicatorText" MinWidth="54" Margin="8,0" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" Text="100%" />
        <ui:Button Width="34" Height="30" Padding="0" Content="+" FontSize="15" Click="ZoomIn_Click" ToolTip="Zoom in" />
        <ui:Button Height="30" Margin="10,0,0,0" Padding="12,0" Content="Reset" Click="ZoomReset_Click" />
      </StackPanel>
    </Border>
    <Border x:Name="StatusBarHost" Grid.Row="2" VerticalAlignment="Bottom" Height="52" CornerRadius="0" Padding="16,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlElevationBorderBrush}" Background="{ui:ThemeResource ControlFillColorDefaultBrush}">
      <StatusBar Name="RootStatusBar" Padding="14,10" BorderThickness="0,1,0,0">
        <Control.Background>
          <SolidColorBrush Opacity="0" Color="{ui:ThemeResource ApplicationBackgroundColor}" />
        </Control.Background>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
            </Grid>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <StatusBarItem Grid.Column="0" Margin="0,0,4,0">
          <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" Foreground="{DynamicResource SystemAccentBrush}" AutomationProperties.Name="{x:Static resources:Strings.Menu_TestMode}" IsChecked="{Binding TestModeEnabled, Mode=TwoWay}" />
            <TextBlock Padding="10,0,0,0" VerticalAlignment="Center" FontSize="14" Text="{x:Static resources:Strings.Menu_TestMode}" />
          </StackPanel>
        </StatusBarItem>
        <StatusBarItem Grid.Column="2" Padding="0,0,8,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid VerticalAlignment="Center" Margin="0,0,8,0">
              <ui:Button Name="LaunchTargetButton" Height="34" Padding="10,0" Appearance="Secondary" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="LaunchTargetButton_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" Text="{Binding SelectedLaunchTargetName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                  <ui:SymbolIcon FontSize="11" VerticalAlignment="Center" Symbol="ChevronUp24" RenderTransformOrigin="0.5,0.5"><ui:SymbolIcon.RenderTransform><RotateTransform x:Name="LaunchTargetChevronRotate" Angle="0" /></ui:SymbolIcon.RenderTransform></ui:SymbolIcon>
                </StackPanel>
              </ui:Button>
            </Grid>
            <ui:Button Name="InstallLaunchButton" HorizontalAlignment="Center" Appearance="Primary" Background="{DynamicResource SystemAccentBrush}" Content="Install" Command="{Binding SaveAndLaunchSettingsCommand, Mode=OneWay}" />
          </StackPanel>
        </StatusBarItem>
        <StatusBarItem Grid.Column="3" Padding="0,0,9,0">
		  <ui:Button MinWidth="56.587" Appearance="Primary" Background="{DynamicResource SystemAccentBrush}" Content="{x:Static resources:Strings.Menu_Save}" Command="{Binding SaveSettingsCommand, Mode=OneWay}" Click="Button_Click_1" />
        </StatusBarItem>
        <StatusBarItem Grid.Column="4" Padding="0,0,8,0">
		  <ui:Button MinWidth="56.587" HorizontalAlignment="Center" Appearance="Secondary" Content="{x:Static resources:Strings.Common_Close}" Command="{Binding CloseWindowCommand, Mode=OneTime}" Click="Button_Click_2" />
        </StatusBarItem>
      </StatusBar>
    </Border>
    <Grid x:Name="LaunchTargetOverlay" Grid.RowSpan="3" Panel.ZIndex="1100" Visibility="Collapsed" Opacity="0">
      <Border Background="#99000000" MouseLeftButtonDown="LaunchTargetScrim_MouseLeftButtonDown" />
      <Border x:Name="LaunchTargetPanel" Width="600" Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20,18,20,14" Background="{DynamicResource LauncherMenuBrush}" BorderBrush="{StaticResource LauncherMenuBorderBrush}" BorderThickness="1" CornerRadius="10" SnapsToDevicePixels="True">
        <Border.RenderTransform>
          <TranslateTransform x:Name="LaunchTargetPanelTranslate" Y="28" />
        </Border.RenderTransform>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="24" FontWeight="Bold" Foreground="{StaticResource LauncherTextPrimaryBrush}" Text="Choose Roblox version" />
            <ui:Button Grid.Column="1" Width="34" Height="34" Padding="0" Appearance="Transparent" Icon="Dismiss24" ToolTip="Close" Click="LaunchTargetClose_Click" />
          </Grid>
          <TextBlock Grid.Row="1" Margin="0,6,0,16" FontSize="13" Foreground="{StaticResource LauncherTextSecondaryBrush}" Text="Select what Save and Launch should start." TextWrapping="Wrap" />
          <vscontrols:RobloxVersionList x:Name="LaunchTargetList" Grid.Row="2" MaxHeight="470" ItemChosen="LaunchTargetList_ItemChosen" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</base:WpfUiWindow>
