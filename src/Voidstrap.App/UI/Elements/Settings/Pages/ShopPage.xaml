<ui:UiPage x:Class="Voidstrap.UI.Elements.Settings.Pages.ShopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Shop" Scrollable="False" Loaded="Page_Loaded" Unloaded="Page_Unloaded">
  <Grid Margin="0,0,14,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ui:SymbolIcon Symbol="Cart24" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center" />
        <TextBlock Text="Shop" FontSize="20" FontWeight="Medium" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <ui:Button Content="Back" Icon="ArrowLeft24" Appearance="Secondary" Click="Back_Click" />
        <ui:Button x:Name="RefreshButton" Margin="8,0,0,0" Content="Refresh" Icon="ArrowClockwise24" Appearance="Secondary" Click="Refresh_Click" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
      <ui:Button x:Name="ShopTabButton" Content="Shop" Icon="Cart24" Appearance="Secondary" IsEnabled="False" Click="ShopTab_Click" />
      <ui:Button x:Name="MarketTabButton" Margin="8,0,0,0" Appearance="Secondary" Click="MarketTab_Click">
        <StackPanel Orientation="Horizontal">
          <Image x:Name="MarketTabIcon" Width="16" Height="16" Margin="0,0,8,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
          <TextBlock Text="Black Market" VerticalAlignment="Center" />
        </StackPanel>
      </ui:Button>
    </StackPanel>

    <StackPanel Grid.Row="2" Margin="0,0,0,12">
      <Border Padding="14"
              CornerRadius="8"
              Background="{DynamicResource ControlFillColorDefaultBrush}"
              BorderBrush="{DynamicResource ControlElevationBorderBrush}"
              BorderThickness="1">
        <StackPanel>
          <Grid>
            <TextBlock x:Name="LevelText" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="LevelXpText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          </Grid>
          <ProgressBar x:Name="LevelBar"
                       Height="10"
                       Margin="0,8,0,0"
                       Minimum="0"
                       Maximum="100"
                       BorderThickness="0"
                       Background="{DynamicResource ControlFillColorSecondaryBrush}"
                       Value="0" />
          <TextBlock x:Name="EarnedText" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Border>
    </StackPanel>

    <Grid Grid.Row="3">
      <ui:ProgressRing x:Name="LoadingRing" IsIndeterminate="True" Width="32" Height="32"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
      <TextBlock x:Name="StatusText" Text="" TextWrapping="Wrap" Opacity="0.75"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
      <ScrollViewer x:Name="ItemsScroller" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <ItemsControl x:Name="ItemsHost">
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
</ui:UiPage>
