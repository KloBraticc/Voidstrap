<ui:UiPage x:Class="Voidstrap.UI.Elements.Settings.Pages.MorePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:resources="clr-namespace:Voidstrap.Resources" Title="{resources:Loc Ui_Nav_More}" Scrollable="True">
  <StackPanel Margin="0,0,14,14">
    <TextBlock Margin="0,0,0,12" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Ui_Misc2_ExtraPagesGroupedUnderMoreIn}" />
    <ui:CardAction Icon="GlobeLocation20" Margin="0,0,0,8" Click="OpenGlobal_Click">
      <StackPanel>
        <TextBlock FontSize="14" Text="{resources:Loc Ui_Nav_Global}" />
        <TextBlock Margin="0,2,0,0" Padding="0,0,16,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Misc2_EditRobloxSOwnInGame}" />
      </StackPanel>
    </ui:CardAction>
    <ui:CardAction Icon="Apps24" Margin="0,0,0,8" Click="OpenShortcuts_Click">
      <StackPanel>
        <TextBlock FontSize="14" Text="{resources:Loc Common_Shortcuts}" />
        <TextBlock Margin="0,2,0,0" Padding="0,0,16,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Menu_Shortcuts_Description}" />
      </StackPanel>
    </ui:CardAction>
    <ui:CardAction Icon="News20" Margin="0,0,0,8" Click="OpenNews_Click">
      <StackPanel>
        <TextBlock FontSize="14" Text="{resources:Loc Ui_Nav_News}" />
        <TextBlock Margin="0,2,0,0" Padding="0,0,16,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Misc2_ReadVoidstrapNewsUpdatesAndForum}" />
      </StackPanel>
    </ui:CardAction>
  </StackPanel>
</ui:UiPage>
