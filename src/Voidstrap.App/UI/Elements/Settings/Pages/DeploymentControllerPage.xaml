<ui:UiPage x:Class="Voidstrap.UI.Elements.Settings.Pages.DeploymentControllerPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls"
           xmlns:resources="clr-namespace:Voidstrap.Resources"
           xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
           Title="DeploymentControllerPage" ui:Breadcrumb.Header="{resources:Loc Ui_Controller_Tab}" Scrollable="True"
           Loaded="OnPageLoaded" Unloaded="OnPageUnloaded">
  <StackPanel Margin="0,0,14,14">
    <controls:OptionControl Header="{resources:Loc Ui_Controller_Device}">
      <StackPanel Orientation="Horizontal">
        <ComboBox MinWidth="170" ItemsSource="{Binding ControllerDevices}" DisplayMemberPath="Display" SelectedValuePath="Id"
                  SelectedValue="{Binding SelectedControllerId, Mode=TwoWay}" />
        <ui:Button Margin="8,0,0,0" Icon="ArrowSync24" ToolTip="{resources:Loc Ui_Controller_Refresh}"
                   AutomationProperties.Name="{resources:Loc Ui_Controller_Refresh}" Click="ControllerRefresh_Click" />
      </StackPanel>
    </controls:OptionControl>
    <controls:OptionControl Header="{resources:Loc Ui_Controller_LeftTrigger}">
      <ComboBox MinWidth="170" SelectedIndex="{Binding DualSenseLeftTrigger, Mode=TwoWay}">
        <ComboBoxItem Content="{resources:Loc Ui_Sound_Equalizer_Off}" />
        <ComboBoxItem Content="{resources:Loc Ui_Controller_Light}" />
        <ComboBoxItem Content="{resources:Loc Ui_Controller_Strong}" />
        <ComboBoxItem Content="{resources:Loc Ui_Controller_Fps}" />
      </ComboBox>
    </controls:OptionControl>
    <controls:OptionControl Header="{resources:Loc Ui_Controller_LeftStrength}">
      <StackPanel Orientation="Horizontal">
        <Slider Width="130" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                AutomationProperties.Name="{resources:Loc Ui_Controller_LeftStrength}" Value="{Binding DualSenseLeftStrength, Mode=TwoWay}" />
        <TextBlock Width="48" TextAlignment="Right" Text="{Binding DualSenseLeftStrength, StringFormat={}{0}%}" />
      </StackPanel>
    </controls:OptionControl>
    <controls:OptionControl Header="{resources:Loc Ui_Controller_RightTrigger}">
      <ComboBox MinWidth="170" SelectedIndex="{Binding DualSenseRightTrigger, Mode=TwoWay}">
        <ComboBoxItem Content="{resources:Loc Ui_Sound_Equalizer_Off}" />
        <ComboBoxItem Content="{resources:Loc Ui_Controller_Light}" />
        <ComboBoxItem Content="{resources:Loc Ui_Controller_Strong}" />
        <ComboBoxItem Content="{resources:Loc Ui_Controller_Fps}" />
      </ComboBox>
    </controls:OptionControl>
    <controls:OptionControl Header="{resources:Loc Ui_Controller_RightStrength}">
      <StackPanel Orientation="Horizontal">
        <Slider Width="130" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                AutomationProperties.Name="{resources:Loc Ui_Controller_RightStrength}" Value="{Binding DualSenseRightStrength, Mode=TwoWay}" />
        <TextBlock Width="48" TextAlignment="Right" Text="{Binding DualSenseRightStrength, StringFormat={}{0}%}" />
      </StackPanel>
    </controls:OptionControl>
    <Expander Margin="0,6,0,0" Header="{resources:Loc Ui_Controller_Vibration}" IsExpanded="False">
      <StackPanel Margin="0,6,0,0">
        <controls:OptionControl Header="{resources:Loc Ui_Controller_EnableRobloxHaptics}" Description="{resources:Loc Ui_Controller_HapticsConflictWarning}">
          <ui:ToggleSwitch IsChecked="{Binding ControllerGlobalSettings.ControllerVibration, Mode=TwoWay}" />
        </controls:OptionControl>
        <controls:OptionControl Header="{resources:Loc Ui_Controller_TriggerVibration}" Description="{resources:Loc Ui_Controller_TriggerVibrationDescription}">
          <ComboBox MinWidth="170" SelectedIndex="{Binding DualSenseVibration, Mode=TwoWay}">
            <ComboBoxItem Content="{resources:Loc Ui_Sound_Equalizer_Off}" />
            <ComboBoxItem Content="{resources:Loc Ui_Controller_Light}" />
            <ComboBoxItem Content="{resources:Loc Ui_Controller_Strong}" />
            <ComboBoxItem Content="{resources:Loc Ui_Controller_Fps}" />
          </ComboBox>
        </controls:OptionControl>
        <controls:OptionControl Header="{resources:Loc Ui_Controller_VibrationStrength}">
          <StackPanel Orientation="Horizontal">
            <Slider Width="130" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                    AutomationProperties.Name="{resources:Loc Ui_Controller_VibrationStrength}" Value="{Binding DualSenseVibrationStrength, Mode=TwoWay}" />
            <TextBlock Width="48" TextAlignment="Right" Text="{Binding DualSenseVibrationStrength, StringFormat={}{0}%}" />
          </StackPanel>
        </controls:OptionControl>
        <controls:OptionControl Header="{resources:Loc Ui_Controller_Hold}" Description="{resources:Loc Ui_Controller_HoldDescription}">
          <ui:ToggleSwitch IsChecked="{Binding DualSenseVibrateWhileHeld, Mode=TwoWay}" />
        </controls:OptionControl>
        <controls:OptionControl Header="{resources:Loc Ui_Controller_HoldTriggers}" IsEnabled="{Binding DualSenseVibrateWhileHeld}">
          <ComboBox MinWidth="170" SelectedIndex="{Binding DualSenseHoldTriggers, Mode=TwoWay}"
                    AutomationProperties.Name="{resources:Loc Ui_Controller_HoldTriggers}">
            <ComboBoxItem Content="{resources:Loc Ui_SessionNotify_Both}" />
            <ComboBoxItem Content="{resources:Loc Ui_Mods_Left}" />
            <ComboBoxItem Content="{resources:Loc Ui_Mods_Right}" />
          </ComboBox>
        </controls:OptionControl>
        <controls:OptionControl Header="{resources:Loc Ui_Controller_PulseLength}" IsEnabled="{Binding DualSenseUsesPulse}">
          <StackPanel Orientation="Horizontal">
            <Slider Width="130" Minimum="50" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True"
                    AutomationProperties.Name="{resources:Loc Ui_Controller_PulseLength}" Value="{Binding DualSensePulseLength, Mode=TwoWay}" />
            <TextBlock Width="48" TextAlignment="Right" Text="{Binding DualSensePulseLength, StringFormat={}{0}%}" />
          </StackPanel>
        </controls:OptionControl>
      </StackPanel>
    </Expander>
    <ui:Button x:Name="ControllerPreviewButton" HorizontalAlignment="Left" Margin="0,8,0,0" Icon="Games24"
               Content="{resources:Loc Ui_Controller_Preview}" Click="ControllerPreview_Click" />
    <TextBlock x:Name="ControllerPreviewStatus" Margin="0,6,0,0" TextWrapping="Wrap"
               Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
</ui:UiPage>
