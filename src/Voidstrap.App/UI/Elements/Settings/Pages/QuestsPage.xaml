<ui:UiPage x:Class="Voidstrap.UI.Elements.Settings.Pages.QuestsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:util="clr-namespace:Voidstrap.Utility"
    Title="Quests" Scrollable="False" Loaded="Page_Loaded" Unloaded="Page_Unloaded">
  <Grid Margin="0,0,14,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ui:SymbolIcon Symbol="TaskListSquareLtr24" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center" />
        <TextBlock Text="Daily quests" FontSize="20" FontWeight="Medium" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <ui:Button Content="Back" Icon="ArrowLeft24" Appearance="Secondary" Click="Back_Click" />
        <ui:Button x:Name="RefreshButton" Margin="8,0,0,0" Content="Refresh" Icon="ArrowClockwise24" Appearance="Secondary" Click="Refresh_Click" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <Border Padding="14"
              CornerRadius="8"
              Background="{DynamicResource ControlFillColorDefaultBrush}"
              BorderBrush="{DynamicResource ControlElevationBorderBrush}"
              BorderThickness="1">
        <StackPanel>
          <Grid>
            <TextBlock x:Name="LevelText" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="LevelXpText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          </Grid>
          <ProgressBar x:Name="LevelBar"
                       Height="10"
                       Margin="0,8,0,0"
                       Minimum="0"
                       Maximum="100"
                       BorderThickness="0"
                       Background="{DynamicResource ControlFillColorSecondaryBrush}"
                       Value="0" />
          <TextBlock x:Name="EarnedText" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Border>
      <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
    </StackPanel>

    <ui:DynamicScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="QuestList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border CornerRadius="8"
                    Margin="0,0,0,10"
                    Padding="14"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                  <StackPanel>
                    <TextBlock Text="{Binding Kind}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Medium" TextWrapping="Wrap" Margin="0,2,120,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  </StackPanel>
                  <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="{Binding StatusBrush}" />
                  </StackPanel>
                </Grid>
                <ProgressBar Grid.Row="1"
                             Height="10"
                             Margin="0,12,0,0"
                             Minimum="0"
                             Maximum="100"
                             BorderThickness="0"
                             Background="{DynamicResource ControlFillColorSecondaryBrush}"
                             Foreground="{Binding BarBrush}"
                             Value="{Binding Percent, Mode=OneWay}" />
                <Border Grid.Row="2" Margin="0,12,0,0" Padding="10" CornerRadius="6"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasGame}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="56" Height="56" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Top"
                            Background="{DynamicResource ControlFillColorTertiaryBrush}">
                      <Border.OpacityMask>
                        <VisualBrush>
                          <VisualBrush.Visual>
                            <Border Width="56" Height="56" CornerRadius="8" Background="White" />
                          </VisualBrush.Visual>
                        </VisualBrush>
                      </Border.OpacityMask>
                      <Image Stretch="UniformToFill"
                             RenderOptions.BitmapScalingMode="HighQuality"
                             util:DynamicRenderSystem.LazyImageSource="{Binding IconUrl}" />
                    </Border>
                    <StackPanel Grid.Column="1">
                      <Grid>
                        <StackPanel Margin="0,0,96,0">
                          <TextBlock Text="{Binding GameName}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                          <TextBlock Text="{Binding GameStats}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <ui:Button Content="Join game"
                                   Tag="{Binding}"
                                   Click="Join_Click"
                                   Appearance="Secondary"
                                   Padding="10,4"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top" />
                      </Grid>
                      <TextBlock Text="{Binding GameDescription}" FontSize="12" TextWrapping="Wrap" MaxHeight="52" Margin="0,6,0,0"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:Button Content="{Binding LikeLabel}" Tag="{Binding}" Click="Like_Click" Appearance="Secondary" Padding="9,3" FontSize="12" />
                        <ui:Button Content="{Binding DislikeLabel}" Tag="{Binding}" Click="Dislike_Click" Appearance="Secondary" Padding="9,3" FontSize="12" Margin="6,0,0,0" />
                        <TextBlock Text="{Binding RatioText}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ui:DynamicScrollViewer>
  </Grid>
</ui:UiPage>
