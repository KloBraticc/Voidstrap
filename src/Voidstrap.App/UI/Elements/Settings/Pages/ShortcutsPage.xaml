<ui:UiPage x:Class="Voidstrap.UI.Elements.Settings.Pages.ShortcutsPage" xmlns:uianim="clr-namespace:Wpf.Ui.Animations;assembly=Wpf.Ui" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dmodels="clr-namespace:Voidstrap.UI.ViewModels.Settings" xmlns:local="clr-namespace:Voidstrap.UI.Elements.Settings.Pages" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:util="clr-namespace:Voidstrap.Utility" xmlns:appUi="clr-namespace:Voidstrap.UI" Title="ShortcutsPage" Scrollable="True" Loaded="Page_Loaded" Unloaded="Page_Unloaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Voidstrap;component/UI/Elements/Controls/ShortcutAppearanceResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Margin="0,0,14,14">
    <TextBlock uianim:Transitions.HoldStill="True" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Menu_Shortcuts_Description}" />
    <controls:OptionControl Margin="0,0,0,12" Header="{resources:Loc Menu_Shortcuts_ExtractIcons_Title}" HelpLink="https://wiki.voidstrapp.pages.dev/features/launching/#shortcuts" Description="{Binding Source={resources:Loc Menu_Shortcuts_ExtractIcons_Description}, Converter={StaticResource StringFormatConverter}, ConverterParameter=https://wiki.voidstrapp.pages.dev/features/launching/#shortcuts}">
      <ui:ToggleSwitch IsChecked="{Binding ExtractIconsTask.NewState, Mode=TwoWay}" />
    </controls:OptionControl>
    <TextBlock FontSize="20" FontWeight="Medium" Text="{resources:Loc Menu_Shortcuts_General_Title}" />
    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Menu_Shortcuts_General_Description}" />
    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <controls:OptionControl Grid.Column="0" Header="{resources:Loc Common_Shortcuts_Desktop}">
        <ui:ToggleSwitch IsChecked="{Binding DesktopIconTask.NewState, Mode=TwoWay}" />
      </controls:OptionControl>
      <controls:OptionControl x:Name="StartMenuOption" Grid.Column="1" Header="{resources:Loc Common_Shortcuts_StartMenu}">
        <ui:ToggleSwitch IsChecked="{Binding StartMenuIconTask.NewState, Mode=TwoWay}" />
      </controls:OptionControl>
    </Grid>
    <TextBlock FontSize="20" FontWeight="Medium" Text="{resources:Loc Menu_Shortcuts_Function_Title}" />
    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Menu_Shortcuts_Function_Description}" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,8,0">
        <controls:OptionControl Margin="0" Header="{resources:Loc LaunchMenu_LaunchRoblox}">
          <ui:ToggleSwitch IsChecked="{Binding PlayerIconTask.NewState, Mode=TwoWay}" />
        </controls:OptionControl>
        <ui:CardExpander Margin="0,8,0,0" IsExpanded="False" Header="{resources:Loc Menu_Shortcuts_Customize}">
          <ContentControl Content="{Binding PlayerIconTask}" ContentTemplate="{StaticResource ShortcutAppearanceTemplate}" />
        </ui:CardExpander>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,8,0">
        <controls:OptionControl Margin="0" Header="{resources:Loc Common_RobloxStudio}">
          <ui:ToggleSwitch IsChecked="{Binding StudioIconTask.NewState, Mode=TwoWay}" />
        </controls:OptionControl>
        <ui:CardExpander Margin="0,8,0,0" IsExpanded="False" Header="{resources:Loc Menu_Shortcuts_Customize}">
          <ContentControl Content="{Binding StudioIconTask}" ContentTemplate="{StaticResource ShortcutAppearanceTemplate}" />
        </ui:CardExpander>
      </StackPanel>
      <StackPanel Grid.Column="2" Margin="0,0,0,0">
        <controls:OptionControl Margin="0" Header="{resources:Loc Menu_Title}">
          <ui:ToggleSwitch IsChecked="{Binding SettingsIconTask.NewState, Mode=TwoWay}" />
        </controls:OptionControl>
        <ui:CardExpander Margin="0,8,0,0" IsExpanded="False" Header="{resources:Loc Menu_Shortcuts_Customize}">
          <ContentControl Content="{Binding SettingsIconTask}" ContentTemplate="{StaticResource ShortcutAppearanceTemplate}" />
        </ui:CardExpander>
      </StackPanel>
    </Grid>
    <ui:CardExpander Margin="0,12,0,0" IsExpanded="False">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock FontSize="14" FontWeight="Medium" Text="{resources:Loc Ui_Pages_GameShortcut}" />
          <TextBlock Margin="0,2,0,0" FontSize="12" Text="{resources:Loc Ui_Pages_LaunchAGameNowOrCreate}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <StackPanel x:Name="GameShortcutPanel">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="64" Height="64" CornerRadius="10" Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center" util:RoundedClip.Radius="10">
            <Grid>
              <ui:SymbolIcon Symbol="Games24" FontSize="26" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              <Border Visibility="{Binding IsIconVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border.Background>
                  <ImageBrush Stretch="UniformToFill" ImageSource="{Binding GameIconUrl, Converter={StaticResource WindowsOnlyImageSourceConverter}, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
                </Border.Background>
                <Image util:DynamicRenderSystem.LinuxImageSource="{Binding GameIconUrl}" Stretch="UniformToFill" Visibility="{x:Static appUi:PlatformFeatureVisibility.PortableImages}" />
              </Border>
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding DisplayGameName}" ToolTip="{Binding DisplayGameName}" />
            <ui:TextBox Margin="0,6,0,0" PlaceholderText="{resources:Loc Ui_Pages_Example1818}" AutomationProperties.Name="{resources:Loc Menu_Integrations_Custom_GameID}" Text="{Binding GameID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>
        <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Pages_UseThePlaceIDFromThe}" TextWrapping="Wrap" />
        <Border Height="1" Margin="0,14" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <StackPanel Visibility="{Binding IsSubplaceMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock FontWeight="Medium" Text="{resources:Loc Enums_ServerType_Private}" />
              <TextBlock Margin="0,2,12,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Pages_UseAPrivateServerShareLink}" TextWrapping="Wrap" />
            </StackPanel>
            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="{resources:Loc Enums_ServerType_Private}" IsChecked="{Binding IsPrivateServer, Mode=TwoWay}" />
          </Grid>
          <ui:TextBox Margin="0,10,0,0" PlaceholderText="{resources:Loc Ui_Pages_PasteTheCompletePrivateServerLink}" AutomationProperties.Name="{resources:Loc Ui_Pages_ShareLinkOrAccessCode}" Text="{Binding PrivateServerCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsPrivateServer, Converter={StaticResource BoolToVisibilityConverter}}" />
          <Border Height="1" Margin="0,14" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock FontWeight="Medium" Text="{resources:Loc Shortcuts_SubplaceTab}" />
            <TextBlock Margin="0,2,12,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Shortcuts_SubplaceDescription}" TextWrapping="Wrap" />
          </StackPanel>
          <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="{resources:Loc Shortcuts_SubplaceTab}" IsChecked="{Binding IsSubplaceMode, Mode=TwoWay}" />
        </Grid>
        <StackPanel Margin="0,10,0,0" Visibility="{Binding IsSubplaceMode, Converter={StaticResource BoolToVisibilityConverter}}">
          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Subplaces}" SelectedItem="{Binding SelectedSubplace, Mode=TwoWay}" IsEnabled="{Binding CanLoadSubplaces}" AutomationProperties.Name="{resources:Loc Shortcuts_SubplaceTab}" ToolTip="{Binding SelectedSubplace.DisplayName}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,2,16,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="32" Height="32" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <Grid>
                      <ui:SymbolIcon Symbol="Games24" FontSize="20" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                      <Image util:DynamicRenderSystem.LazyImageSource="{Binding IconUrl}" Stretch="UniformToFill" />
                    </Grid>
                  </Border>
                  <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Margin="0,6,0,0" FontSize="12" Text="{Binding SubplaceStatus}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock Margin="0,2,0,0" FontSize="12" Text="{resources:Loc Shortcuts_SubplaceAccess}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>
        <StackPanel Visibility="{Binding IsPublicServer, Converter={StaticResource BoolToVisibilityConverter}}">
          <Border Height="1" Margin="0,14" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
          <TextBlock FontWeight="Medium" Text="{resources:Loc Ui_Pages_ServerInstanceID}" />
          <ui:TextBox Margin="0,6,0,0" PlaceholderText="{resources:Loc Ui_Pages_OptionalPublicServerInstance}" AutomationProperties.Name="{resources:Loc Ui_Pages_ServerInstanceID}" Text="{Binding GameInstanceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
          <ui:Button x:Name="LaunchGameButton" Appearance="Primary" Icon="Play24" Content="{resources:Loc Ui_Pages_LaunchGame}" IsEnabled="{Binding CanLaunchGame}" Click="BtnLaunchGame_Click" />
          <ui:Button x:Name="CreateGameShortcutButton" Margin="8,0,0,0" Icon="Desktop24" Content="{resources:Loc Ui_Pages_CreateDesktopShortcut}" IsEnabled="{Binding CanLaunchGame}" Click="BtnCreateShortcut_Click" />
        </StackPanel>
      </StackPanel>
    </ui:CardExpander>
  </StackPanel>
</ui:UiPage>
