<ui:UiPage x:Class="Voidstrap.UI.Elements.Settings.Pages.ChannelPage" xmlns:pages="clr-namespace:Voidstrap.UI.Elements.Settings.Pages" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:platform="clr-namespace:Voidstrap.UI" xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Voidstrap.UI.Elements.Settings.Pages" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:Voidstrap.UI.ViewModels.Settings" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Settings" Scrollable="False" Loaded="OnChannelPageLoaded" Unloaded="OnChannelPageUnloaded">
  <ui:DynamicScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
    <StackPanel Margin="0,0,14,14">
      <TextBlock Margin="0,0,0,8" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Channel_Description}" />
      <TabControl x:Name="SettingsTabs" Margin="0,12,0,0">

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <Image Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Voidstrap.png" />
            <TextBlock Text="Voidstrap" />
          </StackPanel>
        </TabItem.Header>
        <StackPanel Margin="10">
          <TextBlock Margin="0,0,0,4" FontSize="20" FontWeight="Medium" Text="Voidstrap" />
          <controls:OptionControl Header="Install Location" Description="Move where Voidstrap is installed. The app restarts automatically when done." Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <StackPanel>
              <ui:TextBox Width="360" Margin="0,0,0,6" Text="{Binding InstallLocationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <StackPanel Orientation="Horizontal">
                <Button Content="Browse..." Margin="0,0,5,0" Command="{Binding BrowseInstallLocationCommand}" />
                <Button Content="Move" Visibility="{Binding MoveButtonVisibility}" Command="{Binding ApplyInstallLocationCommand}" />
              </StackPanel>
            </StackPanel>
          </controls:OptionControl>
          <controls:OptionControl Header="Voidstrap CPU limit" Description="Limits Voidstrap's own processor affinity. Leave it at the maximum unless another active app needs reserved cores.">
            <ComboBox Grid.Column="1" Margin="8,0,8,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding CpuLimitOptions}" SelectedItem="{Binding SelectedCpuLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </controls:OptionControl>
          <controls:OptionControl Header="{x:Static resources:Strings.Menu_Behaviour_AutoUpdate_Title}" Description="{x:Static resources:Strings.Menu_Behaviour_AutoUpdate_Description}">
            <ui:ToggleSwitch IsChecked="{Binding UpdateCheckingEnabled, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="Include pre-release versions" Description="Updates to test builds as soon as they are published. These are less tested than normal releases and can break, so leave this off unless you want early builds.">
            <ui:ToggleSwitch IsChecked="{Binding AllowPreReleaseUpdates, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="Check for Updates" Description="Check for any available Voidstrap updates.">
            <StackPanel>
              <Button Content="Check for Updates" HorizontalAlignment="Left" Click="Check_Click" />
            </StackPanel>
          </controls:OptionControl>
          <controls:OptionControl Header="Global Settings" Description="Applies your current settings to every bootstrapper installed.">
            <StackPanel>
              <Button Content="Apply" HorizontalAlignment="Left" Click="ApplyNow_Click" />
            </StackPanel>
          </controls:OptionControl>
          <controls:OptionControl Header="Launch Roblox without Voidstrap" Description="Joining a game from your browser opens Roblox directly, and launching from Voidstrap closes it once Roblox starts. Overlays and every other in game Voidstrap feature stop working." Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ui:ToggleSwitch IsChecked="{Binding LaunchWithoutVoidstrap, Mode=TwoWay}" />
          </controls:OptionControl>
          <Expander Header="Display and Resolution" IsExpanded="False" Margin="0,8,0,0" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <StackPanel Margin="0,4,0,0">
                            <Border CornerRadius="8" Padding="10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                <StackPanel>
                  <ItemsControl HorizontalAlignment="Center" ItemsSource="{Binding Monitors}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas Width="540" Height="190" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="{x:Type ContentPresenter}">
                        <Setter Property="Canvas.Left" Value="{Binding CanvasX}" />
                        <Setter Property="Canvas.Top" Value="{Binding CanvasY}" />
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Width="{Binding BoxWidth}" Height="{Binding BoxHeight}" Cursor="Hand" ToolTip="{Binding FriendlyName}" Command="{Binding DataContext.SelectMonitorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                          <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                              <Border Name="MonitorBox" CornerRadius="6" BorderThickness="1" Background="#2E3036" BorderBrush="#3F434C">
                                <TextBlock Name="MonitorNumber" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="26" FontWeight="SemiBold" Foreground="#E6E6EA" Text="{Binding Number}" />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="MonitorBox" Property="Background" Value="#3A3D45" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                  <Setter TargetName="MonitorBox" Property="Background" Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                  <Setter TargetName="MonitorBox" Property="BorderBrush" Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                                  <Setter TargetName="MonitorNumber" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </DataTrigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Button.Template>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid Margin="0,8,0,0">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,110,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SelectedMonitorSummary}" />
                    <ui:Button HorizontalAlignment="Right" Content="Identify" Command="{Binding IdentifyMonitorsCommand}" />
                  </Grid>
                </StackPanel>
              </Border>
              <controls:OptionControl Header="Resolution Changer" Description="Changes the resolution of the selected monitor.">
                <ComboBox DisplayMemberPath="DisplayName" Width="220" ItemsSource="{Binding AvailableResolutions}" SelectedItem="{Binding SelectedResolution, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl Header="Resolution Changer (In Game)" Description="Applies to the selected monitor while you are in a Roblox game, then restores your previous resolution when you leave.">
                <StackPanel>
                  <CheckBox Content="Only apply for a specific PlaceId" IsChecked="{Binding UsePlaceId, Mode=TwoWay}" />
                  <TextBox Width="220" HorizontalAlignment="Left" Margin="0,6,0,0" Text="{Binding PlaceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UsePlaceId}" />
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ComboBox DisplayMemberPath="DisplayName" Width="220" ItemsSource="{Binding AvailableResolutionsInGame}" SelectedItem="{Binding SelectedResolutionInGame, Mode=TwoWay}" />
                    <ui:Button Margin="8,0,0,0" Content="Clear" Command="{Binding ClearInGameResolutionCommand}" />
                  </StackPanel>
                </StackPanel>
              </controls:OptionControl>
            </StackPanel>
          </Expander>
                    <Expander Header="App Settings" IsExpanded="False" Margin="0,8,0,0">
                        <StackPanel>
                            <controls:OptionControl Header="Hardware acceleration" Description="Uses the GPU to render Voidstrap. Turn this off for compatibility or lower video memory usage.">
                                <ui:ToggleSwitch IsChecked="{Binding HWAccelEnabled, Mode=TwoWay}" />
                            </controls:OptionControl>
                            <controls:OptionControl Description="Displays Voidstrap notifications, joined servers, and more." Header="App Notifications">
                                <ui:ToggleSwitch IsChecked="{Binding VoidNotify, Mode=TwoWay}" />
                            </controls:OptionControl>
                            <controls:OptionControl Description="Displays Voidstraps discord RPC." Header="Voidstrap RPC">
                                <ui:ToggleSwitch IsChecked="{Binding VoidRPC, Mode=TwoWay}" />
                            </controls:OptionControl>
                        </StackPanel>
                    </Expander>
                    <StackPanel Orientation="Horizontal">
            <ui:Button Content="Factory reset" Appearance="Danger" Margin="0,8,8,0" Icon="ArrowReset24" Click="ResetSettingsButton_Click" />
            <ui:Button Content="Donate" Icon="Heart24" Margin="0,8,8,0" Click="DonateButton_Click" />
            <ui:Button Content="Logs" Icon="DocumentText24" Margin="0,8,8,0" Click="LogsButton_Click" />
            <ui:Button Content="Uninstall" Icon="Delete24" Margin="0,8,8,0" Click="UninstallButton_Click" />
          </StackPanel>
        </StackPanel>
      </TabItem>

      <TabItem Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,6,0" />
            <TextBlock Text="Installer" />
          </StackPanel>
        </TabItem.Header>
        <StackPanel Margin="10">
          <TextBlock Margin="0,0,0,4" FontSize="20" FontWeight="Medium" Text="Installer" />
          <controls:OptionControl Header="Download server" Description="Used when Roblox is installed or updated" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
			<ComboBox Width="280" Padding="10,5,10,5" DisplayMemberPath="Display" ItemsSource="{Binding MirrorChoices}" SelectedItem="{Binding SelectedMirrorChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </controls:OptionControl>
          <controls:OptionControl Header="Download Buffer Size (KB)" Description="Larger buffers can speed up downloads on fast connections" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
			<ComboBox Width="200" Margin="5,0,0,0" Padding="10,5,10,5" ItemsSource="{Binding DownloadBufferOptions}" SelectedItem="{Binding DownloadBufferKb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </controls:OptionControl>
          <controls:OptionControl Header="Concurrent Downloads" Description="How many packages download at the same time. Higher is faster but uses more bandwidth" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
			<ComboBox Width="200" Margin="5,0,0,0" Padding="10,5,10,5" ItemsSource="{Binding ConcurrentDownloadOptions}" SelectedItem="{Binding MaxConcurrentDownloads, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </controls:OptionControl>
          <controls:OptionControl Header="Segments Per File" Description="Splits each package into parallel chunks for faster downloading" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
			<ComboBox Width="200" Margin="5,0,0,0" Padding="10,5,10,5" ItemsSource="{Binding DownloadSegmentOptions}" SelectedItem="{Binding MaxDownloadSegments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </controls:OptionControl>
          <controls:OptionControl Header="Static directory" Description="Switch from version-xxx to BinaryType based install directories." Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ui:ToggleSwitch IsChecked="{Binding StaticDirectory, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="Compress Roblox installs" Description="Packs Roblox into a compressed archive while they are closed, about 40% smaller on disk. Only the one you launch is unpacked first, which takes a second or two." Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ui:ToggleSwitch IsChecked="{Binding CompressRobloxInstalls, Mode=TwoWay}" />
          </controls:OptionControl>
                </StackPanel>
      </TabItem>

      <TabItem x:Name="GameSettingsTab" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <Image Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Resources/RobloxPlayerIcon.png" />
            <TextBlock Text="Game" />
          </StackPanel>
        </TabItem.Header>
        <StackPanel Margin="10">
          <TextBlock Margin="0,0,0,4" FontSize="20" FontWeight="Medium" Text="Game" />
                        <ui:CardControl Margin="0,8,0,0" Focusable="False" Visibility="{x:Static platform:PlatformFeatureVisibility.ResourceOptimization}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="Allocated Memory" />
                                        <ui:ToggleSwitch Grid.Column="4" VerticalAlignment="Center" IsChecked="{Binding RobloxMemoryLimitEnabled, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="How much memory Roblox is allowed to use" />
                                    <StackPanel IsEnabled="{Binding RobloxMemoryLimitEnabled}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                            <Border Padding="12,8" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="{Binding MemoryLimitText}" />
                                                    <TextBlock Margin="6,3,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding MemoryTotalText}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MemoryFreeText}" />
                                        </StackPanel>
                                        <Slider Margin="0,14,0,0" Tag="{Binding MemoryLimitText}" Minimum="{Binding MemoryLimitMinimumMb, Mode=OneWay}" Maximum="{Binding MemoryLimitMaximumMb, Mode=OneWay}" TickFrequency="{Binding MemoryLimitStepMb, Mode=OneWay}" SmallChange="{Binding MemoryLimitStepMb, Mode=OneWay}" LargeChange="1024" IsSnapToTickEnabled="True" Value="{Binding RobloxMemoryLimitMb, Mode=TwoWay}" />
                                        <Grid Margin="0,4,0,0">
                                            <TextBlock HorizontalAlignment="Left" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding MemoryMinimumText}" />
                                            <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding MemoryMaximumText}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardControl.Header>
                        </ui:CardControl>
                        <ui:CardControl Margin="0,8,0,0" Focusable="False" IsEnabled="{Binding UpdateRoblox}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="Game Update Delivery" />
                                    </StackPanel>
                                    <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Select when you'd like to receive Roblox game updates" />
                                    <RadioButton Margin="0,10,0,0" GroupName="RobloxUpdateDelivery" FontWeight="SemiBold" Content="Normal" IsChecked="{Binding UpdateDeliveryNormal, Mode=TwoWay}" />
                                    <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="You get each Roblox update on your next launch after it is released" />
                                    <RadioButton Margin="0,12,0,0" GroupName="RobloxUpdateDelivery" FontWeight="SemiBold" Content="Early (Opt In)" IsChecked="{Binding UpdateDeliveryEarly, Mode=TwoWay}" />
                                    <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Checks Roblox's own version server first, so a new update is picked up the moment it goes live instead of waiting for the cached copy" />
                                    <RadioButton Margin="0,12,0,0" GroupName="RobloxUpdateDelivery" FontWeight="SemiBold" Content="Late (Opt Out)" IsChecked="{Binding UpdateDeliveryLate, Mode=TwoWay}" />
                                    <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Keeps the version you have for 3 days after each Roblox update so early bugs get fixed first, then updates on its own. A missing or broken install always updates right away" />
                                </StackPanel>
                            </ui:CardControl.Header>
                        </ui:CardControl>
                        <controls:OptionControl Header="Efficiency mode" Description="{Binding EfficiencyModeDescription, Mode=OneWay}" Visibility="{x:Static platform:PlatformFeatureVisibility.ResourceOptimization}">
            <ui:ToggleSwitch IsChecked="{Binding RobloxEfficiencyMode, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="Roblox Priority" Description="{Binding RobloxPriorityDescription, Mode=OneWay}" Visibility="{x:Static platform:PlatformFeatureVisibility.ResourceOptimization}">
            <ComboBox Grid.Column="1" Margin="8,0,8,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding SelectedPriority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </controls:OptionControl>

                        <controls:OptionControl Description="{x:Static resources:Strings.Menu_Behaviour_ForceRobloxReinstall_Description}" Header="{x:Static resources:Strings.Menu_Behaviour_ForceRobloxReinstall_Title}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type controls:OptionControl}">
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding ForceRobloxReinstallation, Mode=OneTime}">
                    <Setter Property="IsEnabled" Value="False" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <ui:ToggleSwitch IsChecked="{Binding ForceRobloxReinstallation, Mode=TwoWay}" />
          </controls:OptionControl>
                        <controls:OptionControl Description="When disabled, Roblox won't update to newer versions." Header="Roblox updates" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
                            <FrameworkElement.Style>
                                <Style TargetType="{x:Type controls:OptionControl}">
                                    <Style.Triggers>
                                        <DataTrigger Value="True" Binding="{Binding ForceRobloxReinstallation, Mode=OneTime}">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </FrameworkElement.Style>
                            <ui:ToggleSwitch IsChecked="{Binding UpdateRoblox, Mode=TwoWay}" />
                        </controls:OptionControl>
                        <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <HeaderedContentControl.Header>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock FontSize="14" Text="Channels - [Roblox Build]" />
                  <TextBlock FontSize="12" Text="Enter deployment channel name. Invalid channels will cause 403-404 error!" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBox Grid.Column="1" Width="200" Margin="8,0,8,0" Padding="10,5,10,5" FontSize="13" VerticalContentAlignment="Center" ToolTip="Enter deployment channel (e.g., production, zlive, live)" MaxLength="2147483647" AcceptsReturn="False" TextWrapping="NoWrap" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" Text="{Binding ViewChannel, Mode=TwoWay, UpdateSourceTrigger=LostFocus, FallbackValue=production}" IsEnabled="{Binding IsChannelEnabled}" />
                <ui:ToggleSwitch Grid.Column="2" Margin="8,0,10,0" VerticalAlignment="Center" AutomationProperties.Name="Deployment channel" IsChecked="{Binding IsChannelEnabled, Mode=TwoWay}" />
              </Grid>
            </HeaderedContentControl.Header>
            <StackPanel>
              <FrameworkElement.Style>
                <Style TargetType="{x:Type StackPanel}">
                  <Setter Property="IsEnabled" Value="True" />
                  <Setter Property="UIElement.Opacity" Value="1" />
                  <Style.Triggers>
                    <DataTrigger Value="False" Binding="{Binding IsChannelEnabled}">
                      <Setter Property="IsEnabled" Value="False" />
                      <Setter Property="UIElement.Opacity" Value="0.5" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
              <Grid Margin="0,0,4,0">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ChannelDeployInfo}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,16,8" VerticalAlignment="Center" Text="{x:Static resources:Strings.Common_Version}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ChannelDeployInfo.Version, Mode=OneWay}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,16,8" VerticalAlignment="Center" Text="{x:Static resources:Strings.Common_VersionGuid}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ChannelDeployInfo.VersionGuid, Mode=OneWay}" />
                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,16,0,0" Orientation="Horizontal">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type StackPanel}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Value="True" Binding="{Binding ShowChannelWarning, Mode=OneWay}">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                  <Image Grid.Column="0" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Resources/MessageBox/Warning.png" />
                  <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{x:Static resources:Strings.Menu_Deployment_Channel_OutOfDate}" />
                </StackPanel>
              </Grid>
              <Grid Column="0">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ChannelDeployInfo}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:ProgressRing Grid.Column="0" Margin="6" IsIndeterminate="True">
                  <FrameworkElement.Style>
                    <Style BasedOn="{StaticResource {x:Type ui:ProgressRing}}" TargetType="{x:Type ui:ProgressRing}">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Value="True" Binding="{Binding ShowLoadingError, Mode=OneWay}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </ui:ProgressRing>
                <Image Grid.Column="0" Margin="6" Width="60" Height="60" Source="pack://application:,,,/Resources/MessageBox/Error.png">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Image}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Value="True" Binding="{Binding ShowLoadingError, Mode=OneWay}">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </Image>
                <TextBlock Grid.Column="1" Margin="16" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding ChannelInfoLoadingText, Mode=OneWay}" />
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <ui:Button Content="Apply channel" Appearance="Primary" Icon="Checkmark24" Command="{Binding ApplyChannelCommand}" />
                <Button Content="Channels" Margin="8,0,0,0" Click="OpenChannelListDialog_Click" />
              </StackPanel>
              <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Applying a different channel clears the currently downloaded Roblox version so the new channel can install" />
            </StackPanel>
          </ui:CardExpander>
          <controls:OptionControl x:Name="RobloxVersionAPP" Header="" />
          <controls:OptionControl x:Name="RenderBackendOption" Visibility="{x:Static platform:PlatformFeatureVisibility.LinuxIntegration}" Header="Renderer backend" Description="Chooses the graphics backend Voidstrap draws itself with. Automatic picks the fastest one your system supports. Changing this takes effect the next time Voidstrap starts.">
            <ComboBox Width="230" ItemsSource="{Binding RenderBackendChoices}" DisplayMemberPath="Display" SelectedItem="{Binding RenderBackendChoice, Mode=TwoWay}" />
          </controls:OptionControl>
        </StackPanel>
      </TabItem>

      </TabControl>
    </StackPanel>
  </ui:DynamicScrollViewer>
</ui:UiPage>
