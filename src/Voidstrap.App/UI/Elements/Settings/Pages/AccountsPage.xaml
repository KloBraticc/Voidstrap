<ui:UiPage
    x:Class="Voidstrap.UI.Elements.Settings.Pages.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:resources="clr-namespace:Voidstrap.Resources"
    xmlns:util="clr-namespace:Voidstrap.Utility"
    xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls"
    xmlns:platform="clr-namespace:Voidstrap.UI"
    Title="{resources:Loc Accounts_Title}"
    ui:Breadcrumb.Header="{resources:Loc Accounts_Title}"
    Scrollable="False">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="NavSideItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="ui:RinControlMotion.Enabled" Value="True" />
        <Setter Property="Margin" Value="0,0,14,4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border x:Name="MainBorder" Background="Transparent" BorderThickness="1" CornerRadius="5">
                <Grid>
                  <Rectangle x:Name="ActiveRectangle" Width="3" Height="0" Margin="-1,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0.0" RadiusX="1.5" RadiusY="1.5">
                    <Rectangle.Fill>
                      <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                    </Rectangle.Fill>
                  </Rectangle>
                  <ContentPresenter Margin="16,8" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="MainBorder" Property="Background">
                    <Setter.Value>
                      <SolidColorBrush Color="{DynamicResource SubtleFillColorSecondary}" />
                    </Setter.Value>
                  </Setter>
                  <Setter TargetName="ActiveRectangle" Property="Height" Value="17" />
                  <Setter TargetName="ActiveRectangle" Property="Opacity" Value="1" />
                  <Trigger.EnterActions>
                    <BeginStoryboard x:Name="PillSelected">
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="ActiveRectangle" Storyboard.TargetProperty="(Rectangle.Opacity)" From="0.0" To="1.0" Duration="00:00:00.25">
                          <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut" />
                          </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="ActiveRectangle" Storyboard.TargetProperty="(Rectangle.Height)" From="0" To="17" Duration="00:00:00.667">
                          <DoubleAnimation.EasingFunction>
                            <QuinticEase EasingMode="EaseOut" />
                          </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.EnterActions>
                  <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="PillSelected" />
                  </Trigger.ExitActions>
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                  </MultiTrigger.Conditions>
                  <Setter TargetName="MainBorder" Property="Background">
                    <Setter.Value>
                      <SolidColorBrush Opacity="0.5" Color="{DynamicResource SubtleFillColorSecondary}" />
                    </Setter.Value>
                  </Setter>
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="icons">
            <Setter Property="Margin" Value="0,0,0,4" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="0,0,14,14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid x:Name="AccountsSidebar" Grid.Column="0" Width="225" Margin="0,0,10,0" HorizontalAlignment="Left" ClipToBounds="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ui:Button x:Name="AddButton" Grid.Row="0" Margin="0,2,0,8" HorizontalAlignment="Stretch" Appearance="Primary" Icon="PersonAdd24" Content="{resources:Loc Accounts_AddAccount}" ToolTip="{resources:Loc Accounts_AddAccount}" Click="AddButton_Click">
        <ui:Button.ContextMenu>
          <ContextMenu x:Name="AddMenu">
            <MenuItem Header="{resources:Loc Accounts_SignInBrowser}" Command="{Binding SignInCommand}" Visibility="{Binding BrowserSignInVisibility}">
              <MenuItem.Icon><ui:SymbolIcon Symbol="Globe24" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{resources:Loc Accounts_CreateAccount}" Command="{Binding SignUpCommand}" Visibility="{Binding BrowserSignInVisibility}">
              <MenuItem.Icon><ui:SymbolIcon Symbol="PersonAdd24" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{resources:Loc Accounts_AddCurrent}" Command="{Binding AddCurrentCommand}">
              <MenuItem.Icon><ui:SymbolIcon Symbol="Save24" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{resources:Loc Accounts_Vault_Import}" Command="{Binding VaultImportCommand}">
              <MenuItem.Icon><ui:SymbolIcon Symbol="LockClosed24" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{resources:Loc Accounts_ImportCookie}" Command="{Binding ToggleImportCommand}">
              <MenuItem.Icon><ui:SymbolIcon Symbol="Key24" /></MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </ui:Button.ContextMenu>
      </ui:Button>
      <ui:TextBox x:Name="SidebarSearchBox" Grid.Row="1" PlaceholderText="{resources:Loc Accounts_Search}" Icon="Search24" ClearButtonEnabled="True" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
      <Grid x:Name="SidebarStatusRow" Grid.Row="2" Margin="16,6,0,4">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding StatusVisibility}" Margin="0,0,34,0">
          <ui:ProgressRing Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" MaxWidth="170" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Padding="4,0" Appearance="Transparent" Icon="ArrowSync24" ToolTip="{resources:Loc Common_Refresh}" Command="{Binding RefreshCommand}" />
      </Grid>
      <ListBox x:Name="SidebarList" Grid.Row="3" Tag="full" Background="#00FFFFFF" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel" ItemContainerStyle="{StaticResource NavSideItem}" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}" AllowDrop="True" PreviewMouseLeftButtonDown="SidebarList_PreviewMouseLeftButtonDown" PreviewMouseMove="SidebarList_PreviewMouseMove" DragOver="SidebarList_DragOver" Drop="SidebarList_Drop">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Background="#00FFFFFF" ToolTip="{Binding Handle}">
              <Grid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.SwitchCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" CommandParameter="{Binding}" />
              </Grid.InputBindings>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="28" Height="28" Margin="-4,0,10,0">
                <Ellipse Fill="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" util:DynamicRenderSystem.LazyImageSource="{Binding AvatarUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}">
                  <Image.Clip><EllipseGeometry Center="14,14" RadiusX="14" RadiusY="14" /></Image.Clip>
                </Image>
                <Ellipse Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="#FF3FB950" Stroke="{DynamicResource ApplicationBackgroundBrush}" StrokeThickness="1.5" Visibility="{Binding CurrentVisibility}" />
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type StackPanel}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="icons">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="130" Text="{Binding Title}" />
                  <ui:SymbolIcon Margin="6,0,0,0" Symbol="Pin16" FontSize="11" Opacity="0.6" Visibility="{Binding PinnedVisibility}" />
                </StackPanel>
                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" Text="{Binding SubText}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ListBox>
      <StackPanel x:Name="SidebarFooter" Grid.Row="4" Margin="0,8,0,0">
        <ui:Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Transparent" Icon="ShieldCheckmark24" Content="{resources:Loc Accounts_CheckAll}" Command="{Binding CheckAllCommand}" />
        <ui:Button Margin="0,2,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Transparent" Icon="SignOut24" Content="{resources:Loc Accounts_SignOut}" Command="{Binding SignOutCommand}" IsEnabled="{Binding CanSwitch}" />
      </StackPanel>
      <Border x:Name="SidebarResizer" Grid.Row="0" Grid.RowSpan="5" Width="8" Margin="0,0,-4,0" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" Panel.ZIndex="50" ToolTip="{resources:Loc Ui_Main_ResizeSidebar}" MouseLeftButtonDown="SidebarResizer_MouseLeftButtonDown" MouseMove="SidebarResizer_MouseMove" MouseLeftButtonUp="SidebarResizer_MouseLeftButtonUp" />
    </Grid>

    <ScrollViewer Grid.Column="1" Margin="10,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,16,0">
        <ui:InfoBar Margin="0,2,0,10" IsOpen="True" IsClosable="False" Severity="Warning" Message="{resources:Loc Accounts_RosemaryNotice}" Visibility="{Binding UnsupportedVisibility}" />

        <Border Margin="0,2,0,12" Padding="14" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}" Visibility="{Binding ImportVisibility}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" PlaceholderText="{resources:Loc Accounts_CookiePlaceholder}" Text="{Binding CookieText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button Grid.Column="1" Margin="8,0,0,0" Appearance="Primary" Icon="ArrowImport24" Content="{resources:Loc Common_Import}" Command="{Binding ImportCommand}" />
          </Grid>
        </Border>

        <TextBlock Margin="0,40,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding EmptyText}" Visibility="{Binding EmptyVisibility}" />

        <StackPanel Visibility="{Binding DetailVisibility}">
          <Grid Margin="0,2,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="64" Height="64">
              <Ellipse Fill="{DynamicResource ControlFillColorSecondaryBrush}" />
              <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" util:DynamicRenderSystem.LazyImageSource="{Binding SelectedAccount.AvatarUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}">
                <Image.Clip><EllipseGeometry Center="32,32" RadiusX="32" RadiusY="32" /></Image.Clip>
              </Image>
            </Grid>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SelectedAccount.Title}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Border Margin="10,0,0,0" Padding="7,2" CornerRadius="4" VerticalAlignment="Center" Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="{Binding SelectedAccount.CurrentVisibility}" platform:LinuxTextGuard.PreserveCompactLayout="True">
                  <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Text="{resources:Loc Accounts_Current}" />
                </Border>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                <TextBlock Text="{Binding SelectedAccount.Handle}" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="{Binding SelectedAccount.Model.UserId}" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <ui:Button Appearance="Transparent" Margin="2,0,0,0" Padding="4,2" FontSize="12" Icon="Copy24" ToolTip="{resources:Loc Accounts_CopyId}" Command="{Binding CopyIdCommand}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <ui:Button Appearance="Secondary" Icon="Play24" Content="{resources:Loc Accounts_SwitchAndPlay}" IsEnabled="{Binding CanSwitch}" Command="{Binding SwitchAndPlayCommand}" />
              <ui:Button Margin="8,0,0,0" Appearance="Primary" Icon="ArrowSwap24" Content="{resources:Loc Accounts_Switch}" IsEnabled="{Binding CanSwitch}" Command="{Binding SwitchCommand}" />
            </StackPanel>
          </Grid>

          <ui:InfoBar Margin="0,0,0,12" IsOpen="True" IsClosable="False" Severity="Error" Message="{resources:Loc Accounts_ExpiredDetail}" Visibility="{Binding SelectedAccount.ExpiredVisibility}" />

          <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Border.Resources>
              <Style x:Key="StatLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
              </Style>
              <Style x:Key="StatValue" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,2,8,0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
              </Style>
            </Border.Resources>
            <UniformGrid Rows="1">
              <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="{resources:Loc Accounts_Robux}" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding Robux}" /></StackPanel>
              <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="{resources:Loc Accounts_Premium}" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding Premium}" /></StackPanel>
              <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="{resources:Loc Accounts_Friends}" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding Friends}" /></StackPanel>
              <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="{resources:Loc Accounts_Followers}" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding Followers}" /></StackPanel>
              <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="{resources:Loc Accounts_Joined}" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding Joined}" /></StackPanel>
              <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="{resources:Loc Accounts_LastUsed}" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding SelectedAccount.LastUsedText}" /></StackPanel>
              <StackPanel><TextBlock Style="{StaticResource StatLabel}" Text="{resources:Loc Accounts_Added}" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding SelectedAccount.AddedText}" /></StackPanel>
            </UniformGrid>
          </Border>
          <ui:TextBox Margin="0,0,0,4" PlaceholderText="{resources:Loc Accounts_NotePlaceholder}" Text="{Binding SelectedAccount.Note, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

          <Border Margin="0,8,0,0" Padding="14" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}" Visibility="{Binding OutfitsVisibility}">
            <StackPanel>
              <DockPanel Margin="0,0,0,8" LastChildFill="True">
                <ui:Button DockPanel.Dock="Right" Padding="10,4" Icon="Add24" Content="{resources:Loc Accounts_Outfits_SaveCurrent}" Command="{Binding SaveCurrentOutfitCommand}" />
                <TextBlock FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{resources:Loc Accounts_Outfits}" />
              </DockPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Width="28" Height="72" Padding="0" Margin="0,0,6,0" Appearance="Transparent" Icon="ChevronLeft24" IsEnabled="{Binding CanPageOutfitsBack}" Command="{Binding OutfitBackCommand}" />
                <ItemsControl Grid.Column="1" ItemsSource="{Binding OutfitPage}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Rows="1" Columns="5" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <ui:Button Height="120" Margin="3" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Top" Appearance="Transparent" ToolTip="{resources:Loc Accounts_Outfits_Wear}" Command="{Binding DataContext.WearOutfitCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ui:UiPage}}">
                        <ui:Button.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="{resources:Loc Accounts_Outfits_Wear}" Command="{Binding PlacementTarget.Tag.WearOutfitCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                            <MenuItem Header="{resources:Loc Accounts_Outfits_Rename}" Command="{Binding PlacementTarget.Tag.RenameOutfitCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                            <MenuItem Header="{resources:Loc Accounts_Outfits_UpdateCurrent}" Command="{Binding PlacementTarget.Tag.UpdateOutfitCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                            <Separator />
                            <MenuItem Header="{resources:Loc Accounts_Outfits_Delete}" Command="{Binding PlacementTarget.Tag.DeleteOutfitCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                          </ContextMenu>
                        </ui:Button.ContextMenu>
                        <StackPanel HorizontalAlignment="Stretch">
                          <Grid Height="92" HorizontalAlignment="Stretch" util:RoundedClip.Radius="6">
                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" util:DynamicRenderSystem.LazyImageSource="{Binding ImageUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
                            <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                          </Grid>
                          <TextBlock Margin="2,4,2,0" FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" />
                        </StackPanel>
                      </ui:Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button Grid.Column="2" Width="28" Height="72" Padding="0" Margin="6,0,0,0" Appearance="Transparent" Icon="ChevronRight24" IsEnabled="{Binding CanPageOutfitsForward}" Command="{Binding OutfitForwardCommand}" />
              </Grid>
            </StackPanel>
          </Border>

          <WrapPanel Margin="0,12,0,0">
            <ui:Button Margin="0,0,8,8" Appearance="Secondary" Icon="Open24" Content="{resources:Loc Accounts_OpenProfile}" Command="{Binding OpenProfileCommand}" />
            <ui:Button Margin="0,0,8,8" Appearance="Secondary" Icon="Copy24" Content="{resources:Loc Accounts_CopyUsername}" Command="{Binding CopyUsernameCommand}" />
            <ui:Button Margin="0,0,8,8" Appearance="Secondary" Icon="LockClosed24" Content="{resources:Loc Accounts_Vault_Export}" Command="{Binding VaultExportCommand}" />
            <ui:Button Margin="0,0,8,8" Appearance="Secondary" Icon="Pin24" Content="{Binding SelectedAccount.PinText}" Command="{Binding PinCommand}" />
            <ui:Button Margin="0,0,8,8" Appearance="Secondary" Icon="ArrowClockwise24" Content="{resources:Loc Accounts_SignInAgain}" Command="{Binding RenewCommand}" Visibility="{Binding BrowserSignInVisibility}" />
            <ui:Button Margin="0,0,8,8" Appearance="Danger" Icon="Delete24" Content="{resources:Loc Accounts_Remove}" Command="{Binding RemoveCommand}" />
          </WrapPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</ui:UiPage>
