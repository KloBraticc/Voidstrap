<ui:UiPage
xmlns:resources="clr-namespace:Voidstrap.Resources" 
    x:Class="Voidstrap.UI.Elements.Settings.Pages.GamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls"
    Title="GamePage"
    ui:Breadcrumb.Header="{resources:Loc Ui_Pages_GameDetails}"
    Loaded="GamePage_Loaded"
    Unloaded="GamePage_Unloaded"
    d:DesignHeight="800"
    d:DesignWidth="900"
    Scrollable="True"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,14,14">

        <Border CornerRadius="4"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1"
                Padding="20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="4*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            CornerRadius="8"
                            Background="#1AFFFFFF"
                            MinHeight="235">
                        <Border x:Name="BannerImage" CornerRadius="8" />
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Stretch">
                        <TextBlock x:Name="GameTitleText"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Text="{resources:Loc Ui_Misc2_Loading}" />

                        <TextBlock x:Name="CreatorText"
                                   FontSize="14"
                                   Opacity="0.75"
                                   Margin="0,4,0,0"
                                   Text="" />

                        <ui:Button x:Name="PlayButton"
                                   Margin="0,20,0,0"
                                   Height="44"
                                   HorizontalAlignment="Stretch"
                                   Appearance="Primary"
                                   Icon="Play24"
                                   FontSize="22"
                                   Click="PlayButton_Click" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="ThumbLike24" FontSize="16" Opacity="0.85" VerticalAlignment="Center" />
                                <TextBlock x:Name="LikesText" Margin="6,0,0,0" FontSize="14" VerticalAlignment="Center" Text="--" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="ThumbDislike24" FontSize="16" Opacity="0.85" VerticalAlignment="Center" />
                                <TextBlock x:Name="DislikesText" Margin="6,0,0,0" FontSize="14" VerticalAlignment="Center" Text="--" />
                            </StackPanel>
                        </Grid>

                        <ProgressBar x:Name="RatingBar"
                                     Margin="0,8,0,0"
                                     Height="4"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="DescriptionText"
                           Margin="2,20,2,0"
                           FontSize="14"
                           LineHeight="21"
                           Opacity="0.85"
                           TextWrapping="Wrap"
                           Text="" />

                <Border Margin="0,20,0,0"
                        CornerRadius="8"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        Padding="8,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{resources:Loc Ui_Misc2_Active}" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ActiveText" Text="--" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{resources:Loc ContextMenu_GameBrowser_Favorites}" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="FavoritesText" Text="--" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{resources:Loc Ui_Pages_Visits}" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="VisitsText" Text="--" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="{resources:Loc Ui_Pages_Created}" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="CreatedText" Text="--" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{resources:Loc Ui_Pages_Updated}" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="UpdatedText" Text="--" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="5">
                            <TextBlock Text="{resources:Loc Ui_Misc2_ServerSize}" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ServerSizeText" Text="--" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="{resources:Loc Ui_Pages_Genre}" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="GenreStatText" Text="--" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <controls:RoReviewControl x:Name="ReviewControl" Margin="0,14,0,0" />
    </StackPanel>
</ui:UiPage>
