<ui:UiPage
    x:Class="Voidstrap.UI.Elements.Settings.Pages.GamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="GamePage"
    Loaded="GamePage_Loaded"
    Unloaded="GamePage_Unloaded"
    d:DesignHeight="800"
    d:DesignWidth="900"
    Scrollable="True"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,14,14">
        <ui:Button x:Name="BackButton"
                   Icon="ArrowLeft24"
                   Content="Back"
                   Appearance="Secondary"
                   Margin="0,0,0,12"
                   Click="BackButton_Click" />

        <Border CornerRadius="4"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1"
                Padding="20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="4*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            ClipToBounds="True"
                            Background="#1AFFFFFF"
                            MinHeight="235">
                        <Grid>
                            <Image x:Name="BannerImage" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Stretch">
                        <TextBlock x:Name="GameTitleText"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Text="Loading..." />

                        <TextBlock x:Name="CreatorText"
                                   FontSize="14"
                                   Opacity="0.75"
                                   Margin="0,4,0,0"
                                   Text="" />

                        <TextBlock x:Name="GenreText"
                                   FontSize="13"
                                   Opacity="0.6"
                                   Margin="0,2,0,0"
                                   Text="" />

                        <ui:Button x:Name="PlayButton"
                                   Margin="0,24,0,0"
                                   Height="45"
                                   HorizontalAlignment="Stretch"
                                   Appearance="Primary"
                                   Icon="Play24"
                                  
                                   IconForeground="White"
                                   Foreground="White"
                                   FontSize="22"
                                   Click="PlayButton_Click" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="ThumbLike24" FontSize="16" Opacity="0.85" VerticalAlignment="Center" />
                                <TextBlock x:Name="LikesText" Margin="6,0,0,0" FontSize="14" VerticalAlignment="Center" Text="--" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="ThumbDislike24" FontSize="16" Opacity="0.85" VerticalAlignment="Center" />
                                <TextBlock x:Name="DislikesText" Margin="6,0,0,0" FontSize="14" VerticalAlignment="Center" Text="--" />
                            </StackPanel>
                        </Grid>

                        <ProgressBar x:Name="RatingBar"
                                     Margin="0,8,0,0"
                                     Height="10"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="DescriptionText"
                           Margin="0,20,0,0"
                           FontSize="14"
                           Opacity="0.85"
                           TextWrapping="Wrap"
                           Text="" />

                <Border Margin="0,20,0,0"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Active" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" />
                            <TextBlock x:Name="ActiveText" Text="--" FontSize="14" FontWeight="Medium" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Favorites" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" />
                            <TextBlock x:Name="FavoritesText" Text="--" FontSize="14" FontWeight="Medium" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Visits" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" />
                            <TextBlock x:Name="VisitsText" Text="--" FontSize="14" FontWeight="Medium" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Created" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" />
                            <TextBlock x:Name="CreatedText" Text="--" FontSize="14" FontWeight="Medium" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Updated" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" />
                            <TextBlock x:Name="UpdatedText" Text="--" FontSize="14" FontWeight="Medium" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="5">
                            <TextBlock Text="Server Size" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" />
                            <TextBlock x:Name="ServerSizeText" Text="--" FontSize="14" FontWeight="Medium" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Genre" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" />
                            <TextBlock x:Name="GenreStatText" Text="--" FontSize="14" FontWeight="Medium" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</ui:UiPage>
