<ui:UiPage x:Class="Voidstrap.UI.Elements.Settings.Pages.IntegrationsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:Voidstrap.UI.ViewModels" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:platform="clr-namespace:Voidstrap.UI" xmlns:util="clr-namespace:Voidstrap.Utility" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Name="IntegrationsPageView" Title="IntegrationsPage" Scrollable="True" xmlns:pages="clr-namespace:Voidstrap.UI.Elements.Settings.Pages">
  <StackPanel Margin="0,0,14,14">
    <TextBlock FontSize="14" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Menu_Integrations_Description}" />

    <TabControl Margin="0,12,0,0">
      <TabControl.Resources>
        <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
          <Setter Property="MinWidth" Value="0" />
          <Setter Property="Padding" Value="24,6" />
        </Style>
      </TabControl.Resources>

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Pulse24" Margin="0,0,6,0" />
            <TextBlock Text="{resources:Loc Ui_Integrations_Activity}" />
          </StackPanel>
        </TabItem.Header>
        <StackPanel Margin="10">
          <TextBlock Margin="0,0,0,4" FontSize="20" FontWeight="Medium" Text="{resources:Loc Menu_Integrations_ActivityTracking}" />
          <controls:OptionControl x:Name="ActivityTrackingOption" Description="{resources:Loc Menu_Integrations_EnableActivityTracking_Description}" Header="{resources:Loc Menu_Integrations_EnableActivityTracking_Title}" HelpLink="https://github.com/BloxstrapLabs/Bloxstrap/wiki/What-is-activity-tracking%3F">
            <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding ActivityTrackingEnabled, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Menu_Integrations_QueryServerLocation_Title}" HelpLink="https://github.com/BloxstrapLabs/Bloxstrap/wiki/What-is-activity-tracking%3F#server-location-querying" Description="{Binding Source={resources:Loc Menu_Integrations_QueryServerLocation_Description}, Converter={StaticResource StringFormatConverter}, ConverterParameter=https://ipinfo.io}" IsEnabled="{Binding ActivityTrackingEnabled, Mode=OneWay}">
            <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding ShowServerDetailsEnabled, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Description="{resources:Loc Ui_Integrations_DisplaysTheGameYouHaveJoined}" Header="{resources:Loc Ui_Integrations_JoinGameNotification}" IsEnabled="{Binding ActivityTrackingEnabled, Mode=OneWay}">
            <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding joinGameNotify, Mode=TwoWay}" />
          </controls:OptionControl>
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <HeaderedContentControl.Header>
              <StackPanel>
                <TextBlock FontSize="14" Text="{resources:Loc Ui_Integrations_FriendsAndFavorites_Title}" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="{resources:Loc Ui_Integrations_FriendsAndFavorites_Description}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel>
              <controls:OptionControl Description="{resources:Loc Ui_Integrations_NotifiesYouInGameWhenA}" Header="{resources:Loc Ui_Integrations_FriendNotifications}" IsEnabled="{Binding ActivityTrackingEnabled, Mode=OneWay}">
                <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding FriendNotifications, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl Description="{resources:Loc Ui_Integrations_LibraryFavorites_Description}" Header="{resources:Loc Ui_Integrations_LibraryFavorites_Title}">
                <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding LibraryShowRobloxFavorites, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl Description="{resources:Loc Ui_Integrations_FavoriteUpdateAlerts_Description}" Header="{resources:Loc Ui_Integrations_FavoriteUpdateAlerts_Title}">
                <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding FavoriteUpdateAlerts, Mode=TwoWay}" />
              </controls:OptionControl>
            </StackPanel>
          </ui:CardExpander>
          <controls:OptionControl Header="{resources:Loc Menu_Integrations_DesktopApp_Title}" HelpLink="https://github.com/BloxstrapLabs/Bloxstrap/wiki/What-is-activity-tracking%3F#dont-exit-to-desktop-app" Description="{Binding Source={resources:Loc Menu_Integrations_DesktopApp_Description}, Converter={StaticResource StringFormatConverter}, ConverterParameter=https://github.com/BloxstrapLabs/Bloxstrap/wiki/What-is-activity-tracking%3F#dont-exit-to-desktop-app}" IsEnabled="{Binding ActivityTrackingEnabled, Mode=OneWay}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding DisableAppPatchEnabled, Mode=TwoWay}" />
          </controls:OptionControl>
        </StackPanel>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Live24" Margin="0,0,6,0" />
            <TextBlock Text="Discord" />
          </StackPanel>
        </TabItem.Header>
        <StackPanel Margin="10">
          <TextBlock Margin="0,0,0,4" FontSize="20" FontWeight="Medium" Text="{resources:Loc Common_DiscordRichPresence}" />
          <controls:MarkdownTextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MarkdownText="{Binding Source={resources:Loc Menu_Integrations_RequiresActivityTracking}, Converter={StaticResource StringFormatConverter}, ConverterParameter=https://github.com/Bloxstraplabs/Bloxstrap/wiki/What-is-activity-tracking%3F#discord-rich-presence}" />
          <controls:OptionControl x:Name="DiscordActivityOption" Header="{resources:Loc Menu_Integrations_ShowGameActivity_Title}" Description="{Binding Source={resources:Loc Menu_Integrations_ShowGameActivity_Description}, Converter={StaticResource StringFormatConverter}, ConverterParameter=https://github.com/Bloxstraplabs/Bloxstrap/wiki/Discord-Rich-Presence-does-not-work}" IsEnabled="{Binding ActivityTrackingEnabled, Mode=OneWay}">
            <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding DiscordActivityEnabled, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Description="{resources:Loc Menu_Integrations_ShowAccountOnProfile_Description}" Header="{resources:Loc Menu_Integrations_ShowAccountOnProfile_Title}" IsEnabled="{Binding DiscordActivityEnabled, Mode=OneWay}">
            <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding DiscordAccountOnProfile, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Description="{resources:Loc Menu_Integrations_AllowActivityJoining_Description}" Header="{resources:Loc Menu_Integrations_AllowActivityJoining_Title}" IsEnabled="{Binding DiscordActivityEnabled, Mode=OneWay}">
            <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding DiscordActivityJoinEnabled, Mode=TwoWay}" />
          </controls:OptionControl>
            <Border CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" Margin="0,8,0,10" Padding="14">
              <StackPanel>
                <Grid Margin="0,0,0,10">
                  <TextBlock x:Name="RpcPreviewHeader" Text="{resources:Loc Ui_Integrations_PlayingRoblox}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                  <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="4" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="6,2,6,2" platform:LinuxTextGuard.PreserveCompactLayout="True">
                    <TextBlock Text="{resources:Loc CustomTheme_Editor_Preview}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                  </Border>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid Grid.Column="0" Width="60" Height="60" VerticalAlignment="Top" Margin="0,0,12,0">
                    <Border x:Name="RpcLargeImageHost" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                      <Image x:Name="RpcLargeImage" Stretch="UniformToFill" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip>
                          <RectangleGeometry Rect="0,0,60,60" RadiusX="8" RadiusY="8" />
                        </Image.Clip>
                      </Image>
                    </Border>
                    <Border x:Name="RpcSmallImageHost" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" Visibility="Collapsed">
                      <Image x:Name="RpcSmallImage" Stretch="UniformToFill" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip>
                          <EllipseGeometry Center="9,9" RadiusX="9" RadiusY="9" />
                        </Image.Clip>
                      </Image>
                    </Border>
                  </Grid>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="RpcPreviewAppName" Text="Roblox" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="RpcPreviewDetails" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    <TextBlock x:Name="RpcPreviewState" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="RpcPreviewElapsed" FontSize="13" FontWeight="Medium" Foreground="#3BA55D" />
                  </StackPanel>
                </Grid>
                <StackPanel x:Name="RpcPreviewButtons" Orientation="Vertical" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
          <ui:CardExpander IsExpanded="False">
            <HeaderedContentControl.Header>
              <StackPanel>
                <TextBlock FontSize="14" Text="{resources:Loc Ui_Integrations_RPCAdvanced}" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="{resources:Loc Ui_Integrations_ChooseWhatDiscordShows}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel>
              <WrapPanel IsEnabled="{Binding ActivityTrackingEnabled, Mode=OneWay}">
                <CheckBox MinWidth="170" Margin="0,0,12,6" Content="{resources:Loc Ui_Integrations_GameName}" IsChecked="{Binding GameNameChecked, Mode=TwoWay}" />
                <CheckBox MinWidth="170" Margin="0,0,12,6" Content="{resources:Loc Ui_Integrations_GameIcon}" IsChecked="{Binding GameIconChecked, Mode=TwoWay}" />
                <CheckBox MinWidth="170" Margin="0,0,12,6" Content="{resources:Loc Ui_Integrations_Creator}" IsChecked="{Binding GameCreatorChecked, Mode=TwoWay}" />
                <CheckBox MinWidth="170" Margin="0,0,12,6" Content="{resources:Loc Ui_Integrations_ServerType}" ToolTip="{resources:Loc Ui_Integrations_PublicPrivateOrReserved}" IsChecked="{Binding GameStatusChecked, Mode=TwoWay}" />
                <CheckBox MinWidth="170" Margin="0,0,12,6" Content="{resources:Loc Menu_Integrations_QueryServerLocation_Title}" IsChecked="{Binding ServerLocationGame, Mode=TwoWay}" />
                <CheckBox MinWidth="170" Margin="0,0,12,6" Content="{resources:Loc Ui_Integrations_BetaTag}" ToolTip="{resources:Loc Ui_Integrations_TurnsMarkersLikeBETAOrWIP}" IsChecked="{Binding GameWIP, Mode=TwoWay}" />
                <CheckBox MinWidth="170" Margin="0,0,12,6" Content="{resources:Loc Ui_Integrations_FastFlagCount}" IsChecked="{Binding FFlagAmountRPC, Mode=TwoWay}" />
              </WrapPanel>
              <WrapPanel Margin="0,8,0,0">
                <ui:TextBox Width="220" Margin="0,0,8,8" PlaceholderText="{resources:Loc Ui_Integrations_CustomGameName}" ToolTip="{resources:Loc Ui_Integrations_ReplacesTheGameNameGameName}" IsEnabled="{Binding ActivityTrackingEnabled, Mode=OneWay}" Text="{Binding gamename, Mode=TwoWay}" />
                <ui:TextBox Width="220" Margin="0,0,8,8" PlaceholderText="{resources:Loc Ui_Integrations_CustomImageLink}" ToolTip="{resources:Loc Ui_Integrations_ReplacesTheGameIcon}" IsEnabled="{Binding ActivityTrackingEnabled, Mode=OneWay}" Text="{Binding gameimage, Mode=TwoWay}" />
                <ComboBox Width="180" Margin="0,0,0,8" ToolTip="{resources:Loc Ui_Integrations_ShownWhenYouAreNotIn}" ItemsSource="{Binding RpcIdleIconOptions}" SelectedItem="{Binding SelectedRpcIdleIcon, Mode=TwoWay}" />
              </WrapPanel>
            </StackPanel>
          </ui:CardExpander>
        </StackPanel>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Games24" Margin="0,0,6,0" />
            <TextBlock Text="Roblox" />
          </StackPanel>
        </TabItem.Header>
        <StackPanel Margin="10">
          <controls:OptionControl Header="{resources:Loc Ui_Integrations_TelemetryBlocker}" Description="{resources:Loc Ui_Integrations_BlockRobloxTelemetryAdministratorAccessIs}">
            <ui:ToggleSwitch IsChecked="{Binding BlockTelemetry, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Ui_Integrations_FPSUnlocker}" Description="{Binding UncapFpsDescription, Mode=OneWay}" IsEnabled="{Binding UncapFpsToggleEnabled, Mode=OneWay}">
            <ui:ToggleSwitch IsChecked="{Binding UncapFPS, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="Snap Tap" Description="{resources:Loc Ui_Integrations_WhenTwoOppositeKeysAreHeld}" Visibility="{x:Static platform:PlatformFeatureVisibility.GlobalInput}">
            <ui:ToggleSwitch IsChecked="{Binding SnapTapEnabled, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Ui_Integrations_KeyboardAccess}" Description="{Binding SnapTapAccessDescription}" Visibility="{Binding SnapTapAccessVisibility}">
            <Button Content="{resources:Loc Ui_Integrations_GrantAccess}" Command="{Binding GrantSnapTapAccessCommand}" />
          </controls:OptionControl>
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False" Visibility="{x:Static platform:PlatformFeatureVisibility.GlobalInput}">
            <HeaderedContentControl.Header>
              <StackPanel>
                <TextBlock FontSize="14" Text="{resources:Loc Ui_Integrations_SnapTapSettings}" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="{resources:Loc Ui_Integrations_ChooseWhichKeysArePairedAnd}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel>
              <controls:OptionControl Header="{resources:Loc Ui_Integrations_Priority}" Description="{resources:Loc Ui_Integrations_WhatHappensWhileTwoKeysFrom}">
                <ComboBox MinWidth="240" ItemsSource="{Binding SnapTapModes}" SelectedIndex="{Binding SnapTapMode, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl Header="{resources:Loc Ui_Integrations_KeyGroups}" Description="{resources:Loc Ui_Integrations_SeparateGroupsWithCommasAndKeys}">
                <ui:TextBox MinWidth="240" PlaceholderText="A D, W S" Text="{Binding SnapTapKeys, Mode=TwoWay}" />
              </controls:OptionControl>
              <TextBlock Margin="16,8,16,4" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{x:Static platform:PlatformFeatureVisibility.LinuxIntegration}" Text="{resources:Loc Ui_Integrations_OnLinuxSnapTapTakesOver}" />
              <TextBlock Margin="16,8,16,4" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{x:Static platform:PlatformFeatureVisibility.MacOSIntegration}" Text="{resources:Loc Ui_Integrations_OnMacOSAllowAccessibilityAccessFor}" />
            </StackPanel>
          </ui:CardExpander>
                    <ui:CardExpander Margin="0,8,0,0" IsExpanded="False" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
                        <HeaderedContentControl.Header>
                            <StackPanel>
                                <TextBlock FontSize="14" Text="{resources:Loc Ui_Integrations_StartupAndTray}" />
                                <TextBlock Margin="0,2,0,0" FontSize="12" Text="{resources:Loc Ui_Integrations_ChooseHowRobloxStartsAndStays}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </HeaderedContentControl.Header>
                        <StackPanel>
                            <controls:OptionControl Header="{resources:Loc Ui_Integrations_SystemTray}" Description="{resources:Loc Ui_Integrations_MinimizeRobloxToTheSystemTray}" Visibility="{x:Static platform:PlatformFeatureVisibility.Tray}">
                                <ui:ToggleSwitch IsChecked="{Binding RobloxSystemTray, Mode=TwoWay}" />
                            </controls:OptionControl>
                            <controls:OptionControl Header="{resources:Loc Ui_Integrations_LaunchOnStartup}" Description="{resources:Loc Ui_Integrations_LaunchRobloxWhenYouSignIn}">
                                <ui:ToggleSwitch IsChecked="{Binding LaunchStartup, Mode=TwoWay}" />
                            </controls:OptionControl>
                        </StackPanel>
                    </ui:CardExpander>
                    <controls:OptionControl Header="{resources:Loc Ui_Integrations_SteamLibrary}" Description="{Binding SteamShortcutDescription}" Visibility="{Binding SteamShortcutVisibility}">
            <Button Content="{resources:Loc Ui_Integrations_AddToSteam}" Command="{Binding AddToSteamCommand}" />
          </controls:OptionControl>
                    <controls:OptionControl Header="{resources:Loc Ui_Integrations_AccountSwitcher}" Description="{resources:Loc Ui_Integrations_CreateBackUpAndSwitchRoblox}" Visibility="{x:Static platform:PlatformFeatureVisibility.NotMacOS}">
            <Button Content="{resources:Loc Common_Open}" HorizontalAlignment="Left" Command="{Binding AccountWindowCommand}" />
          </controls:OptionControl>
                    <controls:OptionControl Header="{resources:Loc ContextMenu_GameHistory_Title}" Description="{resources:Loc Ui_Integrations_ViewGamesYouRecentlyPlayed}">
                        <Button Content="{resources:Loc Common_Open}" HorizontalAlignment="Left" VerticalAlignment="Top" Command="{Binding OpenHistoryWindowCommand}" />
                    </controls:OptionControl>
          <TextBlock Margin="0,16,0,0" Text="{resources:Loc Menu_Integrations_Custom_Title}" FontSize="20" FontWeight="Medium" />
          <TextBlock Text="{resources:Loc Menu_Integrations_Custom_Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <Grid Margin="0,8,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="250" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox Name="CustomIntegrationsListBox" Grid.Row="0" Grid.Column="0" Margin="0,0,4,0" DisplayMemberPath="Name" ItemsSource="{Binding CustomIntegrations, Mode=OneWay}" SelectedIndex="{Binding SelectedCustomIntegrationIndex, Mode=TwoWay}" SelectionChanged="CustomIntegrationSelection" />
            <Grid Row="1" Column="0" Margin="0,8,4,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:Button Grid.Column="0" Margin="0,0,4,0" Icon="Add28" Content="{resources:Loc Common_New}" HorizontalAlignment="Stretch" Command="{Binding AddIntegrationCommand, Mode=OneTime}" />
              <ui:Button Grid.Column="1" Margin="4,0,0,0" Icon="Delete28" Content="{resources:Loc Common_Delete}" HorizontalAlignment="Stretch" Appearance="Danger" IsEnabled="{Binding IsCustomIntegrationSelected, Mode=OneWay}" Command="{Binding DeleteIntegrationCommand, Mode=OneTime}" />
            </Grid>
            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="4,0,0,0">
              <FrameworkElement.Style>
                <Style>
                  <Style.Triggers>
                    <DataTrigger Value="False" Binding="{Binding IsCustomIntegrationSelected}">
                      <Setter Property="UIElement.Visibility" Value="Hidden" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
              <TextBlock Text="{resources:Loc Common_Name}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <ui:TextBox Margin="0,4,0,0" Text="{Binding SelectedCustomIntegration.Name, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Margin="0,8,0,0" Text="{resources:Loc Menu_Integrations_Custom_AppLocation}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" Margin="0,0,0,0" PlaceholderText="{Binding CustomIntegrationLocationPlaceholder, Mode=OneWay}" Text="{Binding SelectedCustomIntegration.Location}" />
                <ui:Button Grid.Column="1" Margin="8,0,0,0" Height="34" Icon="Folder24" Content="{resources:Loc Common_Browse}" Command="{Binding BrowseIntegrationLocationCommand}" />
              </Grid>
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="1*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0" Text="{resources:Loc Ui_Integrations_LaunchDelay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBox Grid.Column="1" Margin="0,0,16,0" PlaceholderText="200" TextWrapping="NoWrap" AcceptsReturn="True" AcceptsTab="True" Text="{Binding SelectedCustomIntegration.Delay}" />
                <TextBlock Grid.Column="2" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0" Text="{resources:Loc Menu_Integrations_Custom_LaunchArgs}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBox Grid.Column="3" TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True" PlaceholderText="{Binding Source=/k echo {0}, Converter={StaticResource StringFormatConverter}, ConverterParameter={resources:Loc Menu_Integrations_Custom_LaunchArgs_Placeholder}}" Text="{Binding SelectedCustomIntegration.LaunchArgs}" />
              </Grid>
              <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <CheckBox Margin="0,0,8,0" Content="{resources:Loc Menu_Integrations_Custom_AutoClose}" IsChecked="{Binding SelectedCustomIntegration.AutoClose}" />
                <CheckBox Margin="0,0,8,0" Content="{resources:Loc Ui_Integrations_PreRobloxLaunch}" IsChecked="{Binding SelectedCustomIntegration.PreLaunch}" />
              </StackPanel>
              <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <CheckBox Margin="0,0,8,0" Content="{resources:Loc Ui_Integrations_RunMinimized}" IsChecked="{Binding SelectedCustomIntegration.RunMinimized}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}" />
                <CheckBox Margin="0,0,8,0" Content="{resources:Loc Ui_Integrations_RunAsAdministrator}" IsChecked="{Binding SelectedCustomIntegration.RunAsAdmin}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}" />
              </StackPanel>
              <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <CheckBox Margin="0,0,8,0" Content="{resources:Loc Ui_Integrations_OnlyForASpecificGame}" IsChecked="{Binding SelectedCustomIntegration.SpecifyGame}" />
                <CheckBox Margin="0,0,8,0" Content="{resources:Loc Ui_Integrations_CloseWhenLeavingThatGame}" IsChecked="{Binding SelectedCustomIntegration.AutoCloseOnGame}" IsEnabled="{Binding SelectedCustomIntegration.SpecifyGame}" />
              </StackPanel>
              <Grid Margin="0,8,0,0" Visibility="{Binding SelectedCustomIntegration.SpecifyGame, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Text="{resources:Loc Ui_Integrations_PlaceID}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBox Grid.Column="1" PlaceholderText="e.g. 286090429" Text="{Binding SelectedCustomIntegration.GameID, UpdateSourceTrigger=PropertyChanged}" />
              </Grid>
            </StackPanel>
            <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Text="{resources:Loc Menu_Integrations_Custom_NoneSelected}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center">
              <FrameworkElement.Style>
                <Style>
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding IsCustomIntegrationSelected}">
                      <Setter Property="UIElement.Visibility" Value="Hidden" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </TextBlock>
          </Grid>
                </StackPanel>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Speaker224" Margin="0,0,6,0" />
            <TextBlock Text="{resources:Loc Ui_Sound_Tab}" />
          </StackPanel>
        </TabItem.Header>
        <StackPanel Margin="10">
          <controls:OptionControl Header="{resources:Loc Ui_Sound_OutputDevice_Title}" Description="{resources:Loc Ui_Sound_OutputDevice_Description}" Visibility="{Binding AudioOutputVisibility, Mode=OneTime}">
            <StackPanel Orientation="Horizontal">
              <ComboBox MinWidth="240" MaxWidth="320" ItemsSource="{Binding AudioOutputs}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedAudioOutput, Mode=TwoWay}" />
              <ui:Button Margin="8,0,0,0" Icon="ArrowClockwise24" ToolTip="{resources:Loc Ui_Sound_RefreshDevices}" Command="{Binding RefreshAudioOutputsCommand}" />
            </StackPanel>
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Ui_Sound_Equalizer_Title}" Description="{resources:Loc Ui_Sound_Equalizer_Description}" Visibility="{Binding EqualizerVisibility, Mode=OneTime}">
            <ComboBox MinWidth="240" ItemsSource="{Binding EqualizerPresets}" SelectedIndex="{Binding EqualizerPreset, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Ui_Integrations_QuietWhenUnfocused}" Description="{resources:Loc Ui_Integrations_LowerRobloxVolumeWhileItsWindow}" Visibility="{x:Static platform:PlatformFeatureVisibility.AudioSession}">
            <ui:ToggleSwitch IsChecked="{Binding DuckRobloxAudio, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Ui_Integrations_HeadsetLoudness}" Description="{resources:Loc Ui_Integrations_BalanceLoudAndQuietRobloxAudio}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ui:ToggleSwitch IsChecked="{Binding HeadsetLoudness, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Ui_Integrations_ViewMusicPlayer}" Description="{resources:Loc Ui_Integrations_ViewAndListenToYourMusic}">
            <Button Content="{resources:Loc Ui_Mods_View}" HorizontalAlignment="Left" VerticalAlignment="Top" Command="{Binding MusicWindowCommand}" />
          </controls:OptionControl>
        </StackPanel>
      </TabItem>

      <TabItem x:Name="MatchmakerTab" DataContext="{x:Null}">
        <HeaderedContentControl.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Globe24" Margin="0,0,6,0" />
            <TextBlock Text="{resources:Loc Ui_Bootstrapper_VoidstrapMatchmaker}" />
          </StackPanel>
        </HeaderedContentControl.Header>
        <StackPanel Margin="10">
          <ui:InfoBar Padding="8" IsClosable="False" IsOpen="True" Severity="Informational" Message="{Binding UserLocationText}" />
          <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_Enable}" Description="{resources:Loc Ui_Bootstrapper_PickMyServerForMe}">
            <ui:ToggleSwitch IsChecked="{Binding VoidstrapMatchmakerEnabled, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_WhatToJoin}" Description="{resources:Loc Ui_Bootstrapper_HowVoidstrapChoosesBetweenTheServers}">
            <ComboBox Width="280" Padding="10,5,10,5" DisplayMemberPath="Display" SelectedValuePath="Value" IsEnabled="{Binding VoidstrapMatchmakerEnabled}" ItemsSource="{Binding MatchmakerModes}" SelectedValue="{Binding MatchmakerMode, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_AskBeforeMovingServers}" Description="{resources:Loc Ui_Bootstrapper_WhenABetterServerIsFound}">
            <ui:ToggleSwitch IsEnabled="{Binding VoidstrapMatchmakerEnabled}" IsChecked="{Binding MatchmakerAskBeforeMoving, Mode=TwoWay}" />
          </controls:OptionControl>
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False" Visibility="{Binding ShowPreferredDatacenterPicker, Converter={StaticResource BooleanToVisibilityConverter}}">
            <HeaderedContentControl.Header>
              <StackPanel>
                <TextBlock FontSize="14" Text="{resources:Loc Ui_Bootstrapper_WhichDatacenter}" />
                <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Bootstrapper_ClickAPinToPickA}" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel>
            <controls:WorldServerMap Height="420" IsEnabled="{Binding VoidstrapMatchmakerEnabled}" Datacenters="{Binding Datacenters}" SelectedKey="{Binding PreferredDatacenterKey, Mode=TwoWay}" UserLatitude="{Binding UserLatitude}" UserLongitude="{Binding UserLongitude}" />
            <controls:OptionControl Margin="0,8,0,0" Header="{resources:Loc Ui_Bootstrapper_PreferredDatacenter}" Description="{resources:Loc Ui_Bootstrapper_VoidstrapWillAlwaysTryThisOne}">
              <ComboBox Width="280" Padding="10,5,10,5" DisplayMemberPath="Display" IsEnabled="{Binding VoidstrapMatchmakerEnabled}" ItemsSource="{Binding PreferredDatacenterOptions}" SelectedItem="{Binding SelectedPreferredDatacenter, Mode=TwoWay}" />
            </controls:OptionControl>
            </StackPanel>
          </ui:CardExpander>
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <HeaderedContentControl.Header>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock FontSize="14" FontWeight="Medium" Text="{resources:Loc Ui_Bootstrapper_Datacenters}" />
                  <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Text="{Binding BlockedDatacenterSummary}" />
                </StackPanel>
                <ui:Button Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Content="{resources:Loc Ui_Bootstrapper_AllowAll}" Icon="ArrowReset24" Click="ResetDatacenters_Click" />
              </Grid>
            </HeaderedContentControl.Header>
            <StackPanel>
              <TextBlock Margin="0,0,0,8" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Bootstrapper_TurnOneOffToNeverBe}" />
              <ui:TextBox Margin="0,0,0,8" Padding="10,5,10,5" Icon="Search24" PlaceholderText="{resources:Loc Ui_Bootstrapper_SearchByCityRegionOrCountry}" Text="{Binding DatacenterSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" MaxHeight="420">
                <DataGrid Name="DatacentersGrid" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" GridLinesVisibility="None" IsReadOnly="True" RowHeaderWidth="0" Background="#00FFFFFF" BorderThickness="0" RowHeight="42" AlternatingRowBackground="{DynamicResource SubtleFillColorTertiaryBrush}" ItemsSource="{Binding FilteredDatacenters}">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{resources:Loc Ui_Bootstrapper_Allow}" Width="70" CanUserSort="False">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <ui:ToggleSwitch HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Location}" IsChecked="{Binding IsAllowed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{resources:Loc Ui_Bootstrapper_Datacenter}" Width="*" MinWidth="180">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel VerticalAlignment="Center" ToolTip="{Binding ServerIps}">
                            <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Location}" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding DistanceDisplay}" />
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{resources:Loc Ui_Bootstrapper_Latency}" Width="100" MinWidth="80" Binding="{Binding PingDisplay}" />
                  </DataGrid.Columns>
                </DataGrid>
              </Border>
            </StackPanel>
          </ui:CardExpander>
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <HeaderedContentControl.Header>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock FontSize="14" FontWeight="Medium" Text="{resources:Loc Ui_Bootstrapper_SkippedGames}" />
                  <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Text="{Binding ExcludedGamesSummary}" />
                </StackPanel>
                <ui:Button Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Content="{resources:Loc FlagSearch_Label25}" Icon="ArrowReset24" Visibility="{Binding HasExcludedGames, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding ClearExcludedGamesCommand}" />
              </Grid>
            </HeaderedContentControl.Header>
            <StackPanel>
              <TextBlock Margin="0,0,0,8" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Bootstrapper_AddThoseHereAndVoidstrapJoins}" />
              <ui:TextBox Margin="0,0,0,8" Padding="10,5,10,5" PlaceholderText="{resources:Loc Ui_Bootstrapper_SearchForAGameByName}" Text="{Binding GameSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Margin="0,0,0,8" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding GameSearchStatus}" Visibility="{Binding HasGameSearchStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
              <Border Margin="0,0,0,8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" MaxHeight="260" Visibility="{Binding HasGameSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding GameSearchResults}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="8,6,8,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Width="40" Height="40" Margin="0,0,10,0" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <Image Source="{Binding IconUrl}" util:DynamicRenderSystem.LinuxImageSource="{Binding IconUrl}" Width="40" Height="40" Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                              <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Players}" Visibility="{Binding HasPlayers, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              <TextBlock FontSize="11" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Detail}" Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                          </StackPanel>
                          <ui:Button Grid.Column="2" VerticalAlignment="Center" Icon="Add24" Content="{resources:Loc Ui_Bootstrapper_Skip}" ToolTip="{resources:Loc Ui_Bootstrapper_NeverLetVoidstrapPickAServer}" Command="{Binding DataContext.AddSearchResultCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
              <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" MaxHeight="320" Visibility="{Binding HasExcludedGames, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DataGrid AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" GridLinesVisibility="None" IsReadOnly="True" RowHeaderWidth="0" Background="#00FFFFFF" BorderThickness="0" RowHeight="48" AlternatingRowBackground="{DynamicResource SubtleFillColorTertiaryBrush}" ItemsSource="{Binding ExcludedGames}">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{resources:Loc Shortcuts_GameTab}" Width="*" MinWidth="200">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="32" Height="32" Margin="0,0,10,0" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                              <Image Source="{Binding IconUrl}" util:DynamicRenderSystem.LinuxImageSource="{Binding IconUrl}" Width="32" Height="32" Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{resources:Loc Ui_Bootstrapper_PlaceId}" Width="140" MinWidth="110" Binding="{Binding PlaceIdDisplay}" />
                    <DataGridTemplateColumn Header="" Width="60" CanUserSort="False">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <ui:Button HorizontalAlignment="Center" VerticalAlignment="Center" Icon="Delete24" Appearance="Secondary" ToolTip="{resources:Loc Ui_Bootstrapper_LetVoidstrapPickServersForThis}" Command="{Binding DataContext.RemoveExcludedGameCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </Border>
            </StackPanel>
          </ui:CardExpander>
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <HeaderedContentControl.Header>
              <StackPanel>
                <TextBlock FontSize="14" FontWeight="Medium" Text="{resources:Loc Ui_Bootstrapper_Advanced}" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Bootstrapper_TheDefaultsAreRightForAlmost}" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel>
              <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_HowHardToSearch}" Description="{Binding SearchDepthDescription}">
                <StackPanel Orientation="Horizontal" Margin="0,2">
                  <ui:ToggleSwitch VerticalAlignment="Center" Margin="0,0,8,0" IsChecked="{Binding VoidstrapMatchmakerAutoCandidates, Mode=TwoWay}" />
                  <TextBlock Text="{resources:Loc Ui_Bootstrapper_Auto}" VerticalAlignment="Center" Margin="0,0,16,0" />
                  <Slider Width="170" Minimum="8" Maximum="64" TickFrequency="4" IsSnapToTickEnabled="True" IsEnabled="{Binding VoidstrapMatchmakerManualCandidates}" Value="{Binding VoidstrapMatchmakerMaxCandidates, Mode=TwoWay}" />
                  <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding EffectiveMatchmakerCandidates}" />
                </StackPanel>
              </controls:OptionControl>
              <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_ReconnectLimit}" Description="{resources:Loc Ui_Bootstrapper_VoidstrapStopsTryingAfterThisMany}">
                <StackPanel Orientation="Horizontal" Margin="0,2">
                  <Slider Width="200" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ServerMatchmakerMaxRetries, Mode=TwoWay}" />
                  <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding ServerMatchmakerMaxRetries}" />
                </StackPanel>
              </controls:OptionControl>
              <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_JoinAPI}" Description="{resources:Loc Ui_Bootstrapper_WhichRobloxJoinEndpointVoidstrapAsks}">
                <ComboBox Width="240" Padding="10,5,10,5" DisplayMemberPath="Display" SelectedValuePath="Value" ItemsSource="{Binding GamejoinApiOptions}" SelectedValue="{Binding GamejoinApiVersion, Mode=TwoWay}" />
              </controls:OptionControl>
              <ui:InfoBar Padding="8" IsClosable="False" IsOpen="True" Margin="0,8,0,0" Severity="Success" Message="{Binding VoidstrapMatchmakerLearnedStats}" Visibility="{Binding HasLearnedData, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
          </ui:CardExpander>
        </StackPanel>
      </TabItem>
    </TabControl>
  </StackPanel>
</ui:UiPage>
