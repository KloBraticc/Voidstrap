<ui:UiPage x:Class="Voidstrap.UI.Elements.Settings.Pages.IntegrationsPage" xmlns:uianim="clr-namespace:Wpf.Ui.Animations;assembly=Wpf.Ui" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:Voidstrap.UI.ViewModels" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:platform="clr-namespace:Voidstrap.UI" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Name="IntegrationsPageView" Title="IntegrationsPage" Scrollable="True" xmlns:pages="clr-namespace:Voidstrap.UI.Elements.Settings.Pages">
  <StackPanel Margin="0,0,14,14">
    <TextBlock uianim:Transitions.HoldStill="True" FontSize="14" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Menu_Integrations_Description}" />

    <TabControl Margin="0,12,0,0">
      <TabControl.Resources>
        <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
          <Setter Property="MinWidth" Value="0" />
        </Style>
      </TabControl.Resources>
      <TabControl.Template>
        <ControlTemplate TargetType="{x:Type TabControl}">
          <Grid KeyboardNavigation.TabNavigation="Local">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <UniformGrid Grid.Row="0" Rows="1" Panel.ZIndex="1" Background="Transparent" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
            <Border x:Name="Border" Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0,0,4,4" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local">
              <ContentPresenter x:Name="PART_SelectedContentHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ContentSource="SelectedContent" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Border" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </TabControl.Template>

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Pulse24" Margin="0,0,6,0" />
            <TextBlock Text="{resources:Loc Ui_Integrations_Activity}" />
          </StackPanel>
        </TabItem.Header>
        <StackPanel Margin="10">
          <TextBlock Margin="0,0,0,4" FontSize="20" FontWeight="Medium" Text="{resources:Loc Menu_Integrations_ActivityTracking}" />
          <controls:OptionControl x:Name="ActivityTrackingOption" Description="{resources:Loc Menu_Integrations_EnableActivityTracking_Description}" Header="{resources:Loc Menu_Integrations_EnableActivityTracking_Title}" HelpLink="https://wiki.voidstrapp.pages.dev/features/integrations/#activity-tracking">
            <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding ActivityTrackingEnabled, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Menu_Integrations_QueryServerLocation_Title}" HelpLink="https://wiki.voidstrapp.pages.dev/features/integrations/#server-location" Description="{Binding Source={resources:Loc Menu_Integrations_QueryServerLocation_Description}, Converter={StaticResource StringFormatConverter}, ConverterParameter=https://ipinfo.io}" IsEnabled="{Binding ActivityTrackingEnabled, Mode=OneWay}">
            <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding ShowServerDetailsEnabled, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/integrations/#desktop-app-and-more" Description="{resources:Loc Ui_Integrations_DisplaysTheGameYouHaveJoined}" Header="{resources:Loc Ui_Integrations_JoinGameNotification}" IsEnabled="{Binding ActivityTrackingEnabled, Mode=OneWay}">
            <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding joinGameNotify, Mode=TwoWay}" />
          </controls:OptionControl>
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <HeaderedContentControl.Header>
              <StackPanel>
                <TextBlock FontSize="14" Text="{resources:Loc Ui_Integrations_FriendsAndFavorites_Title}" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="{resources:Loc Ui_Integrations_FriendsAndFavorites_Description}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel>
              <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/integrations/#desktop-app-and-more" Description="{resources:Loc Ui_Integrations_NotifiesYouInGameWhenA}" Header="{resources:Loc Ui_Integrations_FriendNotifications}" IsEnabled="{Binding ActivityTrackingEnabled, Mode=OneWay}">
                <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding FriendNotifications, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/integrations/#desktop-app-and-more" Description="{resources:Loc Ui_Integrations_LibraryFavorites_Description}" Header="{resources:Loc Ui_Integrations_LibraryFavorites_Title}">
                <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding LibraryShowRobloxFavorites, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/integrations/#desktop-app-and-more" Description="{resources:Loc Ui_Integrations_FavoriteUpdateAlerts_Description}" Header="{resources:Loc Ui_Integrations_FavoriteUpdateAlerts_Title}">
                <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding FavoriteUpdateAlerts, Mode=TwoWay}" />
              </controls:OptionControl>
            </StackPanel>
          </ui:CardExpander>
          <controls:OptionControl Header="{resources:Loc Menu_Integrations_DesktopApp_Title}" HelpLink="https://wiki.voidstrapp.pages.dev/features/integrations/#desktop-app-and-more" Description="{Binding Source={resources:Loc Menu_Integrations_DesktopApp_Description}, Converter={StaticResource StringFormatConverter}, ConverterParameter=https://wiki.voidstrapp.pages.dev/features/integrations/#desktop-app-and-more}" IsEnabled="{Binding ActivityTrackingEnabled, Mode=OneWay}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding DisableAppPatchEnabled, Mode=TwoWay}" />
          </controls:OptionControl>
        </StackPanel>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Live24" Margin="0,0,6,0" />
            <TextBlock Text="Discord" />
          </StackPanel>
        </TabItem.Header>
        <StackPanel Margin="10">
          <TextBlock Margin="0,0,0,4" FontSize="20" FontWeight="Medium" Text="{resources:Loc Common_DiscordRichPresence}" />
          <controls:MarkdownTextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MarkdownText="{Binding Source={resources:Loc Menu_Integrations_RequiresActivityTracking}, Converter={StaticResource StringFormatConverter}, ConverterParameter=https://wiki.voidstrapp.pages.dev/features/integrations/#discord-rich-presence}" />
          <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/integrations/#discord-rich-presence" x:Name="DiscordActivityOption" Header="{resources:Loc Menu_Integrations_ShowGameActivity_Title}" Description="{Binding Source={resources:Loc Menu_Integrations_ShowGameActivity_Description}, Converter={StaticResource StringFormatConverter}, ConverterParameter=https://wiki.voidstrapp.pages.dev/features/troubleshooting/#discord-does-not-show-your-game}" IsEnabled="{Binding ActivityTrackingEnabled, Mode=OneWay}">
            <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding DiscordActivityEnabled, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/integrations/#discord-rich-presence" Description="{resources:Loc Menu_Integrations_ShowAccountOnProfile_Description}" Header="{resources:Loc Menu_Integrations_ShowAccountOnProfile_Title}" IsEnabled="{Binding DiscordActivityEnabled, Mode=OneWay}">
            <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding DiscordAccountOnProfile, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/integrations/#discord-rich-presence" Description="{resources:Loc Menu_Integrations_AllowActivityJoining_Description}" Header="{resources:Loc Menu_Integrations_AllowActivityJoining_Title}" IsEnabled="{Binding DiscordActivityEnabled, Mode=OneWay}">
            <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding DiscordActivityJoinEnabled, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/integrations/#discord-rich-presence" Description="{resources:Loc Menu_Integrations_ShowDiscordPartySize_Description}" Header="{resources:Loc Menu_Integrations_ShowDiscordPartySize_Title}" IsEnabled="{Binding DiscordActivityEnabled, Mode=OneWay}">
            <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding DiscordPartySizeEnabled, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/integrations/#discord-rich-presence" Description="{resources:Loc Menu_Integrations_AllowDiscordInvites_Description}" Header="{resources:Loc Menu_Integrations_AllowDiscordInvites_Title}" IsEnabled="{Binding DiscordActivityEnabled, Mode=OneWay}">
            <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding DiscordInvitesEnabled, Mode=TwoWay}" />
          </controls:OptionControl>
            <Border CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" Margin="0,8,0,10" Padding="14">
              <StackPanel>
                <Grid Margin="0,0,0,10">
                  <TextBlock x:Name="RpcPreviewHeader" Text="{resources:Loc Ui_Integrations_PlayingRoblox}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                  <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="4" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="6,2,6,2" platform:LinuxTextGuard.PreserveCompactLayout="True">
                    <TextBlock Text="{resources:Loc CustomTheme_Editor_Preview}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                  </Border>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid Grid.Column="0" Width="60" Height="60" VerticalAlignment="Top" Margin="0,0,12,0">
                    <Border x:Name="RpcLargeImageHost" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                      <Image x:Name="RpcLargeImage" Stretch="UniformToFill" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip>
                          <RectangleGeometry Rect="0,0,60,60" RadiusX="8" RadiusY="8" />
                        </Image.Clip>
                      </Image>
                    </Border>
                    <Border x:Name="RpcSmallImageHost" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" Visibility="Collapsed">
                      <Image x:Name="RpcSmallImage" Stretch="UniformToFill" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip>
                          <EllipseGeometry Center="9,9" RadiusX="9" RadiusY="9" />
                        </Image.Clip>
                      </Image>
                    </Border>
                  </Grid>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="RpcPreviewAppName" Text="Roblox" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="RpcPreviewDetails" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    <TextBlock x:Name="RpcPreviewState" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="RpcPreviewElapsed" FontSize="13" FontWeight="Medium" Foreground="#3BA55D" />
                  </StackPanel>
                </Grid>
                <StackPanel x:Name="RpcPreviewButtons" Orientation="Vertical" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
          <ui:CardExpander IsExpanded="False">
            <HeaderedContentControl.Header>
              <StackPanel>
                <TextBlock FontSize="14" Text="{resources:Loc Ui_Integrations_RPCAdvanced}" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="{resources:Loc Ui_Integrations_ChooseWhatDiscordShows}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel>
              <WrapPanel IsEnabled="{Binding ActivityTrackingEnabled, Mode=OneWay}">
                <CheckBox MinWidth="170" Margin="0,0,12,6" Content="{resources:Loc Ui_Integrations_GameName}" IsChecked="{Binding GameNameChecked, Mode=TwoWay}" />
                <CheckBox MinWidth="170" Margin="0,0,12,6" Content="{resources:Loc Ui_Integrations_GameIcon}" IsChecked="{Binding GameIconChecked, Mode=TwoWay}" />
                <CheckBox MinWidth="170" Margin="0,0,12,6" Content="{resources:Loc Ui_Integrations_Creator}" IsChecked="{Binding GameCreatorChecked, Mode=TwoWay}" />
                <CheckBox MinWidth="170" Margin="0,0,12,6" Content="{resources:Loc Ui_Integrations_ServerType}" ToolTip="{resources:Loc Ui_Integrations_PublicPrivateOrReserved}" IsChecked="{Binding GameStatusChecked, Mode=TwoWay}" />
                <CheckBox MinWidth="170" Margin="0,0,12,6" Content="{resources:Loc Menu_Integrations_QueryServerLocation_Title}" IsChecked="{Binding ServerLocationGame, Mode=TwoWay}" />
                <CheckBox MinWidth="170" Margin="0,0,12,6" Content="{resources:Loc Ui_Integrations_BetaTag}" ToolTip="{resources:Loc Ui_Integrations_TurnsMarkersLikeBETAOrWIP}" IsChecked="{Binding GameWIP, Mode=TwoWay}" />
                <CheckBox MinWidth="170" Margin="0,0,12,6" Content="{resources:Loc Ui_Integrations_FastFlagCount}" IsChecked="{Binding FFlagAmountRPC, Mode=TwoWay}" />
              </WrapPanel>
              <WrapPanel Margin="0,8,0,0">
                <ui:TextBox Width="220" Margin="0,0,8,8" PlaceholderText="{resources:Loc Ui_Integrations_CustomGameName}" ToolTip="{resources:Loc Ui_Integrations_ReplacesTheGameNameGameName}" IsEnabled="{Binding ActivityTrackingEnabled, Mode=OneWay}" Text="{Binding gamename, Mode=TwoWay}" />
                <ui:TextBox Width="220" Margin="0,0,8,8" PlaceholderText="{resources:Loc Ui_Integrations_CustomImageLink}" ToolTip="{resources:Loc Ui_Integrations_ReplacesTheGameIcon}" IsEnabled="{Binding ActivityTrackingEnabled, Mode=OneWay}" Text="{Binding gameimage, Mode=TwoWay}" />
                <ComboBox Width="180" Margin="0,0,0,8" ToolTip="{resources:Loc Ui_Integrations_ShownWhenYouAreNotIn}" ItemsSource="{Binding RpcIdleIconOptions}" SelectedItem="{Binding SelectedRpcIdleIcon, Mode=TwoWay}" />
              </WrapPanel>
            </StackPanel>
          </ui:CardExpander>
        </StackPanel>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Speaker224" Margin="0,0,6,0" />
            <TextBlock Text="{resources:Loc Ui_Sound_Tab}" />
          </StackPanel>
        </TabItem.Header>
        <StackPanel Margin="10">
          <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/integrations/#audio" Header="{resources:Loc Ui_Sound_OutputDevice_Title}" Description="{resources:Loc Ui_Sound_OutputDevice_Description}" Visibility="{Binding AudioOutputVisibility, Mode=OneTime}">
            <StackPanel Orientation="Horizontal">
              <ComboBox MinWidth="240" MaxWidth="320" ItemsSource="{Binding AudioOutputs}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedAudioOutput, Mode=TwoWay}" />
              <ui:Button Margin="8,0,0,0" Icon="ArrowClockwise24" ToolTip="{resources:Loc Ui_Sound_RefreshDevices}" Command="{Binding RefreshAudioOutputsCommand}" />
            </StackPanel>
          </controls:OptionControl>
          <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/integrations/#audio" Header="{resources:Loc Ui_Sound_Equalizer_Title}" Description="{resources:Loc Ui_Sound_Equalizer_Description}" Visibility="{Binding EqualizerVisibility, Mode=OneTime}">
            <ComboBox MinWidth="240" ItemsSource="{Binding EqualizerPresets}" SelectedIndex="{Binding EqualizerPreset, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/integrations/#audio" Header="{resources:Loc Ui_Integrations_QuietWhenUnfocused}" Description="{resources:Loc Ui_Integrations_LowerRobloxVolumeWhileItsWindow}" Visibility="{x:Static platform:PlatformFeatureVisibility.AudioSession}">
            <ui:ToggleSwitch IsChecked="{Binding DuckRobloxAudio, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/integrations/#audio" Header="{resources:Loc Ui_Integrations_HeadsetLoudness}" Description="{resources:Loc Ui_Integrations_BalanceLoudAndQuietRobloxAudio}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ui:ToggleSwitch IsChecked="{Binding HeadsetLoudness, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/integrations/#audio" Header="{resources:Loc Ui_Integrations_ViewMusicPlayer}" Description="{resources:Loc Ui_Integrations_ViewAndListenToYourMusic}">
            <Button Content="{resources:Loc Ui_Mods_View}" HorizontalAlignment="Left" VerticalAlignment="Top" Command="{Binding MusicWindowCommand}" />
          </controls:OptionControl>
        </StackPanel>
      </TabItem>

      <TabItem>
        <HeaderedContentControl.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Video24" Margin="0,0,6,0" />
            <TextBlock Text="Void Edit" />
          </StackPanel>
        </HeaderedContentControl.Header>
        <StackPanel x:Name="VoidEditPanel" DataContext="{x:Null}" Margin="10">
          <ui:InfoBar Padding="8" IsClosable="False" IsOpen="True" Severity="Warning" Message="{resources:Loc Ui_VoidEdit_AlphaNotice}" />
          <ui:CardAction x:Name="VoidEditCard" Margin="0,8,0,0" MinHeight="78" Icon="Video24" IsEnabled="False" Click="VoidEditCard_Click">
            <StackPanel>
              <TextBlock FontSize="14" FontWeight="Medium" Text="Void Edit" />
              <TextBlock x:Name="VoidEditCardStatus" Margin="0,2,0,0" FontSize="12" Text="{resources:Loc Ui_VoidEdit_Card_Install}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </ui:CardAction>
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False" Visibility="{x:Static platform:PlatformFeatureVisibility.NotMacOS}">
            <HeaderedContentControl.Header>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock FontSize="14" Text="{resources:Loc Ui_Clipper_Title}" />
                  <TextBlock Margin="0,2,0,0" FontSize="12" Text="{Binding ClipperDescription}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
                  <Button Margin="0,0,12,0" VerticalAlignment="Center" Content="{resources:Loc Ui_Mods_ResetShortcut}" Command="{Binding ResetClipperShortcutCommand}" IsEnabled="{Binding CanResetClipperShortcut}" />
                  <ui:ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding ClipperEnabled, Mode=TwoWay}" />
                </StackPanel>
              </Grid>
            </HeaderedContentControl.Header>
            <StackPanel>
              <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/rishade/#video-clipper" Header="{resources:Loc Ui_Clipper_RecordingMode}" Description="{resources:Loc Ui_Clipper_RecordingModeHint}">
                <ComboBox Width="200" Padding="10,5" ItemsSource="{Binding ClipperModeOptions}" SelectedItem="{Binding SelectedClipperMode, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/rishade/#video-clipper" Header="{resources:Loc Ui_Clipper_BufferLength}" Description="{resources:Loc Ui_Clipper_BufferLengthHint}" Visibility="{Binding ClipperIsClipMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ComboBox Width="200" Padding="10,5" ItemsSource="{Binding ClipperBufferOptions}" SelectedItem="{Binding SelectedClipperBuffer, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/rishade/#video-clipper" Header="{resources:Loc Ui_Clipper_RecordOnGameStart}" Description="{resources:Loc Ui_Clipper_RecordOnGameStartHint}">
                <ui:ToggleSwitch IsChecked="{Binding ClipperRecordOnGameStart, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/rishade/#video-clipper" Header="{resources:Loc Ui_Clipper_RedBorder}" Description="{resources:Loc Ui_Clipper_RedBorderHint}">
                <ui:ToggleSwitch IsChecked="{Binding ClipperRedBorder, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/rishade/#video-clipper" Header="{resources:Loc Ui_Clipper_VideoQuality}" Description="{resources:Loc Ui_Clipper_VideoQualityHint}">
                <ComboBox Width="200" Padding="10,5" ItemsSource="{Binding ClipperQualityOptions}" SelectedItem="{Binding SelectedClipperQuality, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/rishade/#video-clipper" Header="{resources:Loc Ui_Clipper_Resolution}" Description="{resources:Loc Ui_Clipper_ResolutionHint}">
                <ComboBox Width="200" Padding="10,5" ItemsSource="{Binding ClipperResolutionOptions}" SelectedItem="{Binding SelectedClipperResolution, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/rishade/#video-clipper" Header="{resources:Loc Ui_Clipper_FrameRate}" Description="{resources:Loc Ui_Clipper_FrameRateHint}">
                <ComboBox Width="200" Padding="10,5" ItemsSource="{Binding ClipperFpsOptions}" SelectedItem="{Binding SelectedClipperFps, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/rishade/#video-clipper" Header="{resources:Loc Ui_Clipper_Codec}" Description="{resources:Loc Ui_Clipper_CodecHint}">
                <ComboBox Width="200" Padding="10,5" ItemsSource="{Binding ClipperCodecOptions}" SelectedItem="{Binding SelectedClipperCodec, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/rishade/#video-clipper" Header="{resources:Loc Ui_Clipper_GameAudio}" Description="{resources:Loc Ui_Clipper_GameAudioHint}">
                <ui:ToggleSwitch IsChecked="{Binding ClipperGameAudio, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/rishade/#video-clipper" Header="{resources:Loc Ui_Clipper_Microphone}" Description="{resources:Loc Ui_Clipper_MicrophoneHint}">
                <ui:ToggleSwitch IsChecked="{Binding ClipperMicrophone, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/rishade/#video-clipper" Header="{resources:Loc Ui_Clipper_StatusIndicator}" Description="{resources:Loc Ui_Clipper_StatusIndicatorHint}">
                <ui:ToggleSwitch IsChecked="{Binding ClipperShowIndicator, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/rishade/#video-clipper" Header="{resources:Loc Ui_VoidEdit_AskRecordings_Title}" Description="{resources:Loc Ui_VoidEdit_AskRecordings_Description}">
                <ui:ToggleSwitch IsChecked="{Binding VoidEditAskForRecordings, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/rishade/#video-clipper" Header="{resources:Loc Ui_Clipper_ClipsFolder}" Description="{resources:Loc Ui_Clipper_ClipsFolderHint}">
                <Button Width="140" Content="{resources:Loc Ui_Clipper_OpenFolder}" Command="{Binding OpenClipsFolderCommand}" />
              </controls:OptionControl>
            </StackPanel>
          </ui:CardExpander>
        </StackPanel>
      </TabItem>
    </TabControl>
  </StackPanel>
</ui:UiPage>
