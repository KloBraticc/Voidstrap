<ui:UiPage x:Class="Voidstrap.UI.Elements.Settings.Pages.ExtensionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:util="clr-namespace:Voidstrap.Utility" xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Voidstrap.UI.Elements.Settings.Pages" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Extensions" Scrollable="True">
  <ui:UiPage.Resources>
    <Style x:Key="RowCard" TargetType="Border">
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    </Style>
    <Style x:Key="RowIcon" TargetType="Border">
      <Setter Property="Width" Value="84" />
      <Setter Property="Height" Value="84" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="RowTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="RowSummary" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="RowMeta" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    </Style>
    <Style x:Key="ChipText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="DetailLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
    <Style x:Key="Paragraph" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="LineHeight" Value="22" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <DataTemplate x:Key="TagChip">
      <Border Style="{StaticResource Chip}">
        <TextBlock Style="{StaticResource ChipText}" Text="{Binding}" />
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="AssetRow" DataType="{x:Type local:ExtensionEntry}">
      <Border Style="{StaticResource RowCard}" Visibility="{Binding Visible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource RowIcon}">
            <Image Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" util:DynamicRenderSystem.LazyImageSource="{Binding Icon}" />
          </Border>
          <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource RowTitle}" Text="{Binding Name}" />
            <TextBlock Style="{StaticResource RowSummary}" Text="{Binding Summary}" MaxHeight="40" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock Style="{StaticResource RowMeta}" Text="{Binding Author}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              <TextBlock Style="{StaticResource RowMeta}" Margin="12,0,0,0" Text="{Binding Type}" />
              <TextBlock Style="{StaticResource RowMeta}" Margin="12,0,0,0" Text="{Binding TagsLine}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
              <ui:SymbolIcon Symbol="Tag24" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              <TextBlock Style="{StaticResource RowMeta}" Margin="5,0,12,0" Text="{Binding Version}" />
              <TextBlock Style="{StaticResource RowMeta}" Text="{Binding StatusLabel}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <ui:Button Content="View" Appearance="Secondary" MinWidth="76" Margin="0,0,8,0" Tag="{Binding}" Click="ViewAsset_Click" />
              <ui:Button Content="{Binding EnableLabel}" Appearance="Primary" MinWidth="84" Tag="{Binding}" Click="ToggleAsset_Click" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </ui:UiPage.Resources>

  <Grid>
    <StackPanel x:Name="BrowseRoot" Margin="0,0,14,14">
      <TextBlock FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Browse and manage extensions for Voidstrap and its community." />

      <WrapPanel Margin="0,10,0,6">
        <ui:TextBox Width="300" Height="34" Margin="0,0,10,8" VerticalContentAlignment="Center" PlaceholderText="Search extensions" Icon="Search24" ClearButtonEnabled="True" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Type" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <ComboBox Width="220" Height="34" VerticalContentAlignment="Center" ItemsSource="{Binding ExtensionTypes}" SelectedItem="{Binding SelectedExtensionType, Mode=TwoWay}" />
        </StackPanel>
      </WrapPanel>

      <TabControl x:Name="ExtensionTabs" Margin="0,4,0,0">
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Apps24" Margin="0,0,6,0" />
              <TextBlock Text="Voidstrap Assets" />
            </StackPanel>
          </TabItem.Header>
          <StackPanel Margin="10">
            <ItemsControl x:Name="AssetList" ItemTemplate="{StaticResource AssetRow}" Focusable="False" />
            <Border Visibility="{Binding EmptyStateVisibility}" Margin="0,8,0,0" Padding="28" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundBrush}">
              <StackPanel HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="Search24" FontSize="34" HorizontalAlignment="Center" Opacity="0.55" />
                <TextBlock Margin="0,12,0,0" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" Text="{Binding EmptyStateTitle}" />
                <TextBlock Margin="0,4,0,0" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" Text="{Binding EmptyStateSubtitle}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </TabItem>
      </TabControl>
    </StackPanel>

    <Grid x:Name="DetailRoot" Visibility="Collapsed" Margin="0,0,14,14" SizeChanged="DetailRoot_SizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="DetailSidebarColumn" Width="300" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel x:Name="DetailMain" Grid.Column="0" Margin="0,0,20,0">
        <ui:Button Content="Back to extensions" Appearance="Transparent" Icon="ArrowLeft24" Padding="8,4,12,4" Margin="0,0,0,10" Click="BackToBrowse_Click" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Width="96" Height="96" CornerRadius="14" ClipToBounds="True" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Image x:Name="DetailIcon" Stretch="Uniform" Margin="10" RenderOptions.BitmapScalingMode="HighQuality" />
          </Border>
          <StackPanel Grid.Column="1" Margin="16,4,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="DetailName" FontSize="24" FontWeight="SemiBold" />
              <ui:Button x:Name="DetailSourceButton" Appearance="Transparent" Icon="Open24" Padding="6" Margin="6,0,0,0" ToolTip="Open the source page" Click="OpenSource_Click" />
            </StackPanel>
            <TextBlock x:Name="DetailAuthor" Margin="0,4,0,0" FontSize="13" />
            <TextBlock x:Name="DetailSummary" Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Grid>

        <TabControl x:Name="DetailTabs" Margin="0,16,0,0">
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Info24" Margin="0,0,6,0" />
                <TextBlock Text="Description" />
              </StackPanel>
            </TabItem.Header>
            <StackPanel Margin="10">
              <ItemsControl x:Name="DetailParagraphs" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource Paragraph}" Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel x:Name="RojoTools" Visibility="Collapsed">
                <TextBlock Style="{StaticResource DetailLabel}" Text="Project tools" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:TextBox Grid.Column="0" Height="34" Margin="0,0,8,0" VerticalContentAlignment="Center" PlaceholderText="Project folder" Text="{Binding RojoProjectPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding rojoenabler}" />
                  <ui:Button Grid.Column="1" Height="34" Content="Browse" Click="BrowseRojoFolder_Click" IsEnabled="{Binding rojoenabler}" />
                </Grid>
                <WrapPanel Margin="0,10,0,0">
                  <ui:Button Margin="0,0,8,8" Content="New project" Click="RojoInit_Click" IsEnabled="{Binding rojoenabler}" />
                  <ui:Button Margin="0,0,8,8" Content="{Binding RojoServeLabel}" Appearance="Primary" Click="RojoServe_Click" IsEnabled="{Binding rojoenabler}" />
                  <ui:Button Margin="0,0,8,8" Content="Build place" Click="RojoBuild_Click" IsEnabled="{Binding rojoenabler}" />
                  <ui:Button Margin="0,0,8,8" Content="Install Studio plugin" Click="RojoInstallPlugin_Click" IsEnabled="{Binding rojoenabler}" />
                  <ui:Button Margin="0,0,0,8" Content="Open folder" Click="OpenRojo_Click" IsEnabled="{Binding rojoenabler}" />
                </WrapPanel>
              </StackPanel>
            </StackPanel>
          </TabItem>
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="History24" Margin="0,0,6,0" />
                <TextBlock Text="Versions" />
              </StackPanel>
            </TabItem.Header>
            <StackPanel Margin="10">
              <TextBlock x:Name="DetailVersionsNote" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <ItemsControl x:Name="DetailReleases" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type local:ReleaseRow}">
                    <Border Style="{StaticResource RowCard}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                          <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Title}" />
                          <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Meta}" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" VerticalAlignment="Center" Appearance="Secondary" Content="Open on GitHub" Icon="Open24" Tag="{Binding Url}" Click="OpenRelease_Click" Visibility="{Binding HasUrl, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </TabItem>
        </TabControl>
      </StackPanel>

      <StackPanel x:Name="DetailSidebar" Grid.Column="1" Margin="0,38,0,0">
        <ui:Button x:Name="DetailPrimaryButton" HorizontalAlignment="Stretch" Height="40" Appearance="Primary" Icon="ArrowDownload24" Click="DetailPrimary_Click" />
        <ui:Button x:Name="DetailOpenButton" HorizontalAlignment="Stretch" Height="36" Margin="0,8,0,0" Appearance="Secondary" Icon="Open24" Click="DetailOpen_Click" />
        <TextBlock x:Name="DetailStatus" Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        <Border Style="{StaticResource RowCard}" Margin="0,14,0,0" Padding="12">
          <StackPanel>
            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Works with" />
            <WrapPanel x:Name="DetailWorksWith" Margin="0,6,0,0" />
            <TextBlock FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Version" />
            <TextBlock x:Name="DetailVersion" Margin="0,4,0,0" FontSize="13" />
            <TextBlock x:Name="DetailUpdatedLabel" FontSize="12" Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Updated" />
            <TextBlock x:Name="DetailUpdated" Margin="0,4,0,0" FontSize="13" />
          </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource DetailLabel}" Text="Tags" />
        <ItemsControl x:Name="DetailTags" ItemTemplate="{StaticResource TagChip}" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Style="{StaticResource DetailLabel}" Text="Creators" />
        <TextBlock x:Name="DetailCreator" FontSize="13" />
      </StackPanel>
    </Grid>

  </Grid>
</ui:UiPage>
