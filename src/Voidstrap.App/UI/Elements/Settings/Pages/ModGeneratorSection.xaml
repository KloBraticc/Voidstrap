<UserControl x:Class="Voidstrap.UI.Elements.Settings.Pages.ModGeneratorSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Loaded="Section_Loaded"
             Unloaded="Section_Unloaded">
  <UserControl.Resources>
    <Style x:Key="SwatchButton" TargetType="Button">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chip" CornerRadius="13" Background="{TemplateBinding Background}" BorderBrush="#33FFFFFF" BorderThickness="1" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="BorderBrush" Value="#CCFFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ColorSwatch" TargetType="Border">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#33FFFFFF" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ToolTip" Value="Pick a colour" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="#CCFFFFFF" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Margin="2,24,0,0" FontSize="16" FontWeight="SemiBold" Text="Mod Generator" />

    <ui:CardControl Margin="0,10,0,0" Focusable="False" ui:RinControlMotion.Enabled="True">
      <ui:CardControl.Header>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,18,0">
          <TextBlock FontSize="13" FontWeight="SemiBold" Text="Style" />
          <ComboBox x:Name="FillPicker" Margin="0,6,0,0" SelectionChanged="Input_Changed">
            <ComboBoxItem Content="Solid colour" />
            <ComboBoxItem Content="Gradient" />
            <ComboBoxItem Content="Image" />
          </ComboBox>

          <StackPanel x:Name="SolidPanel" Margin="0,12,0,0">
            <TextBlock FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Colour" />
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="SolidSwatch" Width="34" Height="34" Margin="0,0,8,0" Style="{StaticResource ColorSwatch}" MouseLeftButtonDown="Swatch_Click" />
              <ui:TextBox x:Name="SolidColorBox" Grid.Column="1" PlaceholderText="#FF3B5C" TextChanged="Input_Changed" />
            </Grid>
            <WrapPanel x:Name="PresetPanel" Margin="0,8,0,0" />
          </StackPanel>

          <StackPanel x:Name="GradientPanel" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Colours, the middle one is optional" />
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="GradientStartSwatch" Width="30" Height="30" Margin="0,0,6,0" Style="{StaticResource ColorSwatch}" MouseLeftButtonDown="Swatch_Click" />
                <ui:TextBox x:Name="GradientStartBox" Grid.Column="1" PlaceholderText="Start" TextChanged="Input_Changed" />
              </Grid>
              <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="GradientMiddleSwatch" Width="30" Height="30" Margin="0,0,6,0" Style="{StaticResource ColorSwatch}" MouseLeftButtonDown="Swatch_Click" />
                <ui:TextBox x:Name="GradientMiddleBox" Grid.Column="1" PlaceholderText="Middle" TextChanged="Input_Changed" />
              </Grid>
              <Grid Grid.Column="4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="GradientEndSwatch" Width="30" Height="30" Margin="0,0,6,0" Style="{StaticResource ColorSwatch}" MouseLeftButtonDown="Swatch_Click" />
                <ui:TextBox x:Name="GradientEndBox" Grid.Column="1" PlaceholderText="End" TextChanged="Input_Changed" />
              </Grid>
            </Grid>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Angle" />
              <Slider x:Name="AngleSlider" Grid.Column="1" Margin="10,0" Minimum="0" Maximum="360" TickFrequency="15" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Angle_Changed" />
              <TextBlock x:Name="AngleText" Grid.Column="2" MinWidth="36" VerticalAlignment="Center" TextAlignment="Right" Text="90°" />
            </Grid>
          </StackPanel>

          <StackPanel x:Name="ImagePanel" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Every icon is filled with this image, cropped to its shape" />
            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
              <ui:Button Content="Choose image" Icon="Image24" Appearance="Secondary" Click="ChooseFill_Click" />
              <TextBlock x:Name="FillImageText" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="No image chosen" />
            </StackPanel>
          </StackPanel>

          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock FontSize="13" Text="Icon sizes" />
              <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Roblox picks a size for your screen, all sizes is safest" />
            </StackPanel>
            <ComboBox x:Name="ScalePicker" Grid.Column="1" MinWidth="120" VerticalAlignment="Center" SelectionChanged="Input_Changed">
              <ComboBoxItem Content="All sizes" />
              <ComboBoxItem Content="1x only" />
              <ComboBoxItem Content="2x only" />
              <ComboBoxItem Content="3x only" />
            </ComboBox>
          </Grid>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock FontSize="13" Text="Recolour the new icon font" />
              <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Roblox draws most new menu and top bar icons with the Builder Icons font instead of images. Images use their average colour here" />
            </StackPanel>
            <ui:ToggleSwitch x:Name="IconFontToggle" Grid.Column="1" VerticalAlignment="Center" Checked="Input_Changed" Unchecked="Input_Changed" />
          </Grid>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock FontSize="13" Text="Keep icon shading" />
              <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Two tone icons keep their darker details instead of becoming one flat shape" />
            </StackPanel>
            <ui:ToggleSwitch x:Name="KeepShadingToggle" Grid.Column="1" VerticalAlignment="Center" Checked="Input_Changed" Unchecked="Input_Changed" />
          </Grid>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock FontSize="13" Text="Keep coloured icons" />
              <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Leaves badges, currency, reactions, logos and other full colour art untouched" />
            </StackPanel>
            <ui:ToggleSwitch x:Name="KeepColoredToggle" Grid.Column="1" VerticalAlignment="Center" Checked="Input_Changed" Unchecked="Input_Changed" />
          </Grid>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock FontSize="13" Text="Also recolour buttons, bubbles and backgrounds" />
              <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="These shapes are normally tinted by Roblox while it runs, so they stay untouched unless you want everything themed" />
            </StackPanel>
            <ui:ToggleSwitch x:Name="RecolorShapesToggle" Grid.Column="1" VerticalAlignment="Center" Checked="Input_Changed" Unchecked="Input_Changed" />
          </Grid>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock FontSize="13" Text="Also recolour other UI textures" />
              <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Includes the loose in game and app textures such as settings, chat, player list and inspect menu icons" />
            </StackPanel>
            <ui:ToggleSwitch x:Name="UiTexturesToggle" Grid.Column="1" VerticalAlignment="Center" />
          </Grid>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock FontSize="13" Text="Custom Roblox logo" />
              <TextBlock x:Name="LogoText" FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Replaces the Roblox logo in menus, the app and the loading screen" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <ui:Button x:Name="ClearLogoButton" Margin="0,0,8,0" Content="Remove" Icon="Delete24" Appearance="Secondary" Visibility="Collapsed" Click="ClearLogo_Click" />
              <ui:Button Content="Choose" Icon="Add24" Appearance="Secondary" Click="ChooseLogo_Click" />
            </StackPanel>
          </Grid>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13" Text="Mod name" />
            <ui:TextBox x:Name="ModNameBox" Grid.Column="1" PlaceholderText="Generated UI theme" />
          </Grid>
        </StackPanel>

        <StackPanel Grid.Column="1" Width="264">
          <TextBlock FontSize="13" FontWeight="SemiBold" Text="Preview" />
          <TextBlock x:Name="PreviewCaption" Margin="0,2,0,8" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Real icons from your Roblox build" />
          <Border Height="168" CornerRadius="8" Background="#FF15171C" BorderBrush="#1FFFFFFF" BorderThickness="1" ClipToBounds="True">
            <Grid>
              <Image x:Name="BeforeImage" Margin="6,20,6,6" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock Margin="8,6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="10.5" Foreground="#99FFFFFF" Text="Original" />
            </Grid>
          </Border>
          <Border Height="168" Margin="0,8,0,0" CornerRadius="8" Background="#FF15171C" BorderBrush="#1FFFFFFF" BorderThickness="1" ClipToBounds="True">
            <Grid>
              <Image x:Name="AfterImage" Margin="6,20,6,6" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock Margin="8,6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="10.5" Foreground="#99FFFFFF" Text="Generated" />
              <ui:ProgressRing x:Name="PreviewRing" Width="22" Height="22" IsIndeterminate="True" Visibility="Collapsed" />
            </Grid>
          </Border>
          <Border x:Name="FontPreviewCard" Height="58" Margin="0,8,0,0" CornerRadius="8" Background="#FF15171C" BorderBrush="#1FFFFFFF" BorderThickness="1" ClipToBounds="True" Visibility="Collapsed">
            <Grid>
              <Image x:Name="FontPreviewImage" Margin="8,22,8,8" Stretch="Uniform" HorizontalAlignment="Left" />
              <TextBlock Margin="8,6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="10.5" Foreground="#99FFFFFF" Text="Icon font" />
            </Grid>
          </Border>
          <TextBlock x:Name="PreviewNote" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>

      </Grid>
      </ui:CardControl.Header>
    </ui:CardControl>

    <ui:CardControl Margin="0,8,0,0" Focusable="False" ui:RinControlMotion.Enabled="True">
      <ui:CardControl.Header>
        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="StatusText" FontSize="12.5" TextWrapping="Wrap" Text="Ready to generate" />
          <ProgressBar x:Name="GenerateProgress" Margin="0,8,0,0" Height="4" Minimum="0" Maximum="1" Visibility="Collapsed" />
        </StackPanel>
      </ui:CardControl.Header>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ui:Button x:Name="CancelButton" Margin="0,0,8,0" Content="Cancel" Icon="Dismiss24" Appearance="Secondary" Visibility="Collapsed" Click="Cancel_Click" />
          <ui:Button x:Name="GenerateButton" Content="Generate mod" Icon="Wand24" Appearance="Primary" Background="{DynamicResource SystemAccentColorSecondaryBrush}" Click="Generate_Click" />
        </StackPanel>
    </ui:CardControl>
  </StackPanel>
</UserControl>
