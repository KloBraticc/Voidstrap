<ui:UiPage x:Class="Voidstrap.UI.Elements.Settings.Pages.NewsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:util="clr-namespace:Voidstrap.Utility" xmlns:resources="clr-namespace:Voidstrap.Resources" Title="{resources:Loc Ui_Nav_News}" ui:Breadcrumb.Header="{resources:Loc Ui_Nav_News}" Scrollable="True" Loaded="Page_Loaded" Unloaded="Page_Unloaded">
  <FrameworkElement.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="PlainButton" TargetType="{x:Type Button}">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Root" Background="{TemplateBinding Background}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.8" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="LinkButtons">
      <ItemsControl ItemsSource="{Binding Links}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:Button Margin="0,8,6,0" Padding="10,5" FontSize="12" Appearance="Secondary" Icon="Open24" Content="{Binding Label}" Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" CommandParameter="{Binding Url}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>
  </FrameworkElement.Resources>
  <StackPanel Margin="0,0,20,24" MaxWidth="1100">
    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{resources:Loc Menu_News_LatestUpdates}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <ui:ProgressRing Width="16" Height="16" Margin="0,0,10,0" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
        <ui:Button Content="{resources:Loc Common_Refresh}" Icon="ArrowSync24" Appearance="Secondary" Command="{Binding RefreshCommand}" />
      </StackPanel>
    </Grid>

    <StackPanel Margin="0,48,0,0" HorizontalAlignment="Center" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}">
      <ui:SymbolIcon Symbol="News24" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
      <TextBlock Margin="0,10,0,0" Text="{resources:Loc Ui_Misc2_NoNewsYet}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
      <TextBlock Margin="0,4,0,0" Text="{resources:Loc Ui_Misc2_NewVoidstrapUpdatesAndAnnouncementsWill}" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
    </StackPanel>

    <Grid Height="260" util:RoundedClip.Radius="12" Visibility="{Binding HasFeatured, Converter={StaticResource BoolToVis}}" MouseEnter="Featured_MouseEnter" MouseLeave="Featured_MouseLeave">
      <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Border Background="{DynamicResource SystemAccentBrush}" Opacity="0.35">
        <Border.OpacityMask>
          <RadialGradientBrush Center="1,1" GradientOrigin="1,1" RadiusX="0.9" RadiusY="1.4">
            <GradientStop Offset="0" Color="#FF000000" />
            <GradientStop Offset="1" Color="#00000000" />
          </RadialGradientBrush>
        </Border.OpacityMask>
      </Border>
      <Image Stretch="UniformToFill" Visibility="{Binding FeaturedPost.HasImage, Converter={StaticResource BoolToVis}}" util:DynamicRenderSystem.LazyImageSource="{Binding FeaturedPost.Image, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
      <ui:SymbolIcon Symbol="News24" FontSize="190" Margin="0,0,40,-30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="#FFFFFF" Opacity="0.12">
        <ui:SymbolIcon.Style>
          <Style TargetType="{x:Type ui:SymbolIcon}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding FeaturedPost.HasImage}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ui:SymbolIcon.Style>
      </ui:SymbolIcon>
      <Border Visibility="{Binding FeaturedPost.HasImage, Converter={StaticResource BoolToVis}}">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
            <GradientStop Offset="0" Color="#B3000000" />
            <GradientStop Offset="0.6" Color="#33000000" />
            <GradientStop Offset="1" Color="#00000000" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <StackPanel Margin="0,16,16,0" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
        <ui:Button Appearance="Transparent" Icon="ChevronLeft24" Foreground="#FFFFFF" Command="{Binding PreviousFeaturedCommand}" />
        <ui:Button Margin="4,0,0,0" Appearance="Transparent" Icon="ChevronRight24" Foreground="#FFFFFF" Command="{Binding NextFeaturedCommand}" />
      </StackPanel>
      <StackPanel Margin="28,0,28,24" MaxWidth="620" HorizontalAlignment="Left" VerticalAlignment="Bottom">
        <Border HorizontalAlignment="Left" CornerRadius="10" Padding="10,3" Background="#26FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
          <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White" Text="{Binding FeaturedPost.DateText}" />
        </Border>
        <TextBlock Margin="0,10,0,0" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" Foreground="#FFFFFF" Text="{Binding FeaturedPost.Title}" />
        <TextBlock Margin="0,6,0,0" FontSize="13" LineHeight="19" MaxHeight="38" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="#D9FFFFFF" Text="{Binding FeaturedPost.Body}" />
        <ContentPresenter Margin="0,4,0,0" Content="{Binding FeaturedPost}" ContentTemplate="{StaticResource LinkButtons}" />
      </StackPanel>
      <ItemsControl Margin="0,0,28,28" HorizontalAlignment="Right" VerticalAlignment="Bottom" ItemsSource="{Binding Featured}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Height="6" Margin="3,0" util:RoundedClip.Radius="3" Command="{Binding DataContext.SelectFeaturedCommand, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" CommandParameter="{Binding}">
              <Button.Style>
                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PlainButton}">
                  <Setter Property="Width" Value="6" />
                  <Setter Property="Background" Value="#66FFFFFF" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                      <Setter Property="Width" Value="20" />
                      <Setter Property="Background" Value="#FFFFFF" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <StackPanel Visibility="{Binding HasPosts, Converter={StaticResource BoolToVis}}">
      <TextBlock Margin="0,26,0,12" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{resources:Loc Ui_Misc2_Earlier}" />
      <ItemsControl ItemsSource="{Binding Posts}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,14,0,0" HorizontalAlignment="Right">
                <TextBlock HorizontalAlignment="Right" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding DayText}" />
                <TextBlock HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" Text="{Binding MonthText}" />
                <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding YearText}" />
              </StackPanel>
              <Rectangle Grid.Column="1" Width="2" HorizontalAlignment="Center" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />
              <Ellipse Grid.Column="1" Width="10" Height="10" Margin="0,22,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Fill="{DynamicResource SystemAccentBrush}" />
              <Border Grid.Column="2" Margin="0,0,0,10" Padding="16,12,16,14" CornerRadius="8" BorderThickness="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" />
                    <TextBlock Margin="0,4,0,0" FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Body}" />
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LinkButtons}" Visibility="{Binding HasLinks, Converter={StaticResource BoolToVis}}" />
                  </StackPanel>
                  <Image Grid.Column="1" Width="160" Height="90" Margin="14,0,0,0" VerticalAlignment="Top" Stretch="UniformToFill" util:RoundedClip.Radius="6" Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}" util:DynamicRenderSystem.LazyImageSource="{Binding Image, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
                </Grid>
              </Border>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</ui:UiPage>
