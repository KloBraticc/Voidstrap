<ui:UiPage x:Class="Voidstrap.UI.Elements.Settings.Pages.NewsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:conv="clr-namespace:Voidstrap.UI.Converters" xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="News" Scrollable="True" xmlns:pages="clr-namespace:Voidstrap.UI.Elements.Settings.Pages">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <conv:InvertBooleanToVisibilityConverter x:Key="InvertBoolToVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Margin="0,0,20,20">
    <TabControl Name="NewsTabs" Margin="0,0,0,0">

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Chat24" Margin="0,0,6,0" />
            <TextBlock Text="Forums" />
          </StackPanel>
        </TabItem.Header>
        <StackPanel Name="ForumsRoot" Margin="10">
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock FontSize="20" FontWeight="Medium" Text="Voidstrap Forums" />
              <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Talk with the community, share configs, and get help." />
            </StackPanel>
            <ui:Button Grid.Column="1" VerticalAlignment="Top" Content="{x:Static resources:Strings.Common_Refresh}" Icon="ArrowSync24" Command="{Binding RefreshCommand}" />
          </Grid>

          <ui:InfoBar Padding="8" IsClosable="False" Severity="Informational" Title="Browsing publicly" Message="Sign in from the Home page to post, vote, and reply." IsOpen="True" Visibility="{Binding SignedOutVisibility}" />

          <Grid Margin="0,10,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Margin="0,0,6,0" Content="Latest" Icon="Flash24" Command="{Binding ShowLatestCommand}" />
            <ui:Button Grid.Column="1" Margin="0,0,6,0" Content="Top" Icon="ArrowTrending24" Command="{Binding ShowTopCommand}" />
            <ui:Button Grid.Column="2" Margin="0,0,10,0" Content="Categories" Icon="Folder24" Command="{Binding BackToCategoriesCommand}" />
            <ui:TextBox Grid.Column="3" PlaceholderText="Search topics" MaxLength="80" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button Grid.Column="4" Margin="6,0,0,0" Content="Search" Icon="Search24" Command="{Binding SearchCommand}" />
          </Grid>

          <ItemsControl Margin="0,0,0,6" ItemsSource="{Binding Tags}" Visibility="{Binding TagsVisibility}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Margin="0,0,6,6" Padding="8,3" Cursor="Hand" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderThickness="0" Command="{Binding DataContext.FilterTagCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding}">
                  <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding DisplayText}" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Margin="0,0,0,8" Padding="10,6" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}" Visibility="{Binding ActiveFilterVisibility}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ActiveFilterText}" />
              <Button Grid.Column="1" Margin="8,0,0,0" Padding="6,2" FontSize="11" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Content="Clear" Command="{Binding ClearFilterCommand}" />
            </Grid>
          </Border>

          <ProgressBar Height="10" Margin="0,0,0,8" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
          <StackPanel Margin="0,0,0,8">
            <TextBlock FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Text="{Binding StatusText}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type TextBlock}">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusText}" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </TextBlock>
            <ui:Button Margin="0,6,0,0" Padding="10,4" FontSize="12" Appearance="Primary" Content="Open in Browser" Command="{Binding OpenStatusUrlCommand}">
              <ui:Button.Style>
                <Style TargetType="{x:Type ui:Button}">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusUrl}" Value="">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusUrl}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ui:Button.Style>
            </ui:Button>
          </StackPanel>

          <StackPanel Visibility="{Binding CategoriesVisibility}">
            <ItemsControl ItemsSource="{Binding Categories}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Margin="0,0,0,8" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.OpenCategoryCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding}">
                    <ui:Card Padding="12">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Name}" />
                          <Border Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center" CornerRadius="4" Background="{DynamicResource AccentFillColorPrimaryBrush}" Visibility="{Binding Announce, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#FFFFFFFF" Text="OFFICIAL" />
                          </Border>
                          <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding PostCount, StringFormat={}{0} threads}" />
                        </StackPanel>
                        <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Description}" />
                        <TextBlock Margin="0,4,0,0" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding LatestText}" />
                      </StackPanel>
                    </ui:Card>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Visibility="{Binding ThreadsVisibility}">
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:Button Grid.Column="0" Content="Back" Icon="ArrowLeft24" Command="{Binding BackToCategoriesCommand}" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{Binding CurrentCategoryName}" />
              <ui:Button Grid.Column="2" Margin="0,0,6,0" Content="Prev" IsEnabled="{Binding HasPrevPage}" Command="{Binding PrevPageCommand}" />
              <TextBlock Grid.Column="3" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding PageText}" />
              <ui:Button Grid.Column="4" Content="Next" IsEnabled="{Binding HasNextPage}" Command="{Binding NextPageCommand}" />
            </Grid>
            <Expander Header="New thread" IsExpanded="False" Margin="0,0,0,8" Visibility="{Binding CanPostInCategory, Converter={StaticResource BoolToVis}}">
              <StackPanel Margin="0,8,0,0">
                <ui:TextBox PlaceholderText="Title" MaxLength="120" Text="{Binding NewThreadTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ui:TextBox Margin="0,8,0,0" PlaceholderText="Write your post" MaxLength="5000" MinHeight="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding NewThreadContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ui:TextBox Margin="0,8,0,0" PlaceholderText="Optional tags, comma separated, max 5" MaxLength="120" Text="{Binding NewThreadTags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button Margin="0,8,0,0" HorizontalAlignment="Left" Appearance="Primary" Content="Post thread" Icon="Send24" Command="{Binding CreateThreadCommand}" />
              </StackPanel>
            </Expander>
            <ItemsControl ItemsSource="{Binding Threads}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Margin="0,0,0,6" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.OpenThreadCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding}">
                    <ui:Card Padding="10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="28" Height="28" Margin="0,0,6,0" VerticalAlignment="Center">
                          <Ellipse Fill="#FF3F3F46" />
                          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#FFFFFFFF" Text="{Binding AvatarInitial}" />
                          <Image Source="{Binding AvatarImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Clip>
                              <EllipseGeometry Center="14,14" RadiusX="14" RadiusY="14" />
                            </Image.Clip>
                          </Image>
                        </Grid>
                        <ItemsControl Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center" ItemsSource="{Binding AuthorBadges}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid Width="18" Height="18" Margin="0,0,2,0">
                                <Image Source="{Binding Image}" Stretch="UniformToFill" ToolTip="{Binding Name}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Grid.Column="2">
                          <StackPanel Orientation="Horizontal">
                            <Border Margin="0,0,6,0" Padding="6,1" VerticalAlignment="Center" CornerRadius="4" Background="{DynamicResource AccentFillColorPrimaryBrush}" Visibility="{Binding PinnedVisibility}">
                              <TextBlock FontSize="10" FontWeight="Bold" Foreground="#FFFFFFFF" Text="PINNED" />
                            </Border>
                            <TextBlock FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Border Padding="6,1" CornerRadius="4" VerticalAlignment="Center" Background="{DynamicResource ControlFillColorSecondaryBrush}" Visibility="{Binding CategoryVisibility}">
                              <TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding CategoryName}" />
                            </Border>
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding TagsText}" Visibility="{Binding TagsVisibility}" />
                          </StackPanel>
                          <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding MetaText}" />
                          <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Posters}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid Width="20" Height="20" Margin="0,0,3,0" ToolTip="{Binding Name}">
                                  <Ellipse Fill="#FF3F3F46" />
                                  <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" Foreground="#FFFFFFFF" Text="{Binding Initial}" />
                                  <Image Source="{Binding Image}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Clip>
                                      <EllipseGeometry Center="10,10" RadiusX="10" RadiusY="10" />
                                    </Image.Clip>
                                  </Image>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                          <TextBlock HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ScoreText}" />
                          <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding RepliesText, StringFormat={}{0} replies}" />
                          <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ViewsText, StringFormat={}{0} views}" />
                        </StackPanel>
                      </Grid>
                    </ui:Card>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Visibility="{Binding ThreadVisibility}">
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:Button Grid.Column="0" Content="Back" Icon="ArrowLeft24" Command="{Binding BackToThreadsCommand}" />
              <TextBlock Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding CurrentThreadTitle}" />
              <ui:Button Grid.Column="2" Content="{Binding PinLabel}" Visibility="{Binding PinVisibility}" Command="{Binding TogglePinCommand}" />
            </Grid>
            <TextBlock Margin="0,0,0,8" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ThreadViewsText}" />
            <ItemsControl ItemsSource="{Binding Posts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ui:Card Margin="0,0,0,8" Padding="12">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                        <Button Padding="2" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="{Binding UpBrush}" IsEnabled="{Binding DataContext.CanInteract, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" Command="{Binding DataContext.VoteUpCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding}">
                          <ui:SymbolIcon Symbol="ChevronUp24" FontSize="18" />
                        </Button>
                        <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ScoreText}" />
                        <Button Padding="2" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="{Binding DownBrush}" IsEnabled="{Binding DataContext.CanInteract, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" Command="{Binding DataContext.VoteDownCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding}">
                          <ui:SymbolIcon Symbol="ChevronDown24" FontSize="18" />
                        </Button>
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                          <Grid Width="32" Height="32" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse Fill="#FF3F3F46" />
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#FFFFFFFF" Text="{Binding AvatarInitial}" />
                            <Image Source="{Binding AvatarImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                              <Image.Clip>
                                <EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16" />
                              </Image.Clip>
                            </Image>
                          </Grid>
                          <ItemsControl Margin="0,0,4,0" VerticalAlignment="Center" ItemsSource="{Binding AuthorBadges}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid Width="18" Height="18" Margin="0,0,2,0">
                                  <Image Source="{Binding Image}" Stretch="UniformToFill" ToolTip="{Binding Name}" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding AuthorName}" />
                              <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding TimeText}" />
                              <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="(edited)" Visibility="{Binding EditedVisibility}" />
                            </StackPanel>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ReplyToText}" Visibility="{Binding ReplyToVisibility}" />
                          </StackPanel>
                        </StackPanel>
                        <controls:ForumRichContent Post="{Binding}" Margin="0,4,0,0" Visibility="{Binding IsEditing, Converter={StaticResource InvertBoolToVis}}" />
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                          <ui:TextBox MinHeight="80" MaxLength="5000" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ui:Button Content="Save" Appearance="Primary" Command="{Binding DataContext.SaveEditCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding}" />
                            <ui:Button Content="Cancel" Margin="8,0,0,0" Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding}" />
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                          <ItemsControl Margin="0,0,6,0" VerticalAlignment="Center" ItemsSource="{Binding Reactions}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Button Margin="0,0,4,0" Padding="6,2" Cursor="Hand" BorderThickness="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" ToolTip="{Binding Tooltip}" Command="{Binding DataContext.ToggleReactionCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}, AncestorLevel=2}}" CommandParameter="{Binding}">
                                  <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="12" Text="{Binding Glyph}" />
                                    <TextBlock Margin="4,0,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Count}" />
                                  </StackPanel>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <ItemsControl Margin="0,0,6,0" VerticalAlignment="Center" ItemsSource="{Binding ReactionChoices}" Visibility="{Binding ReactionVisibility}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Button Margin="0,0,2,0" Padding="4,2" Cursor="Hand" BorderThickness="0" Background="Transparent" ToolTip="{Binding Emoji}" Command="{Binding DataContext.ToggleReactionCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}, AncestorLevel=2}}" CommandParameter="{Binding}">
                                  <TextBlock FontSize="13" Text="{Binding Glyph}" />
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Button Padding="6,2" FontSize="11" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Content="{Binding BookmarkLabel}" Visibility="{Binding ReactionVisibility}" Command="{Binding DataContext.ToggleBookmarkCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding}" />
                          <Button Padding="6,2" FontSize="11" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Content="Reply" Visibility="{Binding ReplyButtonVisibility}" Command="{Binding DataContext.SetReplyTargetCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding}" />
                          <Button Padding="6,2" FontSize="11" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Content="Edit" Visibility="{Binding ManageVisibility}" Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding}" />
                          <Button Padding="6,2" FontSize="11" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#F87171" Content="Delete" Visibility="{Binding ManageVisibility}" Command="{Binding DataContext.DeletePostCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding}" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </ui:Card>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Margin="0,4,0,6" Padding="10,6" CornerRadius="8" Background="#1E1B33" BorderBrush="#4F46E580" BorderThickness="1" Visibility="{Binding ReplyTargetVisibility}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="#C7D2FE" Text="{Binding ReplyTargetText}" />
                <Button Grid.Column="1" Margin="8,0,0,0" Padding="4,0" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#C7D2FE" Content="X" Command="{Binding CancelReplyTargetCommand}" />
              </Grid>
            </Border>
            <ui:TextBox Margin="0,4,0,0" PlaceholderText="Write a reply" MaxLength="3000" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding ReplyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding CanInteract, Converter={StaticResource BoolToVis}}" />
            <ui:Button Margin="0,8,0,0" HorizontalAlignment="Left" Appearance="Primary" Content="Reply" Icon="Send24" Command="{Binding SubmitReplyCommand}" Visibility="{Binding CanInteract, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
        </StackPanel>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="News24" Margin="0,0,6,0" />
            <TextBlock Text="News" />
          </StackPanel>
        </TabItem.Header>
        <StackPanel Margin="10">
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="{x:Static resources:Strings.Menu_News_LatestUpdates}" Margin="0,0,0,4" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding LastUpdatedText}" />
            </StackPanel>
            <ui:Button Grid.Column="1" Content="{x:Static resources:Strings.Common_Refresh}" Icon="ArrowSync24" VerticalAlignment="Top" Command="{Binding RefreshCommand}" />
          </Grid>
          <StackPanel Margin="0,40,0,0" HorizontalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <ProgressBar Width="220" Height="10" Margin="0,0,0,12" IsIndeterminate="True" />
            <TextBlock Text="{x:Static resources:Strings.Menu_News_Loading}" FontSize="14" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding NewsItems}" Visibility="{Binding IsLoading, Converter={StaticResource InvertBoolToVis}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ui:Card Margin="0,0,0,14" Padding="14">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Margin="0,0,0,4" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" />
                      <StackPanel Margin="0,0,0,10" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Date, StringFormat={}{0:MMMM dd, yyyy}}" />
                        <Border Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center" CornerRadius="4" Background="{DynamicResource AccentFillColorPrimaryBrush}" Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                          <TextBlock FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Foreground="#FFFFFFFF" Text="{Binding AgeLabel}" />
                        </Border>
                      </StackPanel>
                      <Image Height="200" Margin="0,0,0,10" Stretch="UniformToFill" SnapsToDevicePixels="True" Source="{Binding Image, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type Image}">
                            <Setter Property="UIElement.Opacity" Value="0" />
                            <Style.Triggers>
                              <EventTrigger RoutedEvent="Image.Loaded">
                                <BeginStoryboard>
                                  <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" FillBehavior="HoldEnd" />
                                  </Storyboard>
                                </BeginStoryboard>
                              </EventTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </Image>
                      <TextBlock Margin="0,0,0,10" FontSize="13" TextWrapping="Wrap" MaxHeight="120" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding DisplayContent}" />
                      <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Margin="0,4,6,0" Padding="8,3" FontSize="12" Cursor="Hand" Foreground="{DynamicResource AccentFillColorPrimaryBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource AccentFillColorPrimaryBrush}" BorderThickness="1" Content="{Binding}" Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType={x:Type ui:UiPage}}}" CommandParameter="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <ui:Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" Content="{x:Static resources:Strings.Common_Open}" Icon="OpenFolder24" Appearance="Primary" Click="OpenItemButton_Click" />
                  </Grid>
                </ui:Card>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </TabItem>

    </TabControl>
  </StackPanel>
</ui:UiPage>
