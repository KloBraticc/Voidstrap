        <StackPanel Orientation="Horizontal">
          <ui:Button Content="Refresh" Icon="ArrowClockwise24" Appearance="Primary" Margin="0,0,8,0" Command="{Binding RefreshModFilesCommand}" />
          <ui:Button Content="Delete" Icon="Delete24" Appearance="Danger" Margin="0,0,8,0" Command="{Binding DeleteModFileCommand}" />
          <ui:Button Content="Open Folder" Icon="FolderOpen24" Appearance="Secondary" Margin="0,0,16,0" Command="{Binding OpenModFileFolderCommand}" />
        </StackPanel>
      </Grid>
      <Grid Row="1" Margin="0,0,0,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:Button Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,0,0,8" Content="Find Mods" Icon="DocumentSearch24" Appearance="Secondary" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://voidstrapp.pages.dev/mods/mods" />
        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
          <ui:Button Icon="ArrowLeft24" Padding="8,4" Margin="0,0,8,0" ToolTip="Go Back" Command="{Binding GoBackCommand}" />
          <TextBlock Text="Roblox" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          <TextBlock Text=" &gt; " VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          <TextBlock VerticalAlignment="Center" FontWeight="Medium" Text="{Binding ExplorerPathDisplay}" />
        </StackPanel>
        <ui:TextBox Grid.Row="1" Grid.Column="1" Width="300" PlaceholderText="Search assets (e.g. mesh, texture, sound)" Icon="Search24" Text="{Binding ExplorerSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      </Grid>
      <Grid Row="2" Height="640" MinHeight="320">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="300" />
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="400" MinWidth="300" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" FontSize="13" MaxWidth="360"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="{Binding ExplorerStatusMessage}"
                   Visibility="{Binding ExplorerHasStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <DataGrid Name="ModGrid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#00FFFFFF" BorderThickness="0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" RowBackground="#00FFFFFF" HorizontalGridLinesBrush="{DynamicResource ControlElevationBorderBrush}" ItemsSource="{Binding ModFiles}" SelectedItem="{Binding SelectedModFile}" SelectionChanged="ModGrid_SelectionChanged" MouseDoubleClick="ModGrid_MouseDoubleClick"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Item"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Name" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="8,0,8,0" Symbol="{Binding Icon}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Type" Width="45" Binding="{Binding Type}" />
            <DataGridTemplateColumn Header="Status" Width="75">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock VerticalAlignment="Center" Margin="4,0" FontWeight="SemiBold" Text="{Binding Status}">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type TextBlock}">
                        <Style.Triggers>
                          <DataTrigger Value="Success" Binding="{Binding StatusColor}">
                            <Setter Property="Foreground" Value="#4CAF50" />
                          </DataTrigger>
                          <DataTrigger Value="Warning" Binding="{Binding StatusColor}">
                            <Setter Property="Foreground" Value="#FFC107" />
                          </DataTrigger>
                          <DataTrigger Value="Danger" Binding="{Binding StatusColor}">
                            <Setter Property="Foreground" Value="#F44336" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </TextBlock>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Size" Width="70" Binding="{Binding SizeText}" />
            <DataGridTextColumn Header="Modified" Width="70" Binding="{Binding ModifiedTime}" />
          </DataGrid.Columns>
        </DataGrid>
        <GridSplitter Grid.Column="1" Width="14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#00FFFFFF" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type GridSplitter}">
              <Grid Background="#00FFFFFF">
                <Border Width="6" Height="44" CornerRadius="3" VerticalAlignment="Center" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Ellipse Width="3" Height="3" Margin="0,1.5" Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Ellipse Width="3" Height="3" Margin="0,1.5" Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Ellipse Width="3" Height="3" Margin="0,1.5" Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                  </StackPanel>
                </Border>
              </Grid>
            </ControlTemplate>
          </Control.Template>
        </GridSplitter>
        <Grid Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <controls:AssetPreviewPanel x:Name="ModPreviewPanel" Grid.Row="0" />
          <Border Grid.Row="1" Margin="0,8,0,0" Padding="8" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}">
            <StackPanel>
              <TextBlock Text="File Operations" FontWeight="Bold" Margin="0,0,0,8" />
              <WrapPanel>
                <FrameworkElement.Resources>
                  <ResourceDictionary>
                    <Style x:Key="{x:Type ui:Button}" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                      <Setter Property="Padding" Value="8,4" />
                      <Setter Property="FontSize" Value="11" />
                      <Setter Property="Margin" Value="0,0,4,4" />
                    </Style>
                  </ResourceDictionary>
                </FrameworkElement.Resources>
                <ui:Button Content="Details" Icon="Info24" Command="{Binding ShowFileDetailsCommand}" />
                <ui:Button Content="Replace" Icon="ArrowSwap24" Appearance="Primary" ToolTip="Select a local file to replace this asset in your Mods folder." Command="{Binding ReplaceFileCommand}" />
                <ui:Button Content="Readjust" Icon="Edit24" ToolTip="Rotate, Flip, or Resize this image." Command="{Binding AdjustImageCommand}" />
                <ui:Button Content="Recolor" Icon="Color24" ToolTip="Tint this image a new color." Command="{Binding RecolorImageCommand}" Visibility="{Binding SelectedModFile.IsImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:Button Content="Export" Icon="ArrowDownload24" ToolTip="Save this file to your computer." Command="{Binding ExportFileCommand}" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </StackPanel>
</ui:UiPage>
