            <TextBlock FontSize="14" Text="{resources:Loc Ui_Mods_FindMods}" FontWeight="Medium" />
            <TextBlock Margin="0,2,0,0" FontSize="12" Text="{resources:Loc Ui_Mods_BrowseCommunityModsOnGamebanana}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction Name="OpenModFolderCardAction" Margin="4,0,4,0" Icon="Folder24" Command="{Binding OpenModsFolderCommand}">
          <StackPanel>
            <TextBlock FontSize="14" Text="{resources:Loc Menu_Mods_OpenModsFolder_Title}" TextWrapping="Wrap" FontWeight="Medium" />
            <TextBlock Margin="0,2,0,0" FontSize="12" Text="{resources:Loc Menu_Mods_OpenModsFolder_Description}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction Margin="4,0,0,0" Icon="DocumentSearch24" Command="{Binding ToggleModExplorerCommand}">
          <StackPanel>
            <TextBlock FontSize="14" Text="{resources:Loc Ui_Mods_ModExplorer}" FontWeight="Medium" />
            <TextBlock Margin="0,2,0,0" FontSize="12" Text="{resources:Loc Ui_Mods_ViewAndManageFilesInYour}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </ui:CardAction>
      </UniformGrid>
      <TabControl Name="ModsTabs" Margin="0,16,0,0">
