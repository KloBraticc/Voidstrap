<ui:UiPage x:Class="Voidstrap.UI.Elements.Settings.Pages.ModsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:Voidstrap.UI.ViewModels" xmlns:pages="clr-namespace:Voidstrap.UI.Elements.Settings.Pages" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:conv="clr-namespace:Voidstrap.Converters" xmlns:converters="clr-namespace:Voidstrap.UI.Converters" xmlns:settings="clr-namespace:Voidstrap.UI.ViewModels.Settings" xmlns:platform="clr-namespace:Voidstrap.UI" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:gif="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif" Title="ModsPage" Scrollable="True">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
      <conv:EnumNotEqualsVisibilityConverter x:Key="EnumNotEqualsVisibilityConverter" />
      <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <DataTemplate x:Key="CursorSlotRow">
        <Border Margin="0,0,0,6" Padding="12,8" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="6" Background="#33000000" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
              <Image Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Preview}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
              <TextBlock FontSize="14" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
              <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Hint}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
              <ui:Button Icon="DocumentAdd16" Content="Choose" Command="{Binding ChooseCommand}" />
              <ui:Button Margin="8,0,0,0" Appearance="Danger" Icon="Delete16" Content="Remove" Command="{Binding ClearCommand}" Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Margin="0,0,14,14">
    <StackPanel Visibility="{Binding MainContentVisibility}">
      <TextBlock FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Mods_Description}" TextWrapping="Wrap" />
      <UniformGrid Margin="0,16,0,0" Rows="1" VerticalAlignment="Stretch">
        <UniformGrid.Resources>
          <Style TargetType="{x:Type ui:CardAction}" BasedOn="{StaticResource {x:Type ui:CardAction}}">
            <Setter Property="MinHeight" Value="78" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
          </Style>
        </UniformGrid.Resources>
        <ui:CardAction Margin="0,0,4,0" Icon="DocumentTextToolbox24" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://gamebanana.com/games/2879">
          <StackPanel>
            <TextBlock FontSize="14" Text="Find Mods" FontWeight="Medium" />
            <TextBlock Margin="0,2,0,0" FontSize="12" Text="Browse community mods on GameBanana." Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction Name="OpenModFolderCardAction" Margin="4,0,4,0" Icon="Folder24" Command="{Binding OpenModsFolderCommand}">
          <StackPanel>
            <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_Mods_OpenModsFolder_Title}" TextWrapping="Wrap" FontWeight="Medium" />
            <TextBlock Margin="0,2,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_Mods_OpenModsFolder_Description}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction Margin="4,0,0,0" Icon="DocumentSearch24" Command="{Binding ToggleModExplorerCommand}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
          <StackPanel>
            <TextBlock FontSize="14" Text="Mod Explorer" FontWeight="Medium" />
            <TextBlock Margin="0,2,0,0" FontSize="12" Text="View and manage files in your Roblox installation." Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </ui:CardAction>
      </UniformGrid>
      <TabControl Name="ModsTabs" Margin="0,16,0,0">
        <TabItem FontWeight="Medium">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Color24" Margin="0,0,6,0" />
              <TextBlock Text="Customize" />
            </StackPanel>
          </TabItem.Header>
          <StackPanel Margin="12">
            <controls:OptionControl Description="Choose whether your mods are applied to the Roblox player, Roblox Studio, or both." Header="Apply mods to">
              <ComboBox Width="200" Margin="5,0,0,0" Padding="10,5,10,5" ItemsSource="{Binding ModApplyTargets, Mode=OneTime}" SelectedItem="{Binding ModApplyTarget, Mode=TwoWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ComboBox>
            </controls:OptionControl>

            <TextBlock Margin="2,24,0,0" FontSize="16" FontWeight="SemiBold" Text="Cursor" />
                        <controls:OptionControl Header="Cursor style" Description="Use the Roblox cursor, a built in style, or your own images.">
              <ComboBox Width="220" Padding="10,5,10,5" ItemsSource="{Binding CursorSettings.Styles, Mode=OneTime}" SelectedItem="{Binding CursorSettings.SelectedStyle, Mode=TwoWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ComboBox>
            </controls:OptionControl>
            <controls:OptionControl Header="Custom Cursor" Description="Use one image for the pointer, out of reach and text cursors.">
              <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" Margin="0,0,10,0" CornerRadius="6" Background="#33000000" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                  <Image Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding CursorSettings.Pointer.Preview}" />
                </Border>
                <ui:Button Icon="DocumentAdd16" Content="Choose" Command="{Binding CursorSettings.ChooseCustomCursorCommand}" />
                <ui:Button Margin="8,0,0,0" Appearance="Danger" Icon="Delete16" Content="Remove" Command="{Binding CursorSettings.RemoveCustomCursorCommand}" Visibility="{Binding CursorSettings.HasCustomCursor, Converter={StaticResource BooleanToVisibilityConverter}}" />
              </StackPanel>
            </controls:OptionControl>
            <controls:OptionControl Header="Custom Drag Cursor" Description="Shown while dragging in Roblox Studio.">
              <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" Margin="0,0,10,0" CornerRadius="6" Background="#33000000" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                  <Image Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding CursorSettings.Drag.Preview}" />
                </Border>
                <ui:Button Icon="DocumentAdd16" Content="Choose" Command="{Binding CursorSettings.Drag.ChooseCommand}" />
                <ui:Button Margin="8,0,0,0" Appearance="Danger" Icon="Delete16" Content="Remove" Command="{Binding CursorSettings.Drag.ClearCommand}" Visibility="{Binding CursorSettings.Drag.HasImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
              </StackPanel>
            </controls:OptionControl>
            <controls:OptionControl Header="Custom Shiftlock" Description="Shown in the middle of the screen while shift lock is on. Works with every cursor style.">
              <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" Margin="0,0,10,0" CornerRadius="6" Background="#33000000" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                  <Image Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding CursorSettings.ShiftLock.Preview}" />
                </Border>
                <ui:Button Icon="DocumentAdd16" Content="Choose" Command="{Binding CursorSettings.ShiftLock.ChooseCommand}" />
                <ui:Button Margin="8,0,0,0" Appearance="Danger" Icon="Delete16" Content="Remove" Command="{Binding CursorSettings.ShiftLock.ClearCommand}" Visibility="{Binding CursorSettings.ShiftLock.HasImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
              </StackPanel>
            </controls:OptionControl>
            <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
              <HeaderedContentControl.Header>
                <StackPanel>
                  <TextBlock FontSize="14" Text="Custom Cursor Sets" />
                  <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Keep several cursor sets ready and switch between them in one click." TextWrapping="Wrap" />
                </StackPanel>
              </HeaderedContentControl.Header>
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox HorizontalAlignment="Stretch" Padding="10,5,10,5" ItemsSource="{Binding CursorSettings.SavedSets}" SelectedItem="{Binding CursorSettings.SelectedSet, Mode=TwoWay}" Visibility="{Binding CursorSettings.HasSavedSets, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="No cursor sets yet. Press New to make one, or import a zip." TextWrapping="Wrap" Visibility="{Binding CursorSettings.HasNoSavedSets, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <StackPanel Grid.Column="1" Margin="8,0,0,0" Orientation="Horizontal">
                    <ui:Button Icon="Add24" Content="New" Command="{Binding CursorSettings.NewSetCommand}" />
                    <ui:Button Margin="8,0,0,0" Icon="FolderZip24" Content="Import" Command="{Binding CursorSettings.ImportSetCommand}" />
                    <ui:Button Margin="8,0,0,0" Icon="FolderOpen24" Content="Folder" ToolTip="Open the cursor sets folder" Command="{Binding CursorSettings.OpenSetsFolderCommand}" />
                  </StackPanel>
                </Grid>
                <StackPanel Margin="0,12,0,0" Visibility="{Binding CursorSettings.HasSelectedSet, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <ItemsControl ItemsSource="{Binding CursorSettings.SetSlots}" ItemTemplate="{StaticResource CursorSlotRow}" />
                  <WrapPanel Margin="0,4,0,0">
                    <ui:Button Margin="0,0,8,8" Appearance="Primary" Icon="Checkmark20" Content="Use this set" Command="{Binding CursorSettings.UseSetCommand}" />
                    <ui:Button Margin="0,0,8,8" Icon="CollectionsAdd24" Content="Copy current cursor" ToolTip="Replace this set with your current custom cursor and shift lock icon" Command="{Binding CursorSettings.CopyCurrentToSetCommand}" />
                    <ui:Button Margin="0,0,8,8" Icon="Edit24" Content="Rename" Command="{Binding CursorSettings.RenameSetCommand}" />
                    <ui:Button Margin="0,0,8,8" Icon="ArrowExportRtl24" Content="Export" Command="{Binding CursorSettings.ExportSetCommand}" />
                    <ui:Button Margin="0,0,0,8" Appearance="Danger" Icon="Delete24" Content="Delete" Command="{Binding CursorSettings.DeleteSetCommand}" />
                  </WrapPanel>
                </StackPanel>
              </StackPanel>
            </ui:CardExpander>

            <TextBlock Margin="2,24,0,0" FontSize="16" FontWeight="SemiBold" Text="Interface" />
            <controls:OptionControl Header="Old Roblox TopBar UI" Description="The 2014 to 2015 topbar and game menu, as an overlay.">
              <StackPanel Orientation="Horizontal">
                <ui:ProgressRing Width="20" Height="20" Margin="0,0,10,0" IsIndeterminate="True" Visibility="{Binding ClassicTopBarBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:ToggleSwitch IsChecked="{Binding ClassicTopBarEnabled, Mode=TwoWay}" IsEnabled="{Binding ClassicTopBarReady}" />
              </StackPanel>
            </controls:OptionControl>
            <controls:OptionControl Header="PS4 Button Icons" Description="Swaps the Xbox button prompts for the official PS4 ones.">
              <ui:ToggleSwitch IsChecked="{Binding Ps4ButtonsEnabled, Mode=TwoWay}" IsEnabled="{Binding ClassicTopBarReady}" />
            </controls:OptionControl>
            <controls:OptionControl Header="Hide every CoreGui icon" Description="Blanks the remaining Roblox interface art. Locked on while the old topbar is on.">
              <ui:ToggleSwitch IsChecked="{Binding ClassicTopBarHideAllCoreGui, Mode=TwoWay}" IsEnabled="{Binding ClassicTopBarCoreGuiEditable}" />
            </controls:OptionControl>

            <TextBlock Margin="2,24,0,0" FontSize="16" FontWeight="SemiBold" Text="Sounds" />
            <controls:OptionControl Description="{x:Static resources:Strings.Menu_Mods_Presets_OldCharacterSounds_Description}" Header="{x:Static resources:Strings.Menu_Mods_Presets_OldCharacterSounds_Title}">
              <ui:ToggleSwitch IsChecked="{Binding OldCharacterSoundsTask.NewState, Mode=TwoWay}" />
            </controls:OptionControl>
            <controls:OptionControl Header="Custom Death Sound" Description="Replaces the death sound with your own audio.">
              <StackPanel>
                <ui:Button Content="Choose Sound..." Icon="DocumentAdd16" Command="{Binding AddCustomDeathSoundCommand}" Visibility="{Binding ChooseCustomDeathSoundVisibility, Mode=OneWay}" />
                <ui:Button Appearance="Danger" Content="Remove Custom Death Sound" Icon="Delete16" Command="{Binding RemoveCustomDeathSoundCommand}" Visibility="{Binding DeleteCustomDeathSoundVisibility, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right" Visibility="{Binding CustomDeathSoundVolumeVisibility, Mode=OneWay}">
                  <TextBlock Text="Volume" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  <ComboBox MinWidth="110" ItemsSource="{Binding CustomDeathSoundVolumeOptions, Mode=OneTime}" SelectedItem="{Binding CustomDeathSoundVolume, Mode=TwoWay}" />
                </StackPanel>
              </StackPanel>
            </controls:OptionControl>

            <TextBlock Margin="2,24,0,0" FontSize="16" FontWeight="SemiBold" Text="Appearance" />
            <controls:OptionControl Description="{x:Static resources:Strings.Menu_Mods_Presets_OldAvatarEditor_Description}" Header="{x:Static resources:Strings.Menu_Mods_Presets_OldAvatarEditor_Title}">
              <ui:ToggleSwitch IsChecked="{Binding OldAvatarBackgroundTask.NewState, Mode=TwoWay}" />
            </controls:OptionControl>
            <controls:OptionControl Description="{x:Static resources:Strings.Menu_Mods_Presets_EmojiType_Description}" Header="{x:Static resources:Strings.Menu_Mods_Presets_EmojiType_Title}">
              <ComboBox Width="220" Margin="5,0,0,0" Padding="10,5,10,5" ItemsSource="{Binding EmojiFontTask.Selections, Mode=OneTime}" Text="{Binding EmojiFontTask.NewState, Mode=TwoWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ComboBox>
            </controls:OptionControl>
            <controls:OptionControl Header="Skybox Manager" Description="Choose a skybox once. Voidstrap downloads and applies it safely when Roblox starts.">
              <StackPanel Width="360">
                <ui:CardExpander Margin="0,0,0,8" IsExpanded="False">
                  <HeaderedContentControl.Header>
                    <StackPanel>
                      <TextBlock FontSize="14" Text="Custom skybox" />
                      <TextBlock Margin="0,2,0,0" FontSize="12" Text="Use one image or choose every cube face." Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                  </HeaderedContentControl.Header>
                  <StackPanel>
                    <ui:Button HorizontalAlignment="Stretch" Content="Use one image for every side" Icon="ImageAdd24" Command="{Binding ChooseSingleSkyboxImageCommand}" IsEnabled="{Binding CustomSkyboxControlsEnabled}" />
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" Text="Back" />
                      <ui:Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding CustomSkyboxBack}" ToolTip="{Binding CustomSkyboxBack}" Command="{Binding ChooseSkyboxFaceCommand}" CommandParameter="Back" IsEnabled="{Binding CustomSkyboxControlsEnabled}" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" Text="Down" />
                      <ui:Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding CustomSkyboxDown}" ToolTip="{Binding CustomSkyboxDown}" Command="{Binding ChooseSkyboxFaceCommand}" CommandParameter="Down" IsEnabled="{Binding CustomSkyboxControlsEnabled}" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" Text="Front" />
                      <ui:Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding CustomSkyboxFront}" ToolTip="{Binding CustomSkyboxFront}" Command="{Binding ChooseSkyboxFaceCommand}" CommandParameter="Front" IsEnabled="{Binding CustomSkyboxControlsEnabled}" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" Text="Left" />
                      <ui:Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding CustomSkyboxLeft}" ToolTip="{Binding CustomSkyboxLeft}" Command="{Binding ChooseSkyboxFaceCommand}" CommandParameter="Left" IsEnabled="{Binding CustomSkyboxControlsEnabled}" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" Text="Right" />
                      <ui:Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding CustomSkyboxRight}" ToolTip="{Binding CustomSkyboxRight}" Command="{Binding ChooseSkyboxFaceCommand}" CommandParameter="Right" IsEnabled="{Binding CustomSkyboxControlsEnabled}" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" Text="Up" />
                      <ui:Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding CustomSkyboxUp}" ToolTip="{Binding CustomSkyboxUp}" Command="{Binding ChooseSkyboxFaceCommand}" CommandParameter="Up" IsEnabled="{Binding CustomSkyboxControlsEnabled}" />
                    </Grid>
                    <WrapPanel Margin="0,10,0,0" HorizontalAlignment="Right">
                      <ui:ProgressRing Width="20" Height="20" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding CustomSkyboxBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      <ui:Button Margin="0,0,8,0" Appearance="Danger" Content="Remove custom" Icon="Delete16" Command="{Binding RemoveCustomSkyboxCommand}" IsEnabled="{Binding CustomSkyboxControlsEnabled}" Visibility="{Binding HasCustomSkybox, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      <ui:Button Appearance="Primary" Content="Save and use" Command="{Binding ApplyCustomSkyboxCommand}" IsEnabled="{Binding CustomSkyboxCanApply}" />
                    </WrapPanel>
                  </StackPanel>
                </ui:CardExpander>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox Grid.Column="0" MinWidth="240" Padding="10,5,10,5" DisplayMemberPath="Name" ItemsSource="{Binding AvailableSkyboxPacks}" SelectedItem="{Binding SelectedSkyboxPack, Mode=TwoWay}" IsEnabled="{Binding SkyboxManagerReady}" />
                  <ui:Button Grid.Column="1" Margin="8,0,0,0" Icon="ArrowClockwise24" ToolTip="Refresh skyboxes" Command="{Binding RefreshSkyboxesCommand}" IsEnabled="{Binding SkyboxManagerReady}" />
                </Grid>
                <Grid Margin="0,8,0,0">
                  <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding SkyboxEnabled, Mode=TwoWay}" IsEnabled="{Binding SkyboxManagerReady}" />
                </Grid>
              </StackPanel>
            </controls:OptionControl>
            <controls:OptionControl Header="Font Manager" Description="Use a local font or use google fonts">
              <StackPanel Width="360">
                <Border Margin="0,0,0,8" Padding="9" MinHeight="54" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}" Visibility="{Binding FontPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <TextBlock VerticalAlignment="Center" FontFamily="{Binding FontPreviewFontFamily}" FontSize="18" Text="Aa Bb Cc 123   The quick brown fox." TextWrapping="Wrap" />
                </Border>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox Grid.Column="0" MinWidth="240" MaxDropDownHeight="360" Padding="10,5,10,5" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" TextSearch.TextPath="Family" DisplayMemberPath="DisplayName" ItemsSource="{Binding AvailableGoogleFonts}" SelectedItem="{Binding SelectedGoogleFont, Mode=TwoWay}" IsEnabled="{Binding FontManagerReady}" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                  <ui:Button Grid.Column="1" Margin="8,0,0,0" Icon="ArrowClockwise24" ToolTip="Refresh fonts" Command="{Binding RefreshGoogleFontsCommand}" IsEnabled="{Binding FontManagerReady}" />
                </Grid>
                <WrapPanel Margin="0,8,0,0" HorizontalAlignment="Right">
                  <ui:Button Margin="0,0,8,0" Content="Choose local font" Icon="DocumentAdd16" Command="{Binding ChooseLocalFontCommand}" IsEnabled="{Binding FontManagerReady}" Visibility="{Binding ChooseCustomFontVisibility}" />
                  <ui:Button Margin="0,0,8,0" Content="Remove font" Appearance="Danger" Icon="Delete16" Command="{Binding RemoveCustomFontCommand}" IsEnabled="{Binding FontManagerReady}" Visibility="{Binding DeleteCustomFontVisibility}" />
                  <ui:Button Content="Use font" Appearance="Primary" Command="{Binding ApplyGoogleFontCommand}" IsEnabled="{Binding FontManagerCanApply}" />
                </WrapPanel>
                <Grid Margin="0,9,0,0" Visibility="{Binding HasCustomFont, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Size" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox MinWidth="100" ItemsSource="{Binding CustomFontScaleOptions, Mode=OneTime}" SelectedItem="{Binding CustomFontScale, Mode=TwoWay}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </controls:OptionControl>

            <pages:ModGeneratorSection />

            <TextBlock Margin="2,24,0,0" FontSize="16" FontWeight="SemiBold" Text="Help and fixes" />
            <ui:CardAction Margin="0,8,0,0" Icon="BookQuestionMark24" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://github.com/Bloxstraplabs/Bloxstrap/wiki/Adding-custom-mods">
              <StackPanel>
                <TextBlock FontSize="14" Text="{x:Static resources:Strings.Common_Help}" FontWeight="Medium" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_Mods_Help_Description}" Padding="0,0,16,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </ui:CardAction>
            <ui:CardAction Margin="0,7,0,0" VerticalAlignment="Top" Icon="WindowWrench24" Command="{Binding OpenCompatSettingsCommand}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
              <StackPanel>
                <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_Mods_Misc_CompatibilitySettings_Title}" TextWrapping="Wrap" FontWeight="Medium" />
                <controls:MarkdownTextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" MarkdownText="{Binding Source={x:Static resources:Strings.Menu_Mods_Misc_CompatibilitySettings_Description}, Converter={StaticResource StringFormatConverter}, ConverterParameter=https://devblogs.microsoft.com/directx/demystifying-full-screen-optimizations/}" />
              </StackPanel>
            </ui:CardAction>
          </StackPanel>
        </TabItem>
        <TabItem x:Name="ModPacksTab" FontWeight="Medium">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Globe24" Margin="0,0,6,0" />
              <TextBlock Text="Mod Packs" />
            </StackPanel>
          </TabItem.Header>
          <Grid Margin="12" DataContext="{Binding CommunityMods}">
            <Grid Visibility="{Binding BrowseVisibility}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="4" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                  <StackPanel Orientation="Horizontal">
                    <ui:Button Height="32" Margin="0,0,4,0" Padding="12,0" Tag="GameBanana" Click="CommunitySource_Click">
                      <ui:Button.Style>
                        <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                          <Setter Property="Appearance" Value="Transparent" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMarketplace}" Value="False">
                              <Setter Property="Appearance" Value="Primary" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ui:Button.Style>
                      <StackPanel Orientation="Horizontal">
                        <Image Width="16" Height="16" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Resources/CommunityMods/GameBanana.png" />
                        <TextBlock VerticalAlignment="Center" Text="GameBanana" />
                      </StackPanel>
                    </ui:Button>
                    <ui:Button Height="32" Padding="12,0" Tag="Kliko's Mods" Click="CommunitySource_Click">
                      <ui:Button.Style>
                        <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                          <Setter Property="Appearance" Value="Transparent" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMarketplace}" Value="True">
                              <Setter Property="Appearance" Value="Primary" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ui:Button.Style>
                      <StackPanel Orientation="Horizontal">
                        <Image Width="16" Height="16" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Resources/CommunityMods/KlikosModManager.png" />
                        <TextBlock VerticalAlignment="Center" Text="Kliko's Mods" />
                      </StackPanel>
                    </ui:Button>
                  </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                  <ComboBox Width="170" Height="34" VerticalContentAlignment="Center" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}" Visibility="{Binding SortVisibility}" />
                  <ui:TextBox Width="240" Height="34" Margin="8,0,0,0" VerticalContentAlignment="Center" Icon="Search24" ClearButtonEnabled="True" PlaceholderText="Search Roblox mods" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
              </Grid>
              <Grid Grid.Row="1" Margin="0,0,0,10">
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StatusText}" />
                <ProgressBar Width="120" Height="3" HorizontalAlignment="Right" VerticalAlignment="Center" IsIndeterminate="True" Visibility="{Binding BusyVisibility}" />
              </Grid>
              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="198" Margin="0,0,12,0" Padding="10" VerticalAlignment="Top" CornerRadius="8" Visibility="{Binding CategoryVisibility}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                  <StackPanel>
                    <TextBlock Margin="2,0,0,8" FontSize="15" FontWeight="SemiBold" Text="Categories" />
                    <ui:Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,4" Appearance="Transparent" Content="All categories" Command="{Binding ClearCategoryCommand}" />
                    <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <ui:Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,4" Appearance="Transparent" Content="{Binding Display, Mode=OneTime}" Tag="{Binding}" Click="CommunityCategory_Click" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <StackPanel Grid.Column="1">
                  <Border Padding="24" CornerRadius="8" Visibility="{Binding EmptyVisibility}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="No mod packs to show" />
                      <TextBlock Margin="0,6,0,0" MaxWidth="460" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Anything that fails the Roblox and safety checks is hidden, so a category can legitimately look empty." />
                    </StackPanel>
                  </Border>
                  <ItemsControl MaxHeight="640" ItemsSource="{Binding Mods}" Focusable="False" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ItemsControl.Template>
                      <ControlTemplate TargetType="{x:Type ItemsControl}">
                        <ScrollViewer Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                          <ItemsPresenter />
                        </ScrollViewer>
                      </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,4,10" Padding="14" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="84" Height="84" VerticalAlignment="Top" CornerRadius="12" Background="{DynamicResource ControlFillColorDefaultBrush}">
                              <Border.Clip>
                                <RectangleGeometry Rect="0,0,84,84" RadiusX="12" RadiusY="12" />
                              </Border.Clip>
                              <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding IconUrl, Mode=OneTime}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                              <TextBlock FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name, Mode=OneTime}" />
                              <TextBlock Margin="0,4,0,0" MaxHeight="40" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Summary, Mode=OneTime}" />
                              <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Author, Mode=OneTime}" />
                                <TextBlock Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding CategoryDisplay, Mode=OneTime}" />
                                <TextBlock Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding StatsDisplay, Mode=OneTime}" />
                              </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                              <StackPanel Margin="0,0,0,10" HorizontalAlignment="Right" Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Tag24" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Margin="5,0,12,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Version, Mode=OneTime}" />
                                <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding UpdatedDisplay, Mode=OneTime}" />
                              </StackPanel>
                              <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <ui:Button MinWidth="76" Margin="0,0,8,0" Appearance="Secondary" Content="Page" Tag="{Binding}" Click="CommunityModPage_Click" />
                                <ui:Button MinWidth="84" Appearance="Primary" Content="View" Tag="{Binding}" Click="CommunityMod_Click" />
                              </StackPanel>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ui:Button Margin="0,4,0,0" HorizontalAlignment="Center" Icon="ArrowDown24" Content="Load more" Command="{Binding LoadMoreCommand}" Visibility="{Binding HasMore, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
              </Grid>
            </Grid>

            <Grid Visibility="{Binding DetailVisibility}">
              <StackPanel>
                <ui:Button Margin="0,0,0,10" Padding="8,4,12,4" Appearance="Transparent" Icon="ArrowLeft24" Content="Back to mod packs" Command="{Binding BackCommand}" />

                <Border Margin="0,0,0,10" Padding="14" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="84" Height="84" VerticalAlignment="Top" CornerRadius="12" Background="{DynamicResource ControlFillColorDefaultBrush}">
                      <Border.Clip>
                        <RectangleGeometry Rect="0,0,84,84" RadiusX="12" RadiusY="12" />
                      </Border.Clip>
                      <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding SelectedMod.IconUrl}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                      <TextBlock FontSize="18" FontWeight="SemiBold" MaxHeight="50" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="{Binding SelectedMod.Name}" />
                      <TextBlock Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="{Binding SelectedMod.CategoryDisplay, Mode=OneWay}" /><Run Text="   by " /><Run Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SelectedMod.Author, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding SelectedMod.DetailStatsDisplay, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <Border Padding="8" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" Visibility="{Binding CreatorVisibility}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Border Width="42" Height="42" Margin="0,0,9,0" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <Border.Clip>
                              <RectangleGeometry Rect="0,0,42,42" RadiusX="6" RadiusY="6" />
                            </Border.Clip>
                            <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding SelectedMod.Submitter.AvatarUrl}" />
                          </Border>
                          <StackPanel Grid.Column="1" MaxWidth="170" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding SelectedMod.Submitter.Name}" />
                            <TextBlock Margin="0,2,0,0" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SelectedMod.Submitter.Detail}" />
                            <TextBlock Margin="0,2,0,0" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SystemAccentBrush}" Text="{Binding SelectedMod.Submitter.AchievementDisplay}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                      <ui:Button Margin="0,8,0,0" HorizontalAlignment="Right" Appearance="Secondary" Icon="Open24" Content="Page" ToolTip="Open the mod page" Command="{Binding OpenModPageCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Margin="0,0,0,12" Padding="14" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                  <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="Download" />
                    <ComboBox MinWidth="280" MaxWidth="460" Margin="0,8,0,0" HorizontalAlignment="Left" DisplayMemberPath="FileName" ItemsSource="{Binding DetailFiles}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}" />
                    <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                      <Run Text="{Binding SelectedFile.SizeDisplay, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding InstallTargetHint, Mode=OneWay}" />
                    </TextBlock>
                    <WrapPanel Margin="0,10,0,0">
                      <ui:Button Height="36" Margin="0,0,8,0" Padding="16,0" Appearance="Primary" Icon="ArrowDownload24" Content="Apply to My Mods" IsEnabled="{Binding CanInstall}" Command="{Binding InstallCommand}" Visibility="{Binding ManagedInstallVisibility}" />
                      <ui:Button Height="36" Margin="0,0,8,0" Padding="16,0" Appearance="Primary" Icon="ArrowDownload24" Content="Apply for Voidstrap" IsEnabled="{Binding CanInstall}" Command="{Binding InstallAssetWarpCommand}" Visibility="{Binding ReplacementInstallVisibility}" />
                      <ui:Button Height="36" Padding="16,0" Icon="ArrowDownload24" Content="Apply for Fleasion" IsEnabled="{Binding CanInstall}" Command="{Binding InstallFleasionCommand}" Visibility="{Binding ReplacementInstallVisibility}" />
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <TabControl>
                  <TabItem Header="Description">
                    <StackPanel Margin="12,12,12,4">
                      <ItemsControl ItemsSource="{Binding DetailParagraphs}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <controls:MarkdownTextBlock Margin="0,0,0,10" FontSize="14" LineHeight="22" TextWrapping="Wrap" MarkdownText="{Binding Mode=OneTime}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <StackPanel Visibility="{Binding GameBananaDetailVisibility}">
                        <TextBlock Margin="0,10,0,6" FontSize="14" FontWeight="SemiBold" Text="License" />
                        <TextBlock Margin="0,0,0,10" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SelectedMod.LicenseText}" />
                        <ItemsControl ItemsSource="{Binding SelectedMod.LicenseRules}" Focusable="False">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Margin="0,0,0,8">
                                <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Group}" />
                                <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Text}" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </StackPanel>
                  </TabItem>
                  <TabItem Header="Gallery" Visibility="{Binding GalleryVisibility}">
                    <ItemsControl Margin="12" ItemsSource="{Binding DetailImages}" Focusable="False">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Width="220" Margin="0,0,10,10">
                            <Border Height="138" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                              <Border.Clip>
                                <RectangleGeometry Rect="0,0,220,138" RadiusX="8" RadiusY="8" />
                              </Border.Clip>
                              <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Thumbnail, Mode=OneTime}" />
                            </Border>
                            <TextBlock Margin="2,6,0,0" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Caption, Mode=OneTime}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </TabItem>
                  <TabItem Visibility="{Binding GameBananaDetailVisibility}">
                    <TabItem.Header>
                      <TextBlock Text="{Binding SelectedMod.CommentCount, StringFormat=Comments ({0})}" />
                    </TabItem.Header>
                    <StackPanel Margin="12">
                      <TextBlock Margin="0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="No comments have been posted yet.">
                        <TextBlock.Style>
                          <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding SelectedMod.Comments.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <ItemsControl ItemsSource="{Binding SelectedMod.Comments}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="12" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                              <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Top" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                  <Border.Clip>
                                    <RectangleGeometry Rect="0,0,40,40" RadiusX="6" RadiusY="6" />
                                  </Border.Clip>
                                  <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Author.AvatarUrl}" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                  <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold" Text="{Binding Author.Name, Mode=OneWay}" /><Run Text="   " /><Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Author.Detail, Mode=OneWay}" />
                                  </TextBlock>
                                  <TextBlock Margin="0,2,0,6" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"><Run Text="{Binding DateDisplay, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding ActivityDisplay, Mode=OneWay}" /></TextBlock>
                                  <ItemsControl ItemsSource="{Binding Paragraphs}" Focusable="False">
                                    <ItemsControl.ItemTemplate><DataTemplate><controls:MarkdownTextBlock Margin="0,0,0,6" TextWrapping="Wrap" MarkdownText="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </TabItem>
                  <TabItem Visibility="{Binding GameBananaDetailVisibility}">
                    <TabItem.Header><TextBlock Text="{Binding SelectedMod.UpdateCount, StringFormat=Updates ({0})}" /></TabItem.Header>
                    <StackPanel Margin="12">
                      <TextBlock Margin="0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="No updates have been published.">
                        <TextBlock.Style><Style TargetType="{x:Type TextBlock}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedMod.Updates.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                      </TextBlock>
                      <ItemsControl ItemsSource="{Binding SelectedMod.Updates}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="14" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                              <StackPanel>
                                <TextBlock FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Name}" />
                                <TextBlock Margin="0,3,0,8" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Detail}" />
                                <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{Binding Summary}" />
                                <ItemsControl ItemsSource="{Binding Paragraphs}" Focusable="False"><ItemsControl.ItemTemplate><DataTemplate><controls:MarkdownTextBlock Margin="0,0,0,6" TextWrapping="Wrap" MarkdownText="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Margin="0,10,0,6" FontSize="14" FontWeight="SemiBold" Text="{Binding SelectedMod.IssueCount, StringFormat=Issues ({0})}" />
                      <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="No issues are currently listed.">
                        <TextBlock.Style><Style TargetType="{x:Type TextBlock}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedMod.Issues.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                      </TextBlock>
                      <ItemsControl ItemsSource="{Binding SelectedMod.Issues}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="14" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                              <StackPanel>
                                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Name}" />
                                <TextBlock Margin="0,3,0,8" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"><Run Text="{Binding Status, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding DateDisplay, Mode=OneWay}" /></TextBlock>
                                <ItemsControl ItemsSource="{Binding Paragraphs}" Focusable="False"><ItemsControl.ItemTemplate><DataTemplate><controls:MarkdownTextBlock Margin="0,0,0,6" TextWrapping="Wrap" MarkdownText="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </TabItem>
                </TabControl>
              </StackPanel>
            </Grid>
          </Grid>
        </TabItem>
        <TabItem FontWeight="Medium">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Folder24" Margin="0,0,6,0" />
              <TextBlock Text="My Mods" />
            </StackPanel>
          </TabItem.Header>
          <StackPanel Margin="12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding ManagedMods.Count, StringFormat=Mods ({0} found)}" />
                <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ManagedModsSummary}" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <Border Padding="3" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                  <StackPanel Orientation="Horizontal">
                    <ui:Button Width="30" Height="26" Padding="0" Appearance="Transparent" Icon="Add24" ToolTip="Add a mod" AutomationProperties.Name="Add a mod" Command="{Binding AddManagedModCommand}" />
                    <ui:Button Width="30" Height="26" Padding="0" Appearance="Transparent" Icon="ArrowSync24" ToolTip="Refresh the list" AutomationProperties.Name="Refresh the list" Command="{Binding RefreshManagedModsCommand}" />
                    <ui:Button Width="30" Height="26" Padding="0" Appearance="Transparent" Icon="FolderOpen24" Foreground="{DynamicResource SystemAccentBrush}" ToolTip="Open the mod library folder" AutomationProperties.Name="Open the mod library folder" Command="{Binding OpenManagedModsRootCommand}" />
                  </StackPanel>
                </Border>
                <ui:TextBox Width="220" Margin="10,0,0,0" Icon="Search24" PlaceholderText="Search Mods..." Text="{Binding ManagedModSearchText, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>
            <ProgressBar Width="120" Height="3" Margin="0,10,0,0" HorizontalAlignment="Left" IsIndeterminate="True" Visibility="{Binding ManagedModsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Border Margin="0,6,0,0" Padding="20,30,20,34" CornerRadius="8">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ManagedMods.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel HorizontalAlignment="Center">
                <StackPanel Width="300" HorizontalAlignment="Center" IsHitTestVisible="False" CacheMode="BitmapCache">
                  <StackPanel.Effect>
                    <BlurEffect Radius="8" KernelType="Gaussian" RenderingBias="Performance" />
                  </StackPanel.Effect>
                  <StackPanel HorizontalAlignment="Center" Opacity="0.16" Orientation="Horizontal">
                    <Border Width="60" Height="22" CornerRadius="6" Background="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Border Width="132" Height="22" Margin="10,0,0,0" CornerRadius="6" Background="{DynamicResource TextFillColorPrimaryBrush}" />
                  </StackPanel>
                  <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center" Opacity="0.24" Orientation="Horizontal">
                    <Border Width="84" Height="26" CornerRadius="6" Background="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Border Width="150" Height="26" Margin="10,0,0,0" CornerRadius="6" Background="{DynamicResource TextFillColorPrimaryBrush}" />
                  </StackPanel>
                  <Border Margin="0,12,0,0" Padding="14" CornerRadius="10" Opacity="0.32" Background="{DynamicResource TextFillColorPrimaryBrush}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Width="56" Height="56" CornerRadius="8" Opacity="0.55" Background="{DynamicResource ApplicationBackgroundBrush}" />
                      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Border Height="13" CornerRadius="4" Opacity="0.55" Background="{DynamicResource ApplicationBackgroundBrush}" />
                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                          <Border Width="13" Height="13" CornerRadius="7" Opacity="0.55" Background="{DynamicResource ApplicationBackgroundBrush}" />
                          <Border Width="13" Height="13" Margin="6,0,0,0" CornerRadius="7" Opacity="0.55" Background="{DynamicResource ApplicationBackgroundBrush}" />
                          <Border Width="104" Height="13" Margin="8,0,0,0" CornerRadius="4" Opacity="0.55" Background="{DynamicResource ApplicationBackgroundBrush}" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
                <TextBlock Margin="0,26,0,0" HorizontalAlignment="Center" FontSize="28" FontWeight="Bold" Text="{Binding ManagedModsEmptyTitle}" />
                <TextBlock Margin="0,10,0,0" MaxWidth="420" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ManagedModsEmptyDescription}" TextWrapping="Wrap" />
                <Grid Margin="0,24,0,0" HorizontalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:Button Height="38" Padding="16,0" Appearance="Primary" Icon="Add24" Content="Add Mod" Command="{Binding AddManagedModCommand}" />
                  <ui:Button Grid.Column="1" Width="30" Height="38" Margin="1,0,0,0" Padding="0" Appearance="Primary" Icon="ChevronDown24" AutomationProperties.Name="More mod actions" Click="ManagedModsMoreActions_Click">
                    <ui:Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Add Mod" Command="{Binding AddManagedModCommand}">
                          <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Add24" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Open Library" Command="{Binding OpenManagedModsRootCommand}">
                          <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Refresh" Command="{Binding RefreshManagedModsCommand}">
                          <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="ArrowSync24" />
                          </MenuItem.Icon>
                        </MenuItem>
                      </ContextMenu>
                    </ui:Button.ContextMenu>
                  </ui:Button>
                </Grid>
                <Grid Width="240" Margin="0,18,0,18">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                  <TextBlock Grid.Column="1" Margin="12,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="OR" />
                  <Border Grid.Column="2" Height="1" VerticalAlignment="Center" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                </Grid>
                <ui:Button Height="38" Padding="16,0" HorizontalAlignment="Center" Icon="ArrowImport24" Content="Open Library" Command="{Binding OpenManagedModsRootCommand}" />
              </StackPanel>
            </Border>
            <ItemsControl x:Name="ManagedModsList" AllowDrop="True" DragOver="ManagedModsList_DragOver" Drop="ManagedModsList_Drop" ItemsSource="{Binding ManagedMods}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type settings:ManagedModItem}">
                  <Border Margin="0,0,0,8" Padding="12" AllowDrop="True" CornerRadius="8" DragEnter="ManagedModCard_DragEnter" DragLeave="ManagedModCard_DragLeave" DragOver="ManagedModCard_DragOver" Drop="ManagedModCard_Drop">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                      </Style>
                    </Border.Style>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Width="30" Height="36" Margin="0,0,6,0" Cursor="SizeAll" AutomationProperties.Name="Drag mod to change apply order" PreviewMouseLeftButtonDown="ManagedModDragHandle_MouseLeftButtonDown" PreviewMouseMove="ManagedModDragHandle_MouseMove">
                        <ui:SymbolIcon Width="20" Height="20" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="ReOrderDotsVertical24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      </Border>
                      <Border Grid.Column="1" Width="44" Height="44" Margin="0,0,10,0" VerticalAlignment="Center" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource ControlFillColorSecondaryBrush}" Visibility="{Binding PackIconVisibility}">
                        <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Pack.IconUrl, Mode=OneWay}" />
                      </Border>
                      <ToggleButton Grid.Column="2" Width="36" Height="36" Margin="0,0,12,0" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Enabled, Mode=OneWay}" Command="{Binding DataContext.ToggleManagedModCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:ModsPage}}}" CommandParameter="{Binding}" AutomationProperties.Name="Enable or disable this mod">
                        <ui:SymbolIcon Width="20" Height="20" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Symbol="Power24" Filled="{Binding Enabled, Mode=OneWay}" />
                      </ToggleButton>
                      <StackPanel Grid.Column="3" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" />
                        <TextBlock Margin="0,3,0,0" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SystemAccentBrush}" Text="{Binding PackDetail, Mode=OneWay}" Visibility="{Binding PackVisibility}" />
                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                          <Run Text="{Binding FileSummary, Mode=OneWay}" /><Run Text="   ID: " /><Run Text="{Binding ShortId, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding ConflictText}" Visibility="{Binding HasConflicts, Converter={StaticResource BooleanToVisibilityConverter}}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding ScanError, Mode=OneWay}" Visibility="{Binding HasScanError, Converter={StaticResource BooleanToVisibilityConverter}}" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="4" VerticalAlignment="Center" Orientation="Horizontal">
                        <ui:Button Height="36" Margin="0,0,6,0" Padding="12,0" Appearance="Primary" Icon="Open24" Content="View" AutomationProperties.Name="View this mod pack" Visibility="{Binding PackVisibility}" Command="{Binding DataContext.ViewModPackCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:ModsPage}}}" CommandParameter="{Binding}" />
                        <ui:Button Width="36" Height="36" Margin="0,0,6,0" Padding="0" Appearance="Secondary" Icon="FolderOpen24" AutomationProperties.Name="Open mod folder" Command="{Binding DataContext.OpenManagedModCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:ModsPage}}}" CommandParameter="{Binding}" />
                        <ui:Button Width="36" Height="36" Margin="0,0,6,0" Padding="0" Appearance="Secondary" Icon="Options24" ToolTip="Edit options" AutomationProperties.Name="Edit mod options" Visibility="{Binding EditVisibility}" Command="{Binding DataContext.EditManagedModCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:ModsPage}}}" CommandParameter="{Binding}" />
                        <ui:Button Width="36" Height="36" Margin="0,0,6,0" Padding="0" Appearance="Secondary" Icon="Edit24" AutomationProperties.Name="Rename mod" Command="{Binding DataContext.RenameManagedModCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:ModsPage}}}" CommandParameter="{Binding}" />
                        <ui:Button Width="36" Height="36" Margin="0,0,6,0" Padding="0" Appearance="Secondary" Icon="Copy24" AutomationProperties.Name="Copy full mod identifier" Command="{Binding DataContext.CopyManagedModIdCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:ModsPage}}}" CommandParameter="{Binding}" />
                        <ui:Button Width="36" Height="36" Padding="0" Appearance="Danger" Icon="Delete24" AutomationProperties.Name="Remove mod" Command="{Binding DataContext.RemoveManagedModCommand, RelativeSource={RelativeSource AncestorType={x:Type pages:ModsPage}}}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </TabItem>
        <TabItem FontWeight="Medium" Visibility="{x:Static platform:PlatformFeatureVisibility.Overlay}">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Layer24" Margin="0,0,6,0" />
              <TextBlock Text="Overlays" />
            </StackPanel>
          </TabItem.Header>
          <StackPanel Margin="12,12,12,12" Height="Auto">
            <TextBlock FontSize="20" FontWeight="Bold" Margin="0,0,0,8" Text="Overlays" />
            <controls:OptionControl Header="Enable Overlays" Description="Turns every overlay below on or off.">
              <ui:ToggleSwitch IsChecked="{Binding OverlaysEnabled, Mode=TwoWay}" />
            </controls:OptionControl>

            <TextBlock Margin="2,20,0,0" FontSize="16" FontWeight="SemiBold" Text="Background" />
                        <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
              <HeaderedContentControl.Header>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="14" Text="Homepage background" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" Text="Replace the dark Roblox home background with a color, gradient, image or video" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                  <ui:ToggleSwitch Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" IsChecked="{Binding HomepageBackgroundOverlayEnabled, Mode=TwoWay}" />
                </Grid>
              </HeaderedContentControl.Header>
              <StackPanel>
                <controls:OptionControl Header="Style" Description="What to show behind the home page.">
                  <ComboBox Width="190" Padding="10,5" ItemsSource="{Binding HomepageBackgroundModes}" SelectedItem="{Binding SelectedHomepageBackgroundMode, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="Color" Visibility="{Binding ShowHomepageSolidColor, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <Button Width="120" Content="{Binding HomepageBackgroundOverlayColor}" Command="{Binding PickHomepageBackgroundColorCommand}" />
                </controls:OptionControl>
                <StackPanel Visibility="{Binding ShowHomepageGradient, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <controls:OptionControl Header="Colors" Description="Start and end of the gradient.">
                    <StackPanel Orientation="Horizontal">
                      <Button Width="110" Content="{Binding HomepageBackgroundOverlayColor}" Command="{Binding PickHomepageBackgroundColorCommand}" />
                      <Button Width="110" Margin="8,0,0,0" Content="{Binding HomepageBackgroundOverlayGradientColor}" Command="{Binding PickHomepageBackgroundGradientColorCommand}" />
                    </StackPanel>
                  </controls:OptionControl>
                  <controls:OptionControl Header="Direction">
                    <StackPanel Orientation="Horizontal">
                      <Slider Width="200" Minimum="0" Maximum="360" TickFrequency="1" VerticalAlignment="Center" Value="{Binding HomepageBackgroundOverlayGradientAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      <TextBlock Width="44" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding HomepageBackgroundOverlayGradientAngleDisplay}" />
                    </StackPanel>
                  </controls:OptionControl>
                </StackPanel>
                <StackPanel Visibility="{Binding ShowHomepageMedia, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <controls:OptionControl Header="File" Description="{Binding HomepageBackgroundOverlayMediaName}">
                    <ui:Button MinWidth="120" Content="{Binding HomepageBackgroundMediaButtonText}" Command="{Binding ToggleHomepageBackgroundMediaCommand}">
                      <FrameworkElement.Style>
                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="{x:Type ui:Button}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasHomepageBackgroundMedia}" Value="True">
                              <Setter Property="Appearance" Value="Danger" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </ui:Button>
                  </controls:OptionControl>
                  <Border Height="150" Margin="0,8,0,4" CornerRadius="6"
                          Background="{DynamicResource ControlFillColorSecondaryBrush}"
                          BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                          ClipToBounds="True" SnapsToDevicePixels="True"
                          Visibility="{Binding HasHomepageBackgroundMedia, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                      <Grid Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
                        <Image Stretch="UniformToFill" IsHitTestVisible="False"
                               Source="{Binding HomepageMediaStillSource}"
                               Visibility="{Binding HomepageMediaIsStill, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Image Stretch="UniformToFill" IsHitTestVisible="False"
                               gif:ImageBehavior.RepeatBehavior="Forever"
                               gif:ImageBehavior.AnimatedSource="{Binding HomepageMediaAnimatedSource}"
                               Visibility="{Binding HomepageMediaIsAnimated, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <controls:HomepageMediaPreviewVideo IsHitTestVisible="False"
                                                            Visibility="{Binding HomepageMediaIsVideo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      </Grid>
                      <controls:HomepageMediaPreviewVideo IsHitTestVisible="False"
                                                          SourcePath="{Binding HomepageBackgroundOverlayMediaPath}"
                                                          Visibility="{x:Static platform:PlatformFeatureVisibility.LinuxIntegration}" />
                      <TextBlock Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                 TextAlignment="Center" Opacity="0.7" Text="{Binding HomepageMediaPreviewMessage}"
                                 Visibility="{Binding HasHomepageMediaPreviewMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                  </Border>
                </StackPanel>
              </StackPanel>
            </ui:CardExpander>

            <TextBlock Margin="2,20,0,0" FontSize="16" FontWeight="SemiBold" Text="Display" />
                        <StackPanel Margin="0,8,0,0">
              <TextBlock Margin="2,0,0,0" FontSize="14" FontWeight="Medium" Text="Screen color" />
              <StackPanel>
                <controls:OptionControl Header="Brightness">
                  <StackPanel Orientation="Horizontal">
                    <Slider Width="200" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Value="{Binding Brightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Width="44" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding BrightnessDisplay}" />
                  </StackPanel>
                </controls:OptionControl>
                <controls:OptionControl Header="Saturation" Description="100 is normal.">
                  <StackPanel Orientation="Horizontal">
                    <Slider Width="200" Minimum="0" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Value="{Binding Saturation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Width="44" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding SaturationDisplay}" />
                  </StackPanel>
                </controls:OptionControl>
                <controls:OptionControl Header="Contrast" Description="100 is normal.">
                  <StackPanel Orientation="Horizontal">
                    <Slider Width="200" Minimum="0" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Value="{Binding Contrast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Width="44" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding ContrastDisplay}" />
                  </StackPanel>
                </controls:OptionControl>
                <controls:OptionControl Header="Warmth" Description="Negative is cooler, positive is warmer." Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
                  <StackPanel Orientation="Horizontal">
                    <Slider Width="200" Minimum="-100" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Value="{Binding ColorTemperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Width="44" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding ColorTemperatureDisplay}" />
                  </StackPanel>
                </controls:OptionControl>
              </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,14,0,0" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
              <TextBlock Margin="2,0,0,0" FontSize="14" FontWeight="Medium" Text="Smoothing and frames" />
              <StackPanel>
                <controls:OptionControl Header="Anti aliasing" Description="Smooths jagged edges using your GPU.">
                  <ComboBox Padding="10,5,10,5" MinWidth="140" ItemsSource="{Binding AntiAliasingMethodNames, Mode=OneTime}" SelectedIndex="{Binding AntiAliasingMethodIndex, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="Motion blur" Description="Adds a motion trail to movement, masked to moving areas so the interface stays sharp.">
                  <ComboBox Padding="10,5,10,5" MinWidth="140" ItemsSource="{Binding MotionBlurStrengthNames, Mode=OneTime}" SelectedIndex="{Binding MotionBlurStrengthIndex, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="Frame generation" Description="Adds generated frames between real ones. Adds a little input delay." Visibility="{x:Static platform:PlatformFeatureVisibility.FrameGeneration}">
                  <ui:ToggleSwitch IsChecked="{Binding FrameGenEnabled, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="Show generated frames" Description="Displays how many frames are being generated." Visibility="{x:Static platform:PlatformFeatureVisibility.FrameGeneration}">
                  <ui:ToggleSwitch IsChecked="{Binding FrameGenOverlayShow, Mode=TwoWay}" />
                </controls:OptionControl>
                <StackPanel Visibility="{x:Static platform:PlatformFeatureVisibility.FrameGeneration}">
                  <ui:InfoBar Margin="0,8,0,0" Severity="Warning" IsClosable="False" IsOpen="{Binding FrameGenCapWarningOpen, Mode=OneWay}" Message="{Binding FrameGenCapWarningMessage, Mode=OneWay}" Visibility="{Binding FrameGenCapWarningOpen, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Content="Fix frame cap" Command="{Binding FixFrameCapCommand}" />
                  </ui:InfoBar>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <ui:CardExpander Margin="0,8,0,0" IsExpanded="False" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
              <HeaderedContentControl.Header>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="14" Text="Color blindness" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" Text="Recolors the screen so colors are easier to tell apart" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                  </StackPanel>
                  <ui:ToggleSwitch Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" IsChecked="{Binding ColorBlindnessEnabled, Mode=TwoWay}" />
                </Grid>
              </HeaderedContentControl.Header>
              <StackPanel>
                <controls:OptionControl Header="Type">
                  <ComboBox SelectedIndex="{Binding ColorBlindnessType, Mode=TwoWay}">
                    <ComboBoxItem Content="Protanopia (red/green)" />
                    <ComboBoxItem Content="Deuteranopia (red/green)" />
                    <ComboBoxItem Content="Tritanopia (blue/yellow)" />
                  </ComboBox>
                </controls:OptionControl>
                <controls:OptionControl Header="Strength">
                  <StackPanel Orientation="Horizontal">
                    <Slider Width="200" Minimum="0" Maximum="100" TickFrequency="25" IsSnapToTickEnabled="True" VerticalAlignment="Center" Value="{Binding ColorBlindnessSeverity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Width="44" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding ColorBlindnessSeverityDisplay}" />
                  </StackPanel>
                </controls:OptionControl>
                <controls:OptionControl Header="Simulate instead" Description="Shows what color blind people see rather than correcting it.">
                  <ui:ToggleSwitch IsChecked="{Binding ColorBlindnessSimulate, Mode=TwoWay}" />
                </controls:OptionControl>
              </StackPanel>
            </ui:CardExpander>

            <TextBlock Margin="2,20,0,0" FontSize="16" FontWeight="SemiBold" Text="In game tools" />
                        <controls:OptionControl Header="Clock" Description="Shows the time in the corner while you play.">
              <ui:ToggleSwitch IsChecked="{Binding CurrentTimeDisplay, Mode=TwoWay}" />
            </controls:OptionControl>
            <StackPanel Margin="16,0,0,0" IsEnabled="{Binding CurrentTimeDisplay}">
              <controls:OptionControl Header="Time zone" Description="System follows this computer.">
                <ComboBox Width="280" Padding="10,5,10,5" SelectedValuePath="Id" DisplayMemberPath="Display"
                          ItemsSource="{Binding ClockTimeZones, Mode=OneTime}"
                          SelectedValue="{Binding ClockTimeZoneId, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl Header="24 hour clock" Description="14:30 instead of 2:30 PM.">
                <ui:ToggleSwitch IsChecked="{Binding Clock24Hour, Mode=TwoWay}" />
              </controls:OptionControl>
            </StackPanel>
            <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
              <HeaderedContentControl.Header>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="14" Text="Crosshair" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" Text="Draw your own crosshair over the game" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                  </StackPanel>
                  <ui:ToggleSwitch Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" IsChecked="{Binding Crosshair, Mode=TwoWay}" />
                </Grid>
              </HeaderedContentControl.Header>
              <StackPanel>
                <controls:OptionControl Header="Shape">
                  <ComboBox Width="160" ItemsSource="{Binding CrosshairShapes}" SelectedItem="{Binding SelectedShape, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="GIF link" Description="Animated GIF URL to use as the crosshair." Visibility="{Binding SelectedShape, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Image}">
                  <TextBox Width="260" Text="{Binding ImageUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:OptionControl>
                <controls:OptionControl Header="Colors" Description="Fill and outline." Visibility="{Binding SelectedShape, Converter={StaticResource EnumNotEqualsVisibilityConverter}, ConverterParameter=Image}">
                  <StackPanel Orientation="Horizontal">
                    <TextBox Width="100" Text="{Binding CursorColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Content="Pick" Margin="4,0,10,0" Command="{Binding PickCursorColorCommand}" />
                    <TextBox Width="100" Text="{Binding CursorOutlineColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Content="Pick" Margin="4,0,0,0" Command="{Binding PickOutlineColorCommand}" />
                  </StackPanel>
                </controls:OptionControl>
                <controls:OptionControl Header="Size">
                  <StackPanel Orientation="Horizontal">
                    <Slider Width="200" Minimum="4" Maximum="64" VerticalAlignment="Center" Value="{Binding CursorSize, Mode=TwoWay}" />
                    <TextBlock Width="44" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding CursorSize}" />
                  </StackPanel>
                </controls:OptionControl>
                <controls:OptionControl Header="Thickness" Visibility="{Binding SelectedShape, Converter={StaticResource EnumNotEqualsVisibilityConverter}, ConverterParameter=Image}">
                  <StackPanel Orientation="Horizontal">
                    <Slider Width="200" Minimum="1" Maximum="10" VerticalAlignment="Center" Value="{Binding CrosshairThickness, Mode=TwoWay}" />
                    <TextBlock Width="44" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding CrosshairThickness}" />
                  </StackPanel>
                </controls:OptionControl>
                <controls:OptionControl Header="Center gap" Visibility="{Binding SelectedShape, Converter={StaticResource EnumNotEqualsVisibilityConverter}, ConverterParameter=Image}">
                  <StackPanel Orientation="Horizontal">
                    <Slider Width="200" Minimum="0" Maximum="32" VerticalAlignment="Center" Value="{Binding Gap, Mode=TwoWay}" />
                    <TextBlock Width="44" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding Gap}" />
                  </StackPanel>
                </controls:OptionControl>
                <controls:OptionControl Header="Opacity">
                  <StackPanel Orientation="Horizontal">
                    <Slider Width="200" Minimum="0.1" Maximum="1.0" VerticalAlignment="Center" Value="{Binding CursorOpacity, Mode=TwoWay}" />
                    <TextBlock Width="44" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding CursorOpacity, StringFormat=0.00}" />
                  </StackPanel>
                </controls:OptionControl>
                <controls:OptionControl Header="Preview">
                  <Border Width="160" Height="160" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}" CornerRadius="6">
                    <Image Stretch="Uniform" Margin="8" Source="{Binding CursorPreview, TargetNullValue={x:Null}}" />
                  </Border>
                </controls:OptionControl>
                <controls:OptionControl Header="Code" Description="Share or paste a crosshair code.">
                  <StackPanel Orientation="Horizontal">
                    <TextBox Width="200" Text="{Binding CursorCode, Mode=TwoWay}" />
                    <ui:Button Content="Generate" Margin="4,0,0,0" Command="{Binding GenerateCursorCodeCommand}" />
                    <ui:Button Content="Apply" Margin="4,0,0,0" Command="{Binding ApplyCursorCodeCommand}" />
                  </StackPanel>
                </controls:OptionControl>
                <controls:OptionControl Header="Save as file">
                  <StackPanel Orientation="Horizontal">
                    <ui:Button Content=".CUR" Margin="0,0,4,0" Command="{Binding DownloadCurCommand}" />
                    <ui:Button Content=".PNG" Command="{Binding DownloadPngCommand}" />
                  </StackPanel>
                </controls:OptionControl>
              </StackPanel>
            </ui:CardExpander>
          </StackPanel>
        </TabItem>
      </TabControl>
    </StackPanel>
    <Border Height="640" Padding="16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Visibility="{Binding ModExplorerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontSize="22" FontWeight="SemiBold" Text="Mod Explorer" />
          <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Browse Roblox assets, preview files, and create mod replacements." />
        </StackPanel>
        <ui:Button Grid.Column="1" Width="36" Height="36" Padding="0" Icon="Dismiss24" ToolTip="Close Mod Explorer" Command="{Binding ToggleModExplorerCommand}" Click="ModExplorerClose_Click" />
      </Grid>
      <Grid Grid.Row="1" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:Button Grid.Column="0" Width="36" Height="36" Padding="0" Margin="0,0,8,0" Icon="ArrowLeft24" ToolTip="Go back" Command="{Binding GoBackCommand}" IsEnabled="{Binding ExplorerCanGoBack}" />
        <Border Grid.Column="1" MinWidth="180" Padding="12,0" Margin="0,0,12,0" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
          <TextBlock VerticalAlignment="Center" FontWeight="Medium" Text="{Binding ExplorerPathDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentExplorerPath}" />
        </Border>
        <ui:TextBox Grid.Column="2" Width="280" PlaceholderText="Search this folder" Icon="Search24" Text="{Binding ExplorerSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      </Grid>
      <Grid Grid.Row="2" MinHeight="320">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" MinWidth="280" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="2*" MinWidth="260" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
          <Grid>
