                  <TextBlock VerticalAlignment="Center" Margin="4,0" FontWeight="SemiBold" Text="{Binding Status}">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type TextBlock}">
                        <Style.Triggers>
                          <DataTrigger Value="Success" Binding="{Binding StatusColor}">
                            <Setter Property="Foreground" Value="#4CAF50" />
                          </DataTrigger>
                          <DataTrigger Value="Warning" Binding="{Binding StatusColor}">
                            <Setter Property="Foreground" Value="#FFC107" />
                          </DataTrigger>
                          <DataTrigger Value="Danger" Binding="{Binding StatusColor}">
                            <Setter Property="Foreground" Value="#F44336" />
