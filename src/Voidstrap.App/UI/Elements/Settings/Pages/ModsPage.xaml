                          </Hyperlink>
                        </TextBlock>
                      </StackPanel>
                      <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Mods_RobloxCursorOverrideDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" IsChecked="{Binding CursorSettings.OverrideEnabled, Mode=TwoWay}" />
                  </Grid>
                </HeaderedContentControl.Header>
                <StackPanel Margin="0,-8,0,0" IsEnabled="{Binding CursorSettings.OverrideEnabled}">
                    <controls:OptionControl Header="{resources:Loc Ui_Mods_OverrideCursorImage}" Description="{resources:Loc Ui_Mods_OverrideCursorImageDescription}">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" Margin="0,0,10,0" CornerRadius="6" Background="#33000000" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                          <Image Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" platform:GifImageBehavior.AnimatedSource="{Binding CursorSettings.OverridePreviewPath}" />
                        </Border>
                        <ui:Button Icon="DocumentAdd16" Content="{resources:Loc Ui_Mods_Choose}" Command="{Binding CursorSettings.ChooseOverrideImageCommand}" Visibility="{Binding CursorSettings.HasOverrideImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        <ui:Button Appearance="Danger" Icon="Delete16" Content="{resources:Loc Ui_Mods_Remove}" Command="{Binding CursorSettings.RemoveOverrideImageCommand}" Visibility="{Binding CursorSettings.HasOverrideImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      </StackPanel>
                    </controls:OptionControl>
                    <controls:OptionControl Header="{resources:Loc Ui_Mods_OverrideHoverCursor}" Description="{resources:Loc Ui_Mods_OverrideHoverCursorDescription}">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" Margin="0,0,10,0" CornerRadius="6" Background="#33000000" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                          <Image Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" platform:GifImageBehavior.AnimatedSource="{Binding CursorSettings.HoverPreviewPath}" />
                        </Border>
                        <ui:Button Icon="DocumentAdd16" Content="{resources:Loc Ui_Mods_Choose}" Command="{Binding CursorSettings.ChooseHoverImageCommand}" Visibility="{Binding CursorSettings.HasHoverImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        <ui:Button Appearance="Danger" Icon="Delete16" Content="{resources:Loc Ui_Mods_Remove}" Command="{Binding CursorSettings.RemoveHoverImageCommand}" Visibility="{Binding CursorSettings.HasHoverImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      </StackPanel>
                    </controls:OptionControl>
                    <controls:OptionControl Header="{resources:Loc Ui_Mods_OverrideClickCursor}" Description="{resources:Loc Ui_Mods_OverrideClickCursorDescription}">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" Margin="0,0,10,0" CornerRadius="6" Background="#33000000" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                          <Image Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" platform:GifImageBehavior.AnimatedSource="{Binding CursorSettings.ClickPreviewPath}" />
                        </Border>
                        <ui:Button Icon="DocumentAdd16" Content="{resources:Loc Ui_Mods_Choose}" Command="{Binding CursorSettings.ChooseClickImageCommand}" Visibility="{Binding CursorSettings.HasClickImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        <ui:Button Appearance="Danger" Icon="Delete16" Content="{resources:Loc Ui_Mods_Remove}" Command="{Binding CursorSettings.RemoveClickImageCommand}" Visibility="{Binding CursorSettings.HasClickImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      </StackPanel>
                    </controls:OptionControl>
                    <controls:OptionControl Header="{resources:Loc Ui_Mods_OverrideCursorSize}">
                      <StackPanel Orientation="Horizontal">
                        <Slider Width="200" VerticalAlignment="Center" Minimum="8" Maximum="256" TickFrequency="4" IsSnapToTickEnabled="True" Value="{Binding CursorSettings.OverrideSize, Mode=TwoWay}" />
                        <TextBlock Width="56" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding CursorSettings.OverrideSize, StringFormat={}{0:0} px}" />
                      </StackPanel>
                    </controls:OptionControl>
                    <controls:OptionControl Header="{resources:Loc Ui_Mods_OverrideCursorCentered}" Description="{resources:Loc Ui_Mods_OverrideCursorCenteredDescription}">
                      <ui:ToggleSwitch IsChecked="{Binding CursorSettings.OverrideCentered, Mode=TwoWay}" />
                    </controls:OptionControl>
                    <ui:InfoBar Margin="0,8,0,0" IsOpen="True" IsClosable="False" Severity="Informational" Visibility="{Binding CursorSettings.OverrideEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Message="{resources:Loc Ui_Mods_CursorLockedByOverride}" />
                </StackPanel>
              </ui:CardExpander>
              <StackPanel IsEnabled="{Binding CursorSettings.IsStyleEditable}">
              <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/mods/#built-in-mods" Header="{resources:Loc Ui_Mods_CursorStyle}">
                <ComboBox Width="240" Padding="10,5,10,5" ItemsSource="{Binding CursorSettings.Styles, Mode=OneTime}" SelectedItem="{Binding CursorSettings.SelectedStyle, Mode=TwoWay}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <Image Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Path=., Converter={StaticResource CursorPreviewConverter}}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ComboBox>
              </controls:OptionControl>
              <controls:OptionControl Header="{resources:Loc Ui_Mods_CustomCursor}" Description="{resources:Loc Ui_Mods_UseOneImageForThePointer}">
                <StackPanel Orientation="Horizontal">
                  <Border Width="36" Height="36" Margin="0,0,10,0" CornerRadius="6" Background="#33000000" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <Image Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding CursorSettings.Pointer.Preview}" />
                  </Border>
                  <ui:Button Icon="DocumentAdd16" Content="{resources:Loc Ui_Mods_Choose}" Command="{Binding CursorSettings.ChooseCustomCursorCommand}" />
                  <ui:Button Margin="8,0,0,0" Appearance="Danger" Icon="Delete16" Content="{resources:Loc Ui_Mods_Remove}" Command="{Binding CursorSettings.RemoveCustomCursorCommand}" Visibility="{Binding CursorSettings.HasCustomCursor, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
              </controls:OptionControl>
              <controls:OptionControl Header="{resources:Loc Ui_Mods_CustomDragCursor}" Description="{resources:Loc Ui_Mods_ShownWhileDraggingInRobloxStudio}">
                <StackPanel Orientation="Horizontal">
                  <Border Width="36" Height="36" Margin="0,0,10,0" CornerRadius="6" Background="#33000000" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <Image Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding CursorSettings.Drag.Preview}" />
                  </Border>
                  <ui:Button Icon="DocumentAdd16" Content="{resources:Loc Ui_Mods_Choose}" Command="{Binding CursorSettings.Drag.ChooseCommand}" />
                  <ui:Button Margin="8,0,0,0" Appearance="Danger" Icon="Delete16" Content="{resources:Loc Ui_Mods_Remove}" Command="{Binding CursorSettings.Drag.ClearCommand}" Visibility="{Binding CursorSettings.Drag.HasImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
              </controls:OptionControl>
              <controls:OptionControl Visibility="{Binding ShiftLockVisibility}" Header="{resources:Loc Ui_Mods_CustomShiftlock}" Description="{resources:Loc Ui_Mods_ShownInTheMiddleOfThe}">
                <StackPanel Orientation="Horizontal">
                  <Border Width="36" Height="36" Margin="0,0,10,0" CornerRadius="6" Background="#33000000" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <Image Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding CursorSettings.ShiftLock.Preview}" />
                  </Border>
                  <ui:Button Icon="DocumentAdd16" Content="{resources:Loc Ui_Mods_Choose}" Command="{Binding CursorSettings.ShiftLock.ChooseCommand}" />
                  <ui:Button Margin="8,0,0,0" Appearance="Danger" Icon="Delete16" Content="{resources:Loc Ui_Mods_Remove}" Command="{Binding CursorSettings.ShiftLock.ClearCommand}" Visibility="{Binding CursorSettings.ShiftLock.HasImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
              </controls:OptionControl>
              <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
                <HeaderedContentControl.Header>
                  <StackPanel>
                    <TextBlock FontSize="14" Text="{resources:Loc Ui_Mods_CustomCursorSets}" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Mods_KeepSeveralCursorSetsReadyAnd}" TextWrapping="Wrap" />
                  </StackPanel>
                </HeaderedContentControl.Header>
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox HorizontalAlignment="Stretch" Padding="10,5,10,5" ItemsSource="{Binding CursorSettings.SavedSets}" SelectedItem="{Binding CursorSettings.SelectedSet, Mode=TwoWay}" Visibility="{Binding CursorSettings.HasSavedSets, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Ui_Mods_NoCursorSetsYetPressNew}" TextWrapping="Wrap" Visibility="{Binding CursorSettings.HasNoSavedSets, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" Orientation="Horizontal">
                      <ui:Button Icon="Add24" Content="{resources:Loc Common_New}" Command="{Binding CursorSettings.NewSetCommand}" />
                      <ui:Button Margin="8,0,0,0" Icon="FolderZip24" Content="{resources:Loc Common_Import}" Command="{Binding CursorSettings.ImportSetCommand}" />
                      <ui:Button Margin="8,0,0,0" Icon="FolderOpen24" Content="{resources:Loc Ui_Mods_Folder}" ToolTip="{resources:Loc Ui_Mods_OpenTheCursorSetsFolder}" Command="{Binding CursorSettings.OpenSetsFolderCommand}" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Margin="0,12,0,0" Visibility="{Binding CursorSettings.HasSelectedSet, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding CursorSettings.SetSlots}" ItemTemplate="{StaticResource CursorSlotRow}" />
                    <WrapPanel Margin="0,4,0,0">
                      <ui:Button Margin="0,0,8,8" Appearance="Primary" Icon="Checkmark20" Content="{resources:Loc Ui_Mods_UseThisSet}" Command="{Binding CursorSettings.UseSetCommand}" />
                      <ui:Button Margin="0,0,8,8" Icon="CollectionsAdd24" Content="{resources:Loc Ui_Mods_CopyCurrentCursor}" ToolTip="{resources:Loc Ui_Mods_ReplaceThisSetWithYourCurrent}" Command="{Binding CursorSettings.CopyCurrentToSetCommand}" />
                      <ui:Button Margin="0,0,8,8" Icon="Edit24" Content="{resources:Loc Common_Rename}" Command="{Binding CursorSettings.RenameSetCommand}" />
                      <ui:Button Margin="0,0,8,8" Icon="ArrowExportRtl24" Content="{resources:Loc Common_Export}" Command="{Binding CursorSettings.ExportSetCommand}" />
                      <ui:Button Margin="0,0,0,8" Appearance="Danger" Icon="Delete24" Content="{resources:Loc Common_Delete}" Command="{Binding CursorSettings.DeleteSetCommand}" />
                    </WrapPanel>
                  </StackPanel>
                </StackPanel>
              </ui:CardExpander>
              </StackPanel>
              </StackPanel>
            </ui:CardExpander>
            <controls:OptionControl Header="{resources:Loc Ui_Mods_OldRobloxTopbarUi}" Description="{resources:Loc Ui_Mods_The2014To2015TopbarAnd}" Visibility="{Binding ClassicTopBarVisibility}">
              <StackPanel Orientation="Horizontal">
                <ui:ProgressRing Width="20" Height="20" Margin="0,0,10,0" IsIndeterminate="True" Visibility="{Binding ClassicTopBarBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:ToggleSwitch IsChecked="{Binding ClassicTopBarEnabled, Mode=TwoWay}" IsEnabled="{Binding ClassicTopBarReady}" />
              </StackPanel>
            </controls:OptionControl>
            <controls:OptionControl Header="{resources:Loc Ui_Mods_Ps4ButtonIcons}" Description="{resources:Loc Ui_Mods_SwapsTheXboxButtonPromptsFor}">
              <ui:ToggleSwitch IsChecked="{Binding Ps4ButtonsEnabled, Mode=TwoWay}" IsEnabled="{Binding ClassicTopBarReady}" />
            </controls:OptionControl>
            <controls:OptionControl Header="{resources:Loc Ui_Mods_HideEveryCoreguiIcon}" Description="{resources:Loc Ui_Mods_BlanksTheRemainingRobloxInterfaceArt}">
              <ui:ToggleSwitch IsChecked="{Binding ClassicTopBarHideAllCoreGui, Mode=TwoWay}" IsEnabled="{Binding ClassicTopBarCoreGuiEditable}" />
            </controls:OptionControl>

            <TextBlock Margin="2,24,0,0" FontSize="16" FontWeight="SemiBold" Text="{resources:Loc Ui_Mods_Sounds}" />
            <controls:OptionControl Description="{resources:Loc Menu_Mods_Presets_OldCharacterSounds_Description}" Header="{resources:Loc Menu_Mods_Presets_OldCharacterSounds_Title}">
              <ui:ToggleSwitch IsChecked="{Binding OldCharacterSoundsTask.NewState, Mode=TwoWay}" />
            </controls:OptionControl>
            <controls:OptionControl Header="{resources:Loc Ui_Mods_CustomDeathSound}" Description="{resources:Loc Ui_Mods_ReplacesTheDeathSoundWithYour}">
              <StackPanel>
                <ui:Button Content="{resources:Loc Ui_Mods_ChooseSound}" Icon="DocumentAdd16" Command="{Binding AddCustomDeathSoundCommand}" Visibility="{Binding ChooseCustomDeathSoundVisibility, Mode=OneWay}" />
                <ui:Button Appearance="Danger" Content="{resources:Loc Ui_Mods_RemoveCustomDeathSound}" Icon="Delete16" Command="{Binding RemoveCustomDeathSoundCommand}" Visibility="{Binding DeleteCustomDeathSoundVisibility, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right" Visibility="{Binding CustomDeathSoundVolumeVisibility, Mode=OneWay}">
                  <TextBlock Text="{resources:Loc Ui_Mods_Volume}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  <ComboBox MinWidth="110" ItemsSource="{Binding CustomDeathSoundVolumeOptions, Mode=OneTime}" SelectedItem="{Binding CustomDeathSoundVolume, Mode=TwoWay}" />
                </StackPanel>
              </StackPanel>
            </controls:OptionControl>

            <TextBlock Margin="2,24,0,0" FontSize="16" FontWeight="SemiBold" Text="{resources:Loc Menu_Appearance_Title}" />
            <controls:OptionControl Description="{resources:Loc Menu_Mods_Presets_OldAvatarEditor_Description}" Header="{resources:Loc Menu_Mods_Presets_OldAvatarEditor_Title}">
              <ui:ToggleSwitch IsChecked="{Binding OldAvatarBackgroundTask.NewState, Mode=TwoWay}" />
            </controls:OptionControl>
