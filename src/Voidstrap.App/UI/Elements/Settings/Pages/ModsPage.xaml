              <TextBlock Margin="5,0" Text="&amp;" />
              <TextBlock Text="{resources:Loc Ui_Mods_Interface}" />
            </StackPanel>
            <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
              <HeaderedContentControl.Header>
                <StackPanel>
                  <TextBlock FontSize="14" Text="{resources:Loc Ui_Mods_Cursor}" />
                  <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Mods_UseTheRobloxCursorABuilt}" TextWrapping="Wrap" />
                </StackPanel>
              </HeaderedContentControl.Header>
              <StackPanel>
