          <ui:Button Content="Open folder" Icon="FolderOpen24" Margin="0,0,8,0" Command="{Binding OpenModFileFolderCommand}" />
          <ui:Button Content="Delete" Icon="Delete24" Appearance="Danger" Command="{Binding DeleteModFileCommand}" IsEnabled="{Binding ExplorerHasSelection}" />
        </StackPanel>
