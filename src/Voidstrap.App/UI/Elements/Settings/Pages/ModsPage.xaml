          <Border Grid.Row="1" Margin="0,12,0,0" Padding="10" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4">
            <StackPanel>
              <TextBlock Text="{resources:Loc Ui_Mods_FileOperations}" FontWeight="Bold" Margin="0,0,0,8" />
              <WrapPanel>
                <FrameworkElement.Resources>
                  <ResourceDictionary>
                    <Style x:Key="{x:Type ui:Button}" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                      <Setter Property="Padding" Value="8,4" />
                      <Setter Property="FontSize" Value="11" />
                      <Setter Property="Margin" Value="0,0,4,4" />
                    </Style>
                  </ResourceDictionary>
                </FrameworkElement.Resources>
                <ui:Button Content="{resources:Loc Ui_Mods_Details}" Icon="Info24" Command="{Binding ShowFileDetailsCommand}" IsEnabled="{Binding ExplorerHasSelection}" />
                <ui:Button Content="{resources:Loc Ui_Mods_Replace}" Icon="ArrowSwap24" Appearance="Primary" ToolTip="{resources:Loc Ui_Mods_ChooseALocalReplacementForThis}" Command="{Binding ReplaceFileCommand}" IsEnabled="{Binding ExplorerSelectedFile}" />
                <ui:Button Content="{resources:Loc Ui_Mods_Adjust}" Icon="Edit24" ToolTip="{resources:Loc Ui_Mods_RotateFlipOrResizeThisImage}" Command="{Binding AdjustImageCommand}" Visibility="{Binding ExplorerSelectedImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:Button Content="{resources:Loc Ui_Mods_Recolor}" Icon="Color24" ToolTip="{resources:Loc Ui_Mods_TintThisImage}" Command="{Binding RecolorImageCommand}" Visibility="{Binding ExplorerSelectedImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:Button Content="{resources:Loc Common_Export}" Icon="ArrowDownload24" ToolTip="{resources:Loc Ui_Mods_SaveThisFileToYourComputer}" Command="{Binding ExportFileCommand}" IsEnabled="{Binding ExplorerSelectedFile}" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </Grid>
        </Border>
      </Grid>
      <Grid Grid.Row="3" Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <ui:Button Content="{resources:Loc ContextMenu_ServerBrowser_Refresh}" Icon="ArrowClockwise24" Appearance="Primary" Margin="0,0,8,0" Command="{Binding RefreshModFilesCommand}" />
          <ui:Button Content="{resources:Loc SettingsProfiles_Folder}" Icon="FolderOpen24" Margin="0,0,8,0" Command="{Binding OpenModFileFolderCommand}" />
          <ui:Button Content="{resources:Loc Common_Delete}" Icon="Delete24" Appearance="Danger" Command="{Binding DeleteModFileCommand}" IsEnabled="{Binding ExplorerHasSelection}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ExplorerItemCountText}" />
          <ui:Button Content="{resources:Loc Ui_Mods_FindMods2}" Icon="DocumentSearch24" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://gamebanana.com/games/2879" />
        </StackPanel>
      </Grid>
      </Grid>
    </Border>
  </StackPanel>
</ui:UiPage>
