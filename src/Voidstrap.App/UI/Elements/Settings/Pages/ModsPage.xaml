                <ui:Button Content="Adjust" Icon="Edit24" ToolTip="Rotate, flip, or resize this image" Command="{Binding AdjustImageCommand}" Visibility="{Binding ExplorerSelectedImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:Button Content="Recolor" Icon="Color24" ToolTip="Tint this image" Command="{Binding RecolorImageCommand}" Visibility="{Binding ExplorerSelectedImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:Button Content="Export" Icon="ArrowDownload24" ToolTip="Save this file to your computer" Command="{Binding ExportFileCommand}" IsEnabled="{Binding ExplorerSelectedFile}" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </Grid>
