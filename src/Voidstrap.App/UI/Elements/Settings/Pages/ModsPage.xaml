          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Color24" Margin="0,0,6,0" />
              <TextBlock Text="{resources:Loc Installer_Appearance_Theme_Customize}" />
            </StackPanel>
          </TabItem.Header>
          <StackPanel Margin="12">
            <ui:CardAction x:Name="OverlaysCard" Margin="0" Icon="Layer24" Click="OpenOverlays_Click" Visibility="{x:Static platform:PlatformFeatureVisibility.Overlay}">
              <StackPanel>
                <TextBlock FontSize="14" Text="{resources:Loc Ui_Mods_Overlays}" FontWeight="Medium" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="{resources:Loc Ui_Mods_OverlaysCardDescription}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </ui:CardAction>
            <controls:OptionControl Description="{resources:Loc Ui_Mods_ChooseWhetherYourModsAreApplied}" Header="{resources:Loc Ui_Mods_ApplyModsTo}">
              <ComboBox Width="200" Margin="5,0,0,0" Padding="10,5,10,5" ItemsSource="{Binding ModApplyTargets, Mode=OneTime}" SelectedItem="{Binding ModApplyTarget, Mode=TwoWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ComboBox>
            </controls:OptionControl>

            <StackPanel Margin="2,24,0,0" Orientation="Horizontal" TextElement.FontSize="16" TextElement.FontWeight="SemiBold">
