              <ComboBox Width="220" Margin="5,0,0,0" Padding="10,5,10,5" ItemsSource="{Binding EmojiFontTask.Selections, Mode=OneTime}" SelectedItem="{Binding EmojiFontTask.NewState, Mode=TwoWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ComboBox>
            </controls:OptionControl>
            <ui:Card Margin="0,8,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="168" Height="168" Margin="0,0,16,0" VerticalAlignment="Top" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}" Background="#FF0D0E12" ClipToBounds="True" ToolTip="{resources:Loc Ui_Mods_SkyboxPreviewHint}">
