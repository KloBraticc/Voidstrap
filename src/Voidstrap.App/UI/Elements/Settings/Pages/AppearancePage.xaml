                          </MultiBinding>
                        </Image.Source>
                      </Image>
                      <TextBlock VerticalAlignment="Center" Text="{Binding Converter={StaticResource EnumNameConverter}}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </controls:OptionControl>
          <Border Margin="0,4,0,0" Padding="16,13,16,14" CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}" Visibility="{Binding CustomThemeEditorVisibility}">
            <Border.Background>
              <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" />
            </Border.Background>
            <controls:CustomThemePanel />
          </Border>
          <controls:OptionControl Header="{resources:Loc Ui_Appearance_WindowBackdrop}" Description="{resources:Loc Ui_Appearance_WindowBackdropDescription}" Visibility="{x:Static platform:PlatformFeatureVisibility.DesktopBackdrop}">
            <ComboBox Width="200" Padding="10,5" ItemsSource="{Binding BackdropOptions}" SelectedItem="{Binding SelectedBackdrop, Mode=OneWay}" SelectionChanged="BackdropComboBox_SelectionChanged">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource EnumNameConverter}}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ComboBox>
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Ui_Appearance_AppFont}" Description="{resources:Loc Ui_Appearance_AppFontDescription}">
            <StackPanel>
              <ui:Button Content="{resources:Loc Ui_Appearance_ChooseFont}" Icon="DocumentAdd16" Command="{Binding ManageAppFontCommand}" Visibility="{Binding ChooseAppFontVisibility, Mode=OneWay}" />
              <ui:Button Appearance="Danger" Icon="Delete16" Command="{Binding ManageAppFontCommand}" Content="{Binding AppFontName, Mode=OneWay}" FontFamily="{Binding AppFontFamily, Mode=OneWay}" Visibility="{Binding RemoveAppFontVisibility, Mode=OneWay}" />
