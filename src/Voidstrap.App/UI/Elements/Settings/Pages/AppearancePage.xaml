          <controls:OptionControl Header="{resources:Loc Ui_Appearance_LauncherStyle}" Description="{resources:Loc Ui_Appearance_LauncherStyleDescription}">
            <ComboBox MinWidth="210" Padding="10,5" ItemsSource="{Binding Dialogs, Mode=OneTime}" SelectedItem="{Binding Dialog, Mode=TwoWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ComboBox>
          </controls:OptionControl>

          <controls:OptionControl Header="{resources:Loc Ui_Appearance_LauncherSize}" Description="{resources:Loc Ui_Appearance_LauncherSizeDescription}">
