                <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="5,0,0,0" Text="{resources:Loc Ui_Appearance_SelectThemeHint}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                  <TextBlock.Style>
