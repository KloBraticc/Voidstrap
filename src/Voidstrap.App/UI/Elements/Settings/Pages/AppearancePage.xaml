                          <StackPanel Orientation="Horizontal">
                            <Grid Width="22" Height="22">
                              <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                <ui:SymbolIcon.Style>
                                  <Style TargetType="ui:SymbolIcon" BasedOn="{StaticResource {x:Type ui:SymbolIcon}}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding UsesImagePreview}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </ui:SymbolIcon.Style>
                              </ui:SymbolIcon>
                              <Image Source="{Binding PreviewImage}" Width="20" Height="20" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Style>
                                  <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding UsesImagePreview}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Image.Style>
                              </Image>
                            </Grid>
                            <TextBlock Margin="7,0,0,0" MaxWidth="82" VerticalAlignment="Center" Text="{Binding IconLabel}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </ui:Button>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="{resources:Loc Ui_Appearance_Section}" Width="130" IsReadOnly="True" Binding="{Binding Section}" />
                  <DataGridTemplateColumn Header="{resources:Loc Ui_Appearance_Show}" Width="90" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <ui:Button MinWidth="74" Height="30" Padding="10,0" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{Binding VisibilityLabel}" ToolTip="{resources:Loc Ui_Appearance_ChangeSidebarVisibility}" IsEnabled="{Binding CanHide}" Command="{Binding DataContext.ToggleSidebarItemVisibilityCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding}">
                          <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                              <Setter Property="Appearance" Value="Secondary" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVisible}" Value="True">
                                  <Setter Property="Appearance" Value="Primary" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </ui:Button.Style>
                        </ui:Button>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="{resources:Loc Ui_Appearance_Move}" Width="86" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                          <ui:Button Width="34" Height="30" Padding="0" Margin="0,0,4,0" ToolTip="{resources:Loc Ui_Appearance_MoveUp}" AutomationProperties.Name="{resources:Loc Ui_Appearance_MoveUp}" IsEnabled="{Binding CanMoveUp}" Command="{Binding DataContext.MoveSidebarItemUpCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="ChevronUp24" Style="{StaticResource SidebarMoveIconStyle}" />
                          </ui:Button>
                          <ui:Button Width="34" Height="30" Padding="0" ToolTip="{resources:Loc Ui_Appearance_MoveDown}" AutomationProperties.Name="{resources:Loc Ui_Appearance_MoveDown}" IsEnabled="{Binding CanMoveDown}" Command="{Binding DataContext.MoveSidebarItemDownCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="ChevronDown24" Style="{StaticResource SidebarMoveIconStyle}" />
                          </ui:Button>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <ItemsControl x:Name="LinuxSidebarList" Grid.Row="0" Visibility="Collapsed" ItemsSource="{Binding SidebarItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,6" Padding="10" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                      <StackPanel>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <ui:TextBox Grid.Column="0" MinWidth="120" Height="32" MaxLength="48" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                          <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Section}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <WrapPanel Margin="0,8,0,0">
                          <ui:Button Width="136" Height="32" Margin="0,0,6,4" Padding="8,0" HorizontalContentAlignment="Left" ToolTip="{resources:Loc Ui_Appearance_ChangeSidebarIcon}" Tag="{Binding}" Click="SidebarIconButton_Click">
                            <StackPanel Orientation="Horizontal">
                              <Grid Width="22" Height="22">
                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                  <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon" BasedOn="{StaticResource {x:Type ui:SymbolIcon}}">
                                      <Setter Property="Visibility" Value="Visible" />
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding UsesImagePreview}" Value="True">
                                          <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <Image Source="{Binding PreviewImage}" Width="20" Height="20" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                  <Image.Style>
                                    <Style TargetType="Image">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding UsesImagePreview}" Value="True">
                                          <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </Image.Style>
                                </Image>
                              </Grid>
                              <TextBlock Margin="7,0,0,0" MaxWidth="86" VerticalAlignment="Center" Text="{Binding IconLabel}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </ui:Button>
                          <ui:Button MinWidth="76" Height="32" Margin="0,0,6,4" Padding="8,0" Content="{Binding VisibilityLabel}" ToolTip="{resources:Loc Ui_Appearance_ChangeSidebarVisibility}" IsEnabled="{Binding CanHide}" Command="{Binding DataContext.ToggleSidebarItemVisibilityCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding}">
                            <ui:Button.Style>
                              <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Secondary" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsVisible}" Value="True">
                                    <Setter Property="Appearance" Value="Primary" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </ui:Button.Style>
                          </ui:Button>
                          <ui:Button Width="34" Height="32" Margin="0,0,4,4" Padding="0" ToolTip="{resources:Loc Ui_Appearance_MoveUp}" AutomationProperties.Name="{resources:Loc Ui_Appearance_MoveUp}" IsEnabled="{Binding CanMoveUp}" Command="{Binding DataContext.MoveSidebarItemUpCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="ChevronUp24" FontSize="16" />
                          </ui:Button>
                          <ui:Button Width="34" Height="32" Margin="0,0,0,4" Padding="0" ToolTip="{resources:Loc Ui_Appearance_MoveDown}" AutomationProperties.Name="{resources:Loc Ui_Appearance_MoveDown}" IsEnabled="{Binding CanMoveDown}" Command="{Binding DataContext.MoveSidebarItemDownCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="ChevronDown24" FontSize="16" />
                          </ui:Button>
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{resources:Loc Ui_Appearance_SidebarAlwaysVisible}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button Grid.Column="1" Margin="12,0,0,0" Icon="ArrowReset24" Content="{resources:Loc Ui_Appearance_ResetSidebar}" Command="{Binding ResetSidebarCommand}" />
              </Grid>
            </Grid>
          </ui:CardExpander>
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <HeaderedContentControl.Header>
              <StackPanel>
                <TextBlock FontSize="14" Text="{resources:Loc Ui_Appearance_AppIdentity}" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="{resources:Loc Ui_Appearance_AppIdentityDescription}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel>
              <controls:OptionControl Header="{resources:Loc Ui_Appearance_AppName}" Description="{resources:Loc Ui_Appearance_AppNameDescription}">
                <ui:TextBox Width="220" MaxLength="32" PlaceholderText="{resources:Loc Enums_Theme_Voidstrap}" Text="{Binding BrandName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </controls:OptionControl>
              <controls:OptionControl Header="{resources:Loc Ui_Appearance_AppIcon}">
                <StackPanel Orientation="Horizontal">
                  <Border Width="36" Height="36" Margin="0,0,10,0" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <Image Width="28" Height="28" Source="{Binding AppIconPreview}" RenderOptions.BitmapScalingMode="HighQuality" />
                  </Border>
                  <ui:Button Content="{resources:Loc Ui_Appearance_ChooseImage}" Icon="ImageAdd24" Command="{Binding ChooseAppIconCommand}" />
                  <ui:Button Margin="8,0,0,0" Content="{resources:Loc Common_Reset}" Icon="ArrowReset24" Appearance="Secondary" Visibility="{Binding ResetAppIconVisibility}" Command="{Binding ResetAppIconCommand}" />
                </StackPanel>
              </controls:OptionControl>
            </StackPanel>
          </ui:CardExpander>
        </StackPanel>
        </StackPanel>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Grid24" Margin="0,0,6,0" />
            <TextBlock Text="{resources:Loc Paths_Icons}" />
          </StackPanel>
        </TabItem.Header>
        <StackPanel Margin="10">
          <TextBlock Margin="0,0,0,4" FontSize="20" FontWeight="Medium" Text="{resources:Loc Paths_Icons}" />
          <controls:OptionControl x:Name="IconSelector" Header="{resources:Loc Menu_Appearance_Icon_Title}" Description="{resources:Loc Menu_Appearance_Icon_Description}">
            <ComboBox Padding="10,5,10,5" SelectedValuePath="IconType" ItemsSource="{Binding Icons, Mode=OneWay}" SelectedValue="{Binding Icon, Mode=TwoWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Height="16" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding ImageSource, Mode=OneWay, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
                    <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Path=IconType, Converter={StaticResource EnumNameConverter}}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ComboBox>
          </controls:OptionControl>
          <controls:OptionControl x:Name="StudioIconSelector" Header="{resources:Loc Ui_Appearance_StudioIcon}" Description="{resources:Loc Ui_Appearance_StudioIconDescription}" Visibility="{Binding StudioIconVisibility, Mode=OneWay}">
            <ComboBox Padding="10,5,10,5" SelectedValuePath="IconType" ItemsSource="{Binding Icons, Mode=OneWay}" SelectedValue="{Binding StudioIcon, Mode=TwoWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Height="16" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding ImageSource, Mode=OneWay, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
                    <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Path=IconType, Converter={StaticResource EnumNameConverter}}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ComboBox>
          </controls:OptionControl>
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <HeaderedContentControl.Header>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock FontSize="14" Text="{resources:Loc Ui_Appearance_Customization}" />
                  <TextBlock FontSize="12" Text="{resources:Loc Menu_Appearance_Customisation_Description}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
              </Grid>
            </HeaderedContentControl.Header>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{resources:Loc Menu_Appearance_CustomisationTitle_Title}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <ui:TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Title, Mode=TwoWay}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" FontSize="12" Text="{resources:Loc Menu_Appearance_CustomisationTitle_Description}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,12,0,0" Text="{resources:Loc Menu_Appearance_CustomisationIcon_Title}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <Grid Row="2" Column="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" Margin="0,0,4,0" Text="{Binding CustomIconLocation, Mode=TwoWay}" />
                <ui:Button Grid.Column="1" Margin="4,0,0,0" Height="35" Icon="Folder24" Content="{resources:Loc Common_Browse}" Command="{Binding BrowseCustomIconLocationCommand}" />
              </Grid>
              <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" FontSize="12" Text="{resources:Loc Menu_Appearance_CustomisationIcon_Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Grid>
          </ui:CardExpander>
        </StackPanel>
      </TabItem>
    </TabControl>
  </StackPanel>
</ui:UiPage>
