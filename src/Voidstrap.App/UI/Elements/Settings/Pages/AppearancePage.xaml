                  <ui:Button Grid.Column="1" Margin="4,0,0,0" Icon="Delete24" Content="{resources:Loc Common_Delete}" Appearance="Danger" HorizontalAlignment="Stretch" IsEnabled="{Binding IsCustomThemeSelected, Mode=OneWay}" Command="{Binding DeleteCustomThemeCommand, Mode=OneTime}" />
