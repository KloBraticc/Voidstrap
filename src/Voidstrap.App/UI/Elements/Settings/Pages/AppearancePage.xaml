              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="22" Height="15" Margin="0,0,10,0" VerticalAlignment="Center" CornerRadius="2" SnapsToDevicePixels="True" Visibility="{Binding Path=., Converter={StaticResource LanguageFlagVisibilityConverter}}">
                      <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Path=., Converter={StaticResource LanguageFlagConverter}}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Margin="0,1,0,0" FontSize="11" Opacity="0.65" Text="{Binding Status}" Visibility="{Binding Path=., Converter={StaticResource LanguageStatusVisibilityConverter}}" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ComboBox>
          </controls:OptionControl>
