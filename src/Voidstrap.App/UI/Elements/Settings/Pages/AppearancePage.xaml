      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="MoreHorizontal24" Margin="0,0,6,0" />
            <TextBlock Text="{resources:Loc Ui_Nav_More}" />
          </StackPanel>
        </TabItem.Header>
        <StackPanel>
        <StackPanel Margin="10">
