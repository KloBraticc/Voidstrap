<ui:UiPage x:Class="Voidstrap.UI.Elements.Settings.Pages.AppearancePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:models="clr-namespace:Voidstrap.UI.ViewModels" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls" xmlns:resources="clr-namespace:Voidstrap.Resources" Title="AppearancePage" Scrollable="True" xmlns:pages="clr-namespace:Voidstrap.UI.Elements.Settings.Pages">
  <StackPanel Margin="0,0,14,14">
    <TextBlock Text="{x:Static resources:Strings.Menu_Appearance_Description}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

    <TabControl Margin="0,12,0,0">

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Color24" Margin="0,0,6,0" />
            <TextBlock Text="Application" />
          </StackPanel>
        </TabItem.Header>
        <StackPanel Margin="10">
          <TextBlock Margin="0,0,0,4" FontSize="20" FontWeight="Medium" Text="Application" />
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <HeaderedContentControl.Header>
              <StackPanel>
                <TextBlock FontSize="14" Text="Background and UI" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="Customize background ui and options" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel>
              <controls:OptionControl Description="Adds Snow to Voidstraps background" Header="Background Snow">
                <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding Snowww, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl Description="Adds a Gradient Movement with Cursor" Header="Gradient Movement">
                <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding GRADmentFR, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl Description="Adds smooth scrollbar movement instantly" Header="Smooth ScrollBar">
                <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding SmooothBARRyesirikikthxlucipook, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl Description="Uses sharper text rendering after Voidstrap restarts" Header="Clear Font">
                <ui:ToggleSwitch Background="{DynamicResource SystemAccentBrush}" IsChecked="{Binding ClearFont, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl Header="Background Settings" Description="Import a background image/video/gif and adjust opacity settings. Gradient opacity is set from the image lighting on import, and you can change it after.">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Margin="0,5,0,0">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,5">
                    <TextBlock Text="Gradient Opacity" VerticalAlignment="Center" Width="120" />
                    <Slider Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" Width="200" Value="{Binding GradientOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="5,0,0,0" Text="{Binding GradientOpacity, StringFormat={}{0:F2}}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,5">
                    <TextBlock Text="Dark Overlay" VerticalAlignment="Center" Width="120" />
                    <Slider Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" Width="200" Value="{Binding BlackOverlayOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="5,0,0,0" Text="{Binding BlackOverlayOpacity, StringFormat={}{0:F2}}" />
                  </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,5">
                                        <TextBlock Text="Display everywhere" VerticalAlignment="Center" Width="130" />
                                        <ui:ToggleSwitch IsChecked="{Binding BackgroundEverywhere, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,5">
                    <ui:Button>
                      <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                          <Setter Property="Content" Value="Import" />
                          <Setter Property="Command" Value="{Binding ImportBackgroundCommand2}" />
                          <Setter Property="Appearance" Value="Secondary" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCustomBackground}" Value="True">
                              <Setter Property="Content" Value="Remove" />
                              <Setter Property="Command" Value="{Binding RemoveBackgroundCommand2}" />
                              <Setter Property="Appearance" Value="Danger" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ui:Button.Style>
                    </ui:Button>
                  </StackPanel>
                </StackPanel>
              </controls:OptionControl>
            </StackPanel>
          </ui:CardExpander>
          <controls:OptionControl Loaded="OptionControl_Loaded" Header="{x:Static resources:Strings.Menu_Appearance_Global_Theme_Title}" Description="Check out some of our built-in custom themes!">
            <StackPanel VerticalAlignment="Center" Orientation="Vertical" Margin="0,5,0,0">
              <ComboBox Width="200" Padding="10,5" Margin="0,0,0,10" ItemsSource="{Binding BindableThemes}" SelectedItem="{Binding Theme, Mode=TwoWay}" SelectionChanged="ThemeComboBox_SelectionChanged">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumNameConverter}}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ComboBox>
              <ui:Button Content="Editor" HorizontalAlignment="Right" Click="OpenCustomThemeEditor_Click" />
            </StackPanel>
          </controls:OptionControl>
          <controls:OptionControl Header="Window Backdrop" Description="Choose the material behind Voidstrap windows.">
            <ComboBox Width="200" Padding="10,5" ItemsSource="{Binding BackdropOptions}" SelectedItem="{Binding SelectedBackdrop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource EnumNameConverter}}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ComboBox>
          </controls:OptionControl>
          <controls:OptionControl Header="Application Font" Description="Change the font used across all of Voidstrap.">
            <StackPanel>
              <ui:Button Content="Choose Font..." Icon="DocumentAdd16" Command="{Binding ManageAppFontCommand}" Visibility="{Binding ChooseAppFontVisibility, Mode=OneWay}" />
              <ui:Button Appearance="Danger" Icon="Delete16" Command="{Binding ManageAppFontCommand}" Content="{Binding AppFontName, Mode=OneWay}" FontFamily="{Binding AppFontFamily, Mode=OneWay}" Visibility="{Binding RemoveAppFontVisibility, Mode=OneWay}" />
            </StackPanel>
          </controls:OptionControl>
          <controls:OptionControl Header="Page zoom" Description="Zooms the settings pages like a browser. Ctrl+Scroll for hotkey">
            <ComboBox Width="110" Padding="10,5" ItemsSource="{Binding ZoomOptions}" SelectedItem="{Binding UiZoomPercent, Mode=TwoWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding StringFormat={}{0}%}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ComboBox>
          </controls:OptionControl>
        </StackPanel>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Globe24" Margin="0,0,6,0" />
            <TextBlock Text="Language" />
          </StackPanel>
        </TabItem.Header>
        <StackPanel Margin="10">
          <TextBlock Margin="0,0,0,4" FontSize="20" FontWeight="Medium" Text="Language" />
          <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_Language_Title}" Description="{x:Static resources:Strings.Menu_Appearance_Language_Description}">
            <ComboBox Width="200" Padding="10,5,10,5" ItemsSource="{Binding LanguageOptions, Mode=OneTime}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_Language_AutoTranslateLanguage}" Description="{x:Static resources:Strings.Menu_Appearance_Language_AutoTranslateLanguage_Description}" Visibility="{Binding AutoTranslateVisibility, Mode=OneWay}">
            <ComboBox Width="200" Padding="10,5,10,5" ItemsSource="{Binding AutoTranslateLanguages, Mode=OneTime}" SelectedItem="{Binding SelectedAutoTranslateLanguage, Mode=TwoWay}" />
          </controls:OptionControl>
        </StackPanel>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Layer24" Margin="0,0,6,0" />
            <TextBlock Text="Bootstrapper" />
          </StackPanel>
        </TabItem.Header>
        <StackPanel Margin="10">
          <Grid Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Text="Bootstrapper" FontSize="20" FontWeight="Medium" />
                        </StackPanel>
            <ui:Button Grid.Column="1" Icon="Play24" Content="Preview" VerticalAlignment="Center" Command="{Binding PreviewBootstrapperCommand}" />
          </Grid>

          <controls:OptionControl Header="Launcher style" Description="Choose a built in launcher or use one of your own themes.">
            <ComboBox MinWidth="210" Padding="10,5" ItemsSource="{Binding Dialogs, Mode=OneTime}" SelectedItem="{Binding Dialog, Mode=TwoWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ComboBox>
          </controls:OptionControl>

          <controls:OptionControl Header="Launcher size" Description="Change the overall size and spacing of the launcher.">
            <ComboBox MinWidth="150" Padding="10,5" ItemsSource="{Binding BootstrapperScales, Mode=OneTime}" SelectedItem="{Binding BootstrapperScale, Mode=TwoWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ComboBox>
          </controls:OptionControl>

          <Grid Margin="0,8,0,0">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CustomThemesExpanded}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <ui:CardExpander Style="{StaticResource NoUserExpansionCardExpanderStyle}" IsExpanded="{Binding CustomThemesExpanded, Mode=OneWay}">
              <HeaderedContentControl.Header>
                <StackPanel>
                  <TextBlock FontSize="14" Text="Theme creator" />
                  <TextBlock Margin="0,2,0,0" FontSize="12" Text="Create and manage the theme used by your custom launcher." Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
              </HeaderedContentControl.Header>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="250" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox Name="CustomThemesListBox" Height="250" Grid.Row="0" Grid.Column="0" Margin="0,0,5,0" ItemsSource="{Binding CustomThemes, Mode=OneWay}" SelectedIndex="{Binding SelectedCustomThemeIndex, Mode=TwoWay}" SelectionChanged="CustomThemeSelection" />

                <Grid Grid.Row="1" Grid.Column="0" Margin="0,8,5,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ui:Button Grid.Column="0" Margin="0,0,4,0" Icon="Add24" Content="New theme" Appearance="Primary" HorizontalAlignment="Stretch" Command="{Binding AddCustomThemeCommand, Mode=OneTime}" />
                  <ui:Button Grid.Column="1" Margin="4,0,0,0" Icon="Delete24" Content="Delete" Appearance="Danger" HorizontalAlignment="Stretch" IsEnabled="{Binding IsCustomThemeSelected, Mode=OneWay}" Command="{Binding DeleteCustomThemeCommand, Mode=OneTime}" />
                </Grid>

                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="5,0,0,0">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCustomThemeSelected}" Value="False">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>

                  <TextBlock Text="Theme name" FontWeight="SemiBold" />
                  <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" Text="{Binding SelectedCustomThemeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Grid.Column="1" Margin="8,0,0,0" Icon="Save24" Content="Save name" Command="{Binding RenameCustomThemeCommand, Mode=OneTime}" />
                  </Grid>

                  <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0" Margin="0,0,4,0" Icon="DesktopEdit24" Content="Open editor" Appearance="Primary" HorizontalAlignment="Stretch" Command="{Binding EditCustomThemeCommand, Mode=OneTime}" />
                    <ui:Button Grid.Column="1" Margin="4,0,0,0" Icon="Play24" Content="Preview" HorizontalAlignment="Stretch" Command="{Binding PreviewBootstrapperCommand}" />
                  </Grid>

                  <ui:Button Margin="0,8,0,0" Icon="CloudArrowUp24" Content="Publish theme" HorizontalAlignment="Stretch" Command="{Binding PublishCustomThemeCommand, Mode=OneTime}" />

                  <Expander Margin="0,10,0,0" Header="More actions" IsExpanded="False">
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <ui:Button Grid.Column="0" Margin="0,0,4,0" Icon="ImageMultiple24" Content="View files" HorizontalAlignment="Stretch" Command="{Binding ViewCustomThemeFilesCommand, Mode=OneTime}" />
                      <ui:Button Grid.Column="1" Margin="4,0,0,0" Icon="ArrowExportRtl24" Content="Export" HorizontalAlignment="Stretch" Command="{Binding ExportCustomThemeCommand, Mode=OneTime}" />
                    </Grid>
                  </Expander>
                </StackPanel>

                <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="5,0,0,0" Text="Select a theme from the list, or create a new one." TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCustomThemeSelected}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </ui:CardExpander>
          </Grid>

          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <HeaderedContentControl.Header>
              <StackPanel>
                <TextBlock FontSize="14" Text="Published themes" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="Manage themes you have already published to the Voidstrap website." Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Select a published theme to download it or upload your latest local changes." TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button Grid.Column="1" Margin="12,0,0,0" Icon="ArrowSync24" Content="Refresh list" IsEnabled="{Binding CanRefreshPublishedThemes, Mode=OneWay}" Command="{Binding RefreshPublishedThemesCommand, Mode=OneTime}" />
              </Grid>
              <ListBox Name="PublishedThemesListBox" MinHeight="96" MaxHeight="180" Margin="0,12,0,0" ItemsSource="{Binding PublishedThemes, Mode=OneWay}" SelectedItem="{Binding SelectedPublishedTheme, Mode=TwoWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="2,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Margin="12,0,2,0" Text="{Binding State}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ListBox>
              <Border Margin="0,12,0,0" Padding="12" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                  <TextBlock Text="{Binding SelectedPublishedState, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Margin="0,3,0,0" Text="{Binding SelectedPublishedFacts, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
              </Border>
              <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Row="0" Grid.Column="0" Margin="0,0,5,5" Icon="ArrowDownload24" Content="Download to this PC" HorizontalAlignment="Stretch" IsEnabled="{Binding CanFetchSelected, Mode=OneWay}" Command="{Binding FetchPublishedThemeCommand, Mode=OneTime}" />
                <ui:Button Grid.Row="0" Grid.Column="1" Margin="5,0,0,5" Icon="CloudArrowUp24" Content="Publish local updates" HorizontalAlignment="Stretch" IsEnabled="{Binding CanCommitSelected, Mode=OneWay}" Command="{Binding CommitPublishedThemeCommand, Mode=OneTime}" />
                <ui:Button Grid.Row="1" Grid.Column="0" Margin="0,5,5,0" Icon="DocumentBulletList24" Content="Review changes" HorizontalAlignment="Stretch" IsEnabled="{Binding CanCommitSelected, Mode=OneWay}" Command="{Binding ViewPublishedChangesCommand, Mode=OneTime}" />
                <ui:Button Grid.Row="1" Grid.Column="1" Margin="5,5,0,0" Icon="Open24" Content="Open website" HorizontalAlignment="Stretch" IsEnabled="{Binding IsPublishedThemeSelected, Mode=OneWay}" Command="{Binding OpenPublishedThemeCommand, Mode=OneTime}" />
              </Grid>
              <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding PublishedStatus, Mode=OneWay}" />
            </StackPanel>
          </ui:CardExpander>

          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <HeaderedContentControl.Header>
              <StackPanel>
                <TextBlock FontSize="14" Text="Optional launcher extras" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="Add a background, startup sound, or profile information. These extras do not apply to custom launchers or themes created in Theme Creator." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel IsEnabled="{Binding LauncherExtrasEnabled, Mode=OneWay}">
              <controls:OptionControl Header="Background" Description="Choose an image for the launcher background.">
                <StackPanel Orientation="Horizontal">
                  <ui:Button Content="Choose image" Icon="ImageAdd24" Margin="0,0,8,0" Command="{Binding ImportBackgroundCommand}" />
                  <ui:Button Content="Remove" Icon="Delete24" Appearance="Danger" Command="{Binding RemoveBackgroundCommand}" />
                </StackPanel>
              </controls:OptionControl>
              <controls:OptionControl Header="Startup sound" Description="Choose audio to play when the launcher opens.">
                <StackPanel Orientation="Horizontal">
                  <ui:Button Content="Choose audio" Icon="MusicNote124" Margin="0,0,8,0" Command="{Binding ImportStartupAudioCommand}" />
                  <ui:Button Content="Remove" Icon="Delete24" Appearance="Danger" Command="{Binding RemoveStartupAudioCommand}" />
                </StackPanel>
              </controls:OptionControl>
              <controls:OptionControl Header="Show profile" Description="Show your Voidstrap username and profile in the launcher.">
                <ui:ToggleSwitch IsChecked="{Binding ShowLaunchProfile, Mode=TwoWay}" />
              </controls:OptionControl>
            </StackPanel>
          </ui:CardExpander>
        </StackPanel>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Grid24" Margin="0,0,6,0" />
            <TextBlock Text="Icons" />
          </StackPanel>
        </TabItem.Header>
        <StackPanel Margin="10">
          <TextBlock Margin="0,0,0,4" FontSize="20" FontWeight="Medium" Text="Icons" />
          <controls:OptionControl x:Name="IconSelector" Header="{x:Static resources:Strings.Menu_Appearance_Icon_Title}" Description="{x:Static resources:Strings.Menu_Appearance_Icon_Description}">
            <ComboBox Padding="10,5,10,5" SelectedValuePath="IconType" ItemsSource="{Binding Icons, Mode=OneWay}" SelectedValue="{Binding Icon, Mode=TwoWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Height="16" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding ImageSource, Mode=OneWay, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
                    <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Path=IconType, Converter={StaticResource EnumNameConverter}}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ComboBox>
          </controls:OptionControl>
          <controls:OptionControl x:Name="StudioIconSelector" Header="Studio icon" Description="The icon shown on the bootstrapper when launching Roblox Studio." Visibility="{Binding StudioIconVisibility, Mode=OneWay}">
            <ComboBox Padding="10,5,10,5" SelectedValuePath="IconType" ItemsSource="{Binding Icons, Mode=OneWay}" SelectedValue="{Binding StudioIcon, Mode=TwoWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Height="16" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding ImageSource, Mode=OneWay, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
                    <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Path=IconType, Converter={StaticResource EnumNameConverter}}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ComboBox>
          </controls:OptionControl>
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <HeaderedContentControl.Header>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock FontSize="14" Text="Customization" />
                  <TextBlock FontSize="12" Text="{x:Static resources:Strings.Menu_Appearance_Customisation_Description}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
              </Grid>
            </HeaderedContentControl.Header>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static resources:Strings.Menu_Appearance_CustomisationTitle_Title}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <ui:TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Title, Mode=TwoWay}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_Appearance_CustomisationTitle_Description}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,12,0,0" Text="{x:Static resources:Strings.Menu_Appearance_CustomisationIcon_Title}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <Grid Row="2" Column="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" Margin="0,0,4,0" Text="{Binding CustomIconLocation, Mode=TwoWay}" />
                <ui:Button Grid.Column="1" Margin="4,0,0,0" Height="35" Icon="Folder24" Content="{x:Static resources:Strings.Common_Browse}" Command="{Binding BrowseCustomIconLocationCommand}" />
              </Grid>
              <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_Appearance_CustomisationIcon_Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Grid>
          </ui:CardExpander>
        </StackPanel>
      </TabItem>

    </TabControl>
  </StackPanel>
</ui:UiPage>
