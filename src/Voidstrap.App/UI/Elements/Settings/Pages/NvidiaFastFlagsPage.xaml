<ui:UiPage x:Class="Voidstrap.UI.Elements.Settings.Pages.NvidiaFastFlagsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls" xmlns:settings="clr-namespace:Voidstrap.UI.ViewModels.Settings" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:models="clr-namespace:Voidstrap.UI.ViewModels" Title="NVIDIA FastFlags" Scrollable="True" xmlns:pages="clr-namespace:Voidstrap.UI.Elements.Settings.Pages" xmlns:platform="clr-namespace:Voidstrap.UI">
  <StackPanel Margin="0,0,14,14">
        <StackPanel>
      <ui:CardAction Margin="0,8,0,0" Icon="Edit24" Click="OpenRawEditor_Click" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
        <StackPanel>
          <TextBlock FontSize="14" Text="{resources:Loc Ui_Pages_AdvancedEditor}" />
          <TextBlock Margin="0,2,0,0" Padding="0,0,16,0" FontSize="12" Text="{resources:Loc Ui_Pages_OpenTheRawNVIDIAProfileInspector}" />
        </StackPanel>
      </ui:CardAction>
      <controls:OptionControl Header="{resources:Loc Ui_Pages_ApplyChanges}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Description="{Binding ApplyDescription}">
        <ui:Button Content="{resources:Loc Mtu_Apply}" Icon="CheckmarkCircle24" Click="Apply_Click" />
      </controls:OptionControl>
    </StackPanel>
    <TextBlock Margin="0,16,0,0" FontSize="17.65" FontWeight="Medium" Text="{resources:Loc Menu_FastFlags_Title}" />
    <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock FontSize="14" Text="{resources:Loc Ui_Pages_GameDetails}" />
          <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Pages_ImageQualityFramePacingAndPerformance}" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <StackPanel>
        <controls:OptionControl Header="{resources:Loc Ui_Pages_TextureQualityLODBias}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}" Description="{resources:Loc Ui_Pages_LowerValuesProduceSharperTexturesHigher}">
          <StackPanel Width="220">
            <Slider Minimum="-32" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TextureLodBias, Mode=TwoWay}" />
            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#FF808080" Text="{Binding TextureLodBiasLabel}" />
          </StackPanel>
        </controls:OptionControl>
        <controls:OptionControl Header="MFAA" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}" Description="{resources:Loc Ui_Pages_ImprovesAntiAliasingQualityByCombining}">
          <ui:ToggleSwitch IsChecked="{Binding EnableMFAA, Mode=TwoWay}" />
        </controls:OptionControl>
        <controls:OptionControl Header="FXAA" Description="{Binding FxaaDescription}">
          <ui:ToggleSwitch IsChecked="{Binding EnableFXAA, Mode=TwoWay}" />
        </controls:OptionControl>
        <controls:OptionControl Header="{resources:Loc Ui_Pages_GammaCorrection}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}" Description="{resources:Loc Ui_Pages_AdjustsHowBrightnessValuesAreMapped}">
          <ui:ToggleSwitch IsChecked="{Binding EnableGamma, Mode=TwoWay}" />
        </controls:OptionControl>
        <controls:OptionControl Header="{resources:Loc Ui_Pages_BenchmarkOverlay}" Description="{Binding BenchmarkOverlayDescription}">
          <ComboBox Width="220" ItemsSource="{Binding BenchMarkOverlayModes}" SelectedItem="{Binding BenchMarkOverlayMode}" />
        </controls:OptionControl>
        <controls:OptionControl Header="{resources:Loc Ui_Pages_FrameRateLimiter}" Description="{Binding FrameRateLimitDescription}">
          <TextBox Width="220" Text="{Binding FrameRateLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </controls:OptionControl>
        <controls:OptionControl Header="{resources:Loc Ui_Pages_BackgroundApplicationFrameRateLimit}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}" Description="{resources:Loc Ui_Pages_LimitsTheMaximumFrameRateWhen}">
          <TextBox Width="220" Text="{Binding BackgroundFrameRateLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </controls:OptionControl>
      </StackPanel>
    </ui:CardExpander>
    <ui:CardExpander Margin="0,8,0,0">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock FontSize="14" Text="{resources:Loc Ui_Pages_LowLatencyModes}" />
          <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Pages_ControlsHowManyFramesAreQueued}" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <StackPanel>
        <controls:OptionControl Header="{resources:Loc Ui_Pages_CPLLowLatencyMode}" Description="{Binding CplLowLatencyDescription}">
          <ComboBox Width="220" ItemsSource="{Binding CplLowLatencyModes}" SelectedItem="{Binding SelectedCplLowLatencyMode}" />
        </controls:OptionControl>
        <controls:OptionControl Header="{resources:Loc Ui_Pages_FRLLowLatencyMode}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}" Description="{resources:Loc Ui_Pages_DriverLevelLowLatencyControlUsing}">
          <ComboBox Width="220" ItemsSource="{Binding FrlLowLatencyModes}" SelectedItem="{Binding SelectedFrlLowLatencyMode}" />
        </controls:OptionControl>
      </StackPanel>
    </ui:CardExpander>
    <ui:CardExpander Margin="0,8,0,0" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock FontSize="14" Text="{resources:Loc Ui_Pages_HardwareAndDriverOverrides}" />
          <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Pages_OverridesThatAffectGPUBehaviorAnd}" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <StackPanel>
        <controls:OptionControl Header="{resources:Loc Ui_Pages_ResizableBAR}" Description="{resources:Loc Ui_Pages_AllowsTheCPUToAccessThe}">
          <ui:ToggleSwitch IsChecked="{Binding EnableRbar, Mode=TwoWay}" />
        </controls:OptionControl>
        <controls:OptionControl Header="{resources:Loc Ui_Pages_SILKSmoothness}" Description="{resources:Loc Ui_Pages_ControlsNVIDIASILKFrameSmoothingIntensity}">
          <ComboBox Width="220" ItemsSource="{Binding SilkSmoothnessModes}" SelectedItem="{Binding SelectedSilkSmoothness}" />
        </controls:OptionControl>
      </StackPanel>
    </ui:CardExpander>
  </StackPanel>
</ui:UiPage>
