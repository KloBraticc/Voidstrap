<UserControl x:Class="Voidstrap.UI.Elements.Settings.Pages.LibraryStorefront" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:util="clr-namespace:Voidstrap.Utility" xmlns:resources="clr-namespace:Voidstrap.Resources" Loaded="Control_Loaded" Unloaded="Control_Unloaded" Visibility="{Binding Storefront.StoreVisibility}">
  <UserControl.Resources>
    <Style x:Key="PlainButton" TargetType="{x:Type Button}">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Root" Background="{TemplateBinding Background}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.85" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <StackPanel Margin="0,0,0,24">
    <TextBlock Margin="0,0,0,8" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{resources:Loc Library_Store_Featured}" />
    <Grid Height="340" util:RoundedClip.Radius="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Style="{StaticResource PlainButton}" ClipToBounds="True" Command="{Binding SelectGameCommand}" CommandParameter="{Binding Storefront.FeaturedGame}">
        <Image util:DynamicRenderSystem.LazyImageSource="{Binding Storefront.FeaturedGame.ThumbnailUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="UniformToFill" />
      </Button>
      <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Storefront.FeaturedGame.Name}" ToolTip="{Binding Storefront.FeaturedGame.Name}" />
          <ItemsControl Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Storefront.FeaturedGame.PreviewShots}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" Rows="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Image Margin="0,0,6,6" util:RoundedClip.Radius="6" Stretch="UniformToFill" util:DynamicRenderSystem.LazyImageSource="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Grid.Row="2">
            <Border HorizontalAlignment="Left" Padding="6,2" Background="{DynamicResource ControlFillColorSecondaryBrush}">
              <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Storefront.FeaturedGame.GenreName}" />
            </Border>
            <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Storefront.FeaturedGame.PriceLine}" />
            <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Storefront.FeaturedGame.PlayingLine}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Grid Margin="0,8,0,0">
      <ItemsControl HorizontalAlignment="Center" ItemsSource="{Binding Storefront.Featured}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Width="8" Height="8" Margin="3,0" util:RoundedClip.Radius="4" Command="{Binding DataContext.Storefront.SelectFeaturedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
              <Button.Style>
                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PlainButton}">
                  <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource SystemAccentBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <ui:Button Appearance="Transparent" Icon="ChevronLeft24" Command="{Binding Storefront.PreviousFeaturedCommand}" />
        <ui:Button Margin="4,0,0,0" Appearance="Transparent" Icon="ChevronRight24" Command="{Binding Storefront.NextFeaturedCommand}" />
      </StackPanel>
    </Grid>

    <TextBlock Margin="0,18,0,8" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{resources:Loc Library_Store_BrowseGenre}" />
    <ItemsControl ItemsSource="{Binding Storefront.GenreTiles}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="4" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Style="{StaticResource PlainButton}" Height="96" Margin="0,0,6,6" util:RoundedClip.Radius="8" Command="{Binding DataContext.Storefront.SelectGenreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
            <Grid ClipToBounds="True">
              <Image Stretch="UniformToFill" util:DynamicRenderSystem.LazyImageSource="{Binding ThumbnailUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
              <Border Background="#99000000" />
              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding GenreName}" />
            </Grid>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Grid Margin="0,14,0,0">
      <ItemsControl ItemsSource="{Binding Storefront.Sorts}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Margin="0,0,2,0" Command="{Binding DataContext.Storefront.SelectSortCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
              <Button.Style>
                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PlainButton}">
                  <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <TextBlock Margin="12,7" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" />
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button HorizontalAlignment="Right" Style="{StaticResource PlainButton}" Visibility="{Binding Storefront.GenreFilterVisibility}" Command="{Binding Storefront.ClearGenreCommand}">
        <StackPanel Margin="8,6" Orientation="Horizontal">
          <TextBlock FontSize="12" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" Text="{Binding Storefront.SelectedGenre}" />
          <ui:SymbolIcon Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" Symbol="Dismiss24" />
        </StackPanel>
      </Button>
    </Grid>
    <Grid Background="{DynamicResource ControlFillColorDefaultBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ItemsControl ItemsSource="{Binding Storefront.TabGames}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource PlainButton}" Margin="0,0,0,4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" MouseEnter="TabRow_MouseEnter" ContextMenu="{DynamicResource GameContextMenu}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
              <Grid Height="69" util:RoundedClip.Radius="6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="123" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Stretch="UniformToFill" util:DynamicRenderSystem.LazyImageSource="{Binding ThumbnailUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                  <TextBlock FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                  <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding GenreName}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0" VerticalAlignment="Center">
                  <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding PriceLine}" />
                  <TextBlock Margin="0,3,0,0" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding PlayingLine}" />
                </StackPanel>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Grid.Column="1" Margin="12">
        <TextBlock FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" Text="{Binding Storefront.PreviewGame.Name}" />
        <TextBlock Margin="0,4,0,8" FontSize="12" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" Text="{Binding Storefront.PreviewGame.LikePercent}" />
        <ItemsControl ItemsSource="{Binding Storefront.PreviewGame.Screenshots}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Image Margin="0,0,0,6" Height="130" util:RoundedClip.Radius="6" Stretch="UniformToFill" util:DynamicRenderSystem.LazyImageSource="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
