<ui:UiPage x:Class="Voidstrap.UI.Elements.Settings.Pages.BehaviourPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:platform="clr-namespace:Voidstrap.UI" xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:local="clr-namespace:Voidstrap.UI.Elements.Settings.Pages" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:Voidstrap.UI.ViewModels.Settings" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="BehaviourPage" Scrollable="True">
  <StackPanel>
    <TextBlock Margin="0,0,0,8" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Behaviour_Description}" />
    <TabControl Margin="0,0,14,14">
      <TabItem>
        <HeaderedContentControl.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,6,0" />
            <TextBlock Text="General" />
          </StackPanel>
        </HeaderedContentControl.Header>
        <StackPanel Margin="10">
          <ui:InfoBar Padding="4" IsClosable="True" IsOpen="True" Message="Features here are highly customizable but intended for advanced users." Severity="Informational" />
          <controls:OptionControl x:Name="ConfirmLaunchOption" Header="{x:Static resources:Strings.Menu_Behaviour_ConfirmLaunches_Title}" Description="{x:Static resources:Strings.Menu_Behaviour_ConfirmLaunches_Description}">
            <ui:ToggleSwitch IsChecked="{Binding ConfirmLaunches, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Description="Disables Background Window when Launching Roblox" Header="Disable Background Window" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ui:ToggleSwitch IsChecked="{Binding BackgroundWindow, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="Disable RobloxCrashHandler" Description="Disables the RobloxCrashHandler that runs on startup, improving memory and RAM efficiency" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ui:ToggleSwitch IsChecked="{Binding disablecrashhandleryayyysocool, Mode=TwoWay}" />
          </controls:OptionControl>
        </StackPanel>
      </TabItem>
      <TabItem>
        <HeaderedContentControl.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Wrench24" Margin="0,0,6,0" />
            <TextBlock Text="Advanced General" />
          </StackPanel>
        </HeaderedContentControl.Header>
        <StackPanel Margin="10">
          <ui:InfoBar Padding="4" IsClosable="True" IsOpen="True" Message="Memory cleanup and optimizations. Some may not work well on every device." Severity="Informational" />
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <HeaderedContentControl.Header>
              <StackPanel>
                <TextBlock FontSize="14" Text="Cleaner" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="Voidstrap will remove old data to save on space" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel>
              <controls:OptionControl Header="When should the files get deleted" Description="Files older than the set amount will be deleted.">
                <ComboBox Padding="10,5,10,5" ItemsSource="{Binding CleanerOptions, Mode=OneTime}" Text="{Binding CleanerOption, Mode=TwoWay}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ComboBox>
              </controls:OptionControl>
              <controls:OptionControl Header="Cache" Description="When should the set amount be deleted.">
                <ui:ToggleSwitch IsChecked="{Binding CleanerCache, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl Header="Logs" Description="Old log files will be deleted.">
                <ui:ToggleSwitch IsChecked="{Binding CleanerLogs, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl Header="Voidstrap logs" Description="Voidstrap logs will be deleted.">
                <ui:ToggleSwitch IsChecked="{Binding CleanerVoidstrap, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl Header="Clean Roblox cache" Description="Deletes all files in Roblox's cache directories to free up disk space. Games will temporarily load slower after this!" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
                <ui:Button Icon="Delete48" Content="Clean" Appearance="Danger" Command="{Binding CleanRobloxCacheCommand}" />
              </controls:OptionControl>
            </StackPanel>
          </ui:CardExpander>
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <HeaderedContentControl.Header>
              <StackPanel>
                <TextBlock FontSize="14" Text="Resource controls" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="Safe scheduling and memory controls for Roblox" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel>
              <controls:OptionControl Header="Roblox CPU limit" Description="{Binding CpuSummary}" Visibility="{x:Static platform:PlatformFeatureVisibility.ResourceOptimization}">
                <ComboBox Grid.Column="1" Padding="10,5,10,5" ItemsSource="{Binding CpuOptions}" SelectedItem="{Binding SelectedCpuPriority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </controls:OptionControl>
              <controls:OptionControl Header="Trim memory when Roblox is unfocused" Description="After Roblox remains unfocused, unused working set is released. It does not trim memory while you are playing." Visibility="{x:Static platform:PlatformFeatureVisibility.ResourceOptimization}">
                <ui:ToggleSwitch IsChecked="{Binding MultiAccount, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl Header="Prioritize Roblox while focused" Description="Uses safe Above Normal scheduling while Roblox is in the foreground. A custom Roblox Priority choice takes precedence." Visibility="{x:Static platform:PlatformFeatureVisibility.ResourceOptimization}">
                <ui:ToggleSwitch IsChecked="{Binding OptimizeRoblox, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl Header="Bypass Windows emulation overhead" Description="Strips compatibility and CPU emulation layers from the Roblox build, drops any compatibility layer Voidstrap inherited, and stops Windows from power throttling Roblox. Your elevation and fullscreen optimisation choices are kept, and everything is restored when you turn this off." Visibility="{Binding BypassEmulationOverheadVisibility, Mode=OneWay}">
                <ui:ToggleSwitch IsChecked="{Binding BypassEmulationOverhead, Mode=TwoWay}" />
              </controls:OptionControl>
            </StackPanel>
          </ui:CardExpander>
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <HeaderedContentControl.Header>
              <StackPanel>
                <TextBlock FontSize="14" Text="Background resource use" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="Keep Roblox and Voidstrap lighter when they are not active" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel>
              <controls:OptionControl Header="Reduce resources when Roblox is unfocused" Description="Lowers Roblox's Windows scheduling priority while another app is active, then restores it when you return." Visibility="{x:Static platform:PlatformFeatureVisibility.ResourceOptimization}">
                <ui:ToggleSwitch IsChecked="{Binding ReduceMemoryOutOfFocus, Mode=TwoWay}" />
              </controls:OptionControl>
            </StackPanel>
          </ui:CardExpander>
        </StackPanel>
      </TabItem>
      <TabItem>
        <HeaderedContentControl.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Globe24" Margin="0,0,6,0" />
            <TextBlock Text="Voidstrap Matchmaker" />
          </StackPanel>
        </HeaderedContentControl.Header>
        <StackPanel Margin="10">
          <ui:InfoBar Padding="8" IsClosable="False" IsOpen="True" Severity="Informational" Message="{Binding UserLocationText}" />
          <controls:OptionControl Header="Enable" Description="Pick my server for me">
            <ui:ToggleSwitch IsChecked="{Binding VoidstrapMatchmakerEnabled, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="What to join" Description="How Voidstrap chooses between the servers it finds">
            <ComboBox Width="280" Padding="10,5,10,5" DisplayMemberPath="Display" SelectedValuePath="Value" IsEnabled="{Binding VoidstrapMatchmakerEnabled}" ItemsSource="{Binding MatchmakerModes}" SelectedValue="{Binding MatchmakerMode, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="Which datacenter" Description="Voidstrap will always try this one first and only fall back when it has no room" Visibility="{Binding ShowPreferredDatacenterPicker, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ComboBox Width="280" Padding="10,5,10,5" DisplayMemberPath="Display" IsEnabled="{Binding VoidstrapMatchmakerEnabled}" ItemsSource="{Binding PreferredDatacenterOptions}" SelectedItem="{Binding SelectedPreferredDatacenter, Mode=TwoWay}" />
          </controls:OptionControl>
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <HeaderedContentControl.Header>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock FontSize="14" FontWeight="Medium" Text="Datacenters" />
                  <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Text="{Binding BlockedDatacenterSummary}" />
                </StackPanel>
                <ui:Button Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Content="Allow all" Icon="ArrowReset24" Click="ResetDatacenters_Click" />
              </Grid>
            </HeaderedContentControl.Header>
            <StackPanel>
              <TextBlock Margin="0,0,0,8" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Turn one off to never be placed there. If Roblox puts you in a blocked datacenter, Voidstrap moves you out." />
              <ui:TextBox Margin="0,0,0,8" Padding="10,5,10,5" Icon="Search24" PlaceholderText="Search by city, region, or country" Text="{Binding DatacenterSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" MaxHeight="420">
                <DataGrid Name="DatacentersGrid" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" GridLinesVisibility="None" IsReadOnly="True" RowHeaderWidth="0" Background="#00FFFFFF" BorderThickness="0" RowHeight="42" AlternatingRowBackground="{DynamicResource SubtleFillColorTertiaryBrush}" ItemsSource="{Binding FilteredDatacenters}">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Allow" Width="70" CanUserSort="False">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <ui:ToggleSwitch HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Location}" IsChecked="{Binding IsAllowed, Mode=TwoWay}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Datacenter" Width="*" MinWidth="180">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel VerticalAlignment="Center" ToolTip="{Binding ServerIps}">
                            <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Location}" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding DistanceDisplay}" />
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Latency" Width="100" MinWidth="80" Binding="{Binding PingDisplay}" />
                  </DataGrid.Columns>
                </DataGrid>
              </Border>
            </StackPanel>
          </ui:CardExpander>
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <HeaderedContentControl.Header>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock FontSize="14" FontWeight="Medium" Text="Skipped games" />
                  <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Text="{Binding ExcludedGamesSummary}" />
                </StackPanel>
                <ui:Button Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Content="Clear" Icon="ArrowReset24" Visibility="{Binding HasExcludedGames, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding ClearExcludedGamesCommand}" />
              </Grid>
            </HeaderedContentControl.Header>
            <StackPanel>
              <TextBlock Margin="0,0,0,8" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Add those here and Voidstrap joins normally and never moves you." />
              <ui:TextBox Margin="0,0,0,8" Padding="10,5,10,5" PlaceholderText="Search for a game by name, or paste a place id" Text="{Binding GameSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Margin="0,0,0,8" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding GameSearchStatus}" Visibility="{Binding HasGameSearchStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
              <Border Margin="0,0,0,8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" MaxHeight="260" Visibility="{Binding HasGameSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding GameSearchResults}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="8,6,8,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Width="40" Height="40" Margin="0,0,10,0" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <Image Source="{Binding IconUrl}" Width="40" Height="40" Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                              <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Players}" Visibility="{Binding HasPlayers, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              <TextBlock FontSize="11" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Detail}" Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                          </StackPanel>
                          <ui:Button Grid.Column="2" VerticalAlignment="Center" Icon="Add24" Content="Skip" ToolTip="Never let Voidstrap pick a server for this game" Command="{Binding DataContext.AddSearchResultCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
              <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" MaxHeight="320" Visibility="{Binding HasExcludedGames, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DataGrid AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" GridLinesVisibility="None" IsReadOnly="True" RowHeaderWidth="0" Background="#00FFFFFF" BorderThickness="0" RowHeight="48" AlternatingRowBackground="{DynamicResource SubtleFillColorTertiaryBrush}" ItemsSource="{Binding ExcludedGames}">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Game" Width="*" MinWidth="200">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="32" Height="32" Margin="0,0,10,0" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                              <Image Source="{Binding IconUrl}" Width="32" Height="32" Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Place id" Width="140" MinWidth="110" Binding="{Binding PlaceIdDisplay}" />
                    <DataGridTemplateColumn Header="" Width="60" CanUserSort="False">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <ui:Button HorizontalAlignment="Center" VerticalAlignment="Center" Icon="Delete24" Appearance="Secondary" ToolTip="Let Voidstrap pick servers for this game again" Command="{Binding DataContext.RemoveExcludedGameCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </Border>
            </StackPanel>
          </ui:CardExpander>
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <HeaderedContentControl.Header>
              <StackPanel>
                <TextBlock FontSize="14" FontWeight="Medium" Text="Advanced" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="The defaults are right for almost everyone" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel>
              <controls:OptionControl Header="How hard to search" Description="{Binding SearchDepthDescription}">
                <StackPanel Orientation="Horizontal" Margin="0,2">
                  <ui:ToggleSwitch VerticalAlignment="Center" Margin="0,0,8,0" IsChecked="{Binding VoidstrapMatchmakerAutoCandidates, Mode=TwoWay}" />
                  <TextBlock Text="Auto" VerticalAlignment="Center" Margin="0,0,16,0" />
                  <Slider Width="170" Minimum="8" Maximum="64" TickFrequency="4" IsSnapToTickEnabled="True" IsEnabled="{Binding VoidstrapMatchmakerManualCandidates}" Value="{Binding VoidstrapMatchmakerMaxCandidates, Mode=TwoWay}" />
                  <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding EffectiveMatchmakerCandidates}" />
                </StackPanel>
              </controls:OptionControl>
              <controls:OptionControl Header="Reconnect limit" Description="Voidstrap stops trying after this many reconnects so it can never loop.">
                <StackPanel Orientation="Horizontal" Margin="0,2">
                  <Slider Width="200" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ServerMatchmakerMaxRetries, Mode=TwoWay}" />
                  <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding ServerMatchmakerMaxRetries}" />
                </StackPanel>
              </controls:OptionControl>
              <controls:OptionControl Header="Join API" Description="Which Roblox join endpoint Voidstrap asks for server locations. Change only if joins stop working.">
                <ComboBox Width="240" Padding="10,5,10,5" DisplayMemberPath="Display" SelectedValuePath="Value" ItemsSource="{Binding GamejoinApiOptions}" SelectedValue="{Binding GamejoinApiVersion, Mode=TwoWay}" />
              </controls:OptionControl>
              <ui:InfoBar Padding="8" IsClosable="False" IsOpen="True" Margin="0,8,0,0" Severity="Success" Message="{Binding VoidstrapMatchmakerLearnedStats}" Visibility="{Binding HasLearnedData, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
          </ui:CardExpander>
        </StackPanel>
      </TabItem>
      <TabItem>
        <HeaderedContentControl.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,6,0" />
            <TextBlock Text="Roblox" />
          </StackPanel>
        </HeaderedContentControl.Header>
        <StackPanel Margin="10">
          <controls:OptionControl Header="Fullscreen mode" Description="How the Roblox game window fills your screen" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ComboBox Width="240" Padding="10,5,10,5" DisplayMemberPath="Display" SelectedValuePath="Value" ItemsSource="{Binding FullscreenModes}" SelectedValue="{Binding RobloxFullscreenMode, Mode=TwoWay}" />
          </controls:OptionControl>
          <ui:InfoBar Padding="8" Margin="0,4,0,0" IsClosable="False" IsOpen="True" Severity="Warning" Title="Overlays are hidden in exclusive fullscreen" Message="Your Windows mouse cursor and every overlay are hidden" Visibility="{Binding ShowExclusiveFullscreenWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <controls:OptionControl Header="Title" Description="Leave blank to keep the title Roblox sets" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ui:TextBox Width="220" PlaceholderText="Voidstrap" Text="{Binding RobloxTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </controls:OptionControl>
          <controls:OptionControl Header="Add the game name" Description="Shows the experience you are playing in the title bar" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ui:ToggleSwitch IsChecked="{Binding CycleTitleWithGameName, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="Use the game icon" Description="Shows the experience icon on the Roblox window and taskbar button" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ui:ToggleSwitch IsChecked="{Binding UseGameIconForRobloxWindow, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="Add the server info" Description="Shows the server region and player count in the title bar" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ui:ToggleSwitch IsChecked="{Binding ShowServerInfoInTitle, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="Window backdrop" Description="Backdrop material to Roblox's window frame. Requires Windows 11" IsEnabled="{Binding IsWindows11}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ComboBox Width="240" Padding="10,5,10,5" ItemsSource="{Binding BackdropOptions}" SelectedValue="{Binding RobloxBackdropType, Mode=TwoWay}" DisplayMemberPath="Display" SelectedValuePath="Value" IsEnabled="{Binding IsWindows11}" />
          </controls:OptionControl>

        </StackPanel>
      </TabItem>
    </TabControl>
  </StackPanel>
</ui:UiPage>
