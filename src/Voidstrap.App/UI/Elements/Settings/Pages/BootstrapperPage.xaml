<ui:UiPage x:Class="Voidstrap.UI.Elements.Settings.Pages.BehaviourPage" xmlns:uianim="clr-namespace:Wpf.Ui.Animations;assembly=Wpf.Ui" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:platform="clr-namespace:Voidstrap.UI" xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:local="clr-namespace:Voidstrap.UI.Elements.Settings.Pages" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:Voidstrap.UI.ViewModels.Settings" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:util="clr-namespace:Voidstrap.Utility" Title="BehaviourPage" Scrollable="True">
  <StackPanel>
    <TextBlock uianim:Transitions.HoldStill="True" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Menu_Behaviour_Description}" />
    <TabControl Margin="0,16,14,14">
      <TabItem>
        <HeaderedContentControl.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,6,0" />
            <TextBlock Text="{resources:Loc Menu_Shortcuts_General_Title}" />
          </StackPanel>
        </HeaderedContentControl.Header>
        <StackPanel Margin="10">
          <controls:OptionControl Margin="0,-8,0,0" x:Name="ConfirmLaunchOption" Header="{resources:Loc Menu_Behaviour_ConfirmLaunches_Title}" Description="{resources:Loc Menu_Behaviour_ConfirmLaunches_Description}">
            <ui:ToggleSwitch IsChecked="{Binding ConfirmLaunches, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Description="{resources:Loc Ui_Bootstrapper_DisablesBackgroundWindowWhenLaunchingRoblox}" Header="{resources:Loc Ui_Bootstrapper_DisableBackgroundWindow}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ui:ToggleSwitch IsChecked="{Binding BackgroundWindow, Mode=TwoWay}" />
          </controls:OptionControl>
		  <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_DisableRobloxCrashHandler}" Description="{resources:Loc Ui_Bootstrapper_ClosesRobloxCrashHandlerAfterRobloxHasSafely}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ui:ToggleSwitch IsChecked="{Binding disablecrashhandleryayyysocool, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_TASXOptimization}" Description="{resources:Loc Ui_Bootstrapper_FullSpeedWhileRobloxIsFocused}" Visibility="{x:Static platform:PlatformFeatureVisibility.TasxOptimization}">
            <ui:ToggleSwitch IsChecked="{Binding TasxOptimization, Mode=TwoWay}" />
          </controls:OptionControl>
        </StackPanel>
      </TabItem>
      <TabItem>
        <HeaderedContentControl.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Wrench24" Margin="0,0,6,0" />
            <TextBlock Text="{resources:Loc Ui_Bootstrapper_AdvancedGeneral}" />
          </StackPanel>
        </HeaderedContentControl.Header>
        <StackPanel Margin="10">
          <ui:CardExpander IsExpanded="False">
            <HeaderedContentControl.Header>
              <StackPanel>
                <TextBlock FontSize="14" Text="{resources:Loc Ui_Bootstrapper_Cleaner}" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="{resources:Loc Ui_Bootstrapper_VoidstrapWillRemoveOldDataTo}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel>
              <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_WhenShouldTheFilesGetDeleted}" Description="{resources:Loc Ui_Bootstrapper_FilesOlderThanTheSetAmount}">
                <ComboBox Padding="10,5,10,5" ItemsSource="{Binding CleanerOptions, Mode=OneTime}" Text="{Binding CleanerOption, Mode=TwoWay}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ComboBox>
              </controls:OptionControl>
              <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_Cache}" Description="{resources:Loc Ui_Bootstrapper_WhenShouldTheSetAmountBe}">
                <ui:ToggleSwitch IsChecked="{Binding CleanerCache, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_Logs}" Description="{resources:Loc Ui_Bootstrapper_OldLogFilesWillBeDeleted}">
                <ui:ToggleSwitch IsChecked="{Binding CleanerLogs, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_VoidstrapLogs}" Description="{resources:Loc Ui_Bootstrapper_VoidstrapLogsWillBeDeleted}">
                <ui:ToggleSwitch IsChecked="{Binding CleanerVoidstrap, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_CleanRobloxCache}" Description="{resources:Loc Ui_Bootstrapper_DeletesAllFilesInRobloxS}" Visibility="{Binding CleanRobloxCacheVisibility, Mode=OneWay}">
                <ui:Button Icon="Delete48" Content="{resources:Loc Ui_Bootstrapper_Clean}" Appearance="Danger" Command="{Binding CleanRobloxCacheCommand}" />
              </controls:OptionControl>
            </StackPanel>
          </ui:CardExpander>
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False" Visibility="{x:Static platform:PlatformFeatureVisibility.ResourceOptimization}">
            <HeaderedContentControl.Header>
              <StackPanel>
                <TextBlock FontSize="14" Text="{resources:Loc Ui_Bootstrapper_ResourceControls}" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="{resources:Loc Ui_Bootstrapper_SafeSchedulingAndMemoryControlsFor}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel>
              <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_RobloxCPULimit}" Description="{Binding CpuSummary}" Visibility="{x:Static platform:PlatformFeatureVisibility.ResourceOptimization}">
                <ComboBox Grid.Column="1" Padding="10,5,10,5" ItemsSource="{Binding CpuOptions}" SelectedItem="{Binding SelectedCpuPriority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </controls:OptionControl>
              <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_TrimMemoryWhenRobloxIsUnfocused}" Description="{resources:Loc Ui_Bootstrapper_AfterRobloxRemainsUnfocusedUnusedWorking}" Visibility="{x:Static platform:PlatformFeatureVisibility.ResourceOptimization}">
                <ui:ToggleSwitch IsChecked="{Binding MultiAccount, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_PrioritizeRobloxWhileFocused}" Description="{Binding PrioritizeRobloxDescription, Mode=OneWay}" Visibility="{x:Static platform:PlatformFeatureVisibility.ResourceOptimization}">
                <ui:ToggleSwitch IsChecked="{Binding OptimizeRoblox, Mode=TwoWay}" />
              </controls:OptionControl>
            </StackPanel>
          </ui:CardExpander>
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False" Visibility="{x:Static platform:PlatformFeatureVisibility.ResourceOptimization}">
            <HeaderedContentControl.Header>
              <StackPanel>
                <TextBlock FontSize="14" Text="{resources:Loc Ui_Bootstrapper_BackgroundResourceUse}" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="{resources:Loc Ui_Bootstrapper_KeepRobloxAndVoidstrapLighterWhen}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel>
              <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_ReduceResourcesWhenRobloxIsUnfocused}" Description="{Binding ReduceResourcesDescription, Mode=OneWay}" Visibility="{x:Static platform:PlatformFeatureVisibility.ResourceOptimization}">
                <ui:ToggleSwitch IsChecked="{Binding ReduceMemoryOutOfFocus, Mode=TwoWay}" />
              </controls:OptionControl>
            </StackPanel>
          </ui:CardExpander>
          <ui:CardExpander x:Name="MtuOption" DataContext="{Binding Mtu}" Margin="0,8,0,0" IsExpanded="False" Visibility="{x:Static platform:PlatformFeatureVisibility.NetworkMtu}">
            <HeaderedContentControl.Header>
              <StackPanel>
                <TextBlock FontSize="14" Text="{resources:Loc Mtu_Title}" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="{resources:Loc Mtu_Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel IsEnabled="{Binding IsIdle, FallbackValue=False}">
              <ComboBox ItemsSource="{Binding Adapters}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedAdapter, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" ToolTip="{resources:Loc Mtu_Adapter}" />
              <TextBlock Margin="0,6,0,0" Text="{Binding CurrentSummary}" TextWrapping="Wrap" FontSize="12" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock VerticalAlignment="Center" Text="{resources:Loc Mtu_CustomValue}" />
                <TextBox Width="105" Margin="8,0,0,0" MaxLength="10" Text="{Binding CustomMtu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" />
              </StackPanel>
              <TextBlock Margin="0,4,0,0" FontSize="12" Text="{Binding ValidationMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <ui:Button Content="{resources:Loc Mtu_Apply}" Command="{Binding ApplyCommand}" Appearance="Primary" />
                <ui:Button Margin="6,0,0,0" Content="{resources:Loc Mtu_Restore}" Command="{Binding RestoreCommand}" />
                <ui:Button Margin="6,0,0,0" Content="{resources:Loc Mtu_Refresh}" Command="{Binding RefreshCommand}" />
              </StackPanel>
              <TextBlock Margin="0,6,0,0" Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </ui:CardExpander>
        </StackPanel>
      </TabItem>
      <TabItem Visibility="{x:Static platform:PlatformFeatureVisibility.NotMacOS}">
        <HeaderedContentControl.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,6,0" />
            <TextBlock Text="Roblox" />
          </StackPanel>
        </HeaderedContentControl.Header>
        <StackPanel Margin="10">
          <controls:OptionControl Margin="0,-8,0,0" Header="{resources:Loc Ui_Bootstrapper_FullscreenMode}" Description="{resources:Loc Ui_Bootstrapper_HowTheRobloxGameWindowFills}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ComboBox Width="240" Padding="10,5,10,5" DisplayMemberPath="Display" SelectedValuePath="Value" ItemsSource="{Binding FullscreenModes}" SelectedValue="{Binding RobloxFullscreenMode, Mode=TwoWay}" />
          </controls:OptionControl>
          <ui:InfoBar Padding="8" Margin="0,4,0,4" IsClosable="False" IsOpen="True" Severity="Informational" Title="{resources:Loc Ui_Bootstrapper_NeedsXWaylandOnLinux}" Message="{resources:Loc Ui_Bootstrapper_TheTitleGameNameGameIcon}" Visibility="{Binding LinuxTitleNeedsXWayland, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <controls:OptionControl Visibility="{x:Static platform:PlatformFeatureVisibility.NotMacOS}" Header="{resources:Loc Menu_Appearance_CustomisationTitle_Title}" Description="{resources:Loc Ui_Bootstrapper_LeaveBlankToKeepTheTitle}">
            <ui:TextBox Width="220" PlaceholderText="{resources:Loc Enums_Theme_Voidstrap}" Text="{Binding RobloxTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </controls:OptionControl>
          <controls:OptionControl Visibility="{x:Static platform:PlatformFeatureVisibility.NotMacOS}" Header="{resources:Loc Ui_Bootstrapper_AddTheGameName}" Description="{resources:Loc Ui_Bootstrapper_ShowsTheExperienceYouArePlaying}">
            <ui:ToggleSwitch IsChecked="{Binding CycleTitleWithGameName, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_DefaultWindowIcon}" Description="{resources:Loc Ui_Bootstrapper_DefaultWindowIconDescription}">
            <StackPanel Orientation="Horizontal">
              <ComboBox Width="200" Padding="10,5,10,5" SelectedValuePath="IconType" ItemsSource="{Binding RobloxIcons, Mode=OneWay}" SelectedValue="{Binding RobloxIcon, Mode=TwoWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Image Height="16" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding ImageSource, Mode=OneWay, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
                      <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Path=IconType, Converter={StaticResource EnumNameConverter}}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ComboBox>
              <ui:Button Margin="8,0,0,0" Icon="FolderOpen24" Content="{resources:Loc Ui_Bootstrapper_ChooseCustomIcon}" Visibility="{Binding IsRobloxIconCustom, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding BrowseRobloxCustomIconCommand}" />
            </StackPanel>
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_UseTheGameIcon}" Description="{resources:Loc Ui_Bootstrapper_ShowsTheExperienceIconOnThe}">
            <ui:ToggleSwitch IsChecked="{Binding UseGameIconForRobloxWindow, Mode=TwoWay}" />
          </controls:OptionControl>
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <HeaderedContentControl.Header>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock FontSize="14" FontWeight="Medium" Text="{resources:Loc Ui_Bootstrapper_CustomGameIcons}" />
                  <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Text="{Binding WindowIconOverridesSummary}" />
                </StackPanel>
                <ui:Button Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Content="{resources:Loc FlagSearch_Label25}" Icon="ArrowReset24" Visibility="{Binding HasWindowIconOverrides, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding ClearWindowIconOverridesCommand}" />
              </Grid>
            </HeaderedContentControl.Header>
            <StackPanel>
              <TextBlock Margin="0,0,0,8" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Bootstrapper_CustomGameIconsDescription}" />
              <ui:TextBox Margin="0,0,0,8" Padding="10,5,10,5" PlaceholderText="{resources:Loc Ui_Bootstrapper_SearchGameOrPlaceId}" Text="{Binding WindowIconSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Margin="0,0,0,8" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding WindowIconSearchStatus}" Visibility="{Binding HasWindowIconSearchStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
              <Border Margin="0,0,0,8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" MaxHeight="280" Visibility="{Binding HasWindowIconSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DataGrid AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" GridLinesVisibility="None" IsReadOnly="True" RowHeaderWidth="0" Background="#00FFFFFF" BorderThickness="0" RowHeight="52" AlternatingRowBackground="{DynamicResource SubtleFillColorTertiaryBrush}" ItemsSource="{Binding WindowIconSearchResults}">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{resources:Loc Shortcuts_GameTab}" Width="*" MinWidth="220">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="36" Height="36" Margin="0,0,10,0" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                              <Image Source="{Binding IconUrl}" util:DynamicRenderSystem.LinuxImageSource="{Binding IconUrl}" Width="36" Height="36" Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock FontWeight="Medium" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                              <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Players}" Visibility="{Binding HasPlayers, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Detail}" Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              </StackPanel>
                            </StackPanel>
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{resources:Loc Ui_Bootstrapper_PlaceId}" Width="130" MinWidth="105" Binding="{Binding PlaceIdDisplay}" />
                    <DataGridTemplateColumn Header="" Width="220" CanUserSort="False">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ui:Button Margin="0,0,6,0" Icon="Branch24" Content="{resources:Loc Ui_Bootstrapper_Subplaces}" ToolTip="{resources:Loc Ui_Bootstrapper_LoadSubplacesTooltip}" Visibility="{Binding CanLoadSubplaces, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding DataContext.LoadWindowIconSubplacesCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                            <ui:Button Icon="ImageAdd24" Appearance="Primary" Content="{resources:Loc Ui_Bootstrapper_SetIcon}" ToolTip="{resources:Loc Ui_Bootstrapper_SetIconTooltip}" Command="{Binding DataContext.AddWindowIconSearchResultCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </Border>
              <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" MaxHeight="340" Visibility="{Binding HasWindowIconOverrides, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DataGrid AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" GridLinesVisibility="None" IsReadOnly="True" RowHeaderWidth="0" Background="#00FFFFFF" BorderThickness="0" RowHeight="52" AlternatingRowBackground="{DynamicResource SubtleFillColorTertiaryBrush}" ItemsSource="{Binding WindowIconOverrides}">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{resources:Loc Ui_Bootstrapper_CustomIconColumn}" Width="90" CanUserSort="False">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Border Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <Image Source="{Binding CustomIconPreview}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasCustomIconPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                          </Border>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{resources:Loc Shortcuts_GameTab}" Width="*" MinWidth="180">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="32" Height="32" Margin="0,0,10,0" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                              <Image Source="{Binding IconUrl}" util:DynamicRenderSystem.LinuxImageSource="{Binding IconUrl}" Width="32" Height="32" Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock FontWeight="Medium" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                              <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" Text="{Binding IconFileName}" />
                            </StackPanel>
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{resources:Loc Ui_Bootstrapper_PlaceId}" Width="125" MinWidth="100" Binding="{Binding PlaceIdDisplay}" />
                    <DataGridTemplateColumn Header="{resources:Loc Ui_Bootstrapper_AllSubplacesColumn}" Width="115" CanUserSort="False">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding AllPlaces, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanApplyToSubplaces}" ToolTip="{resources:Loc Ui_Bootstrapper_AllSubplacesTooltip}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="150" CanUserSort="False">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:Button Margin="0,0,4,0" Icon="Branch24" Appearance="Secondary" ToolTip="{resources:Loc Ui_Bootstrapper_LoadSubplacesTooltip}" Visibility="{Binding CanApplyToSubplaces, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding DataContext.BrowseOverrideSubplacesCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                            <ui:Button Margin="0,0,4,0" Icon="FolderOpen24" Appearance="Secondary" ToolTip="{resources:Loc Ui_Bootstrapper_ChangeIconTooltip}" Command="{Binding DataContext.ChangeWindowIconOverrideCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                            <ui:Button Icon="Delete24" Appearance="Secondary" ToolTip="{resources:Loc Ui_Bootstrapper_RemoveIconTooltip}" Command="{Binding DataContext.RemoveWindowIconOverrideCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </Border>
            </StackPanel>
          </ui:CardExpander>
          <controls:OptionControl Visibility="{x:Static platform:PlatformFeatureVisibility.NotMacOS}" Header="{resources:Loc Ui_Bootstrapper_AddTheServerInfo}" Description="{resources:Loc Ui_Bootstrapper_ShowsTheServerRegionAndPlayer}">
            <ui:ToggleSwitch IsChecked="{Binding ShowServerInfoInTitle, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Installer_Appearance_Backdrop_Title}" Description="{resources:Loc Ui_Bootstrapper_BackdropMaterialToRobloxSWindow}" IsEnabled="{Binding IsWindows11}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ComboBox Width="240" Padding="10,5,10,5" ItemsSource="{Binding BackdropOptions}" SelectedValue="{Binding RobloxBackdropType, Mode=TwoWay}" DisplayMemberPath="Display" SelectedValuePath="Value" IsEnabled="{Binding IsWindows11}" />
          </controls:OptionControl>

        </StackPanel>
      </TabItem>
    </TabControl>
  </StackPanel>
</ui:UiPage>
