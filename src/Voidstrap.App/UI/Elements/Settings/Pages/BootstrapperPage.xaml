<ui:UiPage x:Class="Voidstrap.UI.Elements.Settings.Pages.BehaviourPage" xmlns:uianim="clr-namespace:Wpf.Ui.Animations;assembly=Wpf.Ui" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:platform="clr-namespace:Voidstrap.UI" xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:local="clr-namespace:Voidstrap.UI.Elements.Settings.Pages" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:Voidstrap.UI.ViewModels.Settings" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:pages="clr-namespace:Voidstrap.UI.Elements.Settings.Pages" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:util="clr-namespace:Voidstrap.Utility" Title="BehaviourPage" Scrollable="True">
  <StackPanel>
    <TextBlock uianim:Transitions.HoldStill="True" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Menu_Behaviour_Description}" />
    <TabControl Margin="0,16,14,14">
      <TabItem>
        <HeaderedContentControl.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,6,0" />
            <TextBlock Text="{resources:Loc Menu_Shortcuts_General_Title}" />
          </StackPanel>
        </HeaderedContentControl.Header>
        <StackPanel Margin="10">
          <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/launching/#background-behaviour" Margin="0,-8,0,0" x:Name="ConfirmLaunchOption" Header="{resources:Loc Menu_Behaviour_ConfirmLaunches_Title}" Description="{resources:Loc Menu_Behaviour_ConfirmLaunches_Description}">
            <ui:ToggleSwitch IsChecked="{Binding ConfirmLaunches, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Description="{resources:Loc Ui_Bootstrapper_DisablesBackgroundWindowWhenLaunchingRoblox}" Header="{resources:Loc Ui_Bootstrapper_DisableBackgroundWindow}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ui:ToggleSwitch IsChecked="{Binding BackgroundWindow, Mode=TwoWay}" />
          </controls:OptionControl>
		  <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_DisableRobloxCrashHandler}" Description="{resources:Loc Ui_Bootstrapper_ClosesRobloxCrashHandlerAfterRobloxHasSafely}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ui:ToggleSwitch IsChecked="{Binding disablecrashhandleryayyysocool, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_TASXOptimization}" Description="{resources:Loc Ui_Bootstrapper_FullSpeedWhileRobloxIsFocused}" Visibility="{x:Static platform:PlatformFeatureVisibility.TasxOptimization}">
            <ui:ToggleSwitch IsChecked="{Binding TasxOptimization, Mode=TwoWay}" />
          </controls:OptionControl>
          <ui:CardAction Margin="0,8,0,0" MinHeight="78" Icon="Wrench24" Click="OpenAdvancedGeneral_Click">
            <StackPanel>
              <TextBlock FontSize="14" Text="{resources:Loc Ui_Bootstrapper_AdvancedGeneral}" FontWeight="Medium" />
              <TextBlock Margin="0,2,0,0" FontSize="12" Text="{resources:Loc Ui_Bootstrapper_AdvancedGeneralCard}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </ui:CardAction>
        </StackPanel>
      </TabItem>
      <TabItem>
        <HeaderedContentControl.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Globe24" Margin="0,0,6,0" />
            <TextBlock Text="{resources:Loc Ui_Bootstrapper_VoidstrapMatchmaker}" />
          </StackPanel>
        </HeaderedContentControl.Header>
        <StackPanel Margin="10">
          <ui:InfoBar Padding="8" IsClosable="False" IsOpen="True" Severity="Informational" Message="{Binding UserLocationText}" />
          <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/matchmaker/" Header="{resources:Loc Ui_Bootstrapper_Enable}" Description="{resources:Loc Ui_Bootstrapper_PickMyServerForMe}">
            <ui:ToggleSwitch IsChecked="{Binding VoidstrapMatchmakerEnabled, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_WhatToJoin}" Description="{resources:Loc Ui_Bootstrapper_HowVoidstrapChoosesBetweenTheServers}">
            <ComboBox Width="280" Padding="10,5,10,5" DisplayMemberPath="Display" SelectedValuePath="Value" IsEnabled="{Binding VoidstrapMatchmakerEnabled}" ItemsSource="{Binding MatchmakerModes}" SelectedValue="{Binding MatchmakerMode, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_AskBeforeMovingServers}" Description="{resources:Loc Ui_Bootstrapper_WhenABetterServerIsFound}">
            <ui:ToggleSwitch IsEnabled="{Binding VoidstrapMatchmakerEnabled}" IsChecked="{Binding MatchmakerAskBeforeMoving, Mode=TwoWay}" />
          </controls:OptionControl>
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False" Visibility="{Binding ShowPreferredDatacenterPicker, Converter={StaticResource BooleanToVisibilityConverter}}">
            <HeaderedContentControl.Header>
              <StackPanel>
                <TextBlock FontSize="14" Text="{resources:Loc Ui_Bootstrapper_WhichDatacenter}" />
                <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Bootstrapper_ClickAPinToPickA}" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel>
            <controls:WorldServerMap Height="420" IsEnabled="{Binding VoidstrapMatchmakerEnabled}" Datacenters="{Binding Datacenters}" SelectedKey="{Binding PreferredDatacenterKey, Mode=TwoWay}" UserLatitude="{Binding UserLatitude}" UserLongitude="{Binding UserLongitude}" />
            <controls:OptionControl Margin="0,8,0,0" Header="{resources:Loc Ui_Bootstrapper_PreferredDatacenter}" Description="{resources:Loc Ui_Bootstrapper_VoidstrapWillAlwaysTryThisOne}">
              <ComboBox Width="280" Padding="10,5,10,5" DisplayMemberPath="Display" IsEnabled="{Binding VoidstrapMatchmakerEnabled}" ItemsSource="{Binding PreferredDatacenterOptions}" SelectedItem="{Binding SelectedPreferredDatacenter, Mode=TwoWay}" />
            </controls:OptionControl>
            </StackPanel>
          </ui:CardExpander>
          <ui:CardAction Margin="0,8,0,0" Icon="Options24" Click="OpenAdvancedMatchmaker_Click">
            <StackPanel>
              <TextBlock FontSize="14" FontWeight="Medium" Text="{resources:Loc Ui_Bootstrapper_AdvancedMatchmakerOptions}" />
              <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Text="{resources:Loc Ui_Bootstrapper_AdvancedMatchmakerOptionsDescription}" />
            </StackPanel>
          </ui:CardAction>
        </StackPanel>
      </TabItem>
      <TabItem Visibility="{x:Static platform:PlatformFeatureVisibility.NotMacOS}">
        <HeaderedContentControl.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,6,0" />
            <TextBlock Text="Roblox" />
          </StackPanel>
        </HeaderedContentControl.Header>
        <StackPanel Margin="10">
          <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/launching/#roblox-window-windows" Margin="0,-8,0,0" Header="{resources:Loc Ui_Bootstrapper_FullscreenMode}" Description="{resources:Loc Ui_Bootstrapper_HowTheRobloxGameWindowFills}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ComboBox Width="240" Padding="10,5,10,5" DisplayMemberPath="Display" ItemsSource="{Binding FullscreenModes}" SelectedIndex="{Binding RobloxFullscreenMode, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_HideFullscreenTitleBar}" Description="{resources:Loc Ui_Bootstrapper_HideFullscreenTitleBarDescription}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ui:ToggleSwitch IsChecked="{Binding HideFullscreenTitleBar, Mode=TwoWay}" />
          </controls:OptionControl>
          <ui:InfoBar Padding="8" Margin="0,4,0,4" IsClosable="False" IsOpen="True" Severity="Informational" Title="{resources:Loc Ui_Bootstrapper_NeedsXWaylandOnLinux}" Message="{resources:Loc Ui_Bootstrapper_TheTitleGameNameGameIcon}" Visibility="{Binding LinuxTitleNeedsXWayland, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <controls:OptionControl Visibility="{x:Static platform:PlatformFeatureVisibility.NotMacOS}" Header="{resources:Loc Menu_Appearance_CustomisationTitle_Title}" Description="{resources:Loc Ui_Bootstrapper_LeaveBlankToKeepTheTitle}">
            <ui:TextBox Width="220" PlaceholderText="{resources:Loc Enums_Theme_Voidstrap}" Text="{Binding RobloxTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </controls:OptionControl>
          <controls:OptionControl Visibility="{x:Static platform:PlatformFeatureVisibility.NotMacOS}" Header="{resources:Loc Ui_Bootstrapper_AddTheGameName}" Description="{resources:Loc Ui_Bootstrapper_ShowsTheExperienceYouArePlaying}">
            <ui:ToggleSwitch IsChecked="{Binding CycleTitleWithGameName, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_DefaultWindowIcon}" Description="{resources:Loc Ui_Bootstrapper_DefaultWindowIconDescription}">
            <StackPanel Orientation="Horizontal">
              <ComboBox Width="200" Padding="10,5,10,5" SelectedValuePath="IconType" ItemsSource="{Binding RobloxIcons, Mode=OneWay}" SelectedValue="{Binding RobloxIcon, Mode=TwoWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Image Height="16" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding ImageSource, Mode=OneWay, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
                      <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Path=IconType, Converter={StaticResource EnumNameConverter}}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ComboBox>
              <ui:Button Margin="8,0,0,0" Icon="FolderOpen24" Content="{resources:Loc Ui_Bootstrapper_ChooseCustomIcon}" Visibility="{Binding IsRobloxIconCustom, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding BrowseRobloxCustomIconCommand}" />
            </StackPanel>
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Ui_Bootstrapper_UseTheGameIcon}" Description="{resources:Loc Ui_Bootstrapper_ShowsTheExperienceIconOnThe}">
            <ui:ToggleSwitch IsChecked="{Binding UseGameIconForRobloxWindow, Mode=TwoWay}" />
          </controls:OptionControl>
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <HeaderedContentControl.Header>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock FontSize="14" FontWeight="Medium" Text="{resources:Loc Ui_Bootstrapper_CustomGameIcons}" />
                  <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Text="{Binding WindowIconOverridesSummary}" />
                </StackPanel>
                <ui:Button Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Content="{resources:Loc FlagSearch_Label25}" Icon="ArrowReset24" Visibility="{Binding HasWindowIconOverrides, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding ClearWindowIconOverridesCommand}" />
              </Grid>
            </HeaderedContentControl.Header>
            <StackPanel>
              <TextBlock Margin="0,0,0,8" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Bootstrapper_CustomGameIconsDescription}" />
              <ui:TextBox Margin="0,0,0,8" Padding="10,5,10,5" PlaceholderText="{resources:Loc Ui_Bootstrapper_SearchGameOrPlaceId}" Text="{Binding WindowIconSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Margin="0,0,0,8" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding WindowIconSearchStatus}" Visibility="{Binding HasWindowIconSearchStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
              <ScrollViewer Margin="0,0,0,10" MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasWindowIconSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding WindowIconSearchResults}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Width="40" Height="40" Margin="0,0,12,0" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" util:DynamicRenderSystem.LazyImageSource="{Binding IconUrl}" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontWeight="Medium" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                            <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis">
                              <Run Text="{resources:Loc Ui_Bootstrapper_PlaceId}" /><Run Text=" " /><Run Text="{Binding PlaceIdDisplay, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Detail, Mode=OneWay}" />
                            </TextBlock>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Margin="0,0,6,0" Icon="Branch24" Content="{resources:Loc Ui_Bootstrapper_Subplaces}" ToolTip="{resources:Loc Ui_Bootstrapper_LoadSubplacesTooltip}" Visibility="{Binding CanLoadSubplaces, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding DataContext.LoadWindowIconSubplacesCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                            <ui:Button Icon="ImageAdd24" Appearance="Primary" Content="{resources:Loc Ui_Bootstrapper_SetIcon}" ToolTip="{resources:Loc Ui_Bootstrapper_SetIconTooltip}" Command="{Binding DataContext.AddWindowIconSearchResultCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <ItemsControl ItemsSource="{Binding WindowIconOverrides}" Visibility="{Binding HasWindowIconOverrides, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                          <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" util:DynamicRenderSystem.LazyImageSource="{Binding IconUrl}" />
                        </Border>
                        <ui:SymbolIcon Grid.Column="1" Margin="8,0" Symbol="ArrowRight24" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Border Grid.Column="2" Width="40" Height="40" Margin="0,0,12,0" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}" ToolTip="{resources:Loc Ui_Bootstrapper_CustomIconColumn}">
                          <Image Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding CustomIconPreview, TargetNullValue={x:Null}}" />
                        </Border>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                          <TextBlock FontWeight="Medium" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                          <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis">
                            <Run Text="{resources:Loc Ui_Bootstrapper_PlaceId}" /><Run Text=" " /><Run Text="{Binding PlaceIdDisplay, Mode=OneWay}" />
                          </TextBlock>
                          <CheckBox Margin="0,4,0,0" Content="{resources:Loc Ui_Bootstrapper_AllSubplacesColumn}" ToolTip="{resources:Loc Ui_Bootstrapper_AllSubplacesTooltip}" IsChecked="{Binding AllPlaces, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding CanApplyToSubplaces, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                          <ui:Button Margin="0,0,6,0" Icon="Branch24" Content="{resources:Loc Ui_Bootstrapper_Subplaces}" ToolTip="{resources:Loc Ui_Bootstrapper_LoadSubplacesTooltip}" Visibility="{Binding CanApplyToSubplaces, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding DataContext.BrowseOverrideSubplacesCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                          <ui:Button Margin="0,0,6,0" Icon="Edit24" Content="{resources:Loc Common_Edit}" ToolTip="{resources:Loc Ui_Bootstrapper_ChangeIconTooltip}" Command="{Binding DataContext.ChangeWindowIconOverrideCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                          <ui:Button Icon="Delete24" Content="{resources:Loc Common_Delete}" ToolTip="{resources:Loc Ui_Bootstrapper_RemoveIconTooltip}" Command="{Binding DataContext.RemoveWindowIconOverrideCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ui:CardExpander>
          <controls:OptionControl Visibility="{x:Static platform:PlatformFeatureVisibility.NotMacOS}" Header="{resources:Loc Ui_Bootstrapper_AddTheServerInfo}" Description="{resources:Loc Ui_Bootstrapper_ShowsTheServerRegionAndPlayer}">
            <ui:ToggleSwitch IsChecked="{Binding ShowServerInfoInTitle, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Installer_Appearance_Backdrop_Title}" Description="{resources:Loc Ui_Bootstrapper_BackdropMaterialToRobloxSWindow}" IsEnabled="{Binding IsWindows11}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ComboBox Width="240" Padding="10,5,10,5" ItemsSource="{Binding BackdropOptions}" SelectedValue="{Binding RobloxBackdropType, Mode=TwoWay}" DisplayMemberPath="Display" SelectedValuePath="Value" IsEnabled="{Binding IsWindows11}" />
          </controls:OptionControl>

        
          <StackPanel x:Name="RobloxIntegrations" DataContext="{x:Null}">
          <TextBlock Margin="0,16,0,8" FontSize="20" FontWeight="SemiBold" Text="{resources:Loc Ui_Integrations_RobloxTheme}" />
          <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/integrations/#desktop-app-and-more" Header="{resources:Loc Ui_Integrations_TelemetryBlocker}" Description="{resources:Loc Ui_Integrations_BlockRobloxTelemetryAdministratorAccessIs}">
            <ui:ToggleSwitch IsChecked="{Binding BlockTelemetry, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Ui_Integrations_RobloxTheme}" Description="{resources:Loc Ui_Integrations_RobloxTheme_Description}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <ComboBox MinWidth="160" ItemsSource="{Binding RobloxThemeOptions}" SelectedIndex="{Binding RobloxThemeIndex, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Ui_Integrations_FPSUnlocker}" Description="{Binding UncapFpsDescription, Mode=OneWay}" IsEnabled="{Binding UncapFpsToggleEnabled, Mode=OneWay}">
            <ui:ToggleSwitch IsChecked="{Binding UncapFPS, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Ui_Integrations_MacVirtualDisplayRefreshRate}" Description="{resources:Loc Ui_Integrations_MacVirtualDisplayRefreshRate_Description}" IsEnabled="{Binding UncapFPS, Mode=OneWay}" Visibility="{x:Static platform:PlatformFeatureVisibility.MacOSIntegration}">
            <ComboBox MinWidth="120" ItemsSource="{Binding MacVirtualDisplayRefreshRates}" SelectedItem="{Binding MacVirtualDisplayRefreshRate, Mode=TwoWay}" ItemStringFormat="{}{0} Hz" />
          </controls:OptionControl>
          <TextBlock Margin="0,16,0,8" FontSize="20" FontWeight="SemiBold" Text="Snap Tap" />
          <controls:OptionControl Header="Snap Tap" Description="{resources:Loc Ui_Integrations_WhenTwoOppositeKeysAreHeld}" Visibility="{x:Static platform:PlatformFeatureVisibility.GlobalInput}">
            <ui:ToggleSwitch IsChecked="{Binding SnapTapEnabled, Mode=TwoWay}" />
          </controls:OptionControl>
          <controls:OptionControl Header="{resources:Loc Ui_Integrations_KeyboardAccess}" Description="{Binding SnapTapAccessDescription}" Visibility="{Binding SnapTapAccessVisibility}">
            <Button Content="{resources:Loc Ui_Integrations_GrantAccess}" Command="{Binding GrantSnapTapAccessCommand}" />
          </controls:OptionControl>
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False" Visibility="{x:Static platform:PlatformFeatureVisibility.GlobalInput}">
            <HeaderedContentControl.Header>
              <StackPanel>
                <TextBlock FontSize="14" Text="{resources:Loc Ui_Integrations_SnapTapSettings}" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="{resources:Loc Ui_Integrations_ChooseWhichKeysArePairedAnd}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel>
              <controls:OptionControl Header="{resources:Loc Ui_Integrations_Priority}" Description="{resources:Loc Ui_Integrations_WhatHappensWhileTwoKeysFrom}">
                <ComboBox MinWidth="240" ItemsSource="{Binding SnapTapModes}" SelectedIndex="{Binding SnapTapMode, Mode=TwoWay}" />
              </controls:OptionControl>
              <controls:OptionControl Header="{resources:Loc Ui_Integrations_KeyGroups}" Description="{resources:Loc Ui_Integrations_SeparateGroupsWithCommasAndKeys}">
                <ui:TextBox MinWidth="240" PlaceholderText="A D, W S" Text="{Binding SnapTapKeys, Mode=TwoWay}" />
              </controls:OptionControl>
              <TextBlock Margin="16,8,16,4" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{x:Static platform:PlatformFeatureVisibility.LinuxIntegration}" Text="{resources:Loc Ui_Integrations_OnLinuxSnapTapTakesOver}" />
              <TextBlock Margin="16,8,16,4" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{x:Static platform:PlatformFeatureVisibility.MacOSIntegration}" Text="{resources:Loc Ui_Integrations_OnMacOSAllowAccessibilityAccessFor}" />
            </StackPanel>
          </ui:CardExpander>
                    <ui:CardExpander Margin="0,8,0,0" IsExpanded="False" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
                        <HeaderedContentControl.Header>
                            <StackPanel>
                                <TextBlock FontSize="14" Text="{resources:Loc Ui_Integrations_StartupAndTray}" />
                                <TextBlock Margin="0,2,0,0" FontSize="12" Text="{resources:Loc Ui_Integrations_ChooseHowRobloxStartsAndStays}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </HeaderedContentControl.Header>
                        <StackPanel>
                            <controls:OptionControl HelpLink="https://wiki.voidstrapp.pages.dev/features/launching/#desktop-app-and-closing" Header="{resources:Loc Ui_Integrations_SystemTray}" Description="{resources:Loc Ui_Integrations_MinimizeRobloxToTheSystemTray}" Visibility="{x:Static platform:PlatformFeatureVisibility.Tray}">
                                <ui:ToggleSwitch IsChecked="{Binding RobloxSystemTray, Mode=TwoWay}" />
                            </controls:OptionControl>
                            <controls:OptionControl Header="{resources:Loc Ui_Integrations_LaunchOnStartup}" Description="{resources:Loc Ui_Integrations_LaunchRobloxWhenYouSignIn}">
                                <ui:ToggleSwitch IsChecked="{Binding LaunchStartup, Mode=TwoWay}" />
                            </controls:OptionControl>
                        </StackPanel>
                    </ui:CardExpander>
                    <TextBlock Margin="0,16,0,8" FontSize="20" FontWeight="SemiBold" Text="{resources:Loc Menu_Integrations_Title}" />
          <controls:OptionControl Header="{resources:Loc Ui_Integrations_SteamLibrary}" Description="{Binding SteamShortcutDescription}" Visibility="{Binding SteamShortcutVisibility}">
            <Button Content="{resources:Loc Ui_Integrations_AddToSteam}" Command="{Binding AddToSteamCommand}" />
          </controls:OptionControl>
                    <controls:OptionControl Header="{resources:Loc ContextMenu_GameHistory_Title}" Description="{resources:Loc Ui_Integrations_ViewGamesYouRecentlyPlayed}">
                        <Button Content="{resources:Loc Common_Open}" HorizontalAlignment="Left" VerticalAlignment="Top" Command="{Binding OpenHistoryWindowCommand}" />
                    </controls:OptionControl>
          <TextBlock Margin="0,16,0,0" Text="{resources:Loc Menu_Integrations_Custom_Title}" FontSize="20" FontWeight="Medium" />
          <TextBlock Text="{resources:Loc Menu_Integrations_Custom_Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <Grid Margin="0,8,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="250" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox Name="CustomIntegrationsListBox" Grid.Row="0" Grid.Column="0" Margin="0,0,4,0" DisplayMemberPath="Name" ItemsSource="{Binding CustomIntegrations, Mode=OneWay}" SelectedIndex="{Binding SelectedCustomIntegrationIndex, Mode=TwoWay}" SelectionChanged="CustomIntegrationSelection" />
            <Grid Row="1" Column="0" Margin="0,8,4,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:Button Grid.Column="0" Margin="0,0,4,0" Icon="Add28" Content="{resources:Loc Common_New}" HorizontalAlignment="Stretch" Command="{Binding AddIntegrationCommand, Mode=OneTime}" />
              <ui:Button Grid.Column="1" Margin="4,0,0,0" Icon="Delete28" Content="{resources:Loc Common_Delete}" HorizontalAlignment="Stretch" Appearance="Danger" IsEnabled="{Binding IsCustomIntegrationSelected, Mode=OneWay}" Command="{Binding DeleteIntegrationCommand, Mode=OneTime}" />
            </Grid>
            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="4,0,0,0">
              <FrameworkElement.Style>
                <Style>
                  <Style.Triggers>
                    <DataTrigger Value="False" Binding="{Binding IsCustomIntegrationSelected}">
                      <Setter Property="UIElement.Visibility" Value="Hidden" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
              <TextBlock Text="{resources:Loc Common_Name}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <ui:TextBox Margin="0,4,0,0" Text="{Binding SelectedCustomIntegration.Name, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Margin="0,8,0,0" Text="{resources:Loc Menu_Integrations_Custom_AppLocation}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" Margin="0,0,0,0" PlaceholderText="{Binding CustomIntegrationLocationPlaceholder, Mode=OneWay}" Text="{Binding SelectedCustomIntegration.Location}" />
                <ui:Button Grid.Column="1" Margin="8,0,0,0" Height="34" Icon="Folder24" Content="{resources:Loc Common_Browse}" Command="{Binding BrowseIntegrationLocationCommand}" />
              </Grid>
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="1*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0" Text="{resources:Loc Ui_Integrations_LaunchDelay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBox Grid.Column="1" Margin="0,0,16,0" PlaceholderText="200" TextWrapping="NoWrap" AcceptsReturn="True" AcceptsTab="True" Text="{Binding SelectedCustomIntegration.Delay}" />
                <TextBlock Grid.Column="2" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0" Text="{resources:Loc Menu_Integrations_Custom_LaunchArgs}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBox Grid.Column="3" TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True" PlaceholderText="{Binding Source=/k echo {0}, Converter={StaticResource StringFormatConverter}, ConverterParameter={resources:Loc Menu_Integrations_Custom_LaunchArgs_Placeholder}}" Text="{Binding SelectedCustomIntegration.LaunchArgs}" />
              </Grid>
              <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <CheckBox Margin="0,0,8,0" Content="{resources:Loc Menu_Integrations_Custom_AutoClose}" IsChecked="{Binding SelectedCustomIntegration.AutoClose}" />
                <CheckBox Margin="0,0,8,0" Content="{resources:Loc Ui_Integrations_PreRobloxLaunch}" IsChecked="{Binding SelectedCustomIntegration.PreLaunch}" />
              </StackPanel>
              <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <CheckBox Margin="0,0,8,0" Content="{resources:Loc Ui_Integrations_RunMinimized}" IsChecked="{Binding SelectedCustomIntegration.RunMinimized}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}" />
                <CheckBox Margin="0,0,8,0" Content="{resources:Loc Ui_Integrations_RunAsAdministrator}" IsChecked="{Binding SelectedCustomIntegration.RunAsAdmin}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}" />
              </StackPanel>
              <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <CheckBox Margin="0,0,8,0" Content="{resources:Loc Ui_Integrations_OnlyForASpecificGame}" IsChecked="{Binding SelectedCustomIntegration.SpecifyGame}" />
                <CheckBox Margin="0,0,8,0" Content="{resources:Loc Ui_Integrations_CloseWhenLeavingThatGame}" IsChecked="{Binding SelectedCustomIntegration.AutoCloseOnGame}" IsEnabled="{Binding SelectedCustomIntegration.SpecifyGame}" />
              </StackPanel>
              <Grid Margin="0,8,0,0" Visibility="{Binding SelectedCustomIntegration.SpecifyGame, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Text="{resources:Loc Ui_Integrations_PlaceID}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBox Grid.Column="1" PlaceholderText="e.g. 286090429" Text="{Binding SelectedCustomIntegration.GameID, UpdateSourceTrigger=PropertyChanged}" />
              </Grid>
            </StackPanel>
            <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Text="{resources:Loc Menu_Integrations_Custom_NoneSelected}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center">
              <FrameworkElement.Style>
                <Style>
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding IsCustomIntegrationSelected}">
                      <Setter Property="UIElement.Visibility" Value="Hidden" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </TextBlock>
          </Grid>
          </StackPanel>
        </StackPanel>
      </TabItem>
    </TabControl>
  </StackPanel>
</ui:UiPage>
