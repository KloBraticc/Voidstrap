<UserControl x:Class="Voidstrap.UI.Elements.Settings.Pages.StudioPluginsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:util="clr-namespace:Voidstrap.Utility" xmlns:local="clr-namespace:Voidstrap.UI.Elements.Settings.Pages" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Loaded="View_Loaded" Unloaded="View_Unloaded">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ExtensionStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate x:Key="PluginRow" DataType="{x:Type local:StudioPluginEntry}">
        <Border Style="{StaticResource RowCard}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource RowIcon}">
              <Grid>
                <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55">
                <ui:SymbolIcon.Style>
                  <Style TargetType="ui:SymbolIcon">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Source, ElementName=RowPluginIcon}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
                <Image x:Name="RowPluginIcon" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" util:DynamicRenderSystem.LazyImageSource="{Binding Icon}" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource RowTitle}" Text="{Binding Name}" />
              <TextBlock Style="{StaticResource RowSummary}" Text="{Binding Summary}" MaxHeight="40" />
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Style="{StaticResource RowMeta}" Text="{Binding CreatorLine}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Style="{StaticResource RowMeta}" Margin="12,0,0,0" Text="{Binding Category}" />
                <TextBlock Style="{StaticResource RowMeta}" Margin="12,0,0,0" Text="{Binding Rating}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                <ui:SymbolIcon Symbol="Tag24" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Style="{StaticResource RowMeta}" Margin="5,0,12,0" Text="{Binding PriceText}" />
                <TextBlock Style="{StaticResource RowMeta}" Text="{Binding StatusLabel}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{resources:Loc Ui_Mods_View}" Appearance="Secondary" MinWidth="76" Margin="0,0,8,0" Tag="{Binding}" Click="View_Click" />
                <ui:Button Content="{Binding PrimaryLabel}" IsEnabled="{Binding CanAct}" Appearance="Primary" MinWidth="84" Tag="{Binding}" Click="Primary_Click" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid>
    <StackPanel x:Name="BrowseRoot">
      <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Ui_Mods_StudioPlugins_Intro}" />

      <WrapPanel Margin="0,10,0,6">
        <ui:TextBox x:Name="SearchBox" Width="300" Height="34" Margin="0,0,10,8" VerticalContentAlignment="Center" PlaceholderText="{resources:Loc Ui_Mods_StudioPlugins_Search}" Icon="Search24" ClearButtonEnabled="True" TextChanged="SearchBox_TextChanged" />
        <StackPanel Orientation="Horizontal" Margin="0,0,10,8">
          <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{resources:Loc ContextMenu_ServerInformation_Type}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <ComboBox x:Name="SourcePicker" Width="220" Height="34" VerticalContentAlignment="Center" SelectionChanged="SourcePicker_SelectionChanged">
            <ComboBoxItem Content="{resources:Loc Ui_Mods_StudioPlugins_FilterStore}" />
            <ComboBoxItem Content="{resources:Loc Ui_Mods_StudioPlugins_FilterInstalled}" />
          </ComboBox>
        </StackPanel>
        <ui:Button Height="34" Margin="0,0,8,8" Appearance="Primary" Icon="ArrowImport24" Content="{resources:Loc Ui_Mods_StudioPlugins_Import}" Click="Import_Click" />
        <ui:Button Height="34" Margin="0,0,8,8" Icon="Folder24" Content="{resources:Loc Ui_Mods_StudioPlugins_Folder}" Click="OpenFolder_Click" />
        <ui:Button Height="34" Margin="0,0,0,8" Icon="CloudArrowUp24" Content="{resources:Loc Ui_Mods_StudioPlugins_Publish}" Click="Publish_Click" />
      </WrapPanel>

      <TextBlock x:Name="BrowseStatus" Margin="0,0,0,8" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />

      <ItemsControl x:Name="PluginList" ItemTemplate="{StaticResource PluginRow}" Focusable="False" />
      <ui:ProgressRing x:Name="LoadingRing" IsIndeterminate="True" Width="36" Height="36" Margin="0,12,0,0" HorizontalAlignment="Center" Visibility="Collapsed" />
      <ui:Button x:Name="LoadMoreButton" HorizontalAlignment="Center" Margin="0,4,0,0" Appearance="Secondary" Content="{resources:Loc Ui_Mods_StudioPlugins_LoadMore}" Click="LoadMore_Click" Visibility="Collapsed" />
      <Border x:Name="EmptyState" Visibility="Collapsed" Margin="0,8,0,0" Padding="28" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundBrush}">
        <StackPanel HorizontalAlignment="Center">
          <ui:SymbolIcon Symbol="Search24" FontSize="34" HorizontalAlignment="Center" Opacity="0.55" />
          <TextBlock x:Name="EmptyTitle" Margin="0,12,0,0" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
          <TextBlock Margin="0,4,0,0" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" Text="{resources:Loc Ui_Mods_StudioPlugins_EmptySubtitle}" />
        </StackPanel>
      </Border>
    </StackPanel>

    <Grid x:Name="DetailRoot" Visibility="Collapsed" SizeChanged="DetailRoot_SizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="DetailSidebarColumn" Width="300" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel x:Name="DetailMain" Grid.Column="0" Margin="0,0,20,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Width="96" Height="96" CornerRadius="14" ClipToBounds="True" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
              <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55">
                <ui:SymbolIcon.Style>
                  <Style TargetType="ui:SymbolIcon">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Source, ElementName=DetailIcon}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:SymbolIcon.Style>
              </ui:SymbolIcon>
              <Image x:Name="DetailIcon" Stretch="Uniform" Margin="10" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Margin="16,4,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="DetailName" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <ui:Button x:Name="DetailSourceButton" Appearance="Transparent" Icon="Open24" Padding="6" Margin="6,0,0,0" ToolTip="{resources:Loc Ui_Mods_StudioPlugins_OpenStore}" Click="OpenStore_Click" />
            </StackPanel>
            <TextBlock x:Name="DetailAuthor" Margin="0,4,0,0" FontSize="13" />
            <TextBlock x:Name="DetailSummary" Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Grid>

        <TabControl Margin="0,16,0,0">
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Info24" Margin="0,0,6,0" />
                <TextBlock Text="{resources:Loc Ui_Pages_Description}" />
              </StackPanel>
            </TabItem.Header>
            <StackPanel Margin="10">
              <TextBlock x:Name="DetailDescription" Style="{StaticResource Paragraph}" />
            </StackPanel>
          </TabItem>
          <TabItem x:Name="ReviewsTab">
            <TabItem.Header>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Comment24" Margin="0,0,6,0" />
                <TextBlock Text="{resources:Loc Ui_Mods_StudioPlugins_Reviews}" />
              </StackPanel>
            </TabItem.Header>
            <StackPanel Margin="10">
              <Grid x:Name="ReviewComposer" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="ReviewBox" Grid.Column="0" MinHeight="34" MaxLength="1000" TextWrapping="Wrap" AcceptsReturn="True" PlaceholderText="{resources:Loc Ui_Mods_StudioPlugins_ReviewPlaceholder}" />
                <ui:Button x:Name="PostReviewButton" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top" Height="34" Appearance="Primary" Content="{resources:Loc Ui_Mods_StudioPlugins_PostReview}" Click="PostReview_Click" />
              </Grid>
              <TextBlock x:Name="ReviewsStatus" Margin="0,0,0,8" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              <StackPanel x:Name="ReviewsPanel" />
              <ui:ProgressRing x:Name="ReviewsRing" IsIndeterminate="True" Width="28" Height="28" Margin="0,8,0,0" HorizontalAlignment="Center" Visibility="Collapsed" />
              <ui:Button x:Name="ReviewsMoreButton" HorizontalAlignment="Center" Margin="0,6,0,0" Appearance="Secondary" Content="{resources:Loc Ui_Mods_StudioPlugins_LoadMore}" Click="ReviewsMore_Click" Visibility="Collapsed" />
            </StackPanel>
          </TabItem>
        </TabControl>
      </StackPanel>

      <StackPanel x:Name="DetailSidebar" Grid.Column="1" Margin="0,38,0,0">
        <ui:Button x:Name="DetailPrimaryButton" HorizontalAlignment="Stretch" Height="40" Appearance="Primary" Icon="ArrowDownload24" Click="DetailPrimary_Click" />
        <ui:Button x:Name="DetailOpenButton" HorizontalAlignment="Stretch" Height="36" Margin="0,8,0,0" Appearance="Secondary" Icon="Open24" Click="DetailOpen_Click" />
        <Grid x:Name="VotePanel" Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ui:Button x:Name="LikeButton" Grid.Column="0" HorizontalAlignment="Stretch" Height="34" Appearance="Secondary" Icon="ThumbLike24" Content="{resources:Loc Ui_Mods_StudioPlugins_Like}" Click="Like_Click" />
          <ui:Button x:Name="DislikeButton" Grid.Column="2" HorizontalAlignment="Stretch" Height="34" Appearance="Secondary" Icon="ThumbDislike24" Content="{resources:Loc Ui_Mods_StudioPlugins_Dislike}" Click="Dislike_Click" />
        </Grid>
        <TextBlock x:Name="DetailStatus" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        <Border Style="{StaticResource RowCard}" Margin="0,14,0,0" Padding="12">
          <StackPanel>
            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Mods_StudioPlugins_PriceLabel}" />
            <TextBlock x:Name="DetailPrice" Margin="0,4,0,0" FontSize="13" />
            <TextBlock FontSize="12" Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Mods_StudioPlugins_RatingLabel}" />
            <TextBlock x:Name="DetailRating" Margin="0,4,0,0" FontSize="13" />
            <TextBlock FontSize="12" Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Pages_Updated}" />
            <TextBlock x:Name="DetailUpdated" Margin="0,4,0,0" FontSize="13" />
          </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource DetailLabel}" Text="{resources:Loc Ui_Pages_Creators}" />
        <TextBlock x:Name="DetailCreator" FontSize="13" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
