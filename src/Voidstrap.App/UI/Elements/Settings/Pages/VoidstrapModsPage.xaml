<ui:UiPage x:Class="Voidstrap.UI.Elements.Settings.Pages.VoidstrapModsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:platform="clr-namespace:Voidstrap.UI" Title="{resources:Loc Ui_Nav_VoidstrapMods}" ui:Breadcrumb.Header="{resources:Loc Ui_Nav_VoidstrapMods}" Scrollable="True" Loaded="Page_Loaded" Unloaded="Page_Unloaded">
  <StackPanel Margin="0,0,14,14">
    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
      <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <ui:Button x:Name="NewModButton" Margin="0,0,8,4" Appearance="Primary" Icon="Add24" Content="{resources:Loc Ui_VoidstrapMods_NewMod}" Click="NewMod_Click" />
        <ui:Button Margin="0,0,8,4" Icon="PlugConnected24" Content="{resources:Loc Ui_Mcp_Connect}" ToolTip="{resources:Loc Ui_Mcp_ConnectTooltip}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}" Click="ConnectAi_Click" />
        <ui:Button Margin="0,0,8,4" Icon="ArrowClockwise24" Content="{resources:Loc Ui_VoidstrapMods_Reload}" Click="Reload_Click" />
        <ui:Button Margin="0,0,0,4" Icon="FolderOpen24" Content="{resources:Loc Ui_VoidstrapMods_OpenFolder}" Click="OpenFolder_Click" />
      </WrapPanel>
    </Grid>

    <Border x:Name="CreateModCard" Visibility="Collapsed" Margin="0,0,0,16" Padding="16" CornerRadius="8" BorderThickness="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
      <StackPanel>
        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{resources:Loc Ui_VoidstrapMods_CreateTitle}" />
        <TextBlock Margin="0,4,0,12" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Text="{resources:Loc Ui_VoidstrapMods_CreateSubtitle}" />
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Ui_VoidstrapMods_TemplateLabel}" />
            <ComboBox x:Name="TemplateComboBox" SelectionChanged="TemplateComboBox_SelectionChanged" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Ui_VoidstrapMods_ModNameLabel}" />
            <ui:TextBox x:Name="NewModNameBox" PlaceholderText="{resources:Loc Ui_VoidstrapMods_ModNamePlaceholder}" />
          </StackPanel>
        </Grid>
        <TextBlock x:Name="CreateModErrorText" Visibility="Collapsed" Margin="0,0,0,10" FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <ui:Button Margin="0,0,8,0" Appearance="Primary" Icon="Checkmark24" Content="{resources:Loc Ui_VoidstrapMods_CreateButton}" Click="CreateModConfirm_Click" />
          <ui:Button Appearance="Secondary" Content="{resources:Loc Common_Cancel}" Click="CreateModCancel_Click" />
        </StackPanel>
      </StackPanel>
    </Border>

    <TextBlock Margin="0,0,0,8" FontSize="16" FontWeight="SemiBold" Text="{resources:Loc Ui_VoidstrapMods_Installed}" />
    <StackPanel x:Name="ModsHost" Margin="0,0,0,16" />

    <Border x:Name="EditorCard" Visibility="Collapsed" Margin="0,0,0,16" Padding="16" CornerRadius="8" BorderThickness="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
      <StackPanel>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="Code24" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock x:Name="EditorTitleText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="EditorDirtyText" Visibility="Collapsed" Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{resources:Loc Ui_VoidstrapMods_UnsavedIndicator}" />
          </StackPanel>
          <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Margin="0,0,6,4" Appearance="Primary" Icon="Save24" Content="{resources:Loc Ui_VoidstrapMods_SaveAndReload}" Click="SaveAndReload_Click" />
            <ui:Button Margin="0,0,6,4" Icon="Play24" Content="{resources:Loc Ui_VoidstrapMods_TestButton}" Click="TestEditorMod_Click" />
            <ui:Button Margin="0,0,0,4" Icon="Dismiss24" Content="{resources:Loc Ui_VoidstrapMods_CloseEditor}" Click="CloseEditor_Click" />
          </WrapPanel>
        </Grid>

        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Ui_VoidstrapMods_FileLabel}" />
          <ComboBox x:Name="EditorFileCombo" Grid.Column="1" SelectionChanged="EditorFileCombo_SelectionChanged" />
          <ui:Button Grid.Column="2" Margin="6,0,0,0" Icon="DocumentAdd24" Content="{resources:Loc Ui_VoidstrapMods_NewFileButton}" Click="ShowNewFilePanel_Click" />
          <ui:Button x:Name="DeleteFileButton" Grid.Column="3" Margin="6,0,0,0" Icon="Delete24" Content="{resources:Loc Ui_VoidstrapMods_DeleteFileButton}" Click="DeleteCurrentFile_Click" />
        </Grid>

        <Border x:Name="NewFilePanel" Visibility="Collapsed" Margin="0,0,0,8" Padding="10" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="NewFilePathBox" Grid.Column="0" PlaceholderText="{resources:Loc Ui_VoidstrapMods_NewFilePlaceholder}" />
            <ui:Button Grid.Column="1" Margin="8,0,0,0" Appearance="Primary" Icon="Checkmark24" Content="{resources:Loc Ui_VoidstrapMods_AddFileButton}" Click="ConfirmAddFile_Click" />
            <ui:Button Grid.Column="2" Margin="6,0,0,0" Appearance="Secondary" Content="{resources:Loc Common_Cancel}" Click="CancelAddFile_Click" />
          </Grid>
        </Border>


        <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="420" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <avalonedit:TextEditor x:Name="ModCodeEditor" Grid.Row="0" Margin="4,4,4,0" Padding="8" FontFamily="Cascadia Mono, Consolas" FontSize="13.5" ShowLineNumbers="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Style="{StaticResource NewTextEditor}" />
            <Border Grid.Row="1" Padding="10,6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="EditorFileStatusText" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                  <ui:Button Padding="6,2" Margin="0,0,4,0" Icon="ArrowUndo24" ToolTip="{resources:Loc Ui_Misc_Undo}" Click="UndoCode_Click" />
                  <ui:Button Padding="6,2" Margin="0,0,4,0" Icon="ArrowRedo24" ToolTip="{resources:Loc Ui_Misc_Redo}" Click="RedoCode_Click" />
                  <ui:Button Padding="6,2" Margin="0,0,4,0" Icon="Subtract24" ToolTip="{resources:Loc Ui_Main_ZoomOut}" Click="ZoomOutCode_Click" />
                  <ui:Button Padding="6,2" Icon="Add24" ToolTip="{resources:Loc Ui_Main_ZoomIn}" Click="ZoomInCode_Click" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <Border x:Name="EditorOutputBorder" Margin="0,10,0,0" Padding="12,10" CornerRadius="6" BorderThickness="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
          <StackPanel>
            <TextBlock Margin="0,0,0,6" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Ui_VoidstrapMods_OutputHeader}" />
            <TextBox x:Name="EditorOutputBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <TextBlock x:Name="ActivePanesHeader" Margin="0,0,0,8" FontSize="16" FontWeight="SemiBold" Text="{resources:Loc Ui_VoidstrapMods_ActivePanes}" />
    <TextBlock x:Name="EmptyText" Margin="0,16,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Ui_VoidstrapMods_Empty}" />
    <StackPanel x:Name="PanesHost" />
  </StackPanel>
</ui:UiPage>
