<ui:UiPage x:Class="Voidstrap.UI.Elements.Settings.Pages.VoidstrapModsPage" xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:platform="clr-namespace:Voidstrap.UI" Title="{resources:Loc Ui_Nav_VoidstrapMods}" ui:Breadcrumb.Header="{resources:Loc Ui_Nav_VoidstrapMods}" Scrollable="True" Loaded="Page_Loaded" Unloaded="Page_Unloaded" AllowDrop="True" DragOver="Page_DragOver" Drop="Page_Drop">
  <ui:UiPage.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ExtensionStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </ui:UiPage.Resources>
  <TabControl x:Name="ModTabs" Margin="0,4,14,14">
    <TabItem x:Name="LibraryTab">
      <HeaderedContentControl.Header>
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon Symbol="Library24" Margin="0,0,6,0" />
          <TextBlock Text="{resources:Loc Ui_VoidstrapMods_LibraryTab}" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <Grid Margin="10">
        <StackPanel x:Name="LibraryBrowse">
          <WrapPanel Margin="0,0,0,6">
            <controls:SearchFilterBox Width="560" Margin="0,0,10,8" x:Name="LibrarySearchBox" PlaceholderText="{resources:Loc Ui_AppCode_Search}" ToolTip="{resources:Loc Ui_VoidstrapMods_LibrarySearchHint}" TextChanged="LibrarySearch_TextChanged">
              <controls:SearchFilterBox.Filter>
                <StackPanel Orientation="Horizontal">
                  <ComboBox MinWidth="140" Style="{StaticResource SearchPillComboBox}" x:Name="TagBox" SelectionChanged="TagBox_SelectionChanged" />
                  <Rectangle Width="1" Margin="2,9" Fill="{DynamicResource ControlElevationBorderBrush}" />
                  <ComboBox MinWidth="170" Style="{StaticResource SearchPillComboBox}" x:Name="SortBox" SelectionChanged="SortBox_SelectionChanged" />
                </StackPanel>
              </controls:SearchFilterBox.Filter>
            </controls:SearchFilterBox>
            <ui:Button Height="34" Margin="0,0,8,8" Icon="ArrowClockwise24" Content="{resources:Loc Ui_VoidstrapMods_LibraryRefresh}" Click="LibraryRefresh_Click" />
            <ui:Button Height="34" Margin="0,0,8,8" Icon="Open24" Content="{resources:Loc Ui_VoidstrapMods_LibraryOpenGitHub}" Click="LibraryOpenGitHub_Click" />
            <ui:Button Height="34" Margin="0,0,8,8" Icon="Code24" Content="{resources:Loc Ui_ModCode_OpenButton}" Click="ModCode_Click" ToolTip="{resources:Loc Ui_ModCode_OpenButtonTooltip}" />
            <ui:Button x:Name="AccountButton" Height="34" Margin="0,0,0,8" Icon="Person24" Click="AccountButton_Click" />
          </WrapPanel>
          <ItemsControl x:Name="LibraryHost" Style="{StaticResource RowList}" />
          <Border x:Name="LibraryEmpty" Visibility="Collapsed" Margin="0,8,0,0" Padding="28" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundBrush}">
            <StackPanel HorizontalAlignment="Center">
              <ui:SymbolIcon Symbol="Search24" FontSize="34" HorizontalAlignment="Center" Opacity="0.55" />
              <TextBlock x:Name="LibraryStatusText" Margin="0,12,0,0" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
            </StackPanel>
          </Border>
        </StackPanel>

        <Grid x:Name="LibraryDetail" Visibility="Collapsed" SizeChanged="LibraryDetail_SizeChanged">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ui:Button Grid.Row="0" HorizontalAlignment="Left" Appearance="Transparent" Icon="ChevronLeft24" Padding="6,4,12,4" Margin="-6,0,0,14" Content="{resources:Loc Ui_VoidstrapMods_LibraryBack}" Click="LibraryBack_Click" />
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource RowIcon}" Width="96" Height="96" VerticalAlignment="Top">
              <Grid>
                <ui:SymbolIcon x:Name="DetailIconFallback" Symbol="PuzzlePiece24" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image x:Name="DetailIcon" Stretch="Uniform" Margin="12" RenderOptions.BitmapScalingMode="HighQuality" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,16,0">
              <TextBlock x:Name="DetailName" FontSize="28" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="DetailSummary" Margin="0,2,0,6" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <WrapPanel>
                <TextBlock x:Name="DetailAuthor" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <WrapPanel x:Name="DetailBadges" VerticalAlignment="Center" />
              </WrapPanel>
              <ContentControl x:Name="DetailVotes" Margin="-6,8,0,0" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Top">
              <ui:Button x:Name="DetailInstallButton" MinWidth="130" HorizontalAlignment="Right" Height="40" Appearance="Primary" Icon="ArrowDownload24" Click="LibraryInstall_Click" />
              <StackPanel x:Name="DetailInstalledActions" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <ui:Button x:Name="DetailToggleButton" Height="36" Appearance="Secondary" Click="LibraryToggle_Click" />
                <ui:Button x:Name="DetailUninstallButton" Height="36" Margin="8,0,0,0" Appearance="Danger" Icon="Delete24" Content="{resources:Loc Ui_VoidstrapMods_LibraryUninstall}" Click="LibraryUninstall_Click" />
              </StackPanel>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition x:Name="LibraryDetailSideColumn" Width="300" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Rectangle Grid.ColumnSpan="2" Height="1" VerticalAlignment="Top" Fill="{DynamicResource CardStrokeColorDefaultBrush}" />
            <StackPanel x:Name="LibraryDetailMain" Grid.Column="0" Margin="0,16,18,0">
              <Border HorizontalAlignment="Left" Padding="4" Margin="0,0,0,14" CornerRadius="20" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundBrush}">
                <Grid Grid.IsSharedSizeScope="True">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="DetailTab" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="DetailTab" />
                  </Grid.ColumnDefinitions>
                  <Border x:Name="DetailTabHighlight" Grid.Column="0" CornerRadius="16" Opacity="0.3" Background="{DynamicResource SystemAccentColorSecondaryBrush}">
                    <Border.RenderTransform>
                      <TranslateTransform />
                    </Border.RenderTransform>
                  </Border>
                  <Button x:Name="ChangelogTabButton" Grid.Column="0" Style="{StaticResource PillTab}" Content="{resources:Loc Ui_VoidstrapMods_Changelog}" Click="DetailTab_Click" />
                  <Button x:Name="VersionsTabButton" Grid.Column="1" Style="{StaticResource PillTab}" Content="{resources:Loc Ui_Pages_Versions}" Click="DetailTab_Click" />
                </Grid>
              </Border>
              <Grid ClipToBounds="True">
                <Border x:Name="ChangelogPanel" Style="{StaticResource PanelCard}" Padding="20" Margin="0">
                  <Border.RenderTransform>
                    <TranslateTransform />
                  </Border.RenderTransform>
                  <StackPanel x:Name="ChangelogHost" />
                </Border>
                <Border x:Name="VersionsPanel" Style="{StaticResource PanelCard}" Padding="0" Margin="0" Visibility="Collapsed">
                  <Border.RenderTransform>
                    <TranslateTransform />
                  </Border.RenderTransform>
                  <StackPanel x:Name="VersionsHost" />
                </Border>
              </Grid>
            </StackPanel>
            <StackPanel x:Name="LibraryDetailSidebar" Grid.Column="1" Margin="0,16,0,0">
              <Border Style="{StaticResource PanelCard}" Padding="16">
                <StackPanel>
                  <TextBlock FontSize="15" FontWeight="Bold" Margin="0,0,0,2" Text="{resources:Loc Ui_VoidstrapMods_ModInformation}" />
                  <TextBlock Style="{StaticResource SideLabel}" Text="{resources:Loc Ui_Integrations_Creator}" />
                  <TextBlock x:Name="DetailCreator" FontSize="13" FontWeight="SemiBold" />
                  <TextBlock Style="{StaticResource SideLabel}" Text="{resources:Loc Ui_VoidstrapMods_Trust}" />
                  <TextBlock x:Name="DetailTrust" Style="{StaticResource SideValue}" />
                  <TextBlock Style="{StaticResource SideLabel}" Text="{resources:Loc Ui_VoidstrapMods_LibraryWebsites}" />
                  <TextBlock x:Name="DetailNetwork" Style="{StaticResource SideValue}" />
                  <TextBlock Style="{StaticResource SideLabel}" Text="{resources:Loc Common_Version}" />
                  <TextBlock x:Name="DetailVersion" Style="{StaticResource SideValue}" />
                  <TextBlock Style="{StaticResource SideLabel}" Text="{resources:Loc Ui_Pages_Updated}" />
                  <TextBlock x:Name="DetailUpdated" Style="{StaticResource SideValue}" />
                </StackPanel>
              </Border>
              <ui:Button HorizontalAlignment="Stretch" Height="36" Appearance="Secondary" Icon="Open24" Content="{resources:Loc Ui_Pages_OpenOnGitHub}" Click="DetailGitHub_Click" />
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </TabItem>
    <TabItem x:Name="CreateTab">
      <HeaderedContentControl.Header>
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon Symbol="Code24" Margin="0,0,6,0" />
          <TextBlock Text="{resources:Loc Ui_VoidstrapMods_CreateTab}" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <StackPanel Margin="10">
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button x:Name="NewModButton" Margin="0,0,8,4" Appearance="Primary" Icon="Add24" Content="{resources:Loc Ui_VoidstrapMods_NewMod}" Click="NewMod_Click" />
            <ui:Button Margin="0,0,8,4" Icon="ArrowImport24" Content="{resources:Loc Ui_VoidstrapMods_Import}" ToolTip="{resources:Loc Ui_VoidstrapMods_ImportTooltip}" Click="Import_Click" />
            <ui:Button Margin="0,0,8,4" Icon="PlugConnected24" Content="{resources:Loc Ui_Mcp_Connect}" ToolTip="{resources:Loc Ui_Mcp_ConnectTooltip}" Click="ConnectAi_Click" />
            <ui:Button Margin="0,0,8,4" Icon="ArrowClockwise24" Content="{resources:Loc Ui_VoidstrapMods_Reload}" Click="Reload_Click" />
            <ui:Button Margin="0,0,0,4" Icon="FolderOpen24" Content="{resources:Loc Ui_VoidstrapMods_OpenFolder}" Click="OpenFolder_Click" />
          </WrapPanel>
        </Grid>
  
        <TextBlock Margin="0,0,0,8" FontSize="16" FontWeight="SemiBold" Text="{resources:Loc Ui_VoidstrapMods_Installed}" />
        <ItemsControl x:Name="ModsHost" Margin="0,0,0,6" Style="{StaticResource RowList}" />
  
        <TextBlock x:Name="ActivePanesHeader" Margin="0,0,0,8" FontSize="16" FontWeight="SemiBold" Text="{resources:Loc Ui_VoidstrapMods_ActivePanes}" />
        <TextBlock x:Name="EmptyText" Margin="0,16,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Ui_VoidstrapMods_Empty}" />
        <StackPanel x:Name="PanesHost" />
      </StackPanel>
    </TabItem>
  </TabControl>
</ui:UiPage>
