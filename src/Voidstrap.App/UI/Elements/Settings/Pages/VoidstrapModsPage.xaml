<ui:UiPage x:Class="Voidstrap.UI.Elements.Settings.Pages.VoidstrapModsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:platform="clr-namespace:Voidstrap.UI" Title="{resources:Loc Ui_Nav_VoidstrapMods}" ui:Breadcrumb.Header="{resources:Loc Ui_Nav_VoidstrapMods}" Scrollable="True" Loaded="Page_Loaded" Unloaded="Page_Unloaded" AllowDrop="True" DragOver="Page_DragOver" Drop="Page_Drop">
  <ui:UiPage.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ExtensionStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </ui:UiPage.Resources>
  <TabControl x:Name="ModTabs" Margin="0,4,14,14">
    <TabItem x:Name="LibraryTab">
      <HeaderedContentControl.Header>
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon Symbol="Library24" Margin="0,0,6,0" />
          <TextBlock Text="{resources:Loc Ui_VoidstrapMods_LibraryTab}" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <Grid Margin="10">
        <StackPanel x:Name="LibraryBrowse">
          <WrapPanel Margin="0,0,0,6">
            <ui:TextBox x:Name="LibrarySearchBox" Width="300" Height="34" Margin="0,0,10,8" VerticalContentAlignment="Center" Icon="Search24" ClearButtonEnabled="True" PlaceholderText="{resources:Loc Ui_AppCode_Search}" ToolTip="{resources:Loc Ui_VoidstrapMods_LibrarySearchHint}" TextChanged="LibrarySearch_TextChanged" />
            <ComboBox x:Name="TagBox" Width="150" Height="34" Margin="0,0,10,8" VerticalContentAlignment="Center" SelectionChanged="TagBox_SelectionChanged" />
            <ComboBox x:Name="SortBox" Width="190" Height="34" Margin="0,0,10,8" VerticalContentAlignment="Center" SelectionChanged="SortBox_SelectionChanged" />
            <ui:Button Height="34" Margin="0,0,8,8" Icon="ArrowClockwise24" Content="{resources:Loc Ui_VoidstrapMods_LibraryRefresh}" Click="LibraryRefresh_Click" />
            <ui:Button Height="34" Margin="0,0,8,8" Icon="Open24" Content="{resources:Loc Ui_VoidstrapMods_LibraryOpenGitHub}" Click="LibraryOpenGitHub_Click" />
            <ui:Button Height="34" Margin="0,0,8,8" Icon="Code24" Content="{resources:Loc Ui_ModCode_OpenButton}" Click="ModCode_Click" ToolTip="{resources:Loc Ui_ModCode_OpenButtonTooltip}" />
            <ui:Button x:Name="AccountButton" Height="34" Margin="0,0,0,8" Icon="Person24" Click="AccountButton_Click" />
          </WrapPanel>
          <StackPanel x:Name="LibraryHost" />
          <Border x:Name="LibraryEmpty" Visibility="Collapsed" Margin="0,8,0,0" Padding="28" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundBrush}">
            <StackPanel HorizontalAlignment="Center">
              <ui:SymbolIcon Symbol="Search24" FontSize="34" HorizontalAlignment="Center" Opacity="0.55" />
              <TextBlock x:Name="LibraryStatusText" Margin="0,12,0,0" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
            </StackPanel>
          </Border>
        </StackPanel>

        <Grid x:Name="LibraryDetail" Visibility="Collapsed" SizeChanged="LibraryDetail_SizeChanged">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="LibraryDetailSideColumn" Width="280" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel x:Name="LibraryDetailMain" Grid.Column="0" Margin="0,0,20,0">
            <ui:Button HorizontalAlignment="Left" Appearance="Transparent" Icon="ArrowLeft24" Padding="8,4,12,4" Margin="0,0,0,10" Content="{resources:Loc Ui_VoidstrapMods_LibraryBack}" Click="LibraryBack_Click" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource RowIcon}" Width="96" Height="96">
                <Grid>
                  <ui:SymbolIcon x:Name="DetailIconFallback" Symbol="PuzzlePiece24" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image x:Name="DetailIcon" Stretch="Uniform" Margin="12" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="DetailName" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <WrapPanel x:Name="DetailBadges" Margin="0,4,0,0" />
                <TextBlock x:Name="DetailSummary" Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource DetailLabel}" Text="{resources:Loc Ui_VoidstrapMods_LibraryWebsites}" />
            <TextBlock x:Name="DetailNetwork" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Style="{StaticResource DetailLabel}" Text="{resources:Loc Ui_VoidstrapMods_LibraryFiles}" />
            <Border Style="{StaticResource RowCard}" Padding="12">
              <TextBlock x:Name="DetailFiles" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Border>
          </StackPanel>
          <StackPanel x:Name="LibraryDetailSidebar" Grid.Column="1" Margin="0,38,0,0">
            <ui:Button x:Name="DetailInstallButton" HorizontalAlignment="Stretch" Height="40" Appearance="Primary" Icon="ArrowDownload24" Click="LibraryInstall_Click" />
            <Grid x:Name="DetailInstalledActions" Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:Button x:Name="DetailToggleButton" Grid.Column="0" HorizontalAlignment="Stretch" Height="36" Appearance="Secondary" Click="LibraryToggle_Click" />
              <ui:Button x:Name="DetailUninstallButton" Grid.Column="2" HorizontalAlignment="Stretch" Height="36" Appearance="Danger" Icon="Delete24" Content="{resources:Loc Ui_VoidstrapMods_LibraryUninstall}" Click="LibraryUninstall_Click" />
            </Grid>
            <ui:Button HorizontalAlignment="Stretch" Height="36" Margin="0,8,0,0" Appearance="Secondary" Icon="Open24" Content="{resources:Loc Ui_Pages_OpenOnGitHub}" Click="DetailGitHub_Click" />
            <Border Style="{StaticResource RowCard}" Margin="0,14,0,0" Padding="12">
              <StackPanel>
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Common_Version}" />
                <TextBlock x:Name="DetailVersion" Margin="0,4,0,0" FontSize="13" />
                <TextBlock FontSize="12" Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Pages_Updated}" />
                <TextBlock x:Name="DetailUpdated" Margin="0,4,0,0" FontSize="13" />
                <TextBlock FontSize="12" Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Pages_Creators}" />
                <TextBlock x:Name="DetailCreator" Margin="0,4,0,0" FontSize="13" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="DetailTrust" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          </StackPanel>
        </Grid>
      </Grid>
    </TabItem>
    <TabItem x:Name="CreateTab">
      <HeaderedContentControl.Header>
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon Symbol="Code24" Margin="0,0,6,0" />
          <TextBlock Text="{resources:Loc Ui_VoidstrapMods_CreateTab}" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <StackPanel Margin="10">
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button x:Name="NewModButton" Margin="0,0,8,4" Appearance="Primary" Icon="Add24" Content="{resources:Loc Ui_VoidstrapMods_NewMod}" Click="NewMod_Click" />
            <ui:Button Margin="0,0,8,4" Icon="ArrowImport24" Content="{resources:Loc Ui_VoidstrapMods_Import}" ToolTip="{resources:Loc Ui_VoidstrapMods_ImportTooltip}" Click="Import_Click" />
            <ui:Button Margin="0,0,8,4" Icon="PlugConnected24" Content="{resources:Loc Ui_Mcp_Connect}" ToolTip="{resources:Loc Ui_Mcp_ConnectTooltip}" Click="ConnectAi_Click" />
            <ui:Button Margin="0,0,8,4" Icon="ArrowClockwise24" Content="{resources:Loc Ui_VoidstrapMods_Reload}" Click="Reload_Click" />
            <ui:Button Margin="0,0,0,4" Icon="FolderOpen24" Content="{resources:Loc Ui_VoidstrapMods_OpenFolder}" Click="OpenFolder_Click" />
          </WrapPanel>
        </Grid>
  
        <TextBlock Margin="0,0,0,8" FontSize="16" FontWeight="SemiBold" Text="{resources:Loc Ui_VoidstrapMods_Installed}" />
        <StackPanel x:Name="ModsHost" Margin="0,0,0,16" />
  
        <TextBlock x:Name="ActivePanesHeader" Margin="0,0,0,8" FontSize="16" FontWeight="SemiBold" Text="{resources:Loc Ui_VoidstrapMods_ActivePanes}" />
        <TextBlock x:Name="EmptyText" Margin="0,16,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Ui_VoidstrapMods_Empty}" />
        <StackPanel x:Name="PanesHost" />
      </StackPanel>
    </TabItem>
  </TabControl>
</ui:UiPage>
