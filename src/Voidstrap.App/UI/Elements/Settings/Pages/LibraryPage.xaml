              </StackPanel>
              <StackPanel Margin="0,0,22,0">
                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Pages_PLAYTIME}" />
                <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SelectedGame.PlayTimeDisplay}" />
              </StackPanel>
              <StackPanel Margin="0,0,22,0">
