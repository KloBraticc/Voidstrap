                  <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,18,6" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Pages_Visits}" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SelectedGame.VisitsDisplay}" />
                  <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,18,6" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Pages_Created}" />
