<ui:UiPage x:Class="Voidstrap.UI.Elements.Settings.Pages.LibraryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Voidstrap.UI.Elements.Settings.Pages" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:util="clr-namespace:Voidstrap.Utility" Title="Library" Scrollable="False" Loaded="Page_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <ContextMenu x:Key="GameContextMenu" DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
        <MenuItem Header="Play" Command="{Binding Tag.LaunchCommand}" CommandParameter="{Binding DataContext}">
          <MenuItem.Icon>
            <ui:SymbolIcon Symbol="Play24" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{Binding DataContext.PinButtonText}" Command="{Binding Tag.TogglePinCommand}" CommandParameter="{Binding DataContext}">
          <MenuItem.Icon>
            <ui:SymbolIcon Symbol="Pin24" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="Remove from library" Command="{Binding Tag.RemoveGameCommand}" CommandParameter="{Binding DataContext}">
          <MenuItem.Icon>
            <ui:SymbolIcon Symbol="Delete24" />
          </MenuItem.Icon>
        </MenuItem>
      </ContextMenu>
      <CollectionViewSource x:Key="SidebarGamesView" Source="{Binding SidebarGames}">
        <CollectionViewSource.GroupDescriptions>
          <PropertyGroupDescription PropertyName="SidebarGroup" />
        </CollectionViewSource.GroupDescriptions>
      </CollectionViewSource>
      <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      </Style>
      <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="#26FFFFFF" />
        <Setter Property="BorderBrush" Value="#26FFFFFF" />
        <Setter Property="Height" Value="1" />
      </Style>
      <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabControl}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" IsItemsHost="True" />
                <Border Grid.Row="1" Margin="0,10,0,0" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}">
                  <ContentPresenter ContentSource="SelectedContent" />
                </Border>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabItem}">
              <Border Background="Transparent" Padding="14,8,14,6">
                <StackPanel>
                  <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Rectangle x:Name="TabUnderline" Height="2" Margin="0,5,0,0" RadiusX="1" RadiusY="1" HorizontalAlignment="Stretch" Opacity="0" Fill="{DynamicResource SystemAccentBrush}" />
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="TabUnderline" Property="Opacity" Value="1" />
                  <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsSelected" Value="False" />
                  </MultiTrigger.Conditions>
                  <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="NavSideItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border x:Name="MainBorder" Background="Transparent" BorderThickness="1" CornerRadius="4">
                <Grid>
                  <Rectangle x:Name="ActiveRectangle" Width="0" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0.0" RadiusX="2" RadiusY="2">
                    <Rectangle.Fill>
                      <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                    </Rectangle.Fill>
                  </Rectangle>
                  <ContentPresenter Margin="16,8" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="MainBorder" Property="Background">
                    <Setter.Value>
                      <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" />
                    </Setter.Value>
                  </Setter>
                  <Trigger.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="ActiveRectangle" Storyboard.TargetProperty="(Rectangle.Width)" From="0" To="4" Duration="00:00:00.167" />
                        <DoubleAnimation Storyboard.TargetName="ActiveRectangle" Storyboard.TargetProperty="(Rectangle.Opacity)" From="0.0" To="1.0" Duration="00:00:00.167" />
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.EnterActions>
                  <Trigger.ExitActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="ActiveRectangle" Storyboard.TargetProperty="(Rectangle.Width)" From="4" To="0" Duration="00:00:00.167" />
                        <DoubleAnimation Storyboard.TargetName="ActiveRectangle" Storyboard.TargetProperty="(Rectangle.Opacity)" From="1.0" To="0.0" Duration="00:00:00.167" />
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.ExitActions>
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                  </MultiTrigger.Conditions>
                  <Setter TargetName="MainBorder" Property="Background">
                    <Setter.Value>
                      <SolidColorBrush Opacity="0.5" Color="{DynamicResource ControlFillColorDefault}" />
                    </Setter.Value>
                  </Setter>
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="NavSideButton" TargetType="{x:Type Button}">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border x:Name="MainBorder" Background="Transparent" BorderThickness="1" CornerRadius="4">
                <ContentPresenter Margin="16,8" HorizontalAlignment="Left" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="MainBorder" Property="Background">
                    <Setter.Value>
                      <SolidColorBrush Opacity="0.5" Color="{DynamicResource ControlFillColorDefault}" />
                    </Setter.Value>
                  </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="MainBorder" Property="Background">
                    <Setter.Value>
                      <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" />
                    </Setter.Value>
                  </Setter>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ShelfCardButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="CardRoot" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="0" ClipToBounds="True">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="CardRoot" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="0,0,14,14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" Width="225" Margin="0,0,10,0" HorizontalAlignment="Left">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Button Grid.Row="0" Style="{StaticResource NavSideButton}" Command="{Binding GoHomeCommand}">
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon Width="18" Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Symbol="Home24" />
          <TextBlock FontSize="14" VerticalAlignment="Center" Text="Library Home" />
        </StackPanel>
      </Button>
      <ui:TextBox Grid.Row="1" Margin="0,2,0,0" PlaceholderText="Search games" Icon="Search24" ClearButtonEnabled="True" Text="{Binding SidebarSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <Grid Grid.Row="2" Margin="16,6,0,0">
        <ui:Button HorizontalAlignment="Right" Padding="4,0" Appearance="Transparent" Icon="ArrowSync24" ToolTip="Refresh library" Command="{Binding RefreshCommand}" />
      </Grid>
      <ListBox Grid.Row="3" Background="#00FFFFFF" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource NavSideItem}" ItemsSource="{Binding Source={StaticResource SidebarGamesView}}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}">
        <ListBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.ContainerStyle>
              <Style TargetType="{x:Type GroupItem}">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                      <StackPanel>
                        <ToggleButton x:Name="GroupToggle" IsChecked="True" Focusable="False" Cursor="Hand">
                          <ToggleButton.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                              <Border Background="Transparent" Padding="10,12,10,0">
                                <StackPanel>
                                  <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon x:Name="Chevron" Symbol="ChevronDown12" FontSize="13" Foreground="#7AFFFFFF" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                      <UIElement.RenderTransform>
                                        <RotateTransform Angle="0" />
                                      </UIElement.RenderTransform>
                                    </ui:SymbolIcon>
                                    <TextBlock x:Name="GroupName" Margin="9,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#7AFFFFFF" Text="{Binding Name}" />
                                    <TextBlock x:Name="GroupCount" Margin="7,0,0,0" FontSize="14" VerticalAlignment="Center" Foreground="#4FFFFFFF" Text="{Binding ItemCount, StringFormat=({0})}" />
                                  </StackPanel>
                                  <Rectangle Height="1" Margin="0,7,0,0" Fill="#1FFFFFFF" />
                                </StackPanel>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="False">
                                  <Trigger.EnterActions>
                                    <BeginStoryboard>
                                      <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="-90" Duration="0:0:0.2">
                                          <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                          </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                      </Storyboard>
                                    </BeginStoryboard>
                                  </Trigger.EnterActions>
                                  <Trigger.ExitActions>
                                    <BeginStoryboard>
                                      <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.2">
                                          <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                          </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                      </Storyboard>
                                    </BeginStoryboard>
                                  </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="GroupName" Property="Foreground" Value="#FFFFFFFF" />
                                  <Setter TargetName="Chevron" Property="Foreground" Value="#FFFFFFFF" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </ToggleButton.Template>
                        </ToggleButton>
                        <Border x:Name="GroupItemsHost" Opacity="1">
                          <Border.LayoutTransform>
                            <ScaleTransform ScaleY="1" />
                          </Border.LayoutTransform>
                          <ItemsPresenter Margin="0,4,0,4" />
                        </Border>
                      </StackPanel>
                      <ControlTemplate.Triggers>
                        <Trigger SourceName="GroupToggle" Property="IsChecked" Value="False">
                          <Trigger.EnterActions>
                            <BeginStoryboard>
                              <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="GroupItemsHost" Storyboard.TargetProperty="(UIElement.Opacity)" To="0" Duration="0:0:0.14">
                                  <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                  </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="GroupItemsHost" Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleY)" To="0" Duration="0:0:0.22">
                                  <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseInOut" />
                                  </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                              </Storyboard>
                            </BeginStoryboard>
                          </Trigger.EnterActions>
                          <Trigger.ExitActions>
                            <BeginStoryboard>
                              <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="GroupItemsHost" Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.22">
                                  <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseInOut" />
                                  </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="GroupItemsHost" Storyboard.TargetProperty="(UIElement.Opacity)" To="1" BeginTime="0:0:0.08" Duration="0:0:0.16">
                                  <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                  </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                              </Storyboard>
                            </BeginStoryboard>
                          </Trigger.ExitActions>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </GroupStyle.ContainerStyle>
          </GroupStyle>
        </ListBox.GroupStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Background="#00FFFFFF" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" ContextMenu="{StaticResource GameContextMenu}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Image Grid.Column="0" Width="18" Height="18" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding IconUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="UniformToFill" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip="{Binding Name}" />
              <ui:SymbolIcon Grid.Column="2" Margin="8,0,0,0" Symbol="Pin16" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding PinIconVisibility}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ListBox>
      <Border Grid.Row="4" Margin="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlElevationBorderBrush}" Padding="0,8,0,0">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" PlaceholderText="Add by PlaceId or link" FontSize="12" Text="{Binding AddGameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button Grid.Column="1" Margin="6,0,0,0" Icon="Add24" ToolTip="Add this game to your library" Command="{Binding AddGameCommand}" />
          </Grid>
          <TextBlock Margin="2,6,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding StatusText}" Visibility="{Binding StatusVisibility}" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <ProgressBar Grid.Row="0" Height="10" Margin="0,0,0,6" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

      <ui:DynamicScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding DashboardVisibility}">
        <StackPanel Margin="2,0,4,10">
                    <StackPanel Margin="0,60,0,0" HorizontalAlignment="Center" Visibility="{Binding EmptyLibraryVisibility}">
                        <TextBlock Margin="0,12,0,0" MaxWidth="380" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Your library is empty. Play a game through Voidstrap or add one by PlaceId from the sidebar." />
          </StackPanel>

          <StackPanel Visibility="{Binding EventsVisibility}" Margin="0,0,0,18">
            <TextBlock Margin="2,0,0,8" FontSize="18" FontWeight="SemiBold" Text="Events" />
            <ui:DynamicScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
              <ItemsControl ItemsSource="{Binding Events}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="246" Margin="0,0,10,6" CornerRadius="8" ClipToBounds="True"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1">
                      <StackPanel>
                        <Grid Height="138">
                          <Image util:DynamicRenderSystem.LazyImageSource="{Binding ThumbnailUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="UniformToFill" />
                          <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                  CornerRadius="10" Padding="8,3"
                                  Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                            <TextBlock Text="{Binding StartDisplay}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                          </Border>
                        </Grid>
                        <StackPanel Margin="10,8,10,10">
                          <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" />
                          <TextBlock Margin="0,2,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding SubtitleDisplay}" />
                          <ui:Button Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                     Appearance="Secondary" Content="View event"
                                     Command="{Binding DataContext.OpenEventCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                     CommandParameter="{Binding}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ui:DynamicScrollViewer>
          </StackPanel>

          <StackPanel Visibility="{Binding WhatsNewVisibility}">
            <TextBlock Margin="2,0,0,8" FontSize="18" FontWeight="SemiBold" Text="What's New" />
            <ui:DynamicScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
              <ItemsControl ItemsSource="{Binding WhatsNew}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource ShelfCardButton}" Width="246" Margin="0,0,10,6" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}" ContextMenu="{StaticResource GameContextMenu}" Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                      <StackPanel>
                        <Border Height="138" ClipToBounds="True">
                          <Image util:DynamicRenderSystem.LazyImageSource="{Binding ThumbnailUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Margin="10,8,10,10">
                          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                          <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding UpdatedAgoDisplay}" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ui:DynamicScrollViewer>
          </StackPanel>

          <StackPanel Margin="0,14,0,0" Visibility="{Binding RecentVisibility}">
            <TextBlock Margin="2,0,0,8" FontSize="18" FontWeight="SemiBold" Text="Recent Games" />
            <ui:DynamicScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
              <ItemsControl ItemsSource="{Binding RecentGames}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource ShelfCardButton}" Width="246" Margin="0,0,10,6" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}" ContextMenu="{StaticResource GameContextMenu}" Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                      <StackPanel>
                        <Border Height="138" ClipToBounds="True">
                          <Image util:DynamicRenderSystem.LazyImageSource="{Binding ThumbnailUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Margin="10,8,10,10">
                          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                          <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding LastPlayedDisplay}" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ui:DynamicScrollViewer>
          </StackPanel>

          <StackPanel Margin="0,14,0,0">
            <Grid Margin="2,0,4,8">
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding AllGamesHeader}" />
              <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding TotalPlayTimeDisplay}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding AllGames}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource ShelfCardButton}" Width="150" Margin="0,0,10,10" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}" ContextMenu="{StaticResource GameContextMenu}" Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                    <StackPanel>
                      <Border Height="150" ClipToBounds="True">
                        <Image util:DynamicRenderSystem.LazyImageSource="{Binding IconUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="UniformToFill" />
                      </Border>
                      <Grid Margin="8,6,8,8">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip="{Binding Name}" />
                        <ui:SymbolIcon HorizontalAlignment="Right" Symbol="Pin16" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding PinIconVisibility}" />
                      </Grid>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ui:DynamicScrollViewer>

      <ui:DynamicScrollViewer x:Name="DetailScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding DetailVisibility}" ScrollChanged="DetailScroll_ScrollChanged">
        <StackPanel Margin="2,0,4,10">
          <Border Height="240" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
              <Image Source="{Binding SelectedGame.ThumbnailUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="UniformToFill" />
              <Border>
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.4" Color="#00000000" />
                    <GradientStop Offset="1.0" Color="#D8000000" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <StackPanel VerticalAlignment="Bottom" Margin="18,0,18,14">
                <TextBlock FontSize="26" FontWeight="Bold" Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis" Text="{Binding SelectedGame.Name}" />
                <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="#CCFFFFFF" Text="{Binding SelectedGame.CreatorDisplay}" />
              </StackPanel>
            </Grid>
          </Border>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" MinWidth="140" Height="40" FontSize="15" Appearance="Primary" Background="{DynamicResource SystemAccentBrush}" Icon="Play24" Content="Play" Command="{Binding LaunchCommand}" CommandParameter="{Binding SelectedGame}" />
            <ui:Button Grid.Column="1" Margin="10,0,0,0" Height="40" Appearance="Secondary" Icon="Pin24" Content="{Binding SelectedGame.PinButtonText}" Command="{Binding TogglePinCommand}" CommandParameter="{Binding SelectedGame}" />
            <ui:Button Grid.Column="2" Margin="10,0,0,0" Height="40" Appearance="Secondary" Icon="Delete24" ToolTip="Remove this game from your library" Content="Remove" Command="{Binding RemoveGameCommand}" CommandParameter="{Binding SelectedGame}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <StackPanel Margin="0,0,22,0">
                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="LAST PLAYED" />
                <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SelectedGame.LastPlayedDisplay}" />
              </StackPanel>
              <StackPanel Margin="0,0,22,0">
                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="PLAY TIME" />
                <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SelectedGame.PlayTimeDisplay}" />
              </StackPanel>
              <StackPanel Margin="0,0,22,0">
                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="PLAYING NOW" />
                <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SelectedGame.PlayingDisplay}" />
              </StackPanel>
              <StackPanel>
                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="RATING" />
                <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SelectedGame.LikePercent}" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <TabControl Margin="0,14,0,0">
            <TabItem>
              <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Info24" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                  <TextBlock Text="About" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                </StackPanel>
              </TabItem.Header>
              <StackPanel Margin="12">
                <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SelectedGame.Description}" />
                <Separator Margin="0,12,0,12" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,18,6" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Creator" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SelectedGame.CreatorName}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,18,6" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Genre" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SelectedGame.Genre}" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,18,6" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Max players" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SelectedGame.MaxPlayers}" />
                  <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,18,6" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Visits" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SelectedGame.VisitsDisplay}" />
                  <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,18,6" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Created" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SelectedGame.CreatedDisplay}" />
                  <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,18,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Updated" />
                  <TextBlock Grid.Row="5" Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SelectedGame.UpdatedDisplay}" />
                </Grid>
              </StackPanel>
            </TabItem>
            <TabItem>
              <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Cart24" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                  <TextBlock Text="Store" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                </StackPanel>
              </TabItem.Header>
              <StackPanel Margin="12">
                <ProgressBar Height="10" Margin="0,0,0,10" IsIndeterminate="True" Visibility="{Binding GamePassesLoading, Converter={StaticResource BoolToVis}}" />
                <TextBlock Margin="0,0,0,10" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding GamePassStatus}" Visibility="{Binding GamePassStatusVisibility}" />
                <ItemsControl ItemsSource="{Binding GamePasses}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource ShelfCardButton}" Width="150" Margin="0,0,10,10" ToolTip="Open this gamepass on roblox.com" Command="{Binding DataContext.OpenGamePassCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                        <StackPanel Margin="10">
                          <Border Width="100" Height="100" HorizontalAlignment="Center" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}" ClipToBounds="True">
                            <Image util:DynamicRenderSystem.LazyImageSource="{Binding IconUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="UniformToFill" />
                          </Border>
                          <TextBlock Margin="0,8,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip="{Binding Name}" />
                          <TextBlock Margin="0,3,0,0" FontSize="12" TextAlignment="Center" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" Text="{Binding PriceDisplay}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </TabItem>
          </TabControl>
        </StackPanel>
      </ui:DynamicScrollViewer>

      <Border x:Name="StickyBar" Grid.Row="1" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False" Padding="2,8,4,10" Visibility="{Binding DetailVisibility}" Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource ControlFillColorSecondaryBrush}">
            <Image Source="{Binding SelectedGame.IconUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="UniformToFill" />
          </Border>
          <TextBlock Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SelectedGame.Name}" />
          <ui:Button Grid.Column="2" MinWidth="110" Height="34" Appearance="Primary" Background="{DynamicResource SystemAccentBrush}" Icon="Play24" Content="Play" Command="{Binding LaunchCommand}" CommandParameter="{Binding SelectedGame}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</ui:UiPage>
