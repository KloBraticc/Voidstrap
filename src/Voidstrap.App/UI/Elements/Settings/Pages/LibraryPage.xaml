                      <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,8,0" />
                        <TextBlock FontSize="12" VerticalAlignment="Center" Text="{resources:Loc ContextMenu_ServerBrowser_Refresh}" />
                      </StackPanel>
                    </ui:Button>
                  </StackPanel>
                </Grid>
                <ProgressBar Height="4" Margin="0,12,0,0" IsIndeterminate="True" Visibility="{Binding Servers.PublicLoading, Converter={StaticResource BoolToVis}}" />
                <TextBlock Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding Servers.PublicStatus}" Visibility="{Binding Servers.PublicStatusVisibility}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Servers.Servers}" ItemTemplate="{StaticResource ServerCardTemplate}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </TabItem>
            <TabItem IsSelected="{Binding Servers.IsPrivateServersTabSelected, Mode=TwoWay}">
              <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="LockClosed24" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                  <TextBlock Text="{resources:Loc Library_PrivateServersTab}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                </StackPanel>
              </TabItem.Header>
              <StackPanel Margin="16">
                <ui:Button HorizontalAlignment="Left" Appearance="Secondary" ToolTip="{resources:Loc ContextMenu_ServerBrowser_Refresh}" Command="{Binding Servers.RefreshPrivateCommand}">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,8,0" />
                    <TextBlock FontSize="12" VerticalAlignment="Center" Text="{resources:Loc ContextMenu_ServerBrowser_Refresh}" />
                  </StackPanel>
                </ui:Button>
                <ProgressBar Height="4" Margin="0,12,0,0" IsIndeterminate="True" Visibility="{Binding Servers.PrivateLoading, Converter={StaticResource BoolToVis}}" />
                <TextBlock Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding Servers.PrivateStatus}" Visibility="{Binding Servers.PrivateStatusVisibility}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Servers.PrivateServers}" ItemTemplate="{StaticResource ServerCardTemplate}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </TabItem>
            <TabItem>
              <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="ThumbLike24" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                  <TextBlock Text="{resources:Loc Ui_Session_CommunityRating}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                </StackPanel>
              </TabItem.Header>
              <StackPanel Margin="16">
                <controls:RoReviewControl PlaceId="{Binding SelectedGame.PlaceId}" UniverseId="{Binding SelectedGame.UniverseId}" GameName="{Binding SelectedGame.Name}" />
              </StackPanel>
            </TabItem>
          </TabControl>
        </StackPanel>
      </ui:DynamicScrollViewer>

      <Border x:Name="StickyBar" Grid.Row="1" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False" Padding="2,8,4,10" Visibility="{Binding DetailVisibility}" Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource ControlFillColorSecondaryBrush}">
            <Image util:DynamicRenderSystem.LazyImageSource="{Binding SelectedGame.IconUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="UniformToFill" />
          </Border>
          <TextBlock Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SelectedGame.Name}" />
          <ui:Button Grid.Column="2" MinWidth="110" Height="34" Appearance="Primary" Background="{DynamicResource SystemAccentBrush}" Icon="Play24" Content="{resources:Loc Ui_Pages_Play}" Command="{Binding LaunchCommand}" CommandParameter="{Binding SelectedGame}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</ui:UiPage>
