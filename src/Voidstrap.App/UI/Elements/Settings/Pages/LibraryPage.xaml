                  <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,18,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Pages_Updated}" />
                  <TextBlock Grid.Row="5" Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SelectedGame.UpdatedDisplay}" />
                </Grid>
