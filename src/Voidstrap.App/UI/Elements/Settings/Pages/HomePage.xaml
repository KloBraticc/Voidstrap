<Page
    x:Class="Voidstrap.UI.Elements.Settings.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:platform="clr-namespace:Voidstrap.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="clr-namespace:Voidstrap.UI.ViewModels"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:resources="clr-namespace:Voidstrap.Resources"
    xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls"
    xmlns:util="clr-namespace:Voidstrap.Utility"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="{resources:Loc Ui_Nav_Home}">

    <Page.Resources>
        <DataTemplate x:Key="StudioProjectCard">
            <Border x:Name="ProjectCard"
                    Margin="0,0,12,12"
                    Padding="10"
                    CornerRadius="8"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Cursor="Hand"
                    ToolTip="{Binding Name, StringFormat='Open {0} in Studio'}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.OpenStudioProjectCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <StackPanel>
                    <Border Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <Image Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               util:DynamicRenderSystem.LazyImageSource="{Binding IconUrl}"/>
                    </Border>
                    <Grid Margin="0,10,0,0">
                        <Border x:Name="PrivacyPill"
                                HorizontalAlignment="Left"
                                Padding="8,3"
                                CornerRadius="11"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="PrivacyIcon" Symbol="{Binding PrivacyIcon}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PrivacyText" Text="{Binding PrivacyLabel}" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <ui:Button Width="26" Height="26" Padding="0"
                                       Appearance="Transparent"
                                       Icon="Star24"
                                       IconFilled="{Binding IsFavorite}"
                                       ToolTip="{Binding FavoriteTooltip}"
                                       Command="{Binding DataContext.ToggleStudioFavoriteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       CommandParameter="{Binding}"/>
                            <ui:Button Width="26" Height="26" Padding="0"
                                       Appearance="Transparent"
                                       Icon="MoreVertical24"
                                       ToolTip="{resources:Loc Ui_ModGen_MoreOptions}"
                                       Click="StudioMore_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Name}"
                               Margin="0,6,0,0"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Height="38"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{Binding ModifiedLabel}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding CreatorName}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="ProjectCard" Property="IsMouseOver" Value="True">
                    <Setter TargetName="ProjectCard" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsPublic}" Value="True">
                    <Setter TargetName="PrivacyPill" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                    <Setter TargetName="PrivacyPill" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                    <Setter TargetName="PrivacyIcon" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                    <Setter TargetName="PrivacyText" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="StudioTemplateCard">
            <Border x:Name="TemplateCard"
                    Margin="0,0,12,12"
                    Padding="10"
                    CornerRadius="8"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Cursor="Hand"
                    ToolTip="{Binding Name, StringFormat='Start from {0}'}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.OpenStudioProjectCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <StackPanel>
                    <Border Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <Image Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               util:DynamicRenderSystem.LazyImageSource="{Binding IconUrl}"/>
                    </Border>
                    <TextBlock Text="{Binding Name}"
                               Margin="2,10,0,2"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="TemplateCard" Property="IsMouseOver" Value="True">
                    <Setter TargetName="TemplateCard" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="StudioGridPanel">
            <UniformGrid Columns="{Binding DataContext.StudioColumns, RelativeSource={RelativeSource AncestorType=Page}}" VerticalAlignment="Top"/>
        </ItemsPanelTemplate>
        <DataTemplate x:Key="NewsCardTemplate">
                            <Border x:Name="NewsCard"
                                    Height="212"
                                    Margin="0,0,14,0"
                                    CornerRadius="10"
                                    Background="#FF0E1015"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.OpenNewsCardCommand,
                                                      RelativeSource={RelativeSource AncestorType=Page}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Border x:Name="NewsImageHost" CornerRadius="9" RenderOptions.BitmapScalingMode="HighQuality"
                                        util:DynamicRenderSystem.BrushDecodeWidth="960"
                                        util:DynamicRenderSystem.BrushImageSource="{Binding ImageUrl}">
                                        <Border.Background>
                                            <ImageBrush Stretch="UniformToFill">
                                                <ImageBrush.RelativeTransform>
                                                    <ScaleTransform x:Name="NewsZoom" CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1"/>
                                                </ImageBrush.RelativeTransform>
                                            </ImageBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="9" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#33080A0E" Offset="0"/>
                                                <GradientStop Color="#00080A0E" Offset="0.3"/>
                                                <GradientStop Color="#B305060A" Offset="0.72"/>
                                                <GradientStop Color="#F205060A" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="14,14,0,0"
                                            Padding="10,4"
                                            CornerRadius="12"
                                            Background="{DynamicResource AccentFillColorPrimaryBrush}"
                                            Visibility="{Binding TagVisibility}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Megaphone24"
                                                           FontSize="11"
                                                           Margin="0,1,5,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Tag}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Grid Margin="16,0,14,14" VerticalAlignment="Bottom">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,14,0" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                            <TextBlock Text="{Binding CardTitle}"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       MaxHeight="44"
                                                       LineHeight="22"
                                                       Foreground="White"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Blurb}"
                                                       FontSize="12.5"
                                                       LineHeight="17"
                                                       Margin="0,4,0,0"
                                                       MaxHeight="34"
                                                       Opacity="0.85"
                                                       Foreground="White"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding BlurbVisibility}"/>
                                            <TextBlock Text="{Binding DateLabel}"
                                                       Visibility="{Binding DateVisibility}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Margin="0,6,0,0"
                                                       Opacity="0.7"
                                                       Foreground="White"/>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Width="30"
                                                Height="30"
                                                CornerRadius="15"
                                                Background="White"
                                                VerticalAlignment="Bottom">
                                            <ui:SymbolIcon Symbol="ArrowRight24"
                                                           FontSize="13"
                                                           Foreground="#FF0B0D11"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <ui:ProgressRing Width="26"
                                                     Height="26"
                                                     IsIndeterminate="True"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     IsHitTestVisible="False"
                                                     Visibility="{Binding Background.(util:DynamicRenderSystem.IsBrushLoading),
                                                         ElementName=NewsImageHost,
                                                         Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <EventTrigger SourceName="NewsCard" RoutedEvent="Border.MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="NewsZoom"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.05" Duration="0:0:0.55">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuinticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="NewsZoom"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.05" Duration="0:0:0.55">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuinticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger SourceName="NewsCard" RoutedEvent="Border.MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="NewsZoom"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.65">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuinticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="NewsZoom"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.65">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuinticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>

        <Style x:Key="HomeSectionStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsLayoutEditMode, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentColorSecondaryBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="12"/>
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="Margin" Value="0,0,0,10"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HomeSectionContentStyle" TargetType="Grid">
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsLayoutEditMode, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HomeSectionToolbarStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="SizeAll"/>
            <Setter Property="ToolTip" Value="{resources:Loc Ui_Home_DragSectionTooltip}"/>
            <EventSetter Event="MouseLeftButtonDown" Handler="SectionGrip_MouseLeftButtonDown"/>
            <EventSetter Event="MouseMove" Handler="SectionGrip_MouseMove"/>
            <EventSetter Event="MouseLeftButtonUp" Handler="SectionGrip_MouseLeftButtonUp"/>
            <EventSetter Event="LostMouseCapture" Handler="SectionGrip_LostMouseCapture"/>
            <Setter Property="Padding" Value="4,0,4,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Grid.Row" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsLayoutEditMode, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HomeSectionToolbarDividerStyle" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="4,0,4,0"/>
            <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        </Style>

        <Style x:Key="HomeSectionGripStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,0,8,0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,4,4,4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HomeSectionToolButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1,0,1,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HomeSectionMoveUpButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource HomeSectionToolButtonStyle}">
            <Setter Property="Icon" Value="ArrowUp24"/>
            <Setter Property="ToolTip" Value="{resources:Loc Ui_Home_MoveSectionUpTooltip}"/>
            <EventSetter Event="Click" Handler="SectionMoveUp_Click"/>
        </Style>

        <Style x:Key="HomeSectionMoveDownButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource HomeSectionToolButtonStyle}">
            <Setter Property="Icon" Value="ArrowDown24"/>
            <Setter Property="ToolTip" Value="{resources:Loc Ui_Home_MoveSectionDownTooltip}"/>
            <EventSetter Event="Click" Handler="SectionMoveDown_Click"/>
        </Style>

        <Style x:Key="HomeSectionMoveTopButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource HomeSectionToolButtonStyle}">
            <Setter Property="Icon" Value="ArrowUpload24"/>
            <Setter Property="ToolTip" Value="{resources:Loc Ui_Home_MoveSectionTopTooltip}"/>
            <EventSetter Event="Click" Handler="SectionMoveTop_Click"/>
        </Style>

        <Style x:Key="HomeSectionMoveBottomButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource HomeSectionToolButtonStyle}">
            <Setter Property="Icon" Value="ArrowDownload24"/>
            <Setter Property="ToolTip" Value="{resources:Loc Ui_Home_MoveSectionBottomTooltip}"/>
            <EventSetter Event="Click" Handler="SectionMoveBottom_Click"/>
        </Style>

        <Style x:Key="HomeSectionHideButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource HomeSectionToolButtonStyle}">
            <Setter Property="Icon" Value="EyeOff24"/>
            <Setter Property="ToolTip" Value="{resources:Loc Ui_Home_HideSectionTooltip}"/>
            <EventSetter Event="Click" Handler="SectionHide_Click"/>
        </Style>

        <Style x:Key="HomeHiddenTrayStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsLayoutEditMode, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HomeEditLayoutButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Content" Value="{resources:Loc Ui_Home_EditLayout}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsLayoutEditMode, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                    <Setter Property="Content" Value="{resources:Loc Ui_Home_DoneEditingLayout}"/>
                    <Setter Property="Appearance" Value="Primary"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HomeResetLayoutButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsLayoutEditMode, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,4,28,6">
            <StackPanel x:Name="LearnMoreGroup" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
            <Button VerticalAlignment="Center" Cursor="Hand" Focusable="False" Content="{resources:Loc Ui_Home_LearnMore}" Click="LearnMore_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" Padding="10,3" CornerRadius="999" Background="#2A3A5A" BorderBrush="#33466B" BorderThickness="1">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="12.5" Foreground="#8AB4F8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#32466B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#263553"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <ui:Button x:Name="LearnMoreHideButton" Margin="6,0,0,0" Style="{StaticResource HomeSectionToolButtonStyle}" Icon="EyeOff24" ToolTip="{resources:Loc Ui_Home_HideSectionTooltip}" Visibility="Collapsed" Click="LearnMoreHide_Click"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <ui:Button x:Name="EditLayoutButton"
                           Appearance="Secondary"
                           Icon="Edit24"
                           ToolTip="{resources:Loc Ui_Home_EditLayoutTooltip}"
                           Style="{StaticResource HomeEditLayoutButtonStyle}"
                           Click="EditLayout_Click"/>
                <ui:Button x:Name="ResetLayoutButton"
                           Margin="8,0,0,0"
                           Appearance="Secondary"
                           Icon="ArrowCounterclockwise24"
                           Content="{resources:Loc Ui_Home_ResetLayout}"
                           ToolTip="{resources:Loc Ui_Home_ResetLayoutTooltip}"
                           Style="{StaticResource HomeResetLayoutButtonStyle}"
                           Click="ResetLayout_Click"/>
                <ui:Button x:Name="UndoLayoutButton"
                           Margin="8,0,0,0"
                           Appearance="Secondary"
                           Icon="ArrowUndo24"
                           Content="{resources:Loc Ui_Misc_Undo}"
                           ToolTip="{resources:Loc Ui_Home_UndoLayoutTooltip}"
                           Style="{StaticResource HomeResetLayoutButtonStyle}"
                           IsEnabled="False"
                           Click="UndoLayout_Click"/>
                <StackPanel Margin="12,0,0,0" Orientation="Horizontal" Visibility="{Binding StudioTabVisibility}">
                    <ProgressBar Width="120" Height="3" Margin="0,0,12,0" VerticalAlignment="Center" IsIndeterminate="True"
                                 Visibility="{Binding IsStudioLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:Button Content="{resources:Loc ContextMenu_ServerBrowser_Refresh}" Icon="ArrowSync24" Appearance="Secondary" Command="{Binding RefreshStudioCommand}" />
                    <ui:Button Margin="8,0,0,0" Appearance="Primary" Command="{Binding LaunchStudioCommand}" ToolTip="{resources:Loc LaunchMenu_LaunchRobloxStudio}">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="16" Height="16" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Resources/RobloxStudioIcon.png" />
                            <TextBlock VerticalAlignment="Center" Text="{resources:Loc Ui_Home_OpenStudio}" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="{Binding Error}"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   FontSize="13"
                   Margin="0,0,28,12"
                   TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Error}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ui:DynamicScrollViewer Grid.Row="2"
                      Visibility="{Binding RobloxTabVisibility}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="RobloxSections" Margin="0,0,28,0">

                <Border x:Name="RobloxHiddenTray" Style="{StaticResource HomeHiddenTrayStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{resources:Loc Ui_Home_HiddenSections}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <WrapPanel x:Name="RobloxHiddenChips" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border x:Name="HomeSectionFeatured" Tag="featured" Style="{StaticResource HomeSectionStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="1" Margin="0,28,0,0" Style="{StaticResource HomeSectionContentStyle}">
                            <Border Height="320" CornerRadius="14" util:RoundedClip.Radius="14" Background="#FF0B0B0D" Visibility="{Binding FeaturedVisibility}" Tag="{Binding FeaturedGame}" Cursor="Hand" MouseLeftButtonUp="GameThumbnail_Click">
                                <Grid util:RoundedClip.Radius="14">
                                    <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" util:DynamicRenderSystem.LazyImageSource="{Binding FeaturedGame.ThumbnailUrl}"/>
                                    <controls:GameVideoView VideoPath="{Binding FeaturedVideoPath}" IsHitTestVisible="False"/>
                                    <Border IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#E0000000" Offset="0"/>
                                                <GradientStop Color="#70000000" Offset="0.45"/>
                                                <GradientStop Color="#00000000" Offset="0.8"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="28,0,28,28" MaxWidth="460">
                                        <Border HorizontalAlignment="Left" CornerRadius="10" Padding="10,3" Background="#26FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                                            <TextBlock Text="{resources:Loc Ui_Home_MostPlayedNow}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="{Binding FeaturedGame.Name}" FontSize="30" FontWeight="Bold" Foreground="White" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
