<Page
    x:Class="Voidstrap.UI.Elements.Settings.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:platform="clr-namespace:Voidstrap.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="clr-namespace:Voidstrap.UI.ViewModels"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:resources="clr-namespace:Voidstrap.Resources"
    xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls"
    xmlns:util="clr-namespace:Voidstrap.Utility"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="Home">

    <Page.Resources>
        <DataTemplate x:Key="StudioProjectCard">
            <Border x:Name="ProjectCard"
                    Margin="0,0,12,12"
                    Padding="10"
                    CornerRadius="8"
                    Background="#0DFFFFFF"
                    BorderThickness="1"
                    BorderBrush="#14FFFFFF"
                    Cursor="Hand"
                    ToolTip="{Binding Name, StringFormat='Open {0} in Studio'}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.OpenStudioProjectCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <StackPanel>
                    <Border Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" CornerRadius="6" ClipToBounds="True" Background="#14FFFFFF">
                        <Image Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               util:DynamicRenderSystem.LazyImageSource="{Binding IconUrl}"/>
                    </Border>
                    <Grid Margin="0,10,0,0">
                        <Border x:Name="PrivacyPill"
                                HorizontalAlignment="Left"
                                Padding="8,3"
                                CornerRadius="11"
                                Background="#14FFFFFF"
                                BorderThickness="1"
                                BorderBrush="#26FFFFFF">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="PrivacyIcon" Symbol="{Binding PrivacyIcon}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PrivacyText" Text="{Binding PrivacyLabel}" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ui:Button HorizontalAlignment="Right"
                                   Width="26" Height="26" Padding="0"
                                   Appearance="Transparent"
                                   Icon="MoreVertical24"
                                   ToolTip="More options"
                                   Click="StudioMore_Click"/>
                    </Grid>
                    <TextBlock Text="{Binding Name}"
                               Margin="0,6,0,0"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Height="38"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{Binding ModifiedLabel}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding CreatorName}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="ProjectCard" Property="IsMouseOver" Value="True">
                    <Setter TargetName="ProjectCard" Property="Background" Value="#1AFFFFFF"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsPublic}" Value="True">
                    <Setter TargetName="PrivacyPill" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                    <Setter TargetName="PrivacyPill" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                    <Setter TargetName="PrivacyIcon" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                    <Setter TargetName="PrivacyText" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="StudioTemplateCard">
            <Border x:Name="TemplateCard"
                    Margin="0,0,12,12"
                    Padding="10"
                    CornerRadius="8"
                    Background="#0DFFFFFF"
                    BorderThickness="1"
                    BorderBrush="#14FFFFFF"
                    Cursor="Hand"
                    ToolTip="{Binding Name, StringFormat='Start from {0}'}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.OpenStudioProjectCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <StackPanel>
                    <Border Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" CornerRadius="6" ClipToBounds="True" Background="#14FFFFFF">
                        <Image Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               util:DynamicRenderSystem.LazyImageSource="{Binding IconUrl}"/>
                    </Border>
                    <TextBlock Text="{Binding Name}"
                               Margin="2,10,0,2"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="TemplateCard" Property="IsMouseOver" Value="True">
                    <Setter TargetName="TemplateCard" Property="Background" Value="#1AFFFFFF"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="StudioGridPanel">
            <UniformGrid Columns="{Binding DataContext.StudioColumns, RelativeSource={RelativeSource AncestorType=Page}}" VerticalAlignment="Top"/>
        </ItemsPanelTemplate>
    </Page.Resources>

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,4,28,6">
            <Border HorizontalAlignment="Left" Padding="4" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Orientation="Horizontal">
                    <ui:Button Height="32" Margin="0,0,4,0" Padding="12,0" Tag="Roblox" Click="HomeTab_Click">
                        <ui:Button.Style>
                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStudioTab}" Value="False">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Image Width="16" Height="16" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Resources/RobloxPlayerIcon.png" />
                            <TextBlock VerticalAlignment="Center" Text="Roblox" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Height="32" Padding="12,0" Tag="Studio" Click="HomeTab_Click">
                        <ui:Button.Style>
                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStudioTab}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Image Width="16" Height="16" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Resources/RobloxStudioIcon.png" />
                            <TextBlock VerticalAlignment="Center" Text="Studio" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Border>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Visibility="{Binding StudioTabVisibility}">
                <ProgressBar Width="120" Height="3" Margin="0,0,12,0" VerticalAlignment="Center" IsIndeterminate="True"
                             Visibility="{Binding IsStudioLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:Button Content="Refresh" Icon="ArrowSync24" Appearance="Secondary" Command="{Binding RefreshStudioCommand}" />
                <ui:Button Margin="8,0,0,0" Appearance="Primary" Command="{Binding LaunchStudioCommand}" ToolTip="Launch Roblox Studio">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="16" Height="16" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Resources/RobloxStudioIcon.png" />
                        <TextBlock VerticalAlignment="Center" Text="Open Studio" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="{Binding Error}"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   FontSize="13"
                   Margin="0,0,28,12"
                   TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Error}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ui:DynamicScrollViewer Grid.Row="2"
                      Visibility="{Binding RobloxTabVisibility}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,28,0">

                <Grid Margin="0,12,0,14"
                      Visibility="{Binding HasLatestNews,
                          Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Latest Roblox News"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="{Binding NewsHeaderCount}"
                                   FontSize="13"
                                   Margin="9,4,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                    <ui:Button HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Appearance="Transparent"
                               Padding="6,3"
                               ToolTip="See every Roblox announcement"
                               Click="ExploreNews_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Explore all news"
                                       FontSize="13.5"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentColorSecondaryBrush}"/>
                            <ui:SymbolIcon Symbol="ChevronRight24"
                                           FontSize="11"
                                           Margin="6,1,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentColorSecondaryBrush}"/>
                        </StackPanel>
                    </ui:Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding LatestNews}"
                              Margin="0,0,0,24"
                              Visibility="{Binding HasLatestNews,
                                  Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="NewsCard"
                                    Height="212"
                                    Margin="0,0,14,0"
                                    CornerRadius="10"
                                    Background="#FF0E1015"
                                    BorderThickness="1"
                                    BorderBrush="#26FFFFFF"
                                    Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.OpenNewsCardCommand,
                                                      RelativeSource={RelativeSource AncestorType=Page}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Border x:Name="NewsImageHost" CornerRadius="9" RenderOptions.BitmapScalingMode="LowQuality"
                                        util:DynamicRenderSystem.BrushDecodeWidth="520"
                                        util:DynamicRenderSystem.BrushImageSource="{Binding ImageUrl}">
                                        <Border.Background>
                                            <ImageBrush Stretch="UniformToFill">
                                                <ImageBrush.RelativeTransform>
                                                    <ScaleTransform x:Name="NewsZoom" CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1"/>
                                                </ImageBrush.RelativeTransform>
                                            </ImageBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="9" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#66080A0E" Offset="0"/>
                                                <GradientStop Color="#2E080A0E" Offset="0.45"/>
                                                <GradientStop Color="#8C05060A" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,12,12,0"
                                            Padding="11,4"
                                            CornerRadius="13"
                                            Background="{DynamicResource AccentFillColorPrimaryBrush}"
                                            Visibility="{Binding TagVisibility}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Megaphone24"
                                                           FontSize="11"
                                                           Margin="0,1,5,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Tag}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding CardTitle}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               MaxHeight="66"
                                               LineHeight="21"
                                               Margin="16,13,108,0"
                                               TextAlignment="Left"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               Foreground="White"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               IsHitTestVisible="False"/>
                                    <TextBlock Text="{Binding DateLabel}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Margin="16,0,0,14"
                                               Opacity="0.92"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Bottom"
                                               Foreground="White"
                                               IsHitTestVisible="False"/>
                                    <Border Width="28"
                                            Height="28"
                                            Margin="0,0,13,12"
                                            CornerRadius="14"
                                            Background="White"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom">
                                        <ui:SymbolIcon Symbol="ArrowRight24"
                                                       FontSize="12"
                                                       Foreground="#FF0B0D11"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                    </Border>
                                    <ui:ProgressRing Width="26"
                                                     Height="26"
                                                     IsIndeterminate="True"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     IsHitTestVisible="False"
                                                     Visibility="{Binding Background.(util:DynamicRenderSystem.IsBrushLoading),
                                                         ElementName=NewsImageHost,
                                                         Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <EventTrigger SourceName="NewsCard" RoutedEvent="Border.MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="NewsZoom"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.05" Duration="0:0:0.55">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuinticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="NewsZoom"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.05" Duration="0:0:0.55">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuinticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger SourceName="NewsCard" RoutedEvent="Border.MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="NewsZoom"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.65">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuinticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="NewsZoom"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.65">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuinticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>


                <TextBlock Text="New on the Catalog"
                           FontSize="20" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,8,0,8"/>

                <TextBlock Text="{Binding CatalogError}"
                           Foreground="Red"
                           FontSize="12"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CatalogError}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="Loading new catalog items..."
                           FontSize="12"
                           Opacity="0.5"
                           Margin="0,0,0,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCatalogLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="No new catalog items right now."
                           FontSize="12"
                           Opacity="0.45"
                           Margin="0,0,0,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCatalogEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding NewCatalogItems}"
                              Margin="0,0,0,12"
                              Visibility="{Binding HasCatalogItems,
                                  Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,0,8,8" Padding="0" Cursor="Hand">
                                <ui:Card.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.OpenCatalogItemCommand,
                                                      RelativeSource={RelativeSource AncestorType=Page}}"
                                                  CommandParameter="{Binding}"/>
                                </ui:Card.InputBindings>
                                <StackPanel>
                                    <Border Height="100"
                                            CornerRadius="10,10,0,0"
                                            ClipToBounds="True"
                                            Background="#0DFFFFFF">
                                        <Grid>
                                            <Image Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   util:DynamicRenderSystem.LazyImageSource="{Binding ImageUrl}">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasImage}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>
                                    </Border>

                                    <StackPanel Margin="10,8,10,10">
                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}"/>

                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="0,2,0,0"
                                                   Text="{Binding Creator}"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding PriceDisplay}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentColorSecondaryBrush}"
                                                       VerticalAlignment="Center"/>

                                            <Border Margin="6,0,0,0"
                                                    Padding="4,1"
                                                    CornerRadius="4"
                                                    Background="#1AFFD700"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Limited}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="Limited"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FFD700"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Margin="0,4,0,0"
                                                   Text="{Binding TypeName}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>


                <TextBlock Text="Continue Playing"
                           FontSize="20"
                           FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,8,0,8"/>

                <Border Margin="0,4,0,18"
                        Padding="0,34,0,34"
                        CornerRadius="10"
                        Background="#0AFFFFFF"
                        BorderThickness="1"
                        BorderBrush="#1FFFFFFF"
                        Visibility="{Binding IsEmpty,
                            Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="56"
                                Height="56"
                                CornerRadius="28"
                                Background="#14FFFFFF"
                                HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="History24"
                                           FontSize="26"
                                           Foreground="{StaticResource AccentColorSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="No history yet"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,14,0,5"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Games you play will show up here so you can jump back in."
                                   FontSize="12.5"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Margin="0,4,0,18"
                        Padding="0,34,0,34"
                        CornerRadius="10"
                        Background="#0AFFFFFF"
                        BorderThickness="1"
                        BorderBrush="#1FFFFFFF"
                        Visibility="{Binding IsFilteredEmpty,
                            Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="56"
                                Height="56"
                                CornerRadius="28"
                                Background="#14FFFFFF"
                                HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Search24"
                                           FontSize="26"
                                           Foreground="{StaticResource AccentColorSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="No matches"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,14,0,5"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Nothing in your history matches that search."
                                   FontSize="12.5"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding FilteredHistory}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFilteredEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,0,10,10" Padding="0" Cursor="Hand">
                                <StackPanel>
                                    <Border Height="112"
                                            CornerRadius="8,8,0,0"
                                            ClipToBounds="True"
                                            Cursor="Hand"
                                            ToolTip="View game page"
                                            MouseLeftButtonUp="GameThumbnail_Click"
                                            Background="#1AFFFFFF">
                                        <Grid>

                                            <Image Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   util:DynamicRenderSystem.LazyImageSource="{Binding ThumbnailUrl}">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>
                                    </Border>

                                    <StackPanel Margin="12,8,12,0">
                                        <TextBlock FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}"/>

                                        <TextBlock FontSize="11"
                                                   Opacity="0.6"
                                                   Margin="0,2,0,0"
                                                   Text="{Binding CreatorName}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CreatorName}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <ui:SymbolIcon Symbol="ThumbLike24"
                                                           FontSize="14"
                                                           Opacity="0.75"
                                                           VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding LikePercent}"
                                                       FontSize="12"
                                                       Margin="4,0,12,0"
                                                       Opacity="0.75"
                                                       VerticalAlignment="Center"/>

                                            <ui:SymbolIcon Symbol="People24"
                                                           FontSize="14"
                                                           Opacity="0.75"
                                                           VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PlayerCount}"
                                                       FontSize="12"
                                                       Margin="4,0,0,0"
                                                       Opacity="0.75"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock FontSize="10" Opacity="0.45" Margin="0,4,0,0">
                                            <Run Text="Joined: "/>
                                            <Run Text="{Binding TimeJoined,
                                                         StringFormat='{}{0:MMM d, yyyy  h:mm tt}',
                                                         Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <Grid Margin="12,8,12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ui:Button Grid.Column="0"
                                                   Icon="Play24"
                                                  
                                                   IconForeground="White"
                                                   Foreground="White"
                                                   Appearance="Primary"
                                                   ToolTip="{Binding Name, StringFormat='Play {0}'}"
                                                   HorizontalAlignment="Stretch"
                                                   Command="{Binding DataContext.LaunchCommand,
                                                       RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}"/>

                                        <ui:Button Grid.Column="2"
                                                   Icon="Copy24"
                                                   Appearance="Secondary"
                                                   ToolTip="Copy game link"
                                                   Command="{Binding DataContext.CopyLinkCommand,
                                                       RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}"/>
                                    </Grid>

                                    <ComboBox Margin="12,8,12,0"
                                              Padding="8,4,8,4"
                                              FontSize="12"
                                              ToolTip="Preferred server for rejoining this game"
                                              IsEnabled="{Binding MatchmakerEnabledForGame}"
                                              ItemsSource="{Binding DatacenterOptions}"
                                              SelectedItem="{Binding SelectedDatacenter, Mode=TwoWay}"
                                              DisplayMemberPath="Display"/>

                                    <ui:Button Margin="12,8,12,12"
                                               HorizontalAlignment="Stretch"
                                               FontSize="12"
                                               Icon="{Binding SkipMatchmakerIcon}"
                                               Content="{Binding SkipMatchmakerLabel}"
                                               ToolTip="{Binding SkipMatchmakerTooltip}"
                                               Command="{Binding ToggleSkipMatchmakerCommand}"/>
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ui:DynamicScrollViewer>

        <ui:DynamicScrollViewer Grid.Row="2"
                      SizeChanged="StudioScroller_SizeChanged"
                      Visibility="{Binding StudioTabVisibility}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,28,18">
                <TextBlock Text="{Binding StudioStatus}"
                           Margin="0,12,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StudioStatus}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Visibility="{Binding StudioRecentVisibility}">
                    <TextBlock Text="My Recent Experiences" FontSize="21" FontWeight="Bold" Margin="0,12,0,12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding StudioRecent}" ItemTemplate="{StaticResource StudioProjectCard}" ItemsPanel="{StaticResource StudioGridPanel}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding StudioOwnedVisibility}">
                    <TextBlock Text="My Experiences" FontSize="21" FontWeight="Bold" Margin="0,12,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Every experience on your account, newest changes first." FontSize="13" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding StudioOwned}" ItemTemplate="{StaticResource StudioProjectCard}" ItemsPanel="{StaticResource StudioGridPanel}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding StudioLocalFilesVisibility}">
                    <TextBlock Text="Recent Files" FontSize="21" FontWeight="Bold" Margin="0,12,0,12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding StudioLocalFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="FileRow"
                                        Margin="0,0,0,8"
                                        Padding="14,10"
                                        CornerRadius="8"
                                        Background="#0DFFFFFF"
                                        BorderThickness="1"
                                        BorderBrush="#14FFFFFF"
                                        Cursor="Hand"
                                        ToolTip="{Binding FilePath}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.OpenStudioProjectCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Width="28" Height="28" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Resources/RobloxStudioIcon.png"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding CreatorName}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding ModifiedLabel}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="FileRow" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="FileRow" Property="Background" Value="#1AFFFFFF"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Visibility="{Binding StudioTemplatesVisibility}">
                    <TextBlock Text="Open a Template" FontSize="21" FontWeight="Bold" Margin="0,12,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="See what's possible on Roblox in popular genres with ready made experiences, or start from scratch." FontSize="13" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding StudioTemplates}" ItemTemplate="{StaticResource StudioTemplateCard}" ItemsPanel="{StaticResource StudioGridPanel}"/>
                </StackPanel>
            </StackPanel>
        </ui:DynamicScrollViewer>
    </Grid>
</Page>
