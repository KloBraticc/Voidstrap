<Page
    x:Class="Voidstrap.UI.Elements.Settings.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="clr-namespace:Voidstrap.UI.ViewModels"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:resources="clr-namespace:Voidstrap.Resources"
    xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls"
    xmlns:util="clr-namespace:Voidstrap.Utility"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="Home">

    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,28,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="1"
                       Content="Refresh"
                       Appearance="Secondary"
                       Command="{Binding RefreshCommand}"/>

            <ui:Button Grid.Column="3"
                       Content="Clear All"
                       Appearance="Secondary"
                       Command="{Binding ClearCommand}"/>
        </Grid>

        <TextBlock Grid.Row="2" Visibility="Collapsed" />

        <TextBlock Grid.Row="1"
                   Text="{Binding Error}"
                   Foreground="Red"
                   FontSize="12"
                   Margin="0,0,28,8"
                   TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Error}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ui:DynamicScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,28,0">

                <ui:InfoBar Margin="0,0,0,8"
                            Padding="8"
                            Severity="Informational"
                            IsClosable="False"
                            Title="Voidstrap Profile"
                            Message="Sign into Voidstrap to use more features"
                            IsOpen="{Binding IsSignedOut, Mode=OneWay}" />

                <ui:InfoBar Margin="0,0,0,8"
                            Padding="8"
                            Severity="Warning"
                            IsClosable="False"
                            Title="If Not Working?"
                            Message="Cloudflare pages is being limited right now you cant sign in, logout or do much of anything."
                            IsOpen="{Binding IsSignedOut, Mode=OneWay}" />

                <ui:Button Icon="Person24"
                           Appearance="Primary"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,16"
                           Command="{Binding SignInCommand}">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Content" Value="Sign in"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSignedOut}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSigningIn}" Value="True">
                                    <Setter Property="Content" Value="Waiting for your browser, click to retry"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>

                <Border Margin="0,0,0,16"
                        Padding="16"
                        CornerRadius="8"
                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasWebsiteProfile}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.RowSpan="4"
                                    Grid.ColumnSpan="2"
                                    Panel.ZIndex="10"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,8,8,0">
                            <ui:Button Content="Edit profile"
                                       Icon="Edit24"
                                       Appearance="Secondary"
                                       Background="#33000000"
                                       BorderBrush="#40FFFFFF"
                                       Click="EditProfile_Click"/>
                            <ui:Button Icon="PeopleSwap24"
                                       Content="Accounts"
                                       Appearance="Secondary"
                                       Background="#33000000"
                                       BorderBrush="#40FFFFFF"
                                       Margin="8,0,0,0">
                                <ui:Button.ContextMenu>
                                    <ContextMenu ItemsSource="{Binding Accounts}">
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Header" Value="{Binding Label}"/>
                                                <Setter Property="Command" Value="{Binding DataContext.SwitchAccountCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Setter Property="CommandParameter" Value="{Binding}"/>
                                            </Style>
                                        </ContextMenu.ItemContainerStyle>
                                    </ContextMenu>
                                </ui:Button.ContextMenu>
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <EventSetter Event="Click" Handler="AccountsButton_Click"/>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button Icon="PersonAdd24"
                                       Appearance="Secondary"
                                       Background="#33000000"
                                       BorderBrush="#40FFFFFF"
                                       Width="40"
                                       Margin="8,0,0,0"
                                       Command="{Binding AddAccountCommand}"/>
                            <ui:Button Icon="SignOut24"
                                       Appearance="Secondary"
                                       Background="#33000000"
                                       BorderBrush="#40FFFFFF"
                                       Width="40"
                                       Margin="8,0,0,0"
                                       Command="{Binding SignOutCommand}"/>
                        </StackPanel>
                        <Border Grid.Row="0"
                                Grid.ColumnSpan="2"
                                Height="130"
                                CornerRadius="8,8,0,0"
                                Margin="-16,-16,-16,0"
                                ClipToBounds="True"
                                Background="{Binding WebsiteBannerBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasWebsiteBannerBrush}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                            <Grid Width="96" Height="96" Margin="0,-19,0,-19" ClipToBounds="False">
                                <Border x:Name="AvatarBorderRing"
                                        Width="58" Height="58" CornerRadius="29"
                                        Padding="3"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                        x:FieldModifier="private">
                                    <Border Width="52" Height="52" CornerRadius="26"
                                            Padding="2" Background="#0A0A0A">
                                        <Border CornerRadius="26" ClipToBounds="True">
                                            <Border.Background>
                                                <ImageBrush x:Name="WebsiteAvatarBrush" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                </Border>
                                <Image Source="{Binding WebsiteBorderImage}"
                                       Width="{Binding WebsiteBorderWidth}"
                                       Height="{Binding WebsiteBorderHeight}"
                                       Margin="{Binding WebsiteBorderMargin}"
                                       Panel.ZIndex="{Binding WebsiteBorderZ}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       IsHitTestVisible="False"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding HasWebsiteBorderImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="220">
                                <Border x:Name="WebsiteStatusPill"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,6"
                                        Padding="10,4"
                                        CornerRadius="12"
                                        Background="#E6161616"
                                        BorderBrush="#40FFFFFF"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasWebsiteStatus}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock x:Name="WebsiteStatusText"
                                               Text="{Binding WebsiteStatus}"
                                               FontSize="11"
                                               Foreground="#FFECECEC"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="200"
                                               ToolTip="{Binding WebsiteStatus}"/>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="WebsiteDisplayNameText"
                                               Text="{Binding WebsiteDisplayName}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <ItemsControl ItemsSource="{Binding WebsiteBadges}" Margin="6,0,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding Image}"
                                                       Width="19"
                                                       Height="19"
                                                       Margin="0,0,3,0"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       ToolTip="{Binding Name}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <TextBlock x:Name="WebsiteUsernameText"
                                           Text="{Binding WebsiteUsername, StringFormat=@{0}}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="WebsiteAboutText"
                                   Grid.Row="2"
                                   Text="{Binding WebsiteAbout}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasWebsiteAbout}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                            <StackPanel Orientation="Vertical" Margin="0,0,16,0">
                                <TextBlock Text="{Binding WebsiteFriendsDisplay}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Friends" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.6" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Margin="0,0,16,0">
                                <TextBlock Text="{Binding WebsiteFollowersDisplay}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Followers" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.6" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Margin="0,0,16,0">
                                <TextBlock Text="{Binding WebsiteFollowingDisplay}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Following" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.6" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Margin="0,0,16,0">
                                <TextBlock Text="{Binding WebsiteLikesDisplay}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Likes" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.6" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding WebsiteDislikesDisplay}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Dislikes" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.6" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="2"
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    Margin="16,8,0,0"
                                    VerticalAlignment="Bottom">
                            <StackPanel Orientation="Vertical" Margin="0,0,0,10">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasWebsiteLevel}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid>
                                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Run Text="Level" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Run Text="{Binding WebsiteLevelDisplay, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding WebsiteLevelXpDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                                <ProgressBar Height="5"
                                             Margin="0,8,0,0"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding WebsiteLevelPercent, Mode=OneWay}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <controls:OptionControl Header="In-game Voidstrap chat"
                                        Description="Chat with other users, Voidstrap."
                                        Margin="0,0,0,16">
                    <ui:ToggleSwitch IsChecked="{Binding GameChatEnabled, Mode=TwoWay}"/>
                </controls:OptionControl>

                <TextBlock Text="New on the Catalog"
                           FontSize="20" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,16,0,8"/>

                <TextBlock Text="{Binding CatalogError}"
                           Foreground="Red"
                           FontSize="12"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CatalogError}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="Loading new catalog items..."
                           FontSize="12"
                           Opacity="0.5"
                           Margin="0,0,0,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCatalogLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="No new catalog items right now."
                           FontSize="12"
                           Opacity="0.45"
                           Margin="0,0,0,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCatalogEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding NewCatalogItems}"
                              Margin="0,0,0,12"
                              Visibility="{Binding HasCatalogItems,
                                  Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,0,8,8" Padding="0" Cursor="Hand">
                                <ui:Card.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.OpenCatalogItemCommand,
                                                      RelativeSource={RelativeSource AncestorType=Page}}"
                                                  CommandParameter="{Binding}"/>
                                </ui:Card.InputBindings>
                                <StackPanel>
                                    <Border Height="100"
                                            CornerRadius="10,10,0,0"
                                            ClipToBounds="True"
                                            Background="#0DFFFFFF">
                                        <Grid>
                                            <Image Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   util:DynamicRenderSystem.LazyImageSource="{Binding ImageUrl}">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasImage}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>
                                    </Border>

                                    <StackPanel Margin="10,8,10,10">
                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}"/>

                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="0,2,0,0"
                                                   Text="{Binding Creator}"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding PriceDisplay}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentColorSecondaryBrush}"
                                                       VerticalAlignment="Center"/>

                                            <Border Margin="6,0,0,0"
                                                    Padding="4,1"
                                                    CornerRadius="4"
                                                    Background="#1AFFD700"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Limited}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="Limited"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FFD700"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Margin="0,4,0,0"
                                                   Text="{Binding TypeName}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Visibility="{Binding HasUnderratedGames,
                                Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Underrated Games"
                               FontSize="20"
                               FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,8,0,2"/>
                    <TextBlock Text="{Binding UnderratedSubtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Opacity="0.85"
                               Margin="0,0,0,10"/>

                    <ItemsControl ItemsSource="{Binding UnderratedGames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,0,10,10" Padding="0" Cursor="Hand">
                                    <StackPanel>
                                        <Border Height="92"
                                                CornerRadius="8,8,0,0"
                                                ClipToBounds="True"
                                                Cursor="Hand"
                                                ToolTip="View game page"
                                                MouseLeftButtonUp="UnderratedThumbnail_Click"
                                                Background="#1AFFFFFF">
                                            <Image Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   util:DynamicRenderSystem.LazyImageSource="{Binding BannerUrl}">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasBanner}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Border>

                                        <StackPanel Margin="10,6,10,0">
                                            <TextBlock FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <ui:SymbolIcon Symbol="ThumbLike24"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                               Opacity="0.75"
                                                               VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding LikePercent}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           Margin="4,0,10,0"
                                                           Opacity="0.75"
                                                           VerticalAlignment="Center"/>
                                                <ui:SymbolIcon Symbol="People24"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                               Opacity="0.75"
                                                               VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding PlayerCount}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           Margin="4,0,0,0"
                                                           Opacity="0.75"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <ui:Button Margin="10,8,10,10"
                                                   Icon="Play24"
                                                   IconForeground="White"
                                                   Foreground="White"
                                                   Appearance="Primary"
                                                   ToolTip="{Binding Name, StringFormat='Play {0}'}"
                                                   HorizontalAlignment="Stretch"
                                                   Command="{Binding DataContext.LaunchUnderratedCommand,
                                                       RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="Continue Playing"
                           FontSize="20"
                           FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,8,0,8"/>

                <StackPanel HorizontalAlignment="Center"
                            Margin="0,24,0,24"
                            Visibility="{Binding IsEmpty,
                                Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:SymbolIcon Symbol="History24" FontSize="52" Opacity="0.25"
                                   HorizontalAlignment="Center"/>
                    <TextBlock Text="No history yet" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="16" Opacity="0.5"
                               Margin="0,12,0,4" HorizontalAlignment="Center"/>
                    <TextBlock Text="Games you play will appear here."
                               Opacity="0.4" FontSize="12"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center"
                            Margin="0,24,0,24"
                            Visibility="{Binding IsFilteredEmpty,
                                Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:SymbolIcon Symbol="Search24" FontSize="52" Opacity="0.25"
                                   HorizontalAlignment="Center"/>
                    <TextBlock Text="No matches" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="16" Opacity="0.5"
                               Margin="0,12,0,4" HorizontalAlignment="Center"/>
                    <TextBlock Text="No history entries match your search."
                               Opacity="0.4" FontSize="12"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding FilteredHistory}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFilteredEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,0,10,10" Padding="0" Cursor="Hand">
                                <StackPanel>
                                    <Border Height="112"
                                            CornerRadius="8,8,0,0"
                                            ClipToBounds="True"
                                            Cursor="Hand"
                                            ToolTip="View game page"
                                            MouseLeftButtonUp="GameThumbnail_Click"
                                            Background="#1AFFFFFF">
                                        <Grid>

                                            <Image Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   util:DynamicRenderSystem.LazyImageSource="{Binding ThumbnailUrl}">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>
                                    </Border>

                                    <StackPanel Margin="12,8,12,0">
                                        <TextBlock FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}"/>

                                        <TextBlock FontSize="11"
                                                   Opacity="0.6"
                                                   Margin="0,2,0,0"
                                                   Text="{Binding CreatorName}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CreatorName}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <ui:SymbolIcon Symbol="ThumbLike24"
                                                           FontSize="14"
                                                           Opacity="0.75"
                                                           VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding LikePercent}"
                                                       FontSize="12"
                                                       Margin="4,0,12,0"
                                                       Opacity="0.75"
                                                       VerticalAlignment="Center"/>

                                            <ui:SymbolIcon Symbol="People24"
                                                           FontSize="14"
                                                           Opacity="0.75"
                                                           VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PlayerCount}"
                                                       FontSize="12"
                                                       Margin="4,0,0,0"
                                                       Opacity="0.75"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock FontSize="10" Opacity="0.45" Margin="0,4,0,0">
                                            <Run Text="Joined: "/>
                                            <Run Text="{Binding TimeJoined,
                                                         StringFormat='{}{0:MMM d, yyyy  h:mm tt}',
                                                         Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <Grid Margin="12,8,12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ui:Button Grid.Column="0"
                                                   Icon="Play24"
                                                  
                                                   IconForeground="White"
                                                   Foreground="White"
                                                   Appearance="Primary"
                                                   ToolTip="{Binding Name, StringFormat='Play {0}'}"
                                                   HorizontalAlignment="Stretch"
                                                   Command="{Binding DataContext.LaunchCommand,
                                                       RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}"/>

                                        <ui:Button Grid.Column="2"
                                                   Icon="Copy24"
                                                   Appearance="Secondary"
                                                   ToolTip="Copy game link"
                                                   Command="{Binding DataContext.CopyLinkCommand,
                                                       RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}"/>
                                    </Grid>

                                    <ComboBox Margin="12,8,12,12"
                                              Padding="8,4,8,4"
                                              FontSize="12"
                                              ToolTip="Preferred server for rejoining this game"
                                              ItemsSource="{Binding DatacenterOptions}"
                                              SelectedItem="{Binding SelectedDatacenter, Mode=TwoWay}"
                                              DisplayMemberPath="Display"/>
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ui:DynamicScrollViewer>
    </Grid>
</Page>
