                                                      Command="{Binding DataContext.OpenStudioProjectCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Width="28" Height="28" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Resources/RobloxStudioIcon.png"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding CreatorName}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding ModifiedLabel}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="FileRow" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="FileRow" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource HomeSectionToolbarStyle}">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Style="{StaticResource HomeSectionMoveTopButtonStyle}"/>
                                    <ui:Button Style="{StaticResource HomeSectionMoveUpButtonStyle}"/>
                                    <ui:Button Style="{StaticResource HomeSectionMoveDownButtonStyle}"/>
                                    <ui:Button Style="{StaticResource HomeSectionMoveBottomButtonStyle}"/>
                                    <Border Style="{StaticResource HomeSectionToolbarDividerStyle}"/>
                                    <ui:Button Style="{StaticResource HomeSectionHideButtonStyle}"/>
                                </StackPanel>
                                <Border Style="{StaticResource HomeSectionGripStyle}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="ReOrderDotsVertical24" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Tag="sectionTitle" Loaded="SectionTitle_Loaded" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="StudioSectionTemplates" Tag="studioTemplates" Style="{StaticResource HomeSectionStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="1" Style="{StaticResource HomeSectionContentStyle}">
                            <StackPanel Visibility="{Binding StudioTemplatesVisibility}">
                    <TextBlock Text="{resources:Loc Ui_Home_OpenATemplate}" FontSize="21" FontWeight="Bold" Margin="0,12,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{resources:Loc Ui_Home_SeeWhatSPossibleOnRoblox}" FontSize="13" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding StudioTemplates}" ItemTemplate="{StaticResource StudioTemplateCard}" ItemsPanel="{StaticResource StudioGridPanel}"/>
                </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource HomeSectionToolbarStyle}">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Style="{StaticResource HomeSectionMoveTopButtonStyle}"/>
                                    <ui:Button Style="{StaticResource HomeSectionMoveUpButtonStyle}"/>
                                    <ui:Button Style="{StaticResource HomeSectionMoveDownButtonStyle}"/>
                                    <ui:Button Style="{StaticResource HomeSectionMoveBottomButtonStyle}"/>
                                    <Border Style="{StaticResource HomeSectionToolbarDividerStyle}"/>
                                    <ui:Button Style="{StaticResource HomeSectionHideButtonStyle}"/>
                                </StackPanel>
                                <Border Style="{StaticResource HomeSectionGripStyle}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="ReOrderDotsVertical24" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Tag="sectionTitle" Loaded="SectionTitle_Loaded" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </ui:DynamicScrollViewer>
    </Grid>
</Page>
