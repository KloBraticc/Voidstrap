<ui:UiPage x:Class="Voidstrap.UI.Elements.Settings.Pages.ModPacksPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:util="clr-namespace:Voidstrap.Utility" xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:converters="clr-namespace:Voidstrap.UI.Converters" Title="{resources:Loc Ui_Mods_ModPacks}" ui:Breadcrumb.Header="{resources:Loc Ui_Mods_ModPacks}" Scrollable="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Loaded="Page_Loaded" Unloaded="Page_Unloaded">
  <ui:UiPage.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ExtensionStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ResourceDictionary>
  </ui:UiPage.Resources>
  <Grid Margin="0,4,14,14">
    <Grid Visibility="{Binding BrowseVisibility}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="300" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Grid.ColumnSpan="2" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <controls:SearchFilterBox HorizontalAlignment="Stretch" VerticalAlignment="Center" PlaceholderText="{resources:Loc Ui_Mods_SearchRobloxMods}" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
          <controls:SearchFilterBox.Filter>
            <ComboBox MinWidth="140" Style="{StaticResource SearchPillComboBox}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}" Visibility="{Binding SortVisibility}" />
          </controls:SearchFilterBox.Filter>
        </controls:SearchFilterBox>
        <Border Grid.Column="1" Width="288" Margin="12,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Stretch" Padding="4" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="139" />
              <ColumnDefinition Width="139" />
            </Grid.ColumnDefinitions>
            <Border x:Name="SourceIndicator" Grid.Column="0" CornerRadius="6" IsHitTestVisible="False" Background="{DynamicResource SystemAccentColorPrimaryBrush}" Opacity="0.45" Loaded="SourceIndicator_Loaded">
              <Border.RenderTransform>
                <TranslateTransform x:Name="SourceIndicatorShift" />
              </Border.RenderTransform>
            </Border>
            <ui:Button Grid.Column="0" Height="32" Padding="12,0" HorizontalAlignment="Stretch" Appearance="Transparent" BorderThickness="0" Background="Transparent" Tag="GameBanana" Click="CommunitySource_Click">
              <StackPanel Orientation="Horizontal">
                <Image Width="16" Height="16" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Resources/CommunityMods/GameBanana.png" />
                <TextBlock VerticalAlignment="Center" Text="GameBanana" />
              </StackPanel>
            </ui:Button>
            <ui:Button Grid.Column="1" Height="32" Padding="12,0" HorizontalAlignment="Stretch" Appearance="Transparent" BorderThickness="0" Background="Transparent" Tag="Kliko's Mods" Click="CommunitySource_Click">
              <StackPanel Orientation="Horizontal">
                <Image Width="16" Height="16" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Resources/CommunityMods/KlikosModManager.png" />
                <TextBlock VerticalAlignment="Center" Text="Kliko's Mods" />
              </StackPanel>
            </ui:Button>
          </Grid>
        </Border>
      </Grid>
      <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StatusText}" />
        <ProgressBar Width="120" Height="3" HorizontalAlignment="Right" VerticalAlignment="Center" IsIndeterminate="True" Visibility="{Binding BusyVisibility}" />
      </Grid>
      <StackPanel Grid.Row="2">
        <Border Padding="24" CornerRadius="8" Visibility="{Binding EmptyVisibility}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="{resources:Loc Ui_Mods_NoModPacksToShow}" />
            <TextBlock Margin="0,6,0,0" MaxWidth="460" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Ui_Mods_AnythingThatFailsTheRobloxAnd}" />
          </StackPanel>
        </Border>
        <Border>
          <ItemsControl ItemsSource="{Binding Mods}" Style="{StaticResource RowList}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Padding="0" Cursor="Hand" Focusable="False" HorizontalContentAlignment="Stretch" Tag="{Binding}" Click="CommunityMod_Click">
                  <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Border x:Name="Row" Padding="14,12" SnapsToDevicePixels="True" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Row" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="80" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="236" />
                    </Grid.ColumnDefinitions>
                    <Border Width="80" Height="80" VerticalAlignment="Top" CornerRadius="8" ClipToBounds="True" util:RoundedClip.Radius="8" Background="{DynamicResource ControlFillColorDefaultBrush}">
                      <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" util:DynamicRenderSystem.LazyImageSource="{Binding IconUrl, Mode=OneTime}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                      <TextBlock FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name, Mode=OneTime}" ToolTip="{Binding Name, Mode=OneTime}" />
                      <TextBlock Margin="0,3,0,0" MaxHeight="38" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Summary, Mode=OneTime}" />
                      <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <Border Width="20" Height="20" Margin="0,0,7,0" CornerRadius="10" ClipToBounds="True" util:RoundedClip.Radius="10" Background="{DynamicResource ControlFillColorDefaultBrush}">
                          <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" util:DynamicRenderSystem.LazyImageSource="{Binding AuthorAvatar, Mode=OneTime}" />
                        </Border>
                        <TextBlock MaxWidth="160" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Author, Mode=OneTime}" />
                        <TextBlock Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="&#x2022;" />
                        <ui:SymbolIcon Margin="0,0,5,0" VerticalAlignment="Center" FontSize="14" Symbol="Tag16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock MaxWidth="220" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Category, Mode=OneTime}" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,4,0" VerticalAlignment="Center" FontSize="13" Symbol="ArrowDownload16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="{Binding DownloadsCompact, Mode=OneTime}" />
                        <TextBlock Margin="7,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="&#x2022;" />
                        <ui:SymbolIcon Margin="0,0,4,0" VerticalAlignment="Center" FontSize="13" Symbol="Clock16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="{Binding UpdatedShort, Mode=OneTime}" />
                      </StackPanel>
                      <StackPanel Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:Button Height="34" Margin="0,0,6,0" Padding="12,0" Appearance="Secondary" Icon="Eye24" Content="{resources:Loc Ui_Mods_View}" Tag="{Binding}" Click="CommunityModView_Click" />
                        <ui:Button Height="34" Padding="12,0" Appearance="Primary" Icon="ArrowDownload24" Content="{resources:Loc Ui_Mods_Download}" Tag="{Binding}" Click="CommunityModInstall_Click" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        <ui:Button Margin="0,10,0,0" HorizontalAlignment="Center" Icon="ArrowDown24" Content="{resources:Loc Ui_Mods_LoadMore}" Command="{Binding LoadMoreCommand}" Visibility="{Binding HasMore, Converter={StaticResource BooleanToVisibilityConverter}}" />
      </StackPanel>
      <Border Grid.Row="2" Grid.Column="1" Margin="12,0,0,0" Padding="14" VerticalAlignment="Top" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Visibility="{Binding CategoryVisibility}">
        <StackPanel>
          <TextBlock Margin="0,0,0,10" FontSize="15" FontWeight="SemiBold" Text="{resources:Loc Ui_Mods_Categories}" />
          <ui:Button Margin="0,0,0,6" HorizontalAlignment="Stretch" Appearance="Secondary" Icon="Grid24" Content="{resources:Loc Ui_Mods_AllCategories}" Command="{Binding ClearCategoryCommand}" />
          <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid VerticalAlignment="Top" Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ui:Button Height="32" Margin="0,0,6,6" Padding="8,0" HorizontalAlignment="Stretch" FontSize="12" ToolTip="{Binding Display}" Tag="{Binding}" Click="CommunityCategoryChip_Click">
                  <ui:Button.Style>
                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                      <Setter Property="Appearance" Value="Secondary" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                          <Setter Property="Appearance" Value="Primary" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ui:Button.Style>
                  <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                </ui:Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Visibility="{Binding DetailVisibility}">
      <StackPanel>

        <Border Margin="0,0,0,10" Padding="14" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="84" Height="84" VerticalAlignment="Top" CornerRadius="12" Background="{DynamicResource ControlFillColorDefaultBrush}">
              <Border.Clip>
                <RectangleGeometry Rect="0,0,84,84" RadiusX="12" RadiusY="12" />
              </Border.Clip>
              <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" util:DynamicRenderSystem.LazyImageSource="{Binding SelectedMod.IconUrl}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
              <TextBlock FontSize="18" FontWeight="SemiBold" MaxHeight="50" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="{Binding SelectedMod.Name}" />
              <TextBlock Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="{Binding SelectedMod.CategoryDisplay, Mode=OneWay}" /><Run Text="{resources:Loc Ui_Mods_By}" /><Run Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding SelectedMod.Author, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding SelectedMod.DetailStatsDisplay, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <Border Padding="8" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" Visibility="{Binding CreatorVisibility}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="42" Height="42" Margin="0,0,9,0" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <Border.Clip>
                      <RectangleGeometry Rect="0,0,42,42" RadiusX="6" RadiusY="6" />
                    </Border.Clip>
                    <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding SelectedMod.Submitter.AvatarUrl}" />
                  </Border>
                  <StackPanel Grid.Column="1" MaxWidth="170" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding SelectedMod.Submitter.Name}" />
                    <TextBlock Margin="0,2,0,0" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SelectedMod.Submitter.Detail}" />
                    <TextBlock Margin="0,2,0,0" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SystemAccentBrush}" Text="{Binding SelectedMod.Submitter.AchievementDisplay}" />
                  </StackPanel>
                </Grid>
              </Border>
              <ui:Button Margin="0,8,0,0" HorizontalAlignment="Right" Appearance="Secondary" Icon="Open24" Content="{resources:Loc Ui_Mods_Page}" ToolTip="{resources:Loc Ui_Mods_OpenTheModPage}" Command="{Binding OpenModPageCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Margin="0,0,0,12" Padding="14" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
          <StackPanel>
            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{resources:Loc Ui_Mods_Download}" />
            <ComboBox MinWidth="280" MaxWidth="460" Margin="0,8,0,0" HorizontalAlignment="Left" DisplayMemberPath="FileName" ItemsSource="{Binding DetailFiles}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}" />
            <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
              <Run Text="{Binding SelectedFile.SizeDisplay, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding InstallTargetHint, Mode=OneWay}" />
            </TextBlock>
            <WrapPanel Margin="0,10,0,0">
              <ui:Button Height="36" Margin="0,0,8,0" Padding="16,0" Appearance="Primary" Icon="ArrowDownload24" Content="{resources:Loc Ui_Mods_ApplyToMyMods}" IsEnabled="{Binding CanInstall}" Command="{Binding InstallCommand}" Visibility="{Binding ManagedInstallVisibility}" />
              <ui:Button Height="36" Padding="16,0" Appearance="Primary" Icon="ArrowDownload24" Content="{resources:Loc Ui_Mods_ApplyForFleasion}" IsEnabled="{Binding CanInstall}" Command="{Binding InstallFleasionCommand}" Visibility="{Binding FleasionInstallVisibility}" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <TabControl>
          <TabItem Header="{resources:Loc Ui_Pages_Description}">
            <StackPanel Margin="12,12,12,4">
              <ItemsControl ItemsSource="{Binding DetailParagraphs}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <controls:MarkdownTextBlock Margin="0,0,0,10" FontSize="14" LineHeight="22" TextWrapping="Wrap" MarkdownText="{Binding Mode=OneTime}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Visibility="{Binding GameBananaDetailVisibility}">
                <TextBlock Margin="0,10,0,6" FontSize="14" FontWeight="SemiBold" Text="{resources:Loc Ui_Mods_License}" />
                <TextBlock Margin="0,0,0,10" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SelectedMod.LicenseText}" />
                <ItemsControl ItemsSource="{Binding SelectedMod.LicenseRules}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,0,8">
                        <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Group}" />
                        <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Text}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </TabItem>
          <TabItem Header="{resources:Loc Ui_Mods_Gallery}" Visibility="{Binding GalleryVisibility}">
            <ItemsControl Margin="12" ItemsSource="{Binding DetailImages}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Width="220" Margin="0,0,10,10">
                    <Border Height="138" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                      <Border.Clip>
                        <RectangleGeometry Rect="0,0,220,138" RadiusX="8" RadiusY="8" />
                      </Border.Clip>
                      <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" util:DynamicRenderSystem.LazyImageSource="{Binding Thumbnail, Mode=OneTime}" />
                    </Border>
                    <TextBlock Margin="2,6,0,0" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Caption, Mode=OneTime}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </TabItem>
          <TabItem Visibility="{Binding GameBananaDetailVisibility}">
            <TabItem.Header>
              <TextBlock Text="{Binding SelectedMod.CommentCount, StringFormat=Comments ({0})}" />
            </TabItem.Header>
            <StackPanel Margin="12">
              <TextBlock Margin="0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Ui_Mods_NoCommentsHaveBeenPostedYet}">
                <TextBlock.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SelectedMod.Comments.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <ItemsControl ItemsSource="{Binding SelectedMod.Comments}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,10" Padding="12" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Top" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                          <Border.Clip>
                            <RectangleGeometry Rect="0,0,40,40" RadiusX="6" RadiusY="6" />
                          </Border.Clip>
                          <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Author.AvatarUrl}" />
                        </Border>
                        <StackPanel Grid.Column="1">
                          <TextBlock TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="{Binding Author.Name, Mode=OneWay}" /><Run Text="   " /><Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Author.Detail, Mode=OneWay}" />
                          </TextBlock>
                          <TextBlock Margin="0,2,0,6" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"><Run Text="{Binding DateDisplay, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding ActivityDisplay, Mode=OneWay}" /></TextBlock>
                          <ItemsControl ItemsSource="{Binding Paragraphs}" Focusable="False">
                            <ItemsControl.ItemTemplate><DataTemplate><controls:MarkdownTextBlock Margin="0,0,0,6" TextWrapping="Wrap" MarkdownText="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </TabItem>
          <TabItem Visibility="{Binding GameBananaDetailVisibility}">
            <TabItem.Header><TextBlock Text="{Binding SelectedMod.UpdateCount, StringFormat=Updates ({0})}" /></TabItem.Header>
            <StackPanel Margin="12">
              <TextBlock Margin="0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Ui_Mods_NoUpdatesHaveBeenPublished}">
                <TextBlock.Style><Style TargetType="{x:Type TextBlock}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedMod.Updates.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
              <ItemsControl ItemsSource="{Binding SelectedMod.Updates}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,10" Padding="14" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                      <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Name}" />
                        <TextBlock Margin="0,3,0,8" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Detail}" />
                        <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{Binding Summary}" />
                        <ItemsControl ItemsSource="{Binding Paragraphs}" Focusable="False"><ItemsControl.ItemTemplate><DataTemplate><controls:MarkdownTextBlock Margin="0,0,0,6" TextWrapping="Wrap" MarkdownText="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Margin="0,10,0,6" FontSize="14" FontWeight="SemiBold" Text="{Binding SelectedMod.IssueCount, StringFormat=Issues ({0})}" />
              <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Ui_Mods_NoIssuesAreCurrentlyListed}">
                <TextBlock.Style><Style TargetType="{x:Type TextBlock}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedMod.Issues.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
              <ItemsControl ItemsSource="{Binding SelectedMod.Issues}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,10" Padding="14" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                      <StackPanel>
                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Name}" />
                        <TextBlock Margin="0,3,0,8" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"><Run Text="{Binding Status, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding DateDisplay, Mode=OneWay}" /></TextBlock>
                        <ItemsControl ItemsSource="{Binding Paragraphs}" Focusable="False"><ItemsControl.ItemTemplate><DataTemplate><controls:MarkdownTextBlock Margin="0,0,0,6" TextWrapping="Wrap" MarkdownText="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </TabItem>
        </TabControl>
      </StackPanel>
    </Grid>
  </Grid>
</ui:UiPage>
