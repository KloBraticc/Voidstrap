<Page x:Class="Voidstrap.UI.Elements.Settings.Pages.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls" xmlns:settings="clr-namespace:Voidstrap.UI.ViewModels.Settings" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:models="clr-namespace:Voidstrap.UI.ViewModels" Title="History" xmlns:pages="clr-namespace:Voidstrap.UI.Elements.Settings.Pages">
  <Grid Margin="0,0,28,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Continue where you left off" />
      <ui:Button Grid.Column="1" Content="Refresh" Appearance="Secondary" Command="{Binding RefreshCommand}" />
      <ui:Button Grid.Column="3" Content="Clear All" Appearance="Secondary" Command="{Binding ClearCommand}" />
    </Grid>
    <ui:TextBox Grid.Row="2" Margin="0,0,0,8" Padding="10,5,10,5" Icon="Search24" PlaceholderText="Search by game name, creator, or place ID..." Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock Grid.Row="1" Foreground="#FFFF0000" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap" Text="{Binding Error}">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type TextBlock}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Value="" Binding="{Binding Error}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </TextBlock>
    <Grid Row="3">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ui:SymbolIcon Symbol="History24" FontSize="52" Opacity="0.25" HorizontalAlignment="Center" />
        <TextBlock Text="No history yet" FontSize="16" Opacity="0.5" Margin="0,12,0,4" HorizontalAlignment="Center" />
        <TextBlock Text="Games you play will appear here." Opacity="0.4" FontSize="12" HorizontalAlignment="Center" />
      </StackPanel>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ui:SymbolIcon Symbol="Search24" FontSize="52" Opacity="0.25" HorizontalAlignment="Center" />
        <TextBlock Text="No matches" FontSize="16" Opacity="0.5" Margin="0,12,0,4" HorizontalAlignment="Center" />
        <TextBlock Text="No history entries match your search." Opacity="0.4" FontSize="12" HorizontalAlignment="Center" />
      </StackPanel>
      <ui:DynamicScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
        <ItemsControl ItemsSource="{Binding FilteredHistory}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ui:Card Margin="0,0,10,10" Padding="0" Width="200">
                <StackPanel>
                  <Border Height="112" CornerRadius="8,8,0,0" ClipToBounds="True" Background="#1AFFFFFF">
                    <Grid>
                      <ui:SymbolIcon Symbol="Games28" FontSize="30" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Image Stretch="UniformToFill" Source="{Binding ThumbnailUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type Image}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                              <DataTrigger Value="False" Binding="{Binding HasThumbnail}">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </Image>
                    </Grid>
                  </Border>
                  <StackPanel Margin="12,8,12,0">
                    <TextBlock FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip="{Binding Name}" />
                    <TextBlock FontSize="11" Opacity="0.6" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Text="{Binding CreatorName}">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type TextBlock}">
                          <Setter Property="Visibility" Value="Visible" />
                          <Style.Triggers>
                            <DataTrigger Value="" Binding="{Binding CreatorName}">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                      <ui:SymbolIcon Symbol="ThumbLike24" FontSize="14" Opacity="0.75" VerticalAlignment="Center" />
                      <TextBlock FontSize="12" Margin="4,0,12,0" Opacity="0.75" VerticalAlignment="Center" Text="{Binding LikePercent}" />
                      <ui:SymbolIcon Symbol="People24" FontSize="14" Opacity="0.75" VerticalAlignment="Center" />
                      <TextBlock FontSize="12" Margin="4,0,0,0" Opacity="0.75" VerticalAlignment="Center" Text="{Binding PlayerCount}" />
                    </StackPanel>
                    <TextBlock FontSize="10" Opacity="0.45" Margin="0,4,0,0">
                      <Run Text="Joined: " /> <Run Text="{Binding TimeJoined, StringFormat={}{0:MMM d, yyyy  h:mm tt}, Mode=OneWay}" /></TextBlock>
                  </StackPanel>
                  <Grid Margin="12,8,12,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="6" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0" Icon="Play24" IconForeground="#FFFFFFFF" Foreground="#FFFFFFFF" Appearance="Primary" ToolTip="Play" HorizontalAlignment="Stretch" Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                    <ui:Button Grid.Column="2" Icon="Copy24" Appearance="Secondary" ToolTip="Copy game link" Command="{Binding DataContext.CopyLinkCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                  </Grid>
                  <ComboBox Margin="12,8,12,0" Padding="8,4,8,4" FontSize="12" ToolTip="Preferred server for rejoining this game" DisplayMemberPath="Display" IsEnabled="{Binding MatchmakerEnabledForGame}" ItemsSource="{Binding DatacenterOptions}" SelectedItem="{Binding SelectedDatacenter, Mode=TwoWay}" />
                  <ui:Button Margin="12,8,12,12" HorizontalAlignment="Stretch" FontSize="12" Icon="{Binding SkipMatchmakerIcon}" Content="{Binding SkipMatchmakerLabel}" ToolTip="{Binding SkipMatchmakerTooltip}" Command="{Binding ToggleSkipMatchmakerCommand}" />
                </StackPanel>
              </ui:Card>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ui:DynamicScrollViewer>
    </Grid>
  </Grid>
</Page>
