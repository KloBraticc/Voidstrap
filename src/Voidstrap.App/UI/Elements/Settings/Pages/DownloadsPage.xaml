<ui:UiPage x:Class="Voidstrap.UI.Elements.Settings.Pages.DownloadsPage" xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:util="clr-namespace:Voidstrap.Utility" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:pages="clr-namespace:Voidstrap.UI.Elements.Settings.Pages"
           xmlns:resources="clr-namespace:Voidstrap.Resources"
           Title="{resources:Loc Ui_Nav_Manager}" ui:Breadcrumb.Header="{resources:Loc Ui_Nav_Manager}" Scrollable="False">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <DataTemplate x:Key="VngOptionsTemplate">
                <StackPanel Margin="0,14,0,0">
                    <ui:ToggleSwitch Content="{resources:Loc Vng_UseForLaunches}" IsChecked="{Binding UseVng, Mode=TwoWay}" IsEnabled="{Binding CanPrimary}" />
                    <TextBlock Text="{resources:Loc Vng_UninstallWarning}" FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DataTemplate>

            <Style x:Key="InstallPillStyle" TargetType="{x:Type Border}">
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="Margin" Value="10,0,0,0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="PosterActionStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="IconForeground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="MouseOverBackground" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="AddonChipStyle" TargetType="{x:Type Button}">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="ChipBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PosterFrameStyle" TargetType="{x:Type Border}">
                <Setter Property="Height" Value="236" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PosterArtStyle" TargetType="{x:Type Grid}">
                <Setter Property="util:RoundedClip.Radius" Value="8" />
            </Style>

            <DataTemplate x:Key="PosterCardTemplate">
                <StackPanel Margin="0,0,14,18">
                    <Border Style="{StaticResource PosterFrameStyle}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCommand}" />
                        </Border.InputBindings>
                        <Grid Style="{StaticResource PosterArtStyle}">
                            <controls:LoadingShimmer Source="{Binding IconImage}" IsActive="{Binding HasPoster}" />
                            <Image x:Name="PosterBackdrop" Source="{Binding IconImage}" Stretch="UniformToFill" Opacity="0.5" RenderOptions.BitmapScalingMode="LowQuality">
                                <Image.Effect>
                                    <BlurEffect Radius="24" KernelType="Gaussian" RenderingBias="Performance" />
                                </Image.Effect>
                            </Image>
                            <Image x:Name="PosterArt" Source="{Binding IconImage}" Stretch="Uniform" Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Image Source="{Binding LogoImage}" Stretch="Uniform" MaxWidth="64" MaxHeight="64" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.7" RenderingBias="Performance" />
                                </Image.Effect>
                            </Image>
                            <Border Margin="8" Padding="6,3" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource ApplicationBackgroundBrush}" Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{resources:Loc Ui_Pages_Installed}">
                                <ui:SymbolIcon Symbol="CheckmarkCircle16" FontSize="13" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            </Border>
                            <Border Margin="8" Padding="6,3" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource ApplicationBackgroundBrush}" Visibility="{Binding UpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{resources:Loc Ui_Pages_Update}">
                                <ui:SymbolIcon Symbol="ArrowSync16" FontSize="13" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Border>
                            <ProgressBar Height="4" Margin="8" VerticalAlignment="Bottom" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                    <Grid Margin="2,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}" />
                        <ui:Button Grid.Column="1" Style="{StaticResource PosterActionStyle}" Icon="ArrowDownload24" ToolTip="{Binding PrimaryButtonText}" IsEnabled="{Binding CanPrimary}" Command="{Binding InstallCommand}" />
                    </Grid>
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding HasPoster}" Value="True">
                        <Setter TargetName="PosterBackdrop" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="PosterArt" Property="Stretch" Value="UniformToFill" />
                        <Setter TargetName="PosterArt" Property="Width" Value="NaN" />
                        <Setter TargetName="PosterArt" Property="Height" Value="NaN" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </FrameworkElement.Resources>

    <Grid Margin="0,4,0,12" SizeChanged="Root_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="DetailColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:SearchFilterBox Grid.Column="0" Grid.ColumnSpan="2" x:Name="SearchBox" TextChanged="SearchBox_TextChanged" PlaceholderText="{resources:Loc Ui_Pages_SearchYourInstalls}">
                  <controls:SearchFilterBox.Filter>
                    <ComboBox x:Name="FilterCombo" MinWidth="140" Style="{StaticResource SearchPillComboBox}" SelectedIndex="0" SelectionChanged="FilterCombo_SelectionChanged">
                    <ComboBoxItem Content="Everything" />
                    <ComboBoxItem Content="Roblox" />
                    <ComboBoxItem Content="Classic" />
                    <ComboBoxItem Content="VR" />
                    </ComboBox>
                  </controls:SearchFilterBox.Filter>
                </controls:SearchFilterBox>
                <ui:Button Grid.Column="2" Height="36" Margin="10,0,0,0" Padding="14,0" Icon="FolderOpen24" Content="{resources:Loc Ui_Pages_InstallFolder}" Appearance="Secondary" Command="{Binding OpenRootCommand}" />
            </Grid>

            <ui:DynamicScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                <StackPanel>
                    <StackPanel x:Name="RobloxSection">
                        <TextBlock Text="Roblox" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ItemsControl x:Name="RobloxItems" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource PosterCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid VerticalAlignment="Top" Columns="{Binding ClassicColumns, RelativeSource={RelativeSource AncestorType=pages:DownloadsPage}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="VrSection" Visibility="{Binding HasVr, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="VR" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,10" />
                        <ItemsControl x:Name="VrItemsList" ItemsSource="{Binding VrItems}" ItemTemplate="{StaticResource PosterCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid VerticalAlignment="Top" Columns="{Binding ClassicColumns, RelativeSource={RelativeSource AncestorType=pages:DownloadsPage}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="ClassicSection">
                        <Grid Margin="0,6,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{resources:Loc Ui_Pages_ClassicClients}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{resources:Loc Ui_Pages_Map}" FontSize="12" Opacity="0.7" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <ComboBox MinWidth="170" Padding="10,5" ItemsSource="{Binding ClientMaps}" SelectedItem="{Binding SelectedClassicMap, Mode=TwoWay}" IsEnabled="{Binding HasClientMaps}" />
                                <TextBlock Margin="12,0,32,0" VerticalAlignment="Center" FontSize="13" IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorDisabledBrush}" Text="{resources:Loc Ui_Pages_NoMapsInstalled}" Visibility="{Binding NoClientMapsVisibility}" />
                            </Grid>
                        </Grid>
                        <ItemsControl x:Name="ClassicItems" ItemsSource="{Binding ClientItems}" ItemTemplate="{StaticResource PosterCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid VerticalAlignment="Top" Columns="{Binding ClassicColumns, RelativeSource={RelativeSource AncestorType=pages:DownloadsPage}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ui:DynamicScrollViewer>
        </Grid>

        <Border x:Name="DetailPanel" Grid.Column="1" CornerRadius="12" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" Margin="0,0,0,4" Visibility="Collapsed">
            <Grid>
                <TextBlock Text="{resources:Loc Ui_Pages_PickAnInstallOnTheLeft}" FontSize="13" Opacity="0.6" Margin="24" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Grid DataContext="{Binding SelectedItem}" Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=pages:DownloadsPage}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:DynamicScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Height="150" CornerRadius="11,11,0,0" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Grid ClipToBounds="True">
                                <Grid Height="161" VerticalAlignment="Top" util:RoundedClip.Radius="11">
                                <Grid Height="150" VerticalAlignment="Top">
                                    <controls:LoadingShimmer Source="{Binding IconImage}" IsActive="{Binding HasPoster}" />
                                    <Image Source="{Binding IconImage}" Stretch="UniformToFill" Opacity="0.45" RenderOptions.BitmapScalingMode="LowQuality">
                                        <Image.Effect>
                                            <BlurEffect Radius="26" KernelType="Gaussian" RenderingBias="Performance" />
                                        </Image.Effect>
                                    </Image>
                                    <Image Source="{Binding IconImage}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Stretch" Value="Uniform" />
                                                <Setter Property="Height" Value="88" />
                                                <Setter Property="Margin" Value="0,0,0,18" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPoster}" Value="True">
                                                        <Setter Property="Stretch" Value="UniformToFill" />
                                                        <Setter Property="Height" Value="NaN" />
                                                        <Setter Property="Margin" Value="0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <Image Source="{Binding LogoImage}" Stretch="Uniform" MaxHeight="64" Margin="0,0,0,18" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.7" RenderingBias="Performance" />
                                        </Image.Effect>
                                    </Image>
                                    <Border VerticalAlignment="Bottom" Padding="12,8" CornerRadius="0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0" Color="#00000000" />
                                                <GradientStop Offset="1" Color="#C0000000" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </Grid>
                                </Grid>
                                </Grid>
                            </Border>
                            <StackPanel Margin="16,14,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Games24" FontSize="20" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Text="{Binding Subtitle}" FontSize="13" Opacity="0.7" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="20" />

                                <ContentControl Content="{Binding DataContext.VngItem, RelativeSource={RelativeSource AncestorType=pages:DownloadsPage}}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVng}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="ContentTemplate" Value="{StaticResource VngOptionsTemplate}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{resources:Loc Common_Version}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" MaxWidth="150" Padding="10,5" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding VersionText}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding VersionText}" />
                                    </Border>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SizeText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SizeText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{resources:Loc Ui_Mods_Size}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Padding="10,5" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding SizeText}" FontSize="12" />
                                    </Border>
                                </Grid>

                                <Grid Margin="0,12,0,0" Visibility="{Binding HasAddons, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{resources:Loc Ui_Pages_Addons}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="RiShadeAddonButton" Style="{StaticResource AddonChipStyle}" Click="Addon_Click" ToolTip="{resources:Loc Ui_Pages_RiShadeOpenInExtensions}" Visibility="{Binding ShowFleasion, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Image Width="20" Height="20" util:DynamicRenderSystem.LazyImageSource="https://raw.githubusercontent.com/KloBraticc/RiShade/main/Images/RiShde.png" />
                                        </Button>
                                        <Button Style="{StaticResource AddonChipStyle}" Click="Addon_Click" Tag="swifttunnel" ToolTip="SwiftTunnel" Visibility="{Binding ShowSwiftTunnel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Image Width="20" Height="20" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Voidstrap;component/Resources/AppImages/ext-swifttunnel.png" />
                                        </Button>
                                        <Button x:Name="RojoAddonButton" Style="{StaticResource AddonChipStyle}" Click="Addon_Click" ToolTip="{resources:Loc Ui_Pages_RojoOpenInExtensions}" Visibility="{Binding ShowStudioAddons, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Image Width="20" Height="20" util:DynamicRenderSystem.LazyImageSource="https://github.com/rojo-rbx.png" />
                                        </Button>
                                        <Button x:Name="StudioPluginAddonButton" Style="{StaticResource AddonChipStyle}" Margin="0" Click="Addon_Click" ToolTip="{resources:Loc Ui_Pages_VoidstrapStudioPluginOpenInExtensions}" Visibility="{Binding ShowStudioAddons, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Image Width="20" Height="20" Source="pack://application:,,,/Voidstrap.png" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Border Margin="0,14,0,0" Padding="10,8" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" ToolTip="{Binding LocationText}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="Folder24" FontSize="15" Foreground="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding LocationText}" FontSize="12" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <ui:Button Grid.Column="2" Width="26" Height="26" Padding="0" Appearance="Transparent" Icon="ArrowSwap20" FontSize="14" ToolTip="{resources:Loc Ui_Pages_ChangeInstallLocation}" Command="{Binding ChangeLocationCommand}" />
                                    </Grid>
                                </Border>

                                <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" Visibility="{Binding HasVerifyText, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="DocumentSearch24" FontSize="15" Foreground="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding VerifyText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>

                                <StackPanel Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ProgressDetail}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <ui:Button Grid.Column="1" Padding="8,3" FontSize="11" Appearance="Secondary" Content="{resources:Loc Common_Cancel}" Command="{Binding CancelCommand}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ui:DynamicScrollViewer>

                    <Grid Grid.Row="1" Margin="16,10,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Width="42" Height="42" Padding="0" Appearance="Secondary" Icon="FolderOpen24" FontSize="18" ToolTip="{resources:Loc Ui_Pages_OpenInstallFolder}" Command="{Binding OpenFolderCommand}" />
                        <ui:Button Grid.Column="2" Width="42" Height="42" Padding="0" Appearance="Secondary" Icon="DocumentSearch24" FontSize="18" ToolTip="{resources:Loc Ui_Pages_VerifyFiles}" AutomationProperties.Name="{resources:Loc Ui_Pages_VerifyFiles}" IsEnabled="{Binding CanVerify}" Command="{Binding VerifyCommand}" />
                        <ui:Button Grid.Column="4" Height="42" Icon="ArrowDownload24" FontSize="15" FontWeight="SemiBold" Appearance="Primary" Content="{Binding PrimaryButtonText}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding CanPrimary}" Command="{Binding InstallCommand}" />
                        <ui:Button Grid.Column="6" Width="42" Height="42" Padding="0" Appearance="Danger" Icon="Delete24" FontSize="18" ToolTip="{resources:Loc Uninstaller_Uninstall}" IsEnabled="{Binding CanUninstall}" Command="{Binding UninstallCommand}" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ui:UiPage>
