<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="WindowBackgroundColorPrimary">#FF2B2D30</Color>
  <Color x:Key="WindowBackgroundColorSecondary">#FF2B2D30</Color>
  <Color x:Key="WindowBackgroundColorThird">#FF2B2D30</Color>
  <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FF2B2D30" />
  <SolidColorBrush x:Key="PrimaryBackgroundColor" Color="#FF2B2D30" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF1E1F22" />
  <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF2B2D30" />
  <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF393B40" />
  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF1E1F22" />
  <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF393B40" />
  <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FF393B40" />
  <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FF393B40" />
  <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#FF2B2D30" />
  <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFDFE1E5" />
  <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFB4B8BF" />
  <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF868A91" />
  <SolidColorBrush x:Key="VsDocumentBrush" Color="#FF1E1F22" />
  <SolidColorBrush x:Key="VsToolHeaderBrush" Color="#FF2B2D30" />
  <Style x:Key="VsToolButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#FFDFE1E5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Root" Property="Background" Value="#FF393B40" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
</ResourceDictionary>
