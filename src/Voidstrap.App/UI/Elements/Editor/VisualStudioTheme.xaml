<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="WindowBackgroundColorPrimary">#FF2D2D30</Color>
  <Color x:Key="WindowBackgroundColorSecondary">#FF2D2D30</Color>
  <Color x:Key="WindowBackgroundColorThird">#FF2D2D30</Color>
  <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FF2D2D30" />
  <SolidColorBrush x:Key="PrimaryBackgroundColor" Color="#FF2D2D30" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF1E1E1E" />
  <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF252526" />
  <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF3F3F46" />
  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF1E1E1E" />
  <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF3E3E40" />
  <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FF333337" />
  <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FF3F3F46" />
  <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#FF252526" />
  <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFF1F1F1" />
  <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFD0D0D0" />
  <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF999999" />
  <SolidColorBrush x:Key="VsDocumentBrush" Color="#FF1E1E1E" />
  <SolidColorBrush x:Key="VsToolHeaderBrush" Color="#FF2D2D30" />
  <Style x:Key="VsToolButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#FFF1F1F1" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Root" Property="Background" Value="#FF3E3E40" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
</ResourceDictionary>
