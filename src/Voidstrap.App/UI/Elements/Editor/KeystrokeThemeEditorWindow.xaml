<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.Editor.KeystrokeThemeEditorWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:editor="clr-namespace:Voidstrap.UI.Elements.Editor"
                  xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base"
                  xmlns:resources="clr-namespace:Voidstrap.Resources"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
                  xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls"
                  xmlns:platform="clr-namespace:Voidstrap.UI"
                   Title="{resources:Loc Ui_Keystrokes_Editor_Title}" Width="1080" Height="720"
                   MinWidth="960" MinHeight="600" WindowStartupLocation="CenterScreen"
                   ExtendsContentIntoTitleBar="True"
                   Background="#FF2D2D30">
  <FrameworkElement.Resources>
    <ResourceDictionary Source="/Voidstrap;component/UI/Elements/Editor/VisualStudioTheme.xaml" />
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar x:Name="TitleBarControl" Icon="pack://application:,,,/Voidstrap.png"
                 Title="{resources:Loc Ui_Keystrokes_Editor_Title}" Grid.Row="0" Padding="8" />

    <Menu Grid.Row="1" Background="#FF2D2D30" Foreground="#FFF1F1F1" FontSize="12.5">
      <MenuItem Header="{resources:Loc Ui_VsEditor_File}">
        <MenuItem Header="{resources:Loc Common_Save}" Click="OnSaveClicked" />
        <MenuItem Header="{resources:Loc Ui_Keystrokes_Editor_Revert}" Click="OnRevertClicked" />
        <MenuItem Header="{resources:Loc Ui_Mcp_Connect}" Click="OnConnectAiClicked" />
        <Separator />
        <MenuItem Header="{resources:Loc Common_Close}" Click="OnCloseClicked" />
      </MenuItem>
    </Menu>

    <Border Grid.Row="2" Padding="4,2" Background="#FF2D2D30" BorderBrush="#FF3F3F46" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource VsToolButton}" ToolTip="{resources:Loc Ui_EditorSettings_Title}" Click="EditorSettings_Click"><ui:SymbolIcon Symbol="Settings24" FontSize="15" /></Button>
        <Button Style="{StaticResource VsToolButton}" ToolTip="{resources:Loc Common_Save}" Click="OnSaveClicked"><ui:SymbolIcon Symbol="Save24" FontSize="15" /></Button>
        <Button Style="{StaticResource VsToolButton}" ToolTip="{resources:Loc Ui_Keystrokes_Editor_Revert}" Click="OnRevertClicked"><ui:SymbolIcon Symbol="ArrowUndo24" FontSize="15" /></Button>
        <Button Style="{StaticResource VsToolButton}" ToolTip="{resources:Loc Ui_Mcp_Connect}" Click="OnConnectAiClicked"><ui:SymbolIcon Symbol="PlugConnected24" FontSize="15" /></Button>
      </StackPanel>
    </Border>

    <Grid Grid.Row="3" Margin="8,6,8,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="540" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="380" />
      </Grid.ColumnDefinitions>

      <TabControl x:Name="EditorTabs" Grid.Column="0" Margin="0" SelectionChanged="OnTabSelectionChanged">
        <TabItem Header="{resources:Loc Ui_Keystrokes_Editor_ThemeControls}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,8,8,0">
            <StackPanel Orientation="Vertical">
              <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_ColorsAndBrushes}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_KeyBg}" VerticalAlignment="Center" />
                    <Button x:Name="BtnKeyBg" Grid.Column="1" Width="110" Click="OnPickKeyBgClicked" />
                  </Grid>

                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_KeyPressedBg}" VerticalAlignment="Center" />
                    <Button x:Name="BtnKeyPressedBg" Grid.Column="1" Width="110" Click="OnPickKeyPressedBgClicked" />
                  </Grid>

                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_KeyText}" VerticalAlignment="Center" />
                    <Button x:Name="BtnKeyText" Grid.Column="1" Width="110" Click="OnPickKeyTextClicked" />
                  </Grid>

                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_KeyPressedText}" VerticalAlignment="Center" />
                    <Button x:Name="BtnKeyPressedText" Grid.Column="1" Width="110" Click="OnPickKeyPressedTextClicked" />
                  </Grid>

                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_CpsText}" VerticalAlignment="Center" />
                    <Button x:Name="BtnCpsText" Grid.Column="1" Width="110" Click="OnPickCpsTextClicked" />
                  </Grid>

                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_KeyPressedCpsText}" VerticalAlignment="Center" />
                    <Button x:Name="BtnKeyPressedCpsText" Grid.Column="1" Width="110" Click="OnPickKeyPressedCpsTextClicked" />
                  </Grid>

                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_BorderColor}" VerticalAlignment="Center" />
                    <Button x:Name="BtnBorderColor" Grid.Column="1" Width="110" Click="OnPickBorderColorClicked" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_Geometry}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

                  <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_BorderThickness}" VerticalAlignment="Center" />
                    <Slider x:Name="SliderBorderThickness" Grid.Column="1" Minimum="0" Maximum="4" TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnGeometryChanged" />
                    <TextBlock x:Name="TextBorderThicknessVal" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                  </Grid>

                  <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_CornerRadius}" VerticalAlignment="Center" />
                    <Slider x:Name="SliderCornerRadius" Grid.Column="1" Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnGeometryChanged" />
                    <TextBlock x:Name="TextCornerRadiusVal" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_EffectsAndTypography}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

                  <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_BackdropGlass}" VerticalAlignment="Center" />
                    <ui:ToggleSwitch x:Name="ToggleGlass" Grid.Column="1" Click="OnToggleGlassChanged" />
                  </Grid>

                  <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_PressSquashScale}" VerticalAlignment="Center" />
                    <Slider x:Name="SliderPressScale" Grid.Column="1" Minimum="85" Maximum="105" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnGeometryChanged" />
                    <TextBlock x:Name="TextPressScaleVal" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                  </Grid>

                  <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_FontFamily}" VerticalAlignment="Center" />
                    <ComboBox x:Name="ComboFontFamily" Grid.Column="1" SelectionChanged="OnFontSelectionChanged" />
                  </Grid>

                  <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_FontWeight}" VerticalAlignment="Center" />
                    <ComboBox x:Name="ComboFontWeight" Grid.Column="1" SelectionChanged="OnFontSelectionChanged" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_CustomImages}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

                  <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_KeyBackgroundImage}" Margin="0,4,0,2" />
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TextKeyBgImage" IsReadOnly="True" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" Margin="0,0,4,0" Content="{resources:Loc Common_Browse}" Click="OnBrowseKeyBgImageClicked" />
                    <ui:Button Grid.Column="2" Content="{resources:Loc Ui_Keystrokes_Editor_Clear}" Click="OnClearKeyBgImageClicked" Appearance="Secondary" />
                  </Grid>

                  <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_KeyPressedBackgroundImage}" Margin="0,4,0,2" />
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TextKeyPressedBgImage" IsReadOnly="True" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" Margin="0,0,4,0" Content="{resources:Loc Common_Browse}" Click="OnBrowseKeyPressedBgImageClicked" />
                    <ui:Button Grid.Column="2" Content="{resources:Loc Ui_Keystrokes_Editor_Clear}" Click="OnClearKeyPressedBgImageClicked" Appearance="Secondary" />
                  </Grid>

                  <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_ImageStretch}" VerticalAlignment="Center" />
                    <ComboBox x:Name="ComboImageStretch" Grid.Column="1" SelectionChanged="OnImageStretchChanged" />
                  </Grid>

                  <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_ImageOpacity}" VerticalAlignment="Center" />
                    <Slider x:Name="SliderImageOpacity" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnImageOpacityChanged" />
                    <TextBlock x:Name="TextImageOpacityVal" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_KeycapCustomizer}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

                  <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_SelectKeycap}" VerticalAlignment="Center" />
                    <ComboBox x:Name="ComboKeycapTarget" Grid.Column="1" SelectionChanged="OnKeycapTargetSelectionChanged" Margin="0,0,6,0" />
                    <ui:Button Grid.Column="2" Content="-" Click="OnRemoveKeycapClicked" Appearance="Secondary" Width="32" />
                  </Grid>

                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="New Keycap" VerticalAlignment="Center" />
                    <TextBox x:Name="TextAddKeyName" Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="2" Content="+ Add" Click="OnAddKeycapClicked" Width="70" />
                  </Grid>

                  <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Mouse Track Circle" VerticalAlignment="Center" />
                    <ui:ToggleSwitch x:Name="ToggleMouseCircle" Grid.Column="1" Click="OnToggleMouseCircleClicked" />
                  </Grid>

                  <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_KeycapImage}" Margin="0,4,0,2" />
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TextKeycapImage" IsReadOnly="True" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" Margin="0,0,4,0" Content="{resources:Loc Common_Browse}" Click="OnBrowseKeycapImageClicked" />
                    <ui:Button Grid.Column="2" Content="{resources:Loc Ui_Keystrokes_Editor_Clear}" Click="OnClearKeycapImageClicked" Appearance="Secondary" />
                  </Grid>

                  <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_KeycapPressedImage}" Margin="0,4,0,2" />
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TextKeycapPressedImage" IsReadOnly="True" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" Margin="0,0,4,0" Content="{resources:Loc Common_Browse}" Click="OnBrowseKeycapPressedImageClicked" />
                    <ui:Button Grid.Column="2" Content="{resources:Loc Ui_Keystrokes_Editor_Clear}" Click="OnClearKeycapPressedImageClicked" Appearance="Secondary" />
                  </Grid>

                  <Grid Margin="0,4,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_KeycapCustomLabel}" VerticalAlignment="Center" />
                    <TextBox x:Name="TextKeycapLabel" Grid.Column="1" TextChanged="OnKeycapLabelChanged" />
                  </Grid>

                  <Grid Margin="0,4,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_KeycapHideLabel}" VerticalAlignment="Center" />
                    <ui:ToggleSwitch x:Name="ToggleKeycapHideLabel" Grid.Column="1" Click="OnKeycapHideLabelClicked" />
                  </Grid>

                  <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_KeycapWidth}" VerticalAlignment="Center" />
                    <Slider x:Name="SliderKeycapWidth" Grid.Column="1" Minimum="0" Maximum="140" TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnKeycapGeometryChanged" />
                    <TextBlock x:Name="TextKeycapWidthVal" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                  </Grid>

                  <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_KeycapHeight}" VerticalAlignment="Center" />
                    <Slider x:Name="SliderKeycapHeight" Grid.Column="1" Minimum="0" Maximum="140" TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnKeycapGeometryChanged" />
                    <TextBlock x:Name="TextKeycapHeightVal" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                  </Grid>

                  <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{resources:Loc Ui_Keystrokes_Editor_KeycapCornerRadius}" VerticalAlignment="Center" />
                    <Slider x:Name="SliderKeycapCornerRadius" Grid.Column="1" Minimum="-1" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnKeycapGeometryChanged" />
                    <TextBlock x:Name="TextKeycapCornerRadiusVal" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="{resources:Loc Ui_Keystrokes_Editor_ThemeCode}">
          <Grid Margin="4,8,4,4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Margin="0,0,0,8" Padding="8,6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <ComboBox x:Name="ComboLanguage" Width="140" Margin="0,0,6,4" VerticalAlignment="Center"
                            SelectionChanged="OnLanguageSelectionChanged" />
                  <ui:Button Margin="0,0,6,4" Icon="Code24" Content="{resources:Loc Ui_Keystrokes_Editor_FormatJson}" Click="OnFormatCodeClicked" />
                  <ui:Button Margin="0,0,6,4" Icon="ImageAdd24" Content="{resources:Loc Ui_Keystrokes_Editor_AddImage}" Click="OnAddImageClicked" />
                  <ui:Button Margin="0,0,6,4" Icon="FolderOpen24" Content="{resources:Loc Ui_Keystrokes_Editor_OpenFolder}" Click="OnOpenFolderClicked" />
                  <ComboBox x:Name="ComboSnippets" MinWidth="130" Margin="0,0,6,4" VerticalAlignment="Center"
                            SelectionChanged="OnSnippetSelected" />
                </WrapPanel>
                <DockPanel Grid.Row="1" Margin="2,4,2,0" LastChildFill="True">
                  <TextBlock x:Name="TextCodeStatus" VerticalAlignment="Center" FontSize="11"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </DockPanel>
              </Grid>
            </Border>

            <avalonedit:TextEditor x:Name="CodeEditor" Grid.Row="1"
                                   controls:CodeEditorBehavior.Language=".json"
                                   Style="{StaticResource NewTextEditor}"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="13"
                                   ShowLineNumbers="True"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto" />

            <Grid Grid.Row="2" Margin="0,8,0,0">
              <TextBlock x:Name="TextEditorStats" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              <ui:Button Content="{resources:Loc Ui_Keystrokes_Editor_ApplyCode}"
                         Appearance="Primary" HorizontalAlignment="Right" Click="OnApplyCodeClicked" />
            </Grid>
          </Grid>
        </TabItem>
      </TabControl>

      <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1" CornerRadius="8" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Background="#141416" CornerRadius="8"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                  Padding="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Viewbox MaxWidth="360" MaxHeight="300" HorizontalAlignment="Center" VerticalAlignment="Center">
              <StackPanel x:Name="PreviewMainLayout" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="PreviewMouseCircle" Width="88" Height="88" CornerRadius="44" BorderThickness="1.25"
                        Margin="0,0,14,0" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Cursor="Hand" MouseDown="OnMouseCircleMouseDown" MouseUp="OnMouseCircleMouseUp">
                  <Ellipse x:Name="PreviewMouseDot" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel x:Name="PreviewContainer" Orientation="Vertical">
                  <StackPanel x:Name="PreviewDefaultKeysPanel" Orientation="Vertical">
                    <StackPanel x:Name="PreviewRowW" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                      <Border x:Name="PreviewKeyW" Width="46" Height="46" CornerRadius="8" BorderThickness="1"
                              Cursor="Hand" MouseDown="OnKeyMouseDown" MouseUp="OnKeyMouseUp" Tag="W">
                        <Grid>
                          <Border x:Name="PreviewHighlightW" Opacity="0" />
                          <TextBlock x:Name="PreviewTextW" Text="W" FontSize="15" FontWeight="SemiBold"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </StackPanel>

                    <StackPanel x:Name="PreviewRowASD" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                      <Border x:Name="PreviewKeyA" Width="46" Height="46" CornerRadius="8" BorderThickness="1" Margin="0,0,3,0"
                              Cursor="Hand" MouseDown="OnKeyMouseDown" MouseUp="OnKeyMouseUp" Tag="A">
                        <Grid>
                          <Border x:Name="PreviewHighlightA" Opacity="0" />
                          <TextBlock x:Name="PreviewTextA" Text="A" FontSize="15" FontWeight="SemiBold"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                      <Border x:Name="PreviewKeyS" Width="46" Height="46" CornerRadius="8" BorderThickness="1" Margin="0,0,3,0"
                              Cursor="Hand" MouseDown="OnKeyMouseDown" MouseUp="OnKeyMouseUp" Tag="S">
                        <Grid>
                          <Border x:Name="PreviewHighlightS" Opacity="0" />
                          <TextBlock x:Name="PreviewTextS" Text="S" FontSize="15" FontWeight="SemiBold"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                      <Border x:Name="PreviewKeyD" Width="46" Height="46" CornerRadius="8" BorderThickness="1"
                              Cursor="Hand" MouseDown="OnKeyMouseDown" MouseUp="OnKeyMouseUp" Tag="D">
                        <Grid>
                          <Border x:Name="PreviewHighlightD" Opacity="0" />
                          <TextBlock x:Name="PreviewTextD" Text="D" FontSize="15" FontWeight="SemiBold"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </StackPanel>

                    <StackPanel x:Name="PreviewRowMouse" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                      <Border x:Name="PreviewKeyLmb" Width="71" Height="46" CornerRadius="8" BorderThickness="1" Margin="0,0,3,0"
                              Cursor="Hand" MouseDown="OnKeyMouseDown" MouseUp="OnKeyMouseUp" Tag="LMB">
                        <Grid>
                          <Border x:Name="PreviewHighlightLmb" Opacity="0" />
                          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="PreviewTextLmb" Text="LMB" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="PreviewCpsLmb" Text="8 CPS" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0" />
                          </StackPanel>
                        </Grid>
                      </Border>
                      <Border x:Name="PreviewKeyRmb" Width="71" Height="46" CornerRadius="8" BorderThickness="1"
                              Cursor="Hand" MouseDown="OnKeyMouseDown" MouseUp="OnKeyMouseUp" Tag="RMB">
                        <Grid>
                          <Border x:Name="PreviewHighlightRmb" Opacity="0" />
                          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="PreviewTextRmb" Text="RMB" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="PreviewCpsRmb" Text="6 CPS" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </StackPanel>

                    <StackPanel x:Name="PreviewRowBottom" Orientation="Horizontal" HorizontalAlignment="Center">
                      <Border x:Name="PreviewKeyShift" Width="51" Height="34" CornerRadius="8" BorderThickness="1" Margin="0,0,3,0"
                              Cursor="Hand" MouseDown="OnKeyMouseDown" MouseUp="OnKeyMouseUp" Tag="Shift">
                        <Grid>
                          <Border x:Name="PreviewHighlightShift" Opacity="0" />
                          <TextBlock x:Name="PreviewTextShift" Text="SHIFT" FontSize="11" FontWeight="SemiBold"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                      <Border x:Name="PreviewKeySpace" Width="91" Height="34" CornerRadius="8" BorderThickness="1"
                              Cursor="Hand" MouseDown="OnKeyMouseDown" MouseUp="OnKeyMouseUp" Tag="Space">
                        <Grid>
                          <Border x:Name="PreviewHighlightSpace" Opacity="0" />
                          <TextBlock x:Name="PreviewTextSpace" Text="—" FontSize="14" FontWeight="SemiBold"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel x:Name="PreviewDynamicKeysPanel" Orientation="Vertical" Visibility="Collapsed" />
                </StackPanel>
              </StackPanel>
            </Viewbox>
          </Border>

          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <ui:Button Icon="Play24" Content="{resources:Loc Ui_Keystrokes_Editor_TestSequence}" Appearance="Secondary"
                       Click="OnTestSequenceClicked" Width="140" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="4" Background="{DynamicResource AccentFillColorDefaultBrush}" Padding="8,2">
      <TextBlock FontSize="12" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Text="{resources:Loc Ui_VsEditor_Ready}" />
    </Border>
  </Grid>
</base:WpfUiWindow>
