<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.Editor.KeystrokeThemeEditorWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base"
                  xmlns:resources="clr-namespace:Voidstrap.Resources"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
                  xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls"
                  Title="{resources:Loc Ui_Keystrokes_Editor_Title}" Width="1180" Height="760"
                  MinWidth="860" MinHeight="520" WindowStartupLocation="CenterScreen"
                  ExtendsContentIntoTitleBar="True"
                  Closing="OnWindowClosing"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
  <FrameworkElement.Resources>
    <ResourceDictionary Source="/Voidstrap;component/UI/Elements/Editor/VisualStudioTheme.xaml" />
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar x:Name="TitleBarControl" Icon="pack://application:,,,/Voidstrap.png"
                 Title="{resources:Loc Ui_Keystrokes_Editor_Title}" Grid.Row="0" Padding="8" />

    <DockPanel Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,2">
        <Button Style="{StaticResource VsToolButton}" ToolTip="{resources:Loc Ui_EditorSettings_Title}" Click="EditorSettings_Click"><ui:SymbolIcon Symbol="Settings24" FontSize="15" /></Button>
        <Button Style="{StaticResource VsToolButton}" ToolTip="{resources:Loc Common_Save}" Click="OnSaveClicked"><ui:SymbolIcon Symbol="Save24" FontSize="15" /></Button>
        <Button Style="{StaticResource VsToolButton}" ToolTip="{resources:Loc Ui_Keystrokes_Editor_Revert}" Click="OnRevertClicked"><ui:SymbolIcon Symbol="ArrowUndo24" FontSize="15" /></Button>
        <Button Style="{StaticResource VsToolButton}" ToolTip="{resources:Loc Ui_Mcp_Connect}" Click="OnConnectAiClicked"><ui:SymbolIcon Symbol="PlugConnected24" FontSize="15" /></Button>
      </StackPanel>
      <Menu Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12.5">
        <MenuItem Header="{resources:Loc Ui_VsEditor_File}">
          <MenuItem Header="{resources:Loc Common_Save}" Click="OnSaveClicked" />
          <MenuItem Header="{resources:Loc Ui_Keystrokes_Editor_Revert}" Click="OnRevertClicked" />
          <MenuItem Header="{resources:Loc Ui_Keystrokes_Editor_AddImage}" Click="OnAddImageClicked" />
          <MenuItem Header="{resources:Loc Ui_Keystrokes_Editor_OpenFolder}" Click="OnOpenFolderClicked" />
          <MenuItem Header="{resources:Loc Ui_Mcp_Connect}" Click="OnConnectAiClicked" />
          <Separator />
          <MenuItem Header="{resources:Loc Common_Close}" Click="OnCloseClicked" />
        </MenuItem>
        <MenuItem Header="{resources:Loc Ui_Keystrokes_Editor_Examples}">
          <MenuItem Header="{resources:Loc Ui_Keystrokes_Editor_ExampleClassic}" Tag="Classic" Click="OnExampleClicked" />
          <MenuItem Header="{resources:Loc Ui_Keystrokes_Editor_ExampleMinimal}" Tag="Minimal" Click="OnExampleClicked" />
          <MenuItem Header="{resources:Loc Ui_Keystrokes_Editor_ExampleMouse}" Tag="Mouse" Click="OnExampleClicked" />
          <MenuItem Header="{resources:Loc Ui_Keystrokes_Editor_ExampleCps}" Tag="Cps" Click="OnExampleClicked" />
          <MenuItem Header="{resources:Loc Ui_Keystrokes_Editor_ExampleAnimated}" Tag="Animated" Click="OnExampleClicked" />
        </MenuItem>
      </Menu>
    </DockPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="380" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="420" MinWidth="280" />
      </Grid.ColumnDefinitions>

      <avalonedit:TextEditor x:Name="CodeEditor"
                             controls:CodeEditorBehavior.Language=".js"
                             Style="{StaticResource NewTextEditor}"
                             FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                             FontSize="13"
                             ShowLineNumbers="True"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto" />

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource CardStrokeColorDefaultBrush}" />

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="4" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource VsPaneHeader}" Text="{resources:Loc Ui_Keystrokes_Editor_Preview}" />
        <Border x:Name="PreviewSurface" Grid.Row="1" Background="#141416" Focusable="True" FocusVisualStyle="{x:Null}" ClipToBounds="True"
                MouseDown="OnPreviewMouseDown" MouseUp="OnPreviewMouseUp" MouseMove="OnPreviewMouseMove" MouseWheel="OnPreviewMouseWheel"
                KeyDown="OnPreviewKeyDown" KeyUp="OnPreviewKeyUp" LostKeyboardFocus="OnPreviewLostFocus">
          <Grid>
            <TextBlock Margin="8" VerticalAlignment="Bottom" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="11" IsHitTestVisible="False"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Keystrokes_Editor_OverlayPreviewHint}" />
            <ContentPresenter x:Name="PreviewHost" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
          </Grid>
        </Border>

        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource CardStrokeColorDefaultBrush}" />

        <TextBlock Grid.Row="3" Style="{StaticResource VsPaneHeader}" Text="{resources:Loc Ui_Keystrokes_Editor_Reference}" />
        <avalonedit:TextEditor x:Name="ReferenceView" Grid.Row="4" IsReadOnly="True" Style="{StaticResource NewTextEditor}"
                               FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="11.5"
                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
      </Grid>
    </Grid>

    <Border Grid.Row="3" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="10,3">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Ui_VsEditor_Ready}" />
        <TextBlock x:Name="CaretText" Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </Grid>
    </Border>
  </Grid>
</base:WpfUiWindow>
