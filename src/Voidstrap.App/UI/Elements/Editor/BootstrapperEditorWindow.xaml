<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.Editor.BootstrapperEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base" xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dmodels="clr-namespace:Voidstrap.UI.ViewModels.Editor" xmlns:local="clr-namespace:Voidstrap.UI.Elements.Editor" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:platform="clr-namespace:Voidstrap.UI" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Closing="OnClosing" Width="1400" Height="880" MinWidth="900" MinHeight="600" ExtendsContentIntoTitleBar="True" WindowState="Maximized" WindowStartupLocation="CenterScreen" Title="{Binding Path=Title, Mode=OneTime}" Background="{ui:ThemeResource ApplicationBackgroundBrush}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="/Voidstrap;component/UI/Elements/Editor/EditorSearchResources.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="PaneCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="PaneHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ToolButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Appearance" Value="Secondary" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style TargetType="{x:Type avalonedit:LineNumberMargin}">
      <Setter Property="Margin" Value="10,0,12,0" />
      <Setter Property="TextElement.FontFamily" Value="Cascadia Mono, Consolas" />
      <Setter Property="TextElement.FontSize" Value="13" />
      <Setter Property="TextElement.FontWeight" Value="Medium" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>

  <Grid>
    <Panel.Background>
      <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
        <GradientStop Offset="0.00" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        <GradientStop Offset="0.70" Color="{DynamicResource WindowBackgroundColorSecondary}" />
        <GradientStop Offset="1.00" Color="{DynamicResource WindowBackgroundColorThird}" />
      </LinearGradientBrush>
    </Panel.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Name="RootTitleBar" Grid.Row="0" Padding="8" ForceShutdown="False" Icon="pack://application:,,,/Voidstrap.png" MinimizeToTray="False" UseSnapLayout="True" Title="{Binding Path=Title, Mode=OneTime}" />

    <Grid Grid.Row="1" Margin="14,6,14,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Name="FilesColumn" Width="260" MinWidth="190" MaxWidth="440" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Name="PreviewColumn" Width="460" MinWidth="0" MaxWidth="900" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource PaneCard}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="14,12,10,10">
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
              <ui:Button Style="{StaticResource ToolButton}" Margin="0" Icon="DocumentAdd24" ToolTip="{resources:Loc Ui_Misc_NewFile}" Click="NewFile_Click" />
              <ui:Button Style="{StaticResource ToolButton}" Icon="ArrowImport24" ToolTip="{resources:Loc Common_Import}" Click="ImportFile_Click" />
              <ui:Button Style="{StaticResource ToolButton}" Icon="FolderAdd24" ToolTip="{resources:Loc Ui_Misc_NewFolder}" Click="NewFolder_Click" />
              <ui:Button Style="{StaticResource ToolButton}" Icon="ArrowClockwise24" ToolTip="{resources:Loc Ui_Misc_Reload}" Click="RefreshFiles_Click" />
            </StackPanel>
          </Grid>

          <ListBox Name="FileList" Grid.Row="1" Margin="6,0,6,8" Background="Transparent" BorderThickness="0" SelectionChanged="FileList_SelectionChanged" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="2,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:SymbolIcon Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16" Opacity="0.75" Symbol="{Binding Path=Icon, Mode=OneWay}" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path=RelativePath, Mode=OneWay}" Text="{Binding Path=Display, Mode=OneWay}" />
                  <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Path=SizeText, Mode=OneWay}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{resources:Loc Common_Rename}" Click="RenameFile_Click" />
                <MenuItem Header="{resources:Loc Ui_Mods_Replace}" Click="ReplaceFile_Click" />
                <MenuItem Header="{resources:Loc Ui_Misc_Duplicate}" Click="DuplicateFile_Click" />
                <Separator />
                <MenuItem Header="{resources:Loc Ui_Misc_CopyThemePath}" Click="CopyThemePath_Click" />
                <MenuItem Header="{resources:Loc Ui_Misc_ShowInFolder}" Click="ShowInFolder_Click" />
                <Separator />
                <MenuItem Header="{resources:Loc Common_Delete}" Click="DeleteFile_Click" />
              </ContextMenu>
            </ListBox.ContextMenu>
          </ListBox>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

      <Border Grid.Column="2" Style="{StaticResource PaneCard}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="14,10,10,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Name="EditorFileLabel" Style="{StaticResource PaneHeader}" Text="" />
              <TextBlock Name="EditorDirtyLabel" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <ui:Button Style="{StaticResource ToolButton}" Margin="0" Icon="ArrowUndo24" ToolTip="{resources:Loc Ui_Misc_Undo}" Click="UndoEditor_Click" />
              <ui:Button Style="{StaticResource ToolButton}" Icon="ArrowRedo24" ToolTip="{resources:Loc Ui_Misc_Redo}" Click="RedoEditor_Click" />
              <ui:Button Style="{StaticResource ToolButton}" Icon="Search24" ToolTip="{resources:Loc Ui_Misc_FindInFile}" Click="FindEditor_Click" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <avalonedit:TextEditor Name="UIXML" Grid.Row="0" Margin="4,0,4,0" controls:CodeEditorBehavior.Language=".xaml" Padding="10,10" FontFamily="Cascadia Mono, Consolas" FontSize="14" ShowLineNumbers="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Style="{StaticResource NewTextEditor}" />
            <Border Grid.Row="1" Margin="4,0,4,6" Padding="12,7" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,4,4">
              <Grid>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Name="EditorPositionLabel" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Ln 1, Col 1" />
                  <TextBlock Name="EditorSelectionLabel" Margin="16,0,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="No selection" />
                  <TextBlock Margin="16,0,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Spaces: 2" />
                  <TextBlock Margin="16,0,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="XML" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <ui:Button Style="{StaticResource ToolButton}" Margin="0" Padding="5,1" Icon="Subtract24" ToolTip="{resources:Loc Ui_Main_ZoomOut}" Click="ZoomOutEditor_Click" />
                  <TextBlock Name="EditorZoomLabel" Width="42" VerticalAlignment="Center" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="100%" />
                  <ui:Button Style="{StaticResource ToolButton}" Margin="0" Padding="5,1" Icon="Add24" ToolTip="{resources:Loc Ui_Main_ZoomIn}" Click="ZoomInEditor_Click" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Name="MediaPanel" Grid.RowSpan="2" Margin="4,0,4,6" Visibility="Collapsed" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6">
              <Grid Margin="20">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="6" ClipToBounds="True">
                  <Image Name="MediaImage" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" StretchDirection="DownOnly" />
                </Border>
                <TextBlock Name="MediaInfo" Grid.Row="1" Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Grid.Row="2" Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                  <ui:Button Appearance="Primary" Icon="ArrowSwap24" Content="{resources:Loc Ui_Mods_Replace}" Click="ReplaceFile_Click" />
                  <ui:Button Margin="8,0,0,0" Appearance="Secondary" Icon="Rename24" Content="{resources:Loc Common_Rename}" Click="RenameFile_Click" />
                  <ui:Button Margin="8,0,0,0" Appearance="Secondary" Icon="Delete24" Content="{resources:Loc Common_Delete}" Click="DeleteFile_Click" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

      <Border Grid.Column="4" Style="{StaticResource PaneCard}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="14,12,10,10">
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
              <CheckBox Name="LiveToggle" Margin="0" Padding="8,0,0,0" MinWidth="0" VerticalAlignment="Center" FontSize="12" IsChecked="True" Content="{resources:Loc Ui_Misc_Live}" ToolTip="{resources:Loc Ui_Misc_RebuildWhileYouType}" />
              <ui:Button Style="{StaticResource ToolButton}" Margin="6,0,0,0" Icon="ArrowClockwise24" ToolTip="{resources:Loc Ui_Misc_RebuildNow}" Click="RefreshPreview_Click" />
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" Margin="10,0,10,10" ClipToBounds="True">
            <Grid>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Border Name="PreviewHost" Margin="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </ScrollViewer>
              <TextBlock Name="PreviewPlaceholder" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Text="{resources:Loc Ui_Misc_NothingToShowYet}" />
            </Grid>
          </Border>

          <Border Name="PreviewStatus" Grid.Row="2" Margin="10,0,10,10" Padding="12,10" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Name="PreviewStatusIcon" Margin="0,0,9,0" VerticalAlignment="Center" FontSize="16" Symbol="CheckmarkCircle24" />
                <TextBlock Name="PreviewStatusTitle" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="{resources:Loc FlagSearch_Label6}" />
              </StackPanel>
              <TextBlock Name="PreviewStatusDetail" Margin="25,5,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
              <TextBlock Name="PreviewStatusHint" Margin="25,6,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
              <ui:Button Name="PreviewGoTo" Margin="25,10,0,0" Padding="10,4" Appearance="Secondary" FontSize="12" Content="{resources:Loc Ui_Misc_GoToLine}" Visibility="Collapsed" Click="PreviewGoTo_Click" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Margin="14,10,14,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <ui:Button Appearance="Secondary" Icon="FolderOpen24" Content="{resources:Loc CustomTheme_Editor_OpenThemeDirectory}" Command="{Binding Path=OpenThemeFolderCommand, Mode=OneTime}" />
        <ui:Button Name="ExternalButton" Margin="8,0,0,0" Appearance="Secondary" Icon="Open24" Content="{resources:Loc Ui_Misc_OpenEditor}" ToolTip="{resources:Loc Ui_Misc_EditInAnotherProgramSavingThere}" Click="OpenExternal_Click" />
        <ui:Button Margin="8,0,0,0" Appearance="Secondary" Icon="PlugConnected24" Content="{resources:Loc Ui_Mcp_Connect}" ToolTip="{resources:Loc Ui_Mcp_ConnectTooltip}" Click="OnConnectAiClicked" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <ui:Button MinWidth="92" Appearance="Secondary" Content="{resources:Loc CustomTheme_Editor_Preview}" Command="{Binding Path=PreviewCommand, Mode=OneTime}" />
        <ui:Button MinWidth="92" Margin="8,0,0,0" Appearance="Primary" Content="{resources:Loc CustomTheme_Editor_Save}" Click="SaveActive_Click" />
        <ui:Button MinWidth="92" Margin="8,0,0,0" Appearance="Secondary" Content="{resources:Loc Common_Close}" IsCancel="True" />
      </StackPanel>
    </Grid>

    <ui:Snackbar Name="Snackbar" Grid.RowSpan="3" Margin="200,0,200,24" Panel.ZIndex="9" Timeout="3000">
      <Control.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Offset="0.0" Color="{DynamicResource WindowBackgroundColorPrimary}" />
          <GradientStop Offset="0.35" Color="{DynamicResource WindowBackgroundColorSecondary}" />
          <GradientStop Offset="0.75" Color="{DynamicResource WindowBackgroundColorThird}" />
          <GradientStop Offset="1.0" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        </LinearGradientBrush>
      </Control.Background>
    </ui:Snackbar>
  </Grid>
</base:WpfUiWindow>
