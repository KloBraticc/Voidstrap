<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.Editor.BootstrapperEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:editor="clr-namespace:Voidstrap.UI.Elements.Editor" xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base" xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dmodels="clr-namespace:Voidstrap.UI.ViewModels.Editor" xmlns:local="clr-namespace:Voidstrap.UI.Elements.Editor" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:platform="clr-namespace:Voidstrap.UI" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Closing="OnClosing" Width="1400" Height="880" MinWidth="900" MinHeight="600" ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterScreen" Title="{Binding Path=Title, Mode=OneTime}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="/Voidstrap;component/UI/Elements/Editor/EditorSearchResources.xaml" />
      <ResourceDictionary Source="/Voidstrap;component/UI/Elements/Editor/VisualStudioTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="PaneCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="PaneHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ToolButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Appearance" Value="Secondary" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style TargetType="{x:Type avalonedit:LineNumberMargin}">
      <Setter Property="Margin" Value="10,0,12,0" />
      <Setter Property="TextElement.FontFamily" Value="JetBrains Mono, Cascadia Mono, Consolas" />
      <Setter Property="TextElement.FontSize" Value="13" />
      <Setter Property="TextElement.FontWeight" Value="Medium" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>

  <Grid Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Name="RootTitleBar" Grid.Row="0" Padding="8,4,0,4" ForceShutdown="False" Icon="pack://application:,,,/Voidstrap.png" MinimizeToTray="False" UseSnapLayout="True" Title="{Binding Path=Title, Mode=OneTime}" />

    <DockPanel Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
    <Border DockPanel.Dock="Right" Padding="4,2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0">
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource VsToolButton}" ToolTip="{resources:Loc Ui_EditorSettings_Title}" Click="EditorSettings_Click"><ui:SymbolIcon Symbol="Settings24" FontSize="15" /></Button>
        <Button Style="{StaticResource VsToolButton}" ToolTip="{resources:Loc Ui_Misc_NewFile}" Click="NewFile_Click"><ui:SymbolIcon Symbol="DocumentAdd24" FontSize="15" /></Button>
        <Button Style="{StaticResource VsToolButton}" ToolTip="{resources:Loc Ui_Misc_NewFolder}" Click="NewFolder_Click"><ui:SymbolIcon Symbol="FolderAdd24" FontSize="15" /></Button>
        <Button Style="{StaticResource VsToolButton}" ToolTip="{resources:Loc Common_Import}" Click="ImportFile_Click"><ui:SymbolIcon Symbol="ArrowImport24" FontSize="15" /></Button>
        <Button Style="{StaticResource VsToolButton}" ToolTip="{resources:Loc CustomTheme_Editor_Save}" Click="SaveActive_Click"><ui:SymbolIcon Symbol="Save24" FontSize="15" /></Button>
        <Rectangle Width="1" Margin="4,2" Fill="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Button Style="{StaticResource VsToolButton}" ToolTip="{resources:Loc Ui_Misc_Undo}" Click="UndoEditor_Click"><ui:SymbolIcon Symbol="ArrowUndo24" FontSize="15" /></Button>
        <Button Style="{StaticResource VsToolButton}" ToolTip="{resources:Loc Ui_Misc_Redo}" Click="RedoEditor_Click"><ui:SymbolIcon Symbol="ArrowRedo24" FontSize="15" /></Button>
        <Button Style="{StaticResource VsToolButton}" ToolTip="{resources:Loc Ui_Misc_FindInFile}" Click="FindEditor_Click"><ui:SymbolIcon Symbol="Search24" FontSize="15" /></Button>
        <Rectangle Width="1" Margin="4,2" Fill="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Button Style="{StaticResource VsToolButton}" Command="{Binding Path=PreviewCommand, Mode=OneTime}"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Play24" FontSize="15" Foreground="#FF8DD28A" /><TextBlock Margin="5,0,2,0" FontSize="12" VerticalAlignment="Center" Text="{resources:Loc CustomTheme_Editor_Preview}" /></StackPanel></Button>
        <ui:Button Name="ExternalButton" Visibility="Collapsed" Click="OpenExternal_Click" />
        <Button Width="0" Height="0" Opacity="0" IsCancel="True" Focusable="False" />
      </StackPanel>
    </Border>
    <Menu Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12.5">
      <MenuItem Header="{resources:Loc Ui_VsEditor_File}">
        <MenuItem Header="{resources:Loc Ui_Misc_NewFile}" Click="NewFile_Click" />
        <MenuItem Header="{resources:Loc Ui_Misc_NewFolder}" Click="NewFolder_Click" />
        <MenuItem Header="{resources:Loc Common_Import}" Click="ImportFile_Click" />
        <Separator />
        <MenuItem Header="{resources:Loc CustomTheme_Editor_Save}" InputGestureText="Ctrl+S" Click="SaveActive_Click" />
        <Separator />
        <MenuItem Header="{resources:Loc CustomTheme_Editor_OpenThemeDirectory}" Command="{Binding Path=OpenThemeFolderCommand, Mode=OneTime}" />
        <MenuItem Header="{resources:Loc Ui_Misc_OpenEditor}" Click="OpenExternal_Click" />
        <MenuItem Header="{resources:Loc Ui_Mcp_Connect}" Click="OnConnectAiClicked" />
      </MenuItem>
      <MenuItem Header="{resources:Loc Common_Edit}">
        <MenuItem Header="{resources:Loc Ui_Misc_Undo}" InputGestureText="Ctrl+Z" Click="UndoEditor_Click" />
        <MenuItem Header="{resources:Loc Ui_Misc_Redo}" InputGestureText="Ctrl+Y" Click="RedoEditor_Click" />
        <Separator />
        <MenuItem Header="{resources:Loc Ui_Misc_FindInFile}" InputGestureText="Ctrl+F" Click="FindEditor_Click" />
      </MenuItem>
      <MenuItem Header="{resources:Loc Ui_VsEditor_View}">
        <MenuItem Header="{resources:Loc Ui_Misc_Reload}" Click="RefreshFiles_Click" />
        <MenuItem Header="{resources:Loc Ui_Main_ZoomIn}" Click="ZoomInEditor_Click" />
        <MenuItem Header="{resources:Loc Ui_Main_ZoomOut}" Click="ZoomOutEditor_Click" />
      </MenuItem>
      <MenuItem Header="{resources:Loc Ui_VsEditor_Build}">
        <MenuItem Header="{resources:Loc CustomTheme_Editor_Preview}" Command="{Binding Path=PreviewCommand, Mode=OneTime}" />
        <MenuItem Header="{resources:Loc Ui_Misc_RebuildNow}" Click="RefreshPreview_Click" />
      </MenuItem>
    </Menu>
    </DockPanel>


    <Border Grid.Row="3" Width="36" HorizontalAlignment="Left" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
      <StackPanel>
        <Button Style="{StaticResource VsToolButton}" Height="30" Margin="3,3,3,0" ToolTip="{resources:Loc Ui_VsEditor_SolutionExplorer}" Click="StripeProject_Click"><ui:SymbolIcon Symbol="Folder24" FontSize="17" /></Button>
        <Button Style="{StaticResource VsToolButton}" Height="30" Margin="3,3,3,0" ToolTip="{resources:Loc CustomTheme_Editor_Preview}" Click="StripeTool_Click"><ui:SymbolIcon Symbol="Eye24" FontSize="17" /></Button>
      </StackPanel>
    </Border>

    <Grid Grid.Row="3" Margin="36,0,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Name="ProjectColumn" Width="240" />
        <ColumnDefinition Name="ProjectSplitColumn" Width="3" />
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Name="PreviewSplitColumn" Width="3" />
        <ColumnDefinition Name="PreviewColumn" Width="380" MaxWidth="900" />
      </Grid.ColumnDefinitions>

        <Grid Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Margin="6,3" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Ui_VsEditor_SolutionExplorer}" />
          <ListBox Name="FileList" Grid.Row="1" Margin="0" FontSize="12.5" Background="Transparent" BorderThickness="0" SelectionChanged="FileList_SelectionChanged" HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Row" Background="Transparent">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Row" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="16,2,4,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:SymbolIcon Grid.Column="0" Margin="0,0,5,0" VerticalAlignment="Center" FontSize="14" Filled="True" Foreground="{Binding Path=IconBrush, Mode=OneWay}" Symbol="{Binding Path=Icon, Mode=OneWay}" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path=RelativePath, Mode=OneWay}" Text="{Binding Path=Display, Mode=OneWay}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{resources:Loc Common_Rename}" Click="RenameFile_Click" />
                <MenuItem Header="{resources:Loc Ui_Mods_Replace}" Click="ReplaceFile_Click" />
                <MenuItem Header="{resources:Loc Ui_Misc_Duplicate}" Click="DuplicateFile_Click" />
                <Separator />
                <MenuItem Header="{resources:Loc Ui_Misc_CopyThemePath}" Click="CopyThemePath_Click" />
                <MenuItem Header="{resources:Loc Ui_Misc_ShowInFolder}" Click="ShowInFolder_Click" />
                <Separator />
                <MenuItem Header="{resources:Loc Common_Delete}" Click="DeleteFile_Click" />
              </ContextMenu>
            </ListBox.ContextMenu>
          </ListBox>
        </Grid>

      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource CardStrokeColorDefaultBrush}" />

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
          <Border HorizontalAlignment="Left" Padding="10,4" BorderThickness="0,0,0,3" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Name="EditorFileLabel" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="" />
              <TextBlock Name="EditorDirtyLabel" Margin="6,0,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="" />
            </StackPanel>
          </Border>
        </Border>
        <Grid Grid.Row="1" Background="{DynamicResource VsDocumentBrush}">
          <avalonedit:TextEditor Name="UIXML" controls:CodeEditorBehavior.Language=".xaml" Padding="4,0,0,0" FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="14" ShowLineNumbers="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Style="{StaticResource NewTextEditor}" />
          <Border Name="MediaPanel"  Visibility="Collapsed" Background="{DynamicResource ControlFillColorDefaultBrush}" >
              <Grid Margin="20">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="6" ClipToBounds="True">
                  <Image Name="MediaImage" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" StretchDirection="DownOnly" />
                </Border>
                <TextBlock Name="MediaInfo" Grid.Row="1" Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Grid.Row="2" Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                  <ui:Button Appearance="Primary" Icon="ArrowSwap24" Content="{resources:Loc Ui_Mods_Replace}" Click="ReplaceFile_Click" />
                  <ui:Button Margin="8,0,0,0" Appearance="Secondary" Icon="Rename24" Content="{resources:Loc Common_Rename}" Click="RenameFile_Click" />
                  <ui:Button Margin="8,0,0,0" Appearance="Secondary" Icon="Delete24" Content="{resources:Loc Common_Delete}" Click="DeleteFile_Click" />
                </StackPanel>
              </Grid>
            </Border>
        </Grid>
      </Grid>

      <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource CardStrokeColorDefaultBrush}" />

        <Grid Grid.Column="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel Margin="6,3">
            <CheckBox Name="LiveToggle" DockPanel.Dock="Right" MinWidth="0" Padding="6,0,0,0" FontSize="12" IsChecked="True" Content="{resources:Loc Ui_Misc_Live}" ToolTip="{resources:Loc Ui_Misc_RebuildWhileYouType}" />
            <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc CustomTheme_Editor_Preview}" />
          </DockPanel>
          <Border Grid.Row="1" ClipToBounds="True">
            <Grid>
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" SizeChanged="PreviewArea_SizeChanged">
                <Border Name="PreviewHost" Margin="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </ScrollViewer>
              <TextBlock Name="PreviewPlaceholder" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Text="{resources:Loc Ui_Misc_NothingToShowYet}" />
            </Grid>
          </Border>
          <Border Name="PreviewStatus" Grid.Row="2" Padding="8,6" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Name="PreviewStatusIcon" Margin="0,0,9,0" VerticalAlignment="Center" FontSize="16" Symbol="CheckmarkCircle24" />
                <TextBlock Name="PreviewStatusTitle" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="{resources:Loc FlagSearch_Label6}" />
              </StackPanel>
              <TextBlock Name="PreviewStatusDetail" Margin="25,5,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
              <TextBlock Name="PreviewStatusHint" Margin="25,6,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
              <ui:Button Name="PreviewGoTo" Margin="25,10,0,0" Padding="10,4" Appearance="Secondary" FontSize="12" Content="{resources:Loc Ui_Misc_GoToLine}" Visibility="Collapsed" Click="PreviewGoTo_Click" />
            </StackPanel>
          </Border>
        </Grid>
    </Grid>

    <Border Grid.Row="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="10,3">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <TextBlock Name="EditorPositionLabel" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Ln 1, Col 1" />
          <TextBlock Name="EditorSelectionLabel" Margin="16,0,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="No selection" />
          <TextBlock Margin="16,0,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="SPC" />
          <TextBlock Margin="16,0,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="XML" />
        </StackPanel>
        <TextBlock Name="EditorZoomLabel" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="100%" />
      </Grid>
    </Border>

    <ui:Snackbar Name="Snackbar" Grid.RowSpan="5" Margin="200,0,200,24" Panel.ZIndex="9" Timeout="3000">
      <Control.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Offset="0.0" Color="{DynamicResource WindowBackgroundColorPrimary}" />
          <GradientStop Offset="0.35" Color="{DynamicResource WindowBackgroundColorSecondary}" />
          <GradientStop Offset="0.75" Color="{DynamicResource WindowBackgroundColorThird}" />
          <GradientStop Offset="1.0" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        </LinearGradientBrush>
      </Control.Background>
    </ui:Snackbar>
  </Grid>
</base:WpfUiWindow>
