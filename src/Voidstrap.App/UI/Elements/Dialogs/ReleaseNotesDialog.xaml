<UserControl xmlns:resources="clr-namespace:Voidstrap.Resources" x:Class="Voidstrap.UI.Elements.Dialogs.ReleaseNotesDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="24,24,24,14">
      <TextBlock x:Name="ReleaseTitleText" Text="{resources:Loc Ui_Misc2_LoadingReleaseNotes}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="White" />
      <TextBlock x:Name="ReleaseDetailsText" Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap" Foreground="#C5FFFFFF" />
      <Border x:Name="FallbackNotice" Margin="0,12,0,0" Padding="12,9" CornerRadius="5" BorderThickness="1" Background="#10FFFFFF" BorderBrush="#12757575" Visibility="Collapsed">
        <TextBlock x:Name="FallbackNoticeText" FontSize="13" TextWrapping="Wrap" Foreground="#C5FFFFFF" />
      </Border>
    </StackPanel>
    <Border Grid.Row="1" Margin="24,0,24,24" CornerRadius="5" BorderThickness="1" Background="#0DFFFFFF" BorderBrush="#12757575">
      <Grid>
        <FlowDocumentScrollViewer x:Name="NotesViewer" Margin="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsToolBarVisible="False" />
        <ScrollViewer x:Name="NotesScroll" Margin="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
          <StackPanel x:Name="NotesPanel" Margin="18,14,18,14" />
        </ScrollViewer>
      </Grid>
    </Border>
    <Border Grid.Row="2" Background="#FF202020" BorderBrush="#12757575" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7" Padding="24">
      <UniformGrid Columns="2">
        <ui:Button x:Name="GitHubButton" Margin="0,0,4,0" Height="32" HorizontalAlignment="Stretch" Appearance="Primary" Content="{resources:Loc Ui_Misc2_ViewOnGitHub}" IsEnabled="False" />
        <ui:Button x:Name="CloseButton" Margin="4,0,0,0" Height="32" HorizontalAlignment="Stretch" Content="{resources:Loc Common_Close}" />
      </UniformGrid>
    </Border>
  </Grid>
</UserControl>
