<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.Dialogs.TextInputDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Voidstrap" Width="440" MinHeight="0" ExtendsContentIntoTitleBar="True" ResizeMode="NoResize" SizeToContent="Height" WindowStartupLocation="CenterOwner" Background="{ui:ThemeResource ApplicationBackgroundBrush}">
  <Grid>
    <Panel.Background>
      <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
        <GradientStop Offset="0.00" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        <GradientStop Offset="0.80" Color="{DynamicResource WindowBackgroundColorSecondary}" />
        <GradientStop Offset="1.10" Color="{DynamicResource WindowBackgroundColorThird}" />
      </LinearGradientBrush>
    </Panel.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Padding="8" CanMaximize="False" KeyboardNavigation.TabNavigation="None" ShowMaximize="False" ShowMinimize="False" Title="Voidstrap" />

    <StackPanel Grid.Row="1" Margin="16">
      <TextBlock Name="PromptText" Margin="0,0,0,8" TextWrapping="Wrap" />
      <TextBox Name="ValueBox" KeyDown="OnValueKeyDown" />
      <TextBlock Name="SecondPromptText" Margin="0,14,0,8" TextWrapping="Wrap" Visibility="Collapsed" />
      <TextBox Name="SecondValueBox" KeyDown="OnValueKeyDown" Visibility="Collapsed" />
    </StackPanel>

    <Border Grid.Row="2" Padding="15" Background="{DynamicResource PrimaryBackgroundColor}">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button MinWidth="100" Content="{x:Static resources:Strings.Common_OK}" Click="OnOkClicked" />
        <Button MinWidth="100" Margin="12,0,0,0" Content="{x:Static resources:Strings.Common_Cancel}" IsCancel="True" />
      </StackPanel>
    </Border>
  </Grid>
</base:WpfUiWindow>
