<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.Dialogs.KeystrokePreviewWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base"
                  xmlns:resources="clr-namespace:Voidstrap.Resources"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="{resources:Loc CustomTheme_Editor_Preview}" Width="460" Height="420"
                  MinWidth="400" MinHeight="360" ResizeMode="NoResize"
                  WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True"
                  Background="{ui:ThemeResource ApplicationBackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Icon="pack://application:,,,/Voidstrap.png"
                 Title="{resources:Loc CustomTheme_Editor_Preview}" Grid.Row="0" Padding="8"
                 CanMaximize="False" ShowMaximize="False" ShowMinimize="False" />

    <Border Grid.Row="1" Margin="16,8,16,8" Background="#141416" CornerRadius="8"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
            Padding="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Viewbox MaxWidth="360" MaxHeight="300" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel x:Name="KeysContainer" Orientation="Vertical">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
            <Border x:Name="KeyW" Width="46" Height="46" CornerRadius="8" BorderThickness="1"
                    Cursor="Hand" MouseDown="OnKeyMouseDown" MouseUp="OnKeyMouseUp" Tag="W">
              <Grid>
                <Border x:Name="HighlightW" Opacity="0" />
                <TextBlock x:Name="TextW" Text="W" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
            <Border x:Name="KeyA" Width="46" Height="46" CornerRadius="8" BorderThickness="1" Margin="0,0,3,0"
                    Cursor="Hand" MouseDown="OnKeyMouseDown" MouseUp="OnKeyMouseUp" Tag="A">
              <Grid>
                <Border x:Name="HighlightA" Opacity="0" />
                <TextBlock x:Name="TextA" Text="A" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border x:Name="KeyS" Width="46" Height="46" CornerRadius="8" BorderThickness="1" Margin="0,0,3,0"
                    Cursor="Hand" MouseDown="OnKeyMouseDown" MouseUp="OnKeyMouseUp" Tag="S">
              <Grid>
                <Border x:Name="HighlightS" Opacity="0" />
                <TextBlock x:Name="TextS" Text="S" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border x:Name="KeyD" Width="46" Height="46" CornerRadius="8" BorderThickness="1"
                    Cursor="Hand" MouseDown="OnKeyMouseDown" MouseUp="OnKeyMouseUp" Tag="D">
              <Grid>
                <Border x:Name="HighlightD" Opacity="0" />
                <TextBlock x:Name="TextD" Text="D" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
            <Border x:Name="KeyLmb" Width="71" Height="46" CornerRadius="8" BorderThickness="1" Margin="0,0,3,0"
                    Cursor="Hand" MouseDown="OnKeyMouseDown" MouseUp="OnKeyMouseUp" Tag="LMB">
              <Grid>
                <Border x:Name="HighlightLmb" Opacity="0" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock x:Name="TextLmb" Text="LMB" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock x:Name="TextCpsLmb" Text="8 CPS" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0" />
                </StackPanel>
              </Grid>
            </Border>
            <Border x:Name="KeyRmb" Width="71" Height="46" CornerRadius="8" BorderThickness="1"
                    Cursor="Hand" MouseDown="OnKeyMouseDown" MouseUp="OnKeyMouseUp" Tag="RMB">
              <Grid>
                <Border x:Name="HighlightRmb" Opacity="0" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock x:Name="TextRmb" Text="RMB" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock x:Name="TextCpsRmb" Text="6 CPS" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Border x:Name="KeyShift" Width="51" Height="34" CornerRadius="8" BorderThickness="1" Margin="0,0,3,0"
                    Cursor="Hand" MouseDown="OnKeyMouseDown" MouseUp="OnKeyMouseUp" Tag="Shift">
              <Grid>
                <Border x:Name="HighlightShift" Opacity="0" />
                <TextBlock x:Name="TextShift" Text="SHIFT" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border x:Name="KeySpace" Width="91" Height="34" CornerRadius="8" BorderThickness="1"
                    Cursor="Hand" MouseDown="OnKeyMouseDown" MouseUp="OnKeyMouseUp" Tag="Space">
              <Grid>
                <Border x:Name="HighlightSpace" Opacity="0" />
                <TextBlock x:Name="TextSpace" Text="—" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>
        </StackPanel>
      </Viewbox>
    </Border>

    <Border Grid.Row="2" Padding="16,12" Background="{DynamicResource PrimaryBackgroundColor}">
      <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
          <ui:ToggleSwitch x:Name="ToggleLoop" Content="{resources:Loc Ui_Keystrokes_Preview_Loop}" IsChecked="True" VerticalAlignment="Center" />
          <ui:ToggleSwitch x:Name="ToggleSound" Content="{resources:Loc Ui_Keystrokes_Preview_Sound}" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button MinWidth="90" Content="{resources:Loc Common_Cancel}" IsCancel="True" Click="OnCloseClicked" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</base:WpfUiWindow>
