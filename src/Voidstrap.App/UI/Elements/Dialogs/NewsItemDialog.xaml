<UserControl x:Class="Voidstrap.UI.Elements.Dialogs.NewsItemDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:conv="clr-namespace:Voidstrap.UI.Converters" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:appUi="clr-namespace:Voidstrap.UI" mc:Ignorable="d">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="White" Text="{Binding Title}" />
        <StackPanel Margin="0,6,0,12" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock FontSize="12" Foreground="#9CFFFFFF" Text="{Binding Date, StringFormat={}{0:MMMM dd, yyyy  HH:mm}}" />
          <Border Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center" CornerRadius="4" Background="{DynamicResource AccentFillColorPrimaryBrush}" Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}" appUi:LinuxTextGuard.PreserveCompactLayout="True">
            <TextBlock FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Text="{Binding AgeLabel}" />
          </Border>
        </StackPanel>
        <Border Margin="0,0,0,12" CornerRadius="5" ClipToBounds="True" HorizontalAlignment="Left" Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}">
          <Image MaxHeight="320" Stretch="Uniform" SnapsToDevicePixels="True" Source="{Binding Image, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
        </Border>
        <TextBlock FontSize="14" TextWrapping="Wrap" LineHeight="20" Foreground="#C5FFFFFF" Text="{Binding Content}" />
        <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Tags}" appUi:LinuxTextGuard.PreserveCompactLayout="True">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Margin="0,4,6,0" Padding="8,3" FontSize="12" Cursor="Hand" Foreground="{DynamicResource AccentFillColorPrimaryBrush}" Background="#10FFFFFF" BorderBrush="{DynamicResource AccentFillColorPrimaryBrush}" BorderThickness="1" Content="{Binding}" Click="TagButton_Click" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Background="#FF202020" BorderBrush="#12757575" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7" Padding="24">
      <UniformGrid Columns="2">
        <ui:Button Margin="0,0,4,0" Height="32" HorizontalAlignment="Stretch" Appearance="Primary" Content="{resources:Loc Common_CopyText}" Click="CopyText_Click" />
        <ui:Button Margin="4,0,0,0" Height="32" HorizontalAlignment="Stretch" Content="{resources:Loc Common_Close}" Click="Close_Click" />
      </UniformGrid>
    </Border>
  </Grid>
</UserControl>
