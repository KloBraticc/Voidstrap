<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.Dialogs.NewsItemDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:conv="clr-namespace:Voidstrap.UI.Converters" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="{x:Static resources:Strings.Menu_News_DialogTitle}" Width="620" Height="640" MinWidth="420" MinHeight="360" ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterOwner" xmlns:dialogs="clr-namespace:Voidstrap.UI.Elements.Dialogs" Background="{ui:ThemeResource ApplicationBackgroundBrush}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Padding="8" Title="{x:Static resources:Strings.Menu_News_DialogTitle}" Icon="pack://application:,,,/Voidstrap.png" CanMaximize="True" ShowMaximize="True" ShowMinimize="False" />
    <ScrollViewer Grid.Row="1" Margin="20,12" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" />
        <StackPanel Margin="0,4,0,12" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Date, StringFormat={}{0:MMMM dd, yyyy  HH:mm}}" />
          <Border Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center" CornerRadius="4" Background="{DynamicResource AccentFillColorPrimaryBrush}" Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
            <TextBlock FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Foreground="#FFFFFFFF" Text="{Binding AgeLabel}" />
          </Border>
        </StackPanel>
        <Image MaxHeight="320" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,12" SnapsToDevicePixels="True" Source="{Binding Image, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}" />
        <TextBlock FontSize="14" TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Content}" />
        <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Tags}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Margin="0,4,6,0" Padding="8,3" FontSize="12" Cursor="Hand" Foreground="{DynamicResource AccentFillColorPrimaryBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource AccentFillColorPrimaryBrush}" BorderThickness="1" Content="{Binding}" Click="TagButton_Click" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Padding="15" Background="{DynamicResource PrimaryBackgroundColor}">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button MinWidth="120" Margin="0,0,12,0" Content="{x:Static resources:Strings.Common_CopyText}" Click="CopyText_Click" />
        <Button MinWidth="100" Content="{x:Static resources:Strings.Common_Close}" IsCancel="True" />
      </StackPanel>
    </Border>
  </Grid>
</base:WpfUiWindow>