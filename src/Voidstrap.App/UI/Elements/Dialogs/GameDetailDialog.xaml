<UserControl x:Class="Voidstrap.UI.Elements.Dialogs.GameDetailDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" mc:Ignorable="d">
  <UserControl.Resources>
    <Style x:Key="StatLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Text" Value="--" />
    </Style>
    <Style x:Key="StatCell" TargetType="Border">
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="Padding" Value="8,12" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Height="190" ClipToBounds="True">
      <Border x:Name="BannerHost" CornerRadius="7,7,0,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
      <Border CornerRadius="7,7,0,0">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#CC000000" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="6" Icon="Dismiss24" Appearance="Secondary" ToolTip="{resources:Loc Common_Close}" Click="Close_Click" />
      <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="20,0,20,16">
        <Border Width="84" Height="84" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
          <Border x:Name="IconHost" CornerRadius="8" />
        </Border>
        <StackPanel Margin="14,0,0,2" VerticalAlignment="Bottom">
          <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="520" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Border x:Name="CreatorChip" Padding="10,4" CornerRadius="6" Background="#33FFFFFF" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Person24" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                <TextBlock x:Name="CreatorText" Margin="6,0,0,0" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                <ui:SymbolIcon x:Name="VerifiedIcon" Symbol="CheckmarkCircle24" Filled="True" FontSize="13" Margin="6,0,0,0" Foreground="{DynamicResource SystemAccentBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
              </StackPanel>
            </Border>
            <Border x:Name="GenreChip" Margin="6,0,0,0" Padding="10,4" CornerRadius="6" Background="#33FFFFFF" Visibility="Collapsed">
              <TextBlock x:Name="GenreText" FontSize="12" Foreground="White" VerticalAlignment="Center" />
            </Border>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Grid>
    <UniformGrid Grid.Row="1" Columns="4" Margin="16,16,16,0">
      <Border Style="{StaticResource StatCell}">
        <StackPanel>
          <TextBlock Style="{StaticResource StatLabel}" Text="{resources:Loc Ui_Misc2_Active}" />
          <TextBlock x:Name="ActiveText" Style="{StaticResource StatValue}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource StatCell}">
        <StackPanel>
          <TextBlock Style="{StaticResource StatLabel}" Text="{resources:Loc Ui_Pages_Visits}" />
          <TextBlock x:Name="VisitsText" Style="{StaticResource StatValue}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource StatCell}">
        <StackPanel>
          <TextBlock Style="{StaticResource StatLabel}" Text="{resources:Loc ContextMenu_GameBrowser_Favorites}" />
          <TextBlock x:Name="FavoritesText" Style="{StaticResource StatValue}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource StatCell}">
        <StackPanel>
          <TextBlock Style="{StaticResource StatLabel}" Text="{resources:Loc Ui_Pages_RATING}" />
          <TextBlock x:Name="RatingText" Style="{StaticResource StatValue}" Foreground="#FF22C55E" />
        </StackPanel>
      </Border>
    </UniformGrid>
    <DockPanel Grid.Row="2" Margin="20,18,20,8" LastChildFill="True">
      <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Icon="ArrowSync24" Content="{resources:Loc ContextMenu_ServerBrowser_Refresh}" Click="Refresh_Click" />
      <CheckBox x:Name="HideFullBox" DockPanel.Dock="Right" Margin="12,0,0,0" IsChecked="True" Content="{resources:Loc ContextMenu_ServerBrowser_ExcludeFull}" Checked="Filter_Changed" Unchecked="Filter_Changed" />
      <ComboBox x:Name="SortBox" DockPanel.Dock="Right" MinWidth="160" SelectedIndex="0" SelectionChanged="Filter_Changed">
        <ComboBoxItem Content="{resources:Loc ContextMenu_ServerBrowser_Sort_Ping}" />
        <ComboBoxItem Content="{resources:Loc ContextMenu_ServerBrowser_Sort_Population}" />
        <ComboBoxItem Content="{resources:Loc ContextMenu_ServerBrowser_Sort_Empty}" />
      </ComboBox>
      <TextBlock Text="{resources:Loc ContextMenu_ServerBrowser_Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
    </DockPanel>
    <Grid Grid.Row="3" MinHeight="180">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,0,20,8">
        <ItemsControl x:Name="ServerList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,4" Padding="14,10" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <DockPanel LastChildFill="True">
                  <ui:Button DockPanel.Dock="Right" Margin="12,0,0,0" Appearance="Primary" Icon="Play24" Content="{resources:Loc ContextMenu_ServerBrowser_Join}" Tag="{Binding}" Click="Join_Click" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Capacity}" FontSize="14" FontWeight="SemiBold" />
                    <ProgressBar Margin="0,6,0,0" Height="4" MaxWidth="260" HorizontalAlignment="Left" Width="260" Minimum="0" Maximum="100" Value="{Binding Fill, Mode=OneWay}" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding Metrics}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </Grid>
    <Border Grid.Row="4" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7" Padding="20,16">
      <UniformGrid Columns="2">
        <ui:Button Margin="0,0,4,0" Height="34" HorizontalAlignment="Stretch" Appearance="Primary" Icon="Play24" Content="{resources:Loc Ui_Home_Play}" Click="Play_Click" />
        <ui:Button Margin="4,0,0,0" Height="34" HorizontalAlignment="Stretch" Icon="Open24" Content="{resources:Loc Ui_Home_ViewGamePage}" Click="ViewPage_Click" />
      </UniformGrid>
    </Border>
  </Grid>
</UserControl>
