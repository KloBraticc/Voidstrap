<UserControl x:Class="Voidstrap.UI.Elements.Dialogs.GameDetailDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls" xmlns:conv="clr-namespace:Voidstrap.UI.Converters" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:util="clr-namespace:Voidstrap.Utility" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" mc:Ignorable="d">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Voidstrap;component/UI/Elements/Controls/ServerCardResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <Style x:Key="StatLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Text" Value="--" />
    </Style>
    <Style x:Key="StatCell" TargetType="Border">
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="Padding" Value="8,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    </Style>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Height="140" ClipToBounds="True">
      <Border x:Name="BannerHost" CornerRadius="7,7,0,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
      <Border CornerRadius="7,7,0,0">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#CC000000" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="6" Icon="Dismiss24" Appearance="Secondary" ToolTip="{resources:Loc Common_Close}" Click="Close_Click" />
      <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="20,0,20,16">
        <Border Width="84" Height="84" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
          <Border x:Name="IconHost" CornerRadius="8" />
        </Border>
        <StackPanel Margin="14,0,0,2" VerticalAlignment="Bottom">
          <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="520" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Border x:Name="CreatorChip" Padding="10,4" CornerRadius="6" Background="#33FFFFFF" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Person24" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                <TextBlock x:Name="CreatorText" Margin="6,0,0,0" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                <ui:SymbolIcon x:Name="VerifiedIcon" Symbol="CheckmarkCircle24" Filled="True" FontSize="13" Margin="6,0,0,0" Foreground="{DynamicResource SystemAccentBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
              </StackPanel>
            </Border>
            <Border x:Name="GenreChip" Margin="6,0,0,0" Padding="10,4" CornerRadius="6" Background="#33FFFFFF" Visibility="Collapsed">
              <TextBlock x:Name="GenreText" FontSize="12" Foreground="White" VerticalAlignment="Center" />
            </Border>
            <ComboBox x:Name="AccountBox" Margin="6,0,0,0" MinWidth="150" MaxWidth="220" Padding="10,3" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed" SelectionChanged="AccountBox_SelectionChanged">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Grid Width="20" Height="20" VerticalAlignment="Center">
                      <ui:SymbolIcon Symbol="PersonCircle24" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" util:DynamicRenderSystem.LazyImageSource="{Binding AvatarUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}"><Image.Clip><EllipseGeometry Center="10,10" RadiusX="10" RadiusY="10" /></Image.Clip></Image>
                    </Grid>
                    <TextBlock Margin="6,0,0,0" Text="{Binding Username}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Grid>
    <UniformGrid Grid.Row="1" Columns="4" Margin="16,12,16,0">
      <Border Style="{StaticResource StatCell}">
        <StackPanel>
          <TextBlock Style="{StaticResource StatLabel}" Text="{resources:Loc Ui_Misc2_Active}" />
          <TextBlock x:Name="ActiveText" util:CountUpText.Format="compact" Style="{StaticResource StatValue}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource StatCell}">
        <StackPanel>
          <TextBlock Style="{StaticResource StatLabel}" Text="{resources:Loc Ui_Pages_Visits}" />
          <TextBlock x:Name="VisitsText" util:CountUpText.Format="compact" Style="{StaticResource StatValue}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource StatCell}">
        <StackPanel>
          <TextBlock Style="{StaticResource StatLabel}" Text="{resources:Loc ContextMenu_GameBrowser_Favorites}" />
          <TextBlock x:Name="FavoritesText" util:CountUpText.Format="compact" Style="{StaticResource StatValue}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource StatCell}">
        <StackPanel>
          <TextBlock Style="{StaticResource StatLabel}" Text="{resources:Loc Ui_Pages_RATING}" />
          <TextBlock x:Name="RatingText" util:CountUpText.Format="percent" Style="{StaticResource StatValue}" Foreground="#FF22C55E" />
          <controls:GameVoteBar x:Name="VoteBar" Margin="0,2,0,-4" ShowRatio="False" />
        </StackPanel>
      </Border>
    </UniformGrid>
    <TabControl x:Name="Tabs" Grid.Row="2" Grid.RowSpan="2" Margin="16,8,16,8">
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Server24" Margin="0,0,6,0" />
            <TextBlock Text="{resources:Loc ContextMenu_ServerBrowser_Title}" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,10,4,8">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <ComboBox Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Stretch" SelectedIndex="{Binding Servers.SortIndex, Mode=TwoWay}" ToolTip="{resources:Loc Ui_Session_SortBy}">
                <ComboBoxItem Content="{resources:Loc ContextMenu_ServerBrowser_Sort_Population}" />
                <ComboBoxItem Content="{resources:Loc ContextMenu_ServerBrowser_Sort_Empty}" />
                <ComboBoxItem Content="{resources:Loc ContextMenu_ServerBrowser_Sort_Ping}" />
              </ComboBox>
              <ComboBox Grid.Column="1" Margin="0,0,8,0" HorizontalAlignment="Stretch" ItemsSource="{Binding Servers.Regions}" SelectedItem="{Binding Servers.SelectedRegion, Mode=TwoWay}" ToolTip="{resources:Loc Ui_Session_Region}" />
              <ui:Button Grid.Column="2" Appearance="Secondary" VerticalAlignment="Stretch" Icon="ArrowSync24" Content="{resources:Loc ContextMenu_ServerBrowser_Refresh}" Command="{Binding Servers.RefreshCommand}" />
              <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Orientation="Horizontal">
                <CheckBox MinWidth="0" MinHeight="0" Padding="8,0,0,0" VerticalAlignment="Center" VerticalContentAlignment="Center" IsChecked="{Binding Servers.HideFull, Mode=TwoWay}"><TextBlock VerticalAlignment="Center" FontSize="12" Text="{resources:Loc ContextMenu_ServerBrowser_ExcludeFull}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></CheckBox>
              </StackPanel>
              <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,10,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Text="{Binding Servers.CountText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Grid>
            <ProgressBar Height="4" Margin="0,12,0,0" IsIndeterminate="True" Visibility="{Binding Servers.PublicProgressVisibility}" />
            <TextBlock Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding Servers.PublicStatus}" Visibility="{Binding Servers.PublicStatusVisibility}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Servers.Servers}" ItemTemplate="{StaticResource ServerCardTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" Margin="0,0,-12,0" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="StarEdit24" Margin="0,0,6,0" />
            <TextBlock Text="{resources:Loc Ui_Session_CommunityRating}" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,10,4,8">
          <controls:RoReviewControl x:Name="ReviewControl" />
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="4" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7" Padding="20,16">
      <UniformGrid Columns="2">
        <ui:Button Margin="0,0,4,0" Height="34" HorizontalAlignment="Stretch" Appearance="Primary" Icon="Play24" Content="{resources:Loc Ui_Home_Play}" Click="Play_Click" />
        <ui:Button Margin="4,0,0,0" Height="34" HorizontalAlignment="Stretch" Icon="Open24" Content="{resources:Loc Ui_Home_ViewGamePage}" Click="ViewPage_Click" />
      </UniformGrid>
    </Border>
  </Grid>
</UserControl>
