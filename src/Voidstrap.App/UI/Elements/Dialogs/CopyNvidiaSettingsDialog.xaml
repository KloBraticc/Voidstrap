<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.Dialogs.CopyNvidiaSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Copy flags" Width="390" MinWidth="0" MinHeight="0"
    ExtendsContentIntoTitleBar="True" ResizeMode="NoResize" SizeToContent="Height"
    WindowStartupLocation="CenterOwner" Background="{ui:ThemeResource ApplicationBackgroundBrush}">
  <Grid>
    <Panel.Background>
      <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
        <GradientStop Offset="0.00" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        <GradientStop Offset="0.70" Color="{DynamicResource WindowBackgroundColorSecondary}" />
        <GradientStop Offset="1.00" Color="{DynamicResource WindowBackgroundColorThird}" />
      </LinearGradientBrush>
    </Panel.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Padding="8" Title="Copy flags" Icon="pack://application:,,,/Voidstrap.png" KeyboardNavigation.TabNavigation="None" CanMaximize="False" ShowMaximize="False" ShowMinimize="False" />

    <StackPanel Grid.Row="1" Margin="20,12" MaxWidth="350" HorizontalAlignment="Left">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="Copy flags" />
      <TextBlock x:Name="CountText" Margin="0,6,0,12" TextWrapping="Wrap" />
      <ComboBox x:Name="FormatBox" MinWidth="200" SelectedIndex="0" />
    </StackPanel>

    <Border Grid.Row="2" Margin="0,10,0,0" Padding="15" Background="{DynamicResource PrimaryBackgroundColor}">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button x:Name="CopyButton" MinWidth="120" Content="Copy" Click="Copy_Click" />
        <Button MinWidth="100" Margin="12,0,0,0" Content="Cancel" IsCancel="True" Click="Cancel_Click" />
      </StackPanel>
    </Border>
  </Grid>
</base:WpfUiWindow>
