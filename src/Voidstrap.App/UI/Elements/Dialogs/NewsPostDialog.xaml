<UserControl x:Class="Voidstrap.UI.Elements.Dialogs.NewsPostDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:util="clr-namespace:Voidstrap.Utility" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <DataTemplate x:Key="VoteButtons">
      <StackPanel Orientation="Horizontal" Visibility="{Binding HasVotes, Converter={StaticResource BoolToVis}}">
        <ui:Button Padding="6,3" Appearance="Transparent" Command="{Binding LikeCommand}" ToolTip="{resources:Loc Library_Vote_Like}" AutomationProperties.Name="{resources:Loc Library_Vote_Like}" Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="ThumbLike24" FontSize="14" VerticalAlignment="Center" Filled="{Binding IsLiked}">
              <ui:SymbolIcon.Style>
                <Style TargetType="{x:Type ui:SymbolIcon}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLiked}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ui:SymbolIcon.Style>
            </ui:SymbolIcon>
            <TextBlock Margin="5,0,0,0" FontSize="12" VerticalAlignment="Center" Text="{Binding LikesText}" />
          </StackPanel>
        </ui:Button>
        <ui:Button Margin="2,0,0,0" Padding="6,3" Appearance="Transparent" Command="{Binding DislikeCommand}" ToolTip="{resources:Loc Library_Vote_Dislike}" AutomationProperties.Name="{resources:Loc Library_Vote_Dislike}" Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="ThumbDislike24" FontSize="14" VerticalAlignment="Center" Filled="{Binding IsDisliked}">
              <ui:SymbolIcon.Style>
                <Style TargetType="{x:Type ui:SymbolIcon}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDisliked}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ui:SymbolIcon.Style>
            </ui:SymbolIcon>
            <TextBlock Margin="5,0,0,0" FontSize="12" VerticalAlignment="Center" Text="{Binding DislikesText}" />
          </StackPanel>
        </ui:Button>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Height="200" util:RoundedClip.Radius="7">
      <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Border Background="{DynamicResource SystemAccentBrush}" Opacity="0.6">
        <Border.OpacityMask>
          <LinearGradientBrush StartPoint="0,0.3" EndPoint="1,0.7">
            <GradientStop Offset="0" Color="#00000000" />
            <GradientStop Offset="1" Color="#FF000000" />
          </LinearGradientBrush>
        </Border.OpacityMask>
      </Border>
      <Image Stretch="UniformToFill" Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}" util:DynamicRenderSystem.LazyImageSource="{Binding Image, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
      <Border Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
            <GradientStop Offset="0" Color="#CC000000" />
            <GradientStop Offset="0.7" Color="#22000000" />
            <GradientStop Offset="1" Color="#00000000" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="6" Icon="Dismiss24" Appearance="Secondary" ToolTip="{resources:Loc Common_Close}" Click="Close_Click" />
      <StackPanel Margin="24,0,24,18" VerticalAlignment="Bottom">
        <Border HorizontalAlignment="Left" CornerRadius="10" Padding="10,3" Background="#26FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
          <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White" Text="{Binding DateText}" />
        </Border>
        <TextBlock Margin="0,10,0,0" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" Foreground="White" Text="{Binding Title}" />
      </StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="1" MaxHeight="360" Padding="24,18" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <TextBlock FontSize="14" LineHeight="22" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Body}" />
    </ScrollViewer>
    <Border Grid.Row="2" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7" Padding="20,10,20,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ContentPresenter Margin="-6,6,10,0" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}" Content="{Binding}" ContentTemplate="{StaticResource VoteButtons}" />
        <ItemsControl Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding Links}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ui:Button Margin="0,6,6,0" Height="34" Appearance="Primary" Icon="Open24" Content="{Binding Label}" Tag="{Binding Url}" Click="Link_Click" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ui:Button Grid.Column="2" Margin="8,6,0,0" Height="34" VerticalAlignment="Top" Content="{resources:Loc Common_Close}" Click="Close_Click" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
