<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.Dialogs.AccountPasswordDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:resources="clr-namespace:Voidstrap.Resources" Title="{resources:Loc Accounts_Vault_Password}" Width="400" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True">
  <Grid>
    <Panel.Background>
      <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
        <GradientStop Offset="0.00" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        <GradientStop Offset="0.80" Color="{DynamicResource WindowBackgroundColorSecondary}" />
        <GradientStop Offset="1.10" Color="{DynamicResource WindowBackgroundColorThird}" />
      </LinearGradientBrush>
    </Panel.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Padding="8" Title="{resources:Loc Accounts_Vault_Password}" CanMaximize="False" ShowMaximize="False" ShowMinimize="False" />
    <StackPanel Grid.Row="1" Margin="16,4,16,16">
      <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Accounts_Vault_Password}" />
      <PasswordBox x:Name="PasswordInput" Height="34" VerticalContentAlignment="Center" />
      <StackPanel x:Name="ConfirmPanel" Margin="0,10,0,0">
        <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Accounts_Vault_Confirm}" />
        <PasswordBox x:Name="ConfirmInput" Height="34" VerticalContentAlignment="Center" />
        <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Accounts_Vault_Hint}" />
      </StackPanel>
      <TextBlock x:Name="ErrorText" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{resources:Loc Accounts_Vault_Mismatch}" />
      <StackPanel Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
        <ui:Button Margin="0,0,8,0" Content="{resources:Loc Common_Cancel}" IsCancel="True" />
        <ui:Button Appearance="Primary" Content="{resources:Loc Common_OK}" IsDefault="True" Click="Ok_Click" />
      </StackPanel>
    </StackPanel>
  </Grid>
</base:WpfUiWindow>
