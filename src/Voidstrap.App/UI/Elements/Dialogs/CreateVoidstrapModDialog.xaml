<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.Dialogs.CreateVoidstrapModDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="{resources:Loc Ui_VoidstrapMods_CreateTitle}" Width="560" MinHeight="0" ExtendsContentIntoTitleBar="True" ResizeMode="NoResize" SizeToContent="Height" WindowStartupLocation="CenterOwner" Background="{ui:ThemeResource ApplicationBackgroundBrush}">
  <Grid>
    <Panel.Background>
      <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
        <GradientStop Offset="0.00" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        <GradientStop Offset="0.80" Color="{DynamicResource WindowBackgroundColorSecondary}" />
        <GradientStop Offset="1.10" Color="{DynamicResource WindowBackgroundColorThird}" />
      </LinearGradientBrush>
    </Panel.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Icon="pack://application:,,,/Voidstrap.png" Grid.Row="0" Padding="8" CanMaximize="False" KeyboardNavigation.TabNavigation="None" ShowMaximize="False" ShowMinimize="False" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />

    <StackPanel Grid.Row="1" Margin="16,4,16,16">
      <TextBlock Margin="0,0,0,12" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_VoidstrapMods_CreateSubtitle}" />

      <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Ui_VoidstrapMods_TemplateLabel}" />
      <ListBox x:Name="TemplateList" MaxHeight="300" Margin="0,0,0,14" SelectionChanged="TemplateList_SelectionChanged" MouseDoubleClick="TemplateList_MouseDoubleClick" />

      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Ui_VoidstrapMods_ModNameLabel}" />
          <ui:TextBox x:Name="NameBox" PlaceholderText="{resources:Loc Ui_VoidstrapMods_ModNamePlaceholder}" KeyDown="NameBox_KeyDown" TextChanged="NameBox_TextChanged" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{resources:Loc Ui_VoidstrapMods_IconLabel}" />
          <StackPanel Orientation="Horizontal">
            <Border Width="34" Height="34" Margin="0,0,8,0" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
              <Grid>
                <ui:SymbolIcon x:Name="IconPlaceholder" Symbol="PuzzlePiece24" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image x:Name="IconPreview" Width="24" Height="24" Stretch="Uniform" />
              </Grid>
            </Border>
            <ui:Button Icon="Image24" Content="{resources:Loc Ui_VoidstrapMods_ChooseIcon}" Click="ChooseIcon_Click" />
          </StackPanel>
        </StackPanel>
      </Grid>
      <TextBlock x:Name="ErrorText" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
    </StackPanel>

    <Border Grid.Row="2" Padding="15" Background="{DynamicResource PrimaryBackgroundColor}">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <ui:Button x:Name="CreateButton" MinWidth="120" Appearance="Primary" Icon="Checkmark24" Content="{resources:Loc Ui_VoidstrapMods_CreateButton}" Click="Create_Click" />
        <Button MinWidth="100" Margin="12,0,0,0" Content="{resources:Loc Common_Cancel}" IsCancel="True" />
      </StackPanel>
    </Border>
  </Grid>
</base:WpfUiWindow>
