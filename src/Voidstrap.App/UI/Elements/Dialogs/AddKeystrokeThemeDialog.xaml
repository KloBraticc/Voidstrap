<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.Dialogs.AddKeystrokeThemeDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base"
                  xmlns:resources="clr-namespace:Voidstrap.Resources"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="{resources:Loc Ui_Keystrokes_AddTheme_Title}" Width="480" MinHeight="0"
                  ExtendsContentIntoTitleBar="True" ResizeMode="NoResize"
                  SizeToContent="Height" WindowStartupLocation="CenterScreen"
                  Background="{ui:ThemeResource ApplicationBackgroundBrush}">
  <Grid>
    <Grid>
      <Panel.Background>
        <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
          <GradientStop Offset="0.00" Color="{DynamicResource WindowBackgroundColorPrimary}" />
          <GradientStop Offset="0.80" Color="{DynamicResource WindowBackgroundColorSecondary}" />
          <GradientStop Offset="1.10" Color="{DynamicResource WindowBackgroundColorThird}" />
        </LinearGradientBrush>
      </Panel.Background>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ui:TitleBar Icon="pack://application:,,,/Voidstrap.png" Title="{resources:Loc Ui_Keystrokes_AddTheme_Title}"
                   Grid.Row="0" Padding="8" CanMaximize="False"
                   KeyboardNavigation.TabNavigation="None" ShowMaximize="False" ShowMinimize="False" />
      <TabControl x:Name="Tabs" Grid.Row="1" Margin="16" SelectedIndex="0">
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Add24" Margin="0,0,6,0" />
              <TextBlock Text="{resources:Loc Common_CreateNew}" />
            </StackPanel>
          </TabItem.Header>
          <Grid Margin="16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" MinWidth="100" VerticalAlignment="Center" Text="{resources:Loc Common_Name}" />
            <ui:TextBox x:Name="ThemeNameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" />

            <TextBlock Grid.Row="1" Grid.Column="0" MinWidth="100" VerticalAlignment="Center" Text="{resources:Loc Common_Template}" />
            <ComboBox x:Name="TemplateComboBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />

            <TextBlock x:Name="ErrorText" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0" />
          </Grid>
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,6,0" />
              <TextBlock Text="{resources:Loc Common_Import}" />
            </StackPanel>
          </TabItem.Header>
          <Grid Margin="16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="ImportPathText" Grid.Row="0" FontSize="13" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,0,12" Text="{resources:Loc Ui_Keystrokes_NoFileSelected}" />
            <ui:Button Grid.Row="1" Margin="4" HorizontalAlignment="Stretch"
                       Content="{resources:Loc Common_ImportFromFile}" Icon="DocumentArrowUp16"
                       Click="OnBrowseImportClicked" />
            <TextBlock x:Name="ImportErrorText" Grid.Row="2" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0" />
          </Grid>
        </TabItem>
      </TabControl>
      <Border Grid.Row="2" Margin="0,10,0,0" Padding="15" Background="{DynamicResource PrimaryBackgroundColor}">
        <StackPanel HorizontalAlignment="Right" FlowDirection="LeftToRight" Orientation="Horizontal">
          <Button MinWidth="100" Content="{resources:Loc Common_OK}" Click="OnOkClicked" />
          <Button MinWidth="100" Margin="12,0,0,0" Content="{resources:Loc Common_Cancel}" IsCancel="True" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</base:WpfUiWindow>
