<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.Dialogs.FluentMessageBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:Voidstrap.UI.Elements.Dialogs" xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base" xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls" Title="Voidstrap" MinWidth="340" MaxWidth="640" Width="Auto" MinHeight="190" SizeToContent="Height" ResizeMode="NoResize" ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="247*" />
      <ColumnDefinition Width="213*" />
    </Grid.ColumnDefinitions>
    <Panel.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        <GradientStop Offset="0.35" Color="{DynamicResource WindowBackgroundColorSecondary}" />
        <GradientStop Offset="0.75" Color="{DynamicResource WindowBackgroundColorThird}" />
        <GradientStop Offset="1.0" Color="{DynamicResource WindowBackgroundColorPrimary}" />
      </LinearGradientBrush>
    </Panel.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Name="RootTitleBar" Padding="8" Title="Voidstrap" Icon="pack://application:,,,/Voidstrap.png" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" KeyboardNavigation.TabNavigation="None" VerticalAlignment="Center" Grid.ColumnSpan="2" />
    <Grid Row="1" Margin="22,18,22,22" ColumnSpan="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Name="IconImage" Grid.Column="0" RenderOptions.BitmapScalingMode="HighQuality" Width="34" Height="34" Margin="0,1,18,0" VerticalAlignment="Top" />
      <controls:MarkdownTextBlock x:Name="MessageTextBlock" Grid.Column="1" VerticalAlignment="Center" FontSize="14" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
    </Grid>
    <Border Grid.Row="2" Padding="18,14" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlElevationBorderBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}" Grid.ColumnSpan="2">
      <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Right">
        <ui:Button Name="ButtonOne" MinWidth="96" Height="34" HorizontalContentAlignment="Center" Appearance="Primary" Content="OK" />
        <ui:Button Name="ButtonTwo" MinWidth="96" Height="34" Margin="8,0,0,0" HorizontalContentAlignment="Center" Appearance="Secondary" Content="Cancel" />
        <ui:Button Name="ButtonThree" MinWidth="96" Height="34" Margin="8,0,0,0" HorizontalContentAlignment="Center" Appearance="Secondary" Content="Cancel" />
      </StackPanel>
    </Border>
  </Grid>
</base:WpfUiWindow>
