<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.Dialogs.ExceptionDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base"
                  xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:Voidstrap.UI.Elements.Dialogs"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:resources="clr-namespace:Voidstrap.Resources"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="{x:Static resources:Strings.Dialog_Exception_Title}"
                  Width="500" MinWidth="440" MinHeight="0"
                  ExtendsContentIntoTitleBar="True" SizeToContent="Height"
                  ResizeMode="CanResize"
                  WindowStartupLocation="CenterScreen"
                  Background="{ui:ThemeResource ApplicationBackgroundBrush}">

  <Grid>
    <Panel.Background>
      <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
        <GradientStop Offset="0.00" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        <GradientStop Offset="0.90" Color="{DynamicResource WindowBackgroundColorSecondary}" />
        <GradientStop Offset="1.05" Color="{DynamicResource WindowBackgroundColorThird}" />
      </LinearGradientBrush>
    </Panel.Background>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Name="RootTitleBar" Title="{x:Static resources:Strings.Dialog_Exception_Title}"
                 Grid.Row="0" Padding="8" CanMaximize="False"
                 KeyboardNavigation.TabNavigation="None"
                 ShowMaximize="False" ShowMinimize="False"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

    <Grid Grid.Row="1" Margin="22,6,22,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Width="28" Height="28" Margin="0,2,14,0" VerticalAlignment="Top"
               RenderOptions.BitmapScalingMode="HighQuality"
               Source="pack://application:,,,/Resources/MessageBox/Error.png" />
        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                   FontSize="19" FontWeight="SemiBold" LineHeight="26"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   Text="{x:Static resources:Strings.Dialog_Exception_Info_1}" TextWrapping="Wrap" />
      </Grid>

      <Border Grid.Row="1" Margin="0,16,0,0" CornerRadius="6"
              Background="{DynamicResource ControlFillColorPrimaryBrush}"
              BorderBrush="{DynamicResource ControlElevationBorderBrush}"
              BorderThickness="1" SnapsToDevicePixels="True">
        <RichTextBox Name="ErrorRichTextBox" MaxHeight="240" Padding="12,10"
                     Background="Transparent" BorderThickness="0"
                     FontFamily="Consolas, Courier New" FontSize="12.5"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     IsReadOnly="True" IsReadOnlyCaretVisible="False"
                     SelectionBrush="{DynamicResource SystemAccentColorSecondaryBrush}"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled">
          <FrameworkElement.Resources>
            <Style TargetType="{x:Type Paragraph}">
              <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
          </FrameworkElement.Resources>
        </RichTextBox>
      </Border>

      <controls:MarkdownTextBlock x:Name="HelpMessageMDTextBlock" Grid.Row="2" Margin="0,16,0,0"
                                  FontSize="13" LineHeight="20"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  TextWrapping="Wrap" />
    </Grid>

    <Border Grid.Row="2" Padding="18,12"
            Background="{DynamicResource ControlFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Rows="1" Columns="3" Margin="0,0,0,8">
          <ui:Button Name="ReportExceptionButton" Height="30" Margin="0,0,6,0" Padding="4,0"
                     HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                     Content="{x:Static resources:Strings.Dialog_Exception_Report}" />
          <ui:Button Name="ReportExceptionBackupButton" Height="30" Margin="0,0,6,0" Padding="4,0"
                     HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                     Content="Report on backup" />
          <ui:Button Name="LocateLogFileButton" Height="30" Padding="4,0"
                     HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                     Content="{x:Static resources:Strings.Common_OpenLogFile}" />
        </UniformGrid>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Name="VersionText" Grid.Column="0" Margin="0,0,12,0"
                     HorizontalAlignment="Left" VerticalAlignment="Center"
                     FontSize="12" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                     Text="{Binding Version, Mode=OneTime}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Name="CopyDetailsButton" Height="30" MinWidth="92" Margin="0,0,6,0" Padding="10,0"
                       HorizontalContentAlignment="Center" Icon="Copy16" Content="Copy" />
            <ui:Button Name="CloseButton" Height="30" MinWidth="92" Padding="10,0"
                       HorizontalContentAlignment="Center"
                       Appearance="Primary" Content="{x:Static resources:Strings.Common_Close}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</base:WpfUiWindow>
