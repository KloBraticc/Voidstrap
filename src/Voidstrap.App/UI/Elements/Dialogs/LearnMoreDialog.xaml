<UserControl x:Class="Voidstrap.UI.Elements.Dialogs.LearnMoreDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <UserControl.Resources>
    <Style x:Key="LinkTitle" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,14,0,0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="LinkStatus" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="LinkIcon" TargetType="Border">
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="56" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="24,22,24,24">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="{resources:Loc Ui_Home_LearnMore}" />
      <TextBlock Margin="0,4,0,18" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{resources:Loc Ui_Home_LearnMore_Description}" />
      <UniformGrid Columns="2">
        <ui:CardAction Margin="0,0,6,12" Padding="16,22" IsChevronVisible="False" HorizontalContentAlignment="Center" Tag="https://x.com/VoidstrapDev" Click="Link_Click">
          <StackPanel HorizontalAlignment="Center">
            <Border Style="{StaticResource LinkIcon}" Background="#000000" BorderBrush="#3A3A3A" BorderThickness="1">
              <Viewbox Width="26" Height="26">
                <Path Fill="White" Data="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
              </Viewbox>
            </Border>
            <TextBlock Style="{StaticResource LinkTitle}" Text="Twitter" />
            <TextBlock Style="{StaticResource LinkStatus}" Text="@VoidstrapDev" />
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction Margin="6,0,0,12" Padding="16,22" IsChevronVisible="False" HorizontalContentAlignment="Center" Tag="https://www.youtube.com/@ReallLivvyy" Click="Link_Click">
          <StackPanel HorizontalAlignment="Center">
            <Border Style="{StaticResource LinkIcon}" Background="#FF0033">
              <Viewbox Width="28" Height="28">
                <Path Fill="White" Data="M9.5 7.5v9l7.5-4.5z" />
              </Viewbox>
            </Border>
            <TextBlock Style="{StaticResource LinkTitle}" Text="YouTube" />
            <TextBlock Style="{StaticResource LinkStatus}" Text="@ReallLivvyy" />
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction Margin="0,0,6,0" Padding="16,22" IsChevronVisible="False" HorizontalContentAlignment="Center" Tag="https://discord.gg/dfA9PdWgcV" Click="Link_Click">
          <StackPanel HorizontalAlignment="Center">
            <Border Style="{StaticResource LinkIcon}" Background="#5865F2">
              <Viewbox Width="30" Height="30">
                <Path Fill="White" Data="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" />
              </Viewbox>
            </Border>
            <TextBlock Style="{StaticResource LinkTitle}" Text="Discord" />
            <TextBlock Style="{StaticResource LinkStatus}" Text="discord.gg/dfA9PdWgcV" />
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction Margin="6,0,0,0" Padding="16,22" IsChevronVisible="False" HorizontalContentAlignment="Center" Tag="https://github.com/sponsors/KloBraticc" Click="Link_Click">
          <StackPanel HorizontalAlignment="Center">
            <Border Style="{StaticResource LinkIcon}" Background="#24292F">
              <Viewbox Width="26" Height="26">
                <Path Fill="#DB61A2" Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54z" />
              </Viewbox>
            </Border>
            <TextBlock Style="{StaticResource LinkTitle}" Text="GitHub Sponsors" />
            <TextBlock Style="{StaticResource LinkStatus}" Text="KloBraticc" />
          </StackPanel>
        </ui:CardAction>
      </UniformGrid>
    </StackPanel>
    <Border Grid.Row="1" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7" Padding="24">
      <ui:Button Height="32" HorizontalAlignment="Stretch" Content="{resources:Loc Common_Close}" Click="Close_Click" />
    </Border>
  </Grid>
</UserControl>
