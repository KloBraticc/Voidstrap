<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.Dialogs.ThemeChangesDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base" Title="Changes" Width="1000" Height="680" WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" ResizeMode="CanResize">
  <Grid>
    <Panel.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        <GradientStop Offset="0.70" Color="{DynamicResource WindowBackgroundColorSecondary}" />
        <GradientStop Offset="1.0" Color="{DynamicResource WindowBackgroundColorThird}" />
      </LinearGradientBrush>
    </Panel.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Name="RootTitleBar" Padding="8" Title="Changes" ShowMinimize="False" ShowMaximize="False" />

    <StackPanel Grid.Row="1" Margin="16,4,16,10">
      <TextBlock Name="HeadingText" FontSize="18" FontWeight="Medium" />
      <TextBlock Name="SummaryText" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="2" Margin="16,0,16,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ListBox Name="FileList" Grid.Column="0" Margin="0,0,8,0" SelectionChanged="FileList_SelectionChanged">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,2,0,2">
              <TextBlock Text="{Binding Path}" FontSize="13" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding StateLabel}" FontSize="11" Foreground="{Binding StateBrush}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ListBox>

      <Border Grid.Column="1" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}" Background="#0D0D0D">
        <Grid>
          <TextBlock Name="EmptyText" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="24" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

          <ScrollViewer Name="DiffScroller" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ItemsControl Name="DiffList" Margin="0,6,0,6">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Background="{Binding RowBrush}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="46" />
                      <ColumnDefinition Width="46" />
                      <ColumnDefinition Width="18" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding OldLabel}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" Foreground="#5A5A5A" TextAlignment="Right" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding NewLabel}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" Foreground="#5A5A5A" TextAlignment="Right" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Marker}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" Foreground="{Binding TextBrush}" />
                    <TextBlock Grid.Column="3" Text="{Binding Text}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" Foreground="{Binding TextBrush}" TextWrapping="NoWrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <ScrollViewer Name="MediaScroller" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
              <TextBlock Name="MediaTitle" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" />
              <TextBlock Name="MediaSubtitle" Margin="0,4,0,12" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Name="PublishedPane" Margin="0,0,8,0">
                  <TextBlock Text="Published" FontSize="12" Foreground="#FF817A" Margin="0,0,0,6" />
                  <Border CornerRadius="4" Background="#141414" Padding="8" MinHeight="120">
                    <StackPanel>
                      <Image Name="PublishedImage" Stretch="Uniform" MaxHeight="220" Visibility="Collapsed" />
                      <TextBlock Name="PublishedFontSample" TextWrapping="Wrap" FontSize="20" Visibility="Collapsed" />
                      <TextBlock Name="PublishedInfo" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Name="LocalPane" Margin="8,0,0,0">
                  <TextBlock Text="On this PC" FontSize="12" Foreground="#7EE787" Margin="0,0,0,6" />
                  <Border CornerRadius="4" Background="#141414" Padding="8" MinHeight="120">
                    <StackPanel>
                      <Image Name="LocalImage" Stretch="Uniform" MaxHeight="220" Visibility="Collapsed" />
                      <TextBlock Name="LocalFontSample" TextWrapping="Wrap" FontSize="20" Visibility="Collapsed" />
                      <TextBlock Name="LocalInfo" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="3" Margin="16,12,16,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Name="FilesText" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <ui:Button Name="ShowAllButton" MinWidth="110" Content="Show all lines" Click="ShowAll_Click" />
        <ui:Button Name="CloseButton" MinWidth="100" Margin="10,0,0,0" Content="Close" Click="Close_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</base:WpfUiWindow>
