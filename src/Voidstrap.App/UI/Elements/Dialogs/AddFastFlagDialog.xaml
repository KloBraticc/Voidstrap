<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.Dialogs.AddFastFlagDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base" xmlns:converters="clr-namespace:Voidstrap.UI.Converters" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Voidstrap.UI.Elements.Dialogs" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="{x:Static resources:Strings.Dialog_AddFastFlag_Title}" Width="480" MinHeight="0" ExtendsContentIntoTitleBar="True" ResizeMode="NoResize" SizeToContent="Height" WindowStartupLocation="CenterScreen" Background="{ui:ThemeResource ApplicationBackgroundBrush}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:RangeConverter x:Key="ValidationConverter" From="0" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Panel.Background>
      <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
        <GradientStop Offset="0.00" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        <GradientStop Offset="0.80" Color="{DynamicResource WindowBackgroundColorSecondary}" />
        <GradientStop Offset="1.10" Color="{DynamicResource WindowBackgroundColorThird}" />
      </LinearGradientBrush>
    </Panel.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Title="{x:Static resources:Strings.Dialog_AddFastFlag_Title}" Grid.Row="0" Padding="8" CanMaximize="False" ShowMaximize="False" ShowMinimize="False" />
    <TabControl Name="Tabs" Grid.Row="1" Margin="16">
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Add24" Margin="0,0,6,0" />
            <TextBlock Text="{x:Static resources:Strings.Common_AddSingle}" />
          </StackPanel>
        </TabItem.Header>
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" MinWidth="100" Margin="0,0,0,12" VerticalAlignment="Center" Text="{x:Static resources:Strings.Common_Name}" />
          <TextBox Name="FlagNameTextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12" />
          <TextBlock Grid.Row="1" Grid.Column="0" MinWidth="100" VerticalAlignment="Center" Text="{x:Static resources:Strings.Common_Value}" />
          <TextBox Name="FlagValueTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,0" />
          <Button Grid.Row="1" Grid.Column="2" Width="30" Height="30" Padding="0" ToolTip="Select preset value" Click="PresetValuesButton_Click">
            <ui:SymbolIcon Symbol="ArrowDown24" FontSize="16" />
          </Button>
        </Grid>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Code24" Margin="0,0,6,0" />
            <TextBlock Text="{x:Static resources:Strings.Common_ImportJson}" />
          </StackPanel>
        </TabItem.Header>
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBox Name="JsonTextBox" Grid.Row="0" MinHeight="80" MaxHeight="480" Margin="5" Padding="10" AcceptsReturn="True" AcceptsTab="True" Background="#1E1E1E" BorderBrush="#333" BorderThickness="1" FontFamily="Consolas" FontSize="14" Foreground="#D4D4D4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextChanged="JsonTextBox_TextChanged" />
          <ui:Button Grid.Row="1" Margin="4" HorizontalAlignment="Stretch" Content="{x:Static resources:Strings.Common_ImportFromFile}" Icon="ArrowImport24" Click="ImportButton_Click" />
        </Grid>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Document24" Margin="0,0,6,0" />
            <TextBlock Text="Base64" />
          </StackPanel>
        </TabItem.Header>
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBox Name="Base64TextBox" Grid.Row="0" MinHeight="80" MaxHeight="480" Margin="5" Padding="10" AcceptsReturn="True" AcceptsTab="True" Background="#1E1E1E" BorderBrush="#333" BorderThickness="1" FontFamily="Consolas" FontSize="14" Foreground="#D4D4D4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
          <ui:Button Grid.Row="1" Margin="4" HorizontalAlignment="Stretch" Content="Paste Base64" Icon="Add16" Click="PasteBase64Button_Click" />
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Padding="14,10" Background="{DynamicResource PrimaryBackgroundColor}" BorderThickness="0,1,0,0">
      <StackPanel HorizontalAlignment="Right" FlowDirection="LeftToRight" Orientation="Horizontal">
        <Button MinWidth="100" Content="{x:Static resources:Strings.Common_OK}" Click="OKButton_Click">
          <FrameworkElement.Style>
            <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="0" Binding="{Binding ElementName=Tabs, Path=SelectedIndex}" />
                    <Condition Value="True" Binding="{Binding ElementName=FlagNameTextBox, Path=Text.Length, Converter={StaticResource ValidationConverter}}" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="IsEnabled" Value="True" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="1" Binding="{Binding ElementName=Tabs, Path=SelectedIndex}" />
                    <Condition Value="True" Binding="{Binding ElementName=JsonTextBox, Path=Text.Length, Converter={StaticResource ValidationConverter}}" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="IsEnabled" Value="True" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="2" Binding="{Binding ElementName=Tabs, Path=SelectedIndex}" />
                    <Condition Value="True" Binding="{Binding ElementName=Base64TextBox, Path=Text.Length, Converter={StaticResource ValidationConverter}}" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="IsEnabled" Value="True" />
                </MultiDataTrigger>
              </Style.Triggers>
              <Setter Property="IsEnabled" Value="False" />
            </Style>
          </FrameworkElement.Style>
        </Button>
        <Button MinWidth="100" Margin="12,0,0,0" Content="{x:Static resources:Strings.Common_Cancel}" IsCancel="True" />
      </StackPanel>
    </Border>
  </Grid>
</base:WpfUiWindow>