<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.Dialogs.LaunchMenuDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Voidstrap.UI.Elements.Dialogs" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:Voidstrap.UI.ViewModels" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Voidstrap" Width="580" MinWidth="0" MinHeight="0" BorderBrush="{DynamicResource SystemAccentBrush}" BorderThickness="2,2,2,2" ExtendsContentIntoTitleBar="True" ResizeMode="NoResize" SizeToContent="Height" AllowsTransparency="True" WindowBackdropType="Aero" WindowStyle="None" WindowStartupLocation="CenterScreen" Background="{ui:ThemeResource ApplicationBackgroundBrush}">
  <Grid>
    <Panel.Background>
      <LinearGradientBrush StartPoint="0,1" EndPoint="1,0" SpreadMethod="Pad">
        <GradientStop Offset="0.00" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        <GradientStop Offset="0.35" Color="{DynamicResource WindowBackgroundColorSecondary}" />
        <GradientStop Offset="0.65" Color="{DynamicResource WindowBackgroundColorSecondary}" />
        <GradientStop Offset="1.00" Color="{DynamicResource WindowBackgroundColorThird}" />
      </LinearGradientBrush>
    </Panel.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Title="Voidstrap" Grid.Row="0" Padding="8" CanMaximize="False" Icon="pack://application:,,,/Voidstrap.png" KeyboardNavigation.TabNavigation="None" ShowMaximize="False" ShowMinimize="True" />
    <Grid Name="grid" Grid.Row="1" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid HorizontalAlignment="Center" Margin="0,0,0,26">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image Grid.Column="0" Width="72" Height="72" Source="pack://application:,,,/Voidstrap.png" RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Name="LaunchTitle" Text="Voidstrap" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Margin="0,1,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Version, Mode=OneTime}" />
          </StackPanel>
        </Grid>
        <StackPanel HorizontalAlignment="Center">
          <ui:Hyperlink HorizontalAlignment="Center" Icon="QuestionCircle48" Content="{x:Static resources:Strings.About_Title}" Command="{Binding LaunchAboutCommand, Mode=OneTime}" />
          <ui:Hyperlink Margin="0,2,0,0" HorizontalAlignment="Center" Icon="Heart20" Content="Donate" NavigateUri="https://github.com/sponsors/KloBraticc" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Width="285" Margin="0,9,0,0" HorizontalAlignment="Left">
        <ui:CardAction Icon="Games28" IconFilled="False" TabIndex="0" Command="{Binding LaunchRobloxCommand, Mode=OneTime}">
          <TextBlock FontSize="14" Text="{x:Static resources:Strings.LaunchMenu_LaunchRoblox}" />
        </ui:CardAction>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ui:CardAction Grid.Column="0" Margin="0,0,4,0" Padding="13,13,13,12" IsChevronVisible="False" Icon="Settings28" TabIndex="1" Command="{Binding LaunchSettingsCommand, Mode=OneTime}">
            <TextBlock FontSize="14" TextTrimming="None" Text="Settings" />
          </ui:CardAction>
          <ui:CardAction Grid.Column="1" Margin="4,0,0,0" Padding="13,13,13,12" IsChevronVisible="False" Icon="WindowDevTools24" IconFilled="False" TabIndex="2" Command="{Binding LaunchRobloxStudioCommand, Mode=OneTime}">
            <TextBlock FontSize="14" TextTrimming="None" Text="Studio" />
          </ui:CardAction>
        </Grid>
        <ui:CardAction Margin="0,12,0,0" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://github.com/KloBraticc/Voidstrap" Icon="Code24" IconFilled="False" TabIndex="3">
          <StackPanel>
            <TextBlock FontSize="14" Text="GitHub" />
            <TextBlock Margin="0,2,0,0" Padding="0,0,16,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Releases, source and issues." />
          </StackPanel>
        </ui:CardAction>
      </StackPanel>
    </Grid>
  </Grid>
</base:WpfUiWindow>
