<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.Dialogs.LaunchMenuDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Voidstrap.UI.Elements.Dialogs" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:Voidstrap.UI.ViewModels" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:util="clr-namespace:Voidstrap.Utility" Title="{resources:Loc Enums_Theme_Voidstrap}" Width="580" MinWidth="0" MinHeight="0" BorderBrush="Transparent" BorderThickness="0" ExtendsContentIntoTitleBar="True" ResizeMode="NoResize" SizeToContent="Height" AllowsTransparency="True" WindowBackdropType="Aero" WindowStyle="None" WindowStartupLocation="CenterScreen" Background="{ui:ThemeResource ApplicationBackgroundBrush}">
  <Grid>
    <Panel.Background>
      <LinearGradientBrush StartPoint="0,1" EndPoint="1,0" SpreadMethod="Pad">
        <GradientStop Offset="0.00" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        <GradientStop Offset="0.35" Color="{DynamicResource WindowBackgroundColorSecondary}" />
        <GradientStop Offset="0.65" Color="{DynamicResource WindowBackgroundColorSecondary}" />
        <GradientStop Offset="1.00" Color="{DynamicResource WindowBackgroundColorThird}" />
      </LinearGradientBrush>
    </Panel.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Title="{resources:Loc Enums_Theme_Voidstrap}" Grid.Row="0" Padding="8" CanMaximize="False" Icon="pack://application:,,,/Voidstrap.png" KeyboardNavigation.TabNavigation="None" ShowMaximize="False" ShowMinimize="True" />
    <Grid Name="grid" Grid.Row="1" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid HorizontalAlignment="Center" Margin="0,0,0,26">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image Grid.Column="0" Width="72" Height="72" Source="pack://application:,,,/Voidstrap.png" RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Name="LaunchTitle" Text="{resources:Loc Enums_Theme_Voidstrap}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Margin="0,1,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Version, Mode=OneTime}" />
          </StackPanel>
        </Grid>
        <StackPanel HorizontalAlignment="Center">
          <ui:Hyperlink HorizontalAlignment="Center" Icon="QuestionCircle48" Content="{resources:Loc About_Title}" Command="{Binding LaunchAboutCommand, Mode=OneTime}" />
          <ui:Hyperlink Margin="0,2,0,0" HorizontalAlignment="Center" Icon="Heart20" Content="{resources:Loc Ui_Channel_Donate}" NavigateUri="https://github.com/sponsors/KloBraticc" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Width="285" Margin="0,9,0,0" HorizontalAlignment="Left">
        <Border CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" SnapsToDevicePixels="True">
          <Border.Resources>
            <Style x:Key="LaunchSplitPartStyle" TargetType="{x:Type Button}">
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="Focusable" Value="True" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Part" Background="Transparent" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Padding="{TemplateBinding Padding}">
                      <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Part" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Part" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Border.Resources>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Padding="14,12,12,12" Tag="4,0,0,4" Style="{StaticResource LaunchSplitPartStyle}" TabIndex="0" AutomationProperties.Name="{resources:Loc LaunchMenu_LaunchRoblox}" Command="{Binding LaunchRobloxCommand, Mode=OneTime}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Games28" FontSize="24" Margin="0,0,14,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock FontSize="14" Text="{resources:Loc LaunchMenu_LaunchRoblox}" />
                  <TextBlock Margin="0,2,0,0" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding SelectedTargetName, Mode=OneWay}" />
                </StackPanel>
              </StackPanel>
            </Button>
            <Rectangle Grid.Column="1" Width="1" Margin="0,10" Fill="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Button x:Name="LaunchTargetButton" Grid.Column="2" Width="44" Padding="0" Tag="0,4,4,0" Style="{StaticResource LaunchSplitPartStyle}" TabIndex="1" AutomationProperties.Name="{resources:Loc LaunchMenu_SelectVersion}" ToolTip="{resources:Loc LaunchMenu_SelectVersion}" Click="LaunchTargetButton_Click">
              <ui:SymbolIcon x:Name="LaunchTargetChevron" Symbol="ChevronDown24" FontSize="14" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <ui:SymbolIcon.RenderTransform>
                  <RotateTransform x:Name="LaunchTargetChevronRotation" Angle="0" />
                </ui:SymbolIcon.RenderTransform>
              </ui:SymbolIcon>
            </Button>
          </Grid>
        </Border>
        <Grid Margin="0,8,0,0" Height="56">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" SnapsToDevicePixels="True">
            <Button x:Name="AccountSelectorButton" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Cursor="Hand" TabIndex="2" Click="AccountSelectorButton_Click" IsEnabled="{Binding CanOpenAccounts}" ToolTip="{resources:Loc Accounts_Title}" AutomationProperties.Name="{Binding CurrentAccountTitle}">
              <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                  <Border x:Name="AccountButtonBackground" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}">
                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="AccountButtonBackground" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="AccountButtonBackground" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="AccountButtonBackground" Property="Opacity" Value="0.65" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
              <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <Grid Width="30" Height="30" VerticalAlignment="Center">
                  <Ellipse Fill="{DynamicResource ControlFillColorSecondaryBrush}" />
                  <ui:SymbolIcon Symbol="PersonCircle24" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                  <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" util:DynamicRenderSystem.LazyImageSource="{Binding CurrentAvatarUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}">
                    <Image.Clip>
                      <EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15" />
                    </Image.Clip>
                  </Image>
                </Grid>
                <StackPanel Grid.Column="1" Margin="8,0,3,0" VerticalAlignment="Center">
                  <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding CurrentAccountTitle, Mode=OneWay}" />
                  <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" Text="{Binding CurrentAccountUsername, Mode=OneWay}" Visibility="{Binding CurrentAccountUsernameVisibility}" />
                </StackPanel>
                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronUpDown20" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </Grid>
            </Button>
          </Border>
          <ui:Button Grid.Column="1" Width="56" Height="56" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Appearance="Secondary" TabIndex="3" Command="{Binding LaunchSettingsCommand, Mode=OneTime}" AutomationProperties.Name="{resources:Loc Ui_Nav_Settings}" ToolTip="{resources:Loc Ui_Nav_Settings}">
            <ui:SymbolIcon Symbol="Settings24" FontSize="24" />
          </ui:Button>
        </Grid>
        <ui:CardAction Margin="0,12,0,0" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://github.com/KloBraticc/Voidstrap" Icon="Code24" IconFilled="False" TabIndex="4">
          <StackPanel>
            <TextBlock FontSize="14" Text="GitHub" />
            <TextBlock Margin="0,2,0,0" Padding="0,0,16,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Misc2_ReleasesSourceAndIssues}" />
          </StackPanel>
        </ui:CardAction>
      </StackPanel>
    </Grid>
  </Grid>
</base:WpfUiWindow>
