<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.Dialogs.ModEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:resources="clr-namespace:Voidstrap.Resources" Title="Edit Mod" Width="780" Height="660" MinWidth="600" MinHeight="440" ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterOwner" Background="{ui:ThemeResource ApplicationBackgroundBrush}">
  <Grid>
    <Panel.Background>
      <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
        <GradientStop Offset="0.00" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        <GradientStop Offset="0.80" Color="{DynamicResource WindowBackgroundColorSecondary}" />
        <GradientStop Offset="1.10" Color="{DynamicResource WindowBackgroundColorThird}" />
      </LinearGradientBrush>
    </Panel.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Title="Edit Mod" Grid.Row="0" Padding="8" CanMaximize="False" KeyboardNavigation.TabNavigation="None" ShowMaximize="False" ShowMinimize="False" />

    <StackPanel Grid.Row="1" Margin="20,4,20,12">
      <TextBlock x:Name="ModTitle" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="ModHint" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
        <ui:Button x:Name="DownloadOptionsButton" Icon="ArrowDownload24" Content="Get every option from GameBanana" Visibility="Collapsed" Click="DownloadOptions_Click" />
        <ComboBox x:Name="ConfigPicker" MinWidth="320" Visibility="Collapsed" DisplayMemberPath="Label" SelectionChanged="ConfigPicker_SelectionChanged" />
      </StackPanel>
    </StackPanel>

    <Grid Grid.Row="2" Margin="20,0,8,0">
        <ui:ProgressRing x:Name="LoadingRing" Width="32" Height="32" Margin="0,24,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" IsIndeterminate="True" />
        <TextBlock x:Name="EmptyText" Margin="0,24,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />

        <ItemsControl x:Name="SlotList" Padding="0,0,12,12" Visibility="Collapsed" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
          <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
              <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" Padding="{TemplateBinding Padding}">
                <ItemsPresenter />
              </ScrollViewer>
            </ControlTemplate>
          </ItemsControl.Template>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,8" Padding="12" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="52" Height="52" Margin="0,0,12,0" CornerRadius="6" Background="#33000000">
                    <Image Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Preview}" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <ComboBox Grid.Column="2" Width="280" VerticalAlignment="Center" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                          <Image Width="28" Height="28" Margin="0,0,8,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Preview}" />
                          <TextBlock VerticalAlignment="Center" Text="{Binding Label}" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl x:Name="RuleList" Padding="0,0,12,12" Visibility="Collapsed" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
          <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
              <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" Padding="{TemplateBinding Padding}">
                <ItemsPresenter />
              </ScrollViewer>
            </ControlTemplate>
          </ItemsControl.Template>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,8" Padding="12" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <ui:ToggleSwitch Grid.RowSpan="2" Margin="0,0,12,0" VerticalAlignment="Center" IsChecked="{Binding Enabled, Mode=TwoWay}" />
                  <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox PlaceholderText="Rule name" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Grid.Column="1" Width="130" Margin="8,0,0,0" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode, Mode=TwoWay}" />
                  </Grid>
                  <Grid Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="220" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox PlaceholderText="Asset ids to replace" Text="{Binding Ids, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Grid.Column="1" Margin="8,0,0,0" IsEditable="True" IsEnabled="{Binding TargetEnabled}" ToolTip="{Binding TargetHint}" ItemsSource="{Binding Suggestions}" Text="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>

    <Border Grid.Row="3" Padding="14,10" Background="{DynamicResource PrimaryBackgroundColor}" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button MinWidth="100" Content="{x:Static resources:Strings.Common_Cancel}" Click="Cancel_Click" />
          <ui:Button x:Name="SaveButton" MinWidth="100" Margin="8,0,0,0" Appearance="Primary" Content="Save" IsEnabled="False" Click="Save_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</base:WpfUiWindow>
