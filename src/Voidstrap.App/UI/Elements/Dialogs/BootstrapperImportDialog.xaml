<UserControl x:Class="Voidstrap.UI.Elements.Dialogs.BootstrapperImportDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="24,22,24,24">
      <TextBlock FontSize="20" FontWeight="SemiBold" Text="{resources:Loc Menu_Import_Title}" />
      <TextBlock Margin="0,4,0,18" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{resources:Loc Menu_Import_Description}" />
      <UniformGrid Columns="2">
        <ui:CardAction x:Name="BloxstrapCard" Margin="0,0,6,0" Padding="16,22" IsChevronVisible="False" HorizontalContentAlignment="Center" Tag="Bloxstrap" Click="Source_Click">
          <StackPanel HorizontalAlignment="Center">
            <Image Width="56" Height="56" Source="pack://application:,,,/Resources/ImportSourceBloxstrap.png" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock x:Name="BloxstrapTitle" Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
            <TextBlock x:Name="BloxstrapStatus" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction x:Name="FishstrapCard" Margin="6,0,0,0" Padding="16,22" IsChevronVisible="False" HorizontalContentAlignment="Center" Tag="Fishstrap" Click="Source_Click">
          <StackPanel HorizontalAlignment="Center">
            <Image Width="56" Height="56" Source="pack://application:,,,/Resources/ImportSourceFishstrap.png" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock x:Name="FishstrapTitle" Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
            <TextBlock x:Name="FishstrapStatus" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </ui:CardAction>
      </UniformGrid>
    </StackPanel>
    <Border Grid.Row="1" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7" Padding="24">
      <ui:Button Height="32" HorizontalAlignment="Stretch" Content="{resources:Loc Common_Close}" Click="Close_Click" />
    </Border>
  </Grid>
</UserControl>
