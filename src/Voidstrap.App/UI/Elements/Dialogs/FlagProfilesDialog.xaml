<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.Dialogs.FlagProfilesDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base" xmlns:converters="clr-namespace:Voidstrap.UI.Converters" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Flag Profiles" Width="565" MinHeight="30" ExtendsContentIntoTitleBar="True" ResizeMode="NoResize" SizeToContent="Height" WindowStartupLocation="CenterOwner" Background="{ui:ThemeResource ApplicationBackgroundBrush}" Loaded="Window_Loaded" Closed="Window_Closed">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:RangeConverter x:Key="ValidationConverter" From="0" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Panel.Background>
      <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
        <GradientStop Offset="0.00" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        <GradientStop Offset="0.90" Color="{DynamicResource WindowBackgroundColorSecondary}" />
        <GradientStop Offset="1.10" Color="{DynamicResource WindowBackgroundColorThird}" />
      </LinearGradientBrush>
    </Panel.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Title="Flag Profiles" Grid.Row="0" Padding="9" CanMaximize="False" KeyboardNavigation.TabNavigation="None" ShowMaximize="False" ShowMinimize="False" />
    <TabControl Name="Tabs" Grid.Row="1" Margin="5" SelectionChanged="Tabs_SelectionChanged">
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0" />
            <TextBlock Text="Save" />
          </StackPanel>
        </TabItem.Header>
        <Grid Margin="11">
          <TextBox Name="SaveBackup" Height="32" MaxLength="48" VerticalContentAlignment="Center" TextChanged="SaveBackup_TextChanged" />
          <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#FFA9A9A9" IsHitTestVisible="False" Text="Profile name">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=SaveBackup}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" />
            <TextBlock Text="Load" />
          </StackPanel>
        </TabItem.Header>
        <Grid Margin="10">
          <ListView Name="LoadBackup" MinHeight="180" MaxHeight="260" DisplayMemberPath="Name" SelectionChanged="LoadBackup_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto" />
          <TextBlock Name="EmptyProfiles" Margin="18,14,0,0" Foreground="#FFA9A9A9" IsHitTestVisible="False" Text="No saved profiles" />
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Margin="0,10,0,0" Padding="15" Background="{DynamicResource PrimaryBackgroundColor}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <CheckBox Name="ClearFlags" VerticalAlignment="Center" Content="Clear existing flags first">
          <CheckBox.Style>
            <Style BasedOn="{StaticResource {x:Type CheckBox}}" TargetType="CheckBox">
              <Setter Property="Visibility" Value="Hidden" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=Tabs}" Value="1">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </CheckBox.Style>
        </CheckBox>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Name="DeleteButton" Width="130" Margin="10,0,0,0" Background="{DynamicResource SystemAccentBrush}" Content="Delete Selected" Click="DeleteButton_Click">
            <Button.Style>
              <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                <Setter Property="Visibility" Value="Hidden" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedIndex, ElementName=Tabs}" Value="1">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Name="OKButton" Width="80" Margin="10,0,0,0" Content="OK" Click="OKButton_Click" />
          <Button Width="90" Margin="10,0,0,0" Content="Close" IsCancel="True" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</base:WpfUiWindow>
