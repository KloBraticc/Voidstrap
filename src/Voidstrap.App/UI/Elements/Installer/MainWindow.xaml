<base:WpfUiWindow x:Class="Voidstrap.UI.Elements.Installer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="clr-namespace:Voidstrap.UI.Elements.Base" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dmodels="clr-namespace:Voidstrap.UI.ViewModels.Installer" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:pages="clr-namespace:Voidstrap.UI.Elements.Installer.Pages" xmlns:settingspages="clr-namespace:Voidstrap.UI.Elements.Settings.Pages" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="{x:Static resources:Strings.Installer_Title}" Width="1000" Height="650" MinWidth="1000" MinHeight="650" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowStartupLocation="CenterScreen" xmlns:installer="clr-namespace:Voidstrap.UI.Elements.Installer" Background="{ui:ThemeResource ApplicationBackgroundBrush}">
  <base:WpfUiWindow.Resources>
    <Style x:Key="StepNumber" TargetType="{x:Type Border}">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="StepTitle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>
    <Style x:Key="StepDesc" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
    </Style>
    <Style x:Key="StepRail" TargetType="{x:Type Rectangle}">
      <Setter Property="Width" Value="2" />
      <Setter Property="Margin" Value="0,6,0,-2" />
      <Setter Property="RadiusX" Value="1" />
      <Setter Property="RadiusY" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Fill" Value="{DynamicResource ControlElevationBorderBrush}" />
    </Style>
  </base:WpfUiWindow.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar Name="RootTitleBar" Title="{x:Static resources:Strings.Installer_Title}" Grid.Row="0" Padding="4" ForceShutdown="False" Icon="pack://application:,,,/Voidstrap.png" MinimizeToTray="False" ShowMaximize="False" UseSnapLayout="True" />
    <Grid Name="RootGrid" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Name="SidebarHost" Grid.Column="0" Padding="24,20,16,24" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource ControlElevationBorderBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
        <StackPanel>
          <Image Width="42" Height="42" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Voidstrap.png" />
          <TextBlock Margin="0,14,0,0" FontSize="17" FontWeight="Bold" LineHeight="24" TextWrapping="Wrap" Text="Onboarding" />
                    <TextBlock Margin="0,8,0,0" FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Advanced Roblox bootstrapper with deep customization and performance." />
          <ui:NavigationStore Name="RootNavigation" Width="210" Margin="0,22,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" Focusable="False" SelectedPageIndex="0" Frame="{Binding ElementName=RootFrame}">
            <ui:NavigationStore.Resources>
              <Style TargetType="{x:Type ui:NavigationItem}">
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="IconSize" Value="18" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="IconForeground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:NavigationItem}">
                      <Border x:Name="MainBorder" Padding="10,9" HorizontalAlignment="Stretch" Background="Transparent" CornerRadius="6">
                        <Grid>
                          <Rectangle x:Name="ActiveRectangle" Width="3" Height="16" Margin="-6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" RadiusX="1.5" RadiusY="1.5">
                            <Rectangle.Fill>
                              <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                            </Rectangle.Fill>
                          </Rectangle>
                          <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon x:Name="ElementIcon" Grid.Column="0" Width="18" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="{TemplateBinding IconSize}" Foreground="{TemplateBinding IconForeground}" Symbol="{TemplateBinding Icon}" />
                            <ContentPresenter x:Name="ElementContentPresenter" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding Content}" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.Foreground="{TemplateBinding Foreground}" />
                          </Grid>
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="True">
                          <Setter TargetName="ActiveRectangle" Property="Opacity" Value="1" />
                          <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                          <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                          <Setter Property="IconForeground" Value="{DynamicResource SystemAccentBrush}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ui:NavigationStore.Resources>
            <ui:NavigationBase.Items>
              <ui:NavigationItem Visibility="Collapsed" Content="Sign in" Icon="Person24" PageType="{x:Type pages:SignInPage}" />
              <ui:NavigationItem Content="Welcome" Icon="Home24" PageType="{x:Type pages:WelcomePage}" />
              <ui:NavigationItem Content="{x:Static resources:Strings.Installer_Install_Title}" Icon="ArrowDownload24" PageType="{x:Type pages:InstallPage}" />
              <ui:NavigationItem Content="Channel" Icon="Globe24" PageType="{x:Type pages:ChannelPage}" />
              <ui:NavigationItem Content="Manager" Icon="Apps24" PageType="{x:Type settingspages:DownloadsPage}" />
              <ui:NavigationItem Content="Extensions" Icon="PuzzlePiece24" PageType="{x:Type settingspages:ExtensionPage}" />
              <ui:NavigationItem Content="Completed" Icon="CheckmarkCircle24" PageType="{x:Type pages:CompletionPage}" />
            </ui:NavigationBase.Items>
          </ui:NavigationStore>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1" Margin="36,20,36,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Name="StepHeadingText" Grid.Row="0" Margin="0,0,0,20" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="{Binding StepHeading, Mode=OneWay}" />
        <Frame Name="RootFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Navigated="RootFrame_Navigated" />
        <Grid Name="NavButtonBar" Grid.Row="2" Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.ColumnSpan="3" VerticalAlignment="Top" Margin="0,-20,0,0" Height="1" Background="{DynamicResource ControlElevationBorderBrush}" />
          <ui:Button Grid.Column="0" MinWidth="{Binding ButtonWidth, Mode=OneTime}" Height="36" Margin="0,20,0,0" HorizontalContentAlignment="Center" Content="{x:Static resources:Strings.Common_Close}" Command="{Binding CloseWindowCommand}" />
          <StackPanel Grid.Column="2" Margin="0,20,0,0" Orientation="Horizontal">
            <ui:Button MinWidth="{Binding ButtonWidth, Mode=OneTime}" Height="36" HorizontalContentAlignment="Center" Content="{x:Static resources:Strings.Common_Navigation_Back}" Command="{Binding BackPageCommand, Mode=OneWay}" IsEnabled="{Binding BackButtonEnabled, Mode=OneWay}" />
            <ui:Button Name="NextButton" MinWidth="120" Height="36" Margin="8,0,0,0" HorizontalContentAlignment="Center" Appearance="Primary" Command="{Binding NextPageCommand, Mode=OneWay}" Content="{Binding NextButtonText, Mode=OneWay}" IsEnabled="{Binding NextButtonEnabled, Mode=OneWay}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</base:WpfUiWindow>
