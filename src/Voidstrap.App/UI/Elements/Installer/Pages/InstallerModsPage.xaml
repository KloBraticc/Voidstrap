<ui:UiPage x:Class="Voidstrap.UI.Elements.Installer.Pages.InstallerModsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Voidstrap.UI.Elements.Controls" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="{x:Static resources:Strings.Menu_Mods_Title}" Scrollable="True" Loaded="UiPage_Loaded" Unloaded="UiPage_Unloaded">
  <StackPanel Margin="0,0,14,14">
    <TextBlock FontSize="14" LineHeight="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Mods_Description}" TextWrapping="Wrap" />
    <TextBlock Margin="0,18,0,0" FontSize="20" FontWeight="SemiBold" Text="{x:Static resources:Strings.Common_Presets}" TextWrapping="Wrap" />
    <controls:OptionControl Margin="0,2,0,0" Header="{x:Static resources:Strings.Menu_Mods_Presets_MouseCursor_Title}" Description="{x:Static resources:Strings.Menu_Mods_Presets_MouseCursor_Description}">
      <ComboBox Width="210" Height="35" Padding="10,5,10,5" VerticalContentAlignment="Center" ItemsSource="{Binding CursorStyles, Mode=OneTime}" SelectedItem="{Binding SelectedCursorType, Mode=TwoWay}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ComboBox>
    </controls:OptionControl>
    <controls:OptionControl Margin="0,2,0,0" Header="{x:Static resources:Strings.Menu_Mods_Presets_OldCharacterSounds_Title}" Description="{x:Static resources:Strings.Menu_Mods_Presets_OldCharacterSounds_Description}">
      <ui:ToggleSwitch IsChecked="{Binding OldCharacterSoundsTask.NewState, Mode=TwoWay}" />
    </controls:OptionControl>
    <controls:OptionControl Margin="0,2,0,0" Header="{x:Static resources:Strings.Menu_Mods_Presets_OldDeathSound_Title}" Description="{x:Static resources:Strings.Menu_Mods_Presets_OldDeathSound_Description}">
      <ui:ToggleSwitch IsChecked="{Binding OldDeathSoundTask.NewState, Mode=TwoWay}" />
    </controls:OptionControl>
    <controls:OptionControl Margin="0,2,0,0" Header="{x:Static resources:Strings.Menu_Mods_Presets_OldAvatarEditor_Title}" Description="{x:Static resources:Strings.Menu_Mods_Presets_OldAvatarEditor_Description}">
      <ui:ToggleSwitch IsChecked="{Binding OldAvatarBackgroundTask.NewState, Mode=TwoWay}" />
    </controls:OptionControl>
  </StackPanel>
</ui:UiPage>
