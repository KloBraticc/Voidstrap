<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
      <DataTemplate x:Key="ShortcutAppearanceTemplate">
        <StackPanel>
          <TextBlock Text="{x:Static resources:Strings.Common_Name}" Margin="0,0,0,4" />
          <ui:TextBox MaxLength="100" Text="{Binding ShortcutName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" FontSize="12" />
          <TextBlock Text="{x:Static resources:Strings.Menu_Appearance_Icon_Title}" Margin="0,8,0,4" />
          <ComboBox ItemsSource="{Binding Icons}" SelectedValuePath="IconType" SelectedValue="{Binding SelectedIcon, Mode=TwoWay}" Padding="10,5">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Image Width="16" Height="16" Source="{Binding ImageSource}" Margin="0,0,8,0" />
                  <TextBlock Text="{Binding IconType, Converter={StaticResource EnumNameConverter}}" />
                </StackPanel>
              </DataTemplate>
        </ComboBox.ItemTemplate>
          </ComboBox>
          <StackPanel Visibility="{Binding CustomIconVisibility}" Margin="0,8,0,0">
            <TextBlock Text="{Binding CustomIconPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CustomIconPath}" Margin="0,0,0,4" />
            <ui:Button Content="{x:Static resources:Strings.Common_Browse}" Icon="Folder24" Command="{Binding BrowseIconCommand}" />
          </StackPanel>
        </StackPanel>
      </DataTemplate>


</ResourceDictionary>
