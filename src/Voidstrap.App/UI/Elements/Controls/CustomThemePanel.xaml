<UserControl xmlns:resources="clr-namespace:Voidstrap.Resources" x:Class="Voidstrap.UI.Elements.Controls.CustomThemePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Loaded="Panel_Loaded" Unloaded="Panel_Unloaded" IsVisibleChanged="Panel_IsVisibleChanged">
  <UserControl.Resources>
    <DataTemplate x:Key="ThemeColorTile">
      <Border Width="236" Margin="0,0,10,10" Padding="10" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Opacity="{Binding RowOpacity}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Width="48" Height="48" Cursor="Hand" VerticalAlignment="Center" Background="{Binding Swatch}" ToolTip="{resources:Loc Ui_Misc_ClickToChangeThisColour}" Click="Swatch_Click">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border CornerRadius="10" BorderThickness="1" BorderBrush="#55FFFFFF" Background="#22FFFFFF">
                  <Border CornerRadius="9" Background="{TemplateBinding Background}" />
                </Border>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <Grid>
              <TextBlock Margin="0,0,28,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Label}" ToolTip="{Binding Label}" />
              <ui:Button Width="24" Height="24" Padding="0" HorizontalAlignment="Right" Appearance="Transparent" Icon="ArrowReset24" FontSize="12" ToolTip="{resources:Loc Ui_Misc_UseTheDefault}" Visibility="{Binding ResetVisibility}" Click="ResetColor_Click" />
            </Grid>
            <ui:TextBox Margin="0,6,0,0" Padding="6,3" FontSize="12" FontFamily="Consolas" ClearButtonEnabled="False" PlaceholderText="{Binding Placeholder}" Text="{Binding Hex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" KeyDown="HexBox_KeyDown" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="GroupHeader">
      <TextBlock Margin="0,10,0,8" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" />
    </DataTemplate>
    <ItemsPanelTemplate x:Key="TileGrid">
      <WrapPanel />
    </ItemsPanelTemplate>
  </UserControl.Resources>
  <StackPanel>
    <Border Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Name="PreviewWindow" Width="280" Height="168" CornerRadius="8" BorderThickness="1" BorderBrush="#33FFFFFF" ClipToBounds="True" ToolTip="{resources:Loc CustomTheme_Editor_Preview}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Name="PreviewSidebar" Margin="8" CornerRadius="6">
              <StackPanel Margin="8,10">
                <Border Name="PreviewNavActive" Height="8" CornerRadius="4" />
                <Border Name="PreviewNav1" Height="8" Margin="0,8,0,0" CornerRadius="4" Opacity="0.5" />
                <Border Name="PreviewNav2" Height="8" Margin="0,8,0,0" CornerRadius="4" Opacity="0.5" />
                <Border Name="PreviewNav3" Height="8" Margin="0,8,0,0" CornerRadius="4" Opacity="0.5" />
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Margin="2,12,12,12">
              <Border Name="PreviewTitle" Width="110" Height="10" HorizontalAlignment="Left" CornerRadius="4" />
              <Border Name="PreviewCard1" Height="40" Margin="0,12,0,0" Padding="10" CornerRadius="6" BorderThickness="1">
                <StackPanel>
                  <Border Name="PreviewLine1" Width="90" Height="6" HorizontalAlignment="Left" CornerRadius="3" />
                  <Border Name="PreviewSubLine1" Width="60" Height="5" Margin="0,6,0,0" HorizontalAlignment="Left" CornerRadius="3" Opacity="0.6" />
                </StackPanel>
              </Border>
              <Border Name="PreviewCard2" Height="40" Margin="0,8,0,0" Padding="10" CornerRadius="6" BorderThickness="1">
                <Grid>
                  <Border Name="PreviewLine2" Width="70" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="3" />
                  <Border Name="PreviewButton" Width="44" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="8" />
                </Grid>
              </Border>
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Name="ProfileBox" Grid.Column="0" Padding="10,5" VerticalAlignment="Center" ToolTip="{resources:Loc Ui_Misc_YourSavedThemeProfiles}" SelectionChanged="ProfileBox_SelectionChanged" />
            <ui:Button Grid.Column="1" Margin="8,0,0,0" Appearance="Primary" Icon="Save24" Content="{resources:Loc CustomTheme_Editor_Save}" ToolTip="{resources:Loc Ui_Misc_SaveYourColoursToThisProfile}" Click="ProfileSave_Click" />
            <ui:Button Name="MoreButton" Grid.Column="2" Margin="8,0,0,0" Appearance="Secondary" Icon="MoreHorizontal24" Content="{resources:Loc Ui_Nav_More}" ToolTip="{resources:Loc Ui_Misc_MoreProfileOptions}" Click="More_Click" />
          </Grid>
          <TextBlock Margin="0,16,0,8" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Theme_StartFrom}" />
          <ItemsControl Name="PresetList">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ui:Button Margin="0,0,6,6" Padding="10,4" Appearance="Secondary" Content="{Binding}" Tag="{Binding}" Click="Preset_Click" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </Border>

    <Border Name="StatusBorder" Margin="0,8,0,0" Padding="12,8" CornerRadius="6" Visibility="Collapsed" BorderThickness="1">
      <StackPanel Orientation="Horizontal">
        <ui:SymbolIcon Name="StatusIcon" Symbol="Warning24" Margin="0,0,8,0" VerticalAlignment="Top" />
        <TextBlock Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <ItemsControl Name="ColorList" Margin="0,6,0,0" ItemTemplate="{StaticResource ThemeColorTile}" ItemsPanel="{StaticResource TileGrid}">
      <ItemsControl.GroupStyle>
        <GroupStyle HeaderTemplate="{StaticResource GroupHeader}" />
      </ItemsControl.GroupStyle>
    </ItemsControl>

    <ui:CardExpander Margin="0,4,0,0" IsExpanded="False">
      <ui:CardExpander.Header>
        <Grid>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="{resources:Loc Ui_Misc_BackgroundGradient}" />
            <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Misc_BlendUpTo8ColoursBehind}" />
          </StackPanel>
          <ui:ToggleSwitch Name="GradientToggle" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="GradientToggle_Changed" Unchecked="GradientToggle_Changed" />
        </Grid>
      </ui:CardExpander.Header>
      <StackPanel>
        <TextBlock Name="GradientOffHint" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Misc_TurnTheSwitchOnToBuild}" />
        <StackPanel Name="GradientPanel" Visibility="Collapsed">
          <Border Name="GradientBar" Height="52" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}" />
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox Name="GradientTypeBox" Grid.Column="0" Width="120" Padding="10,5" SelectionChanged="GradientTypeBox_SelectionChanged">
              <ComboBoxItem Content="Linear" />
              <ComboBoxItem Content="Radial" />
            </ComboBox>
            <Grid Name="AnglePanel" Grid.Column="1" Margin="14,0,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" Text="{resources:Loc Ui_ModGen_Angle}" />
              <Slider Name="AngleSlider" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="360" SmallChange="1" LargeChange="15" ValueChanged="GradientSlider_ValueChanged" />
              <TextBlock Name="AngleText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="45°" />
            </Grid>
            <StackPanel Name="RadialPanel" Grid.Column="1" Margin="14,0,0,0" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{resources:Loc Ui_Mods_Size}" />
                <Slider Name="RadiusSlider" Grid.Column="1" VerticalAlignment="Center" Minimum="10" Maximum="200" SmallChange="1" LargeChange="10" ValueChanged="GradientSlider_ValueChanged" />
                <TextBlock Name="RadiusText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="75%" />
              </Grid>
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{resources:Loc Ui_Misc_CentreX}" />
                <Slider Name="CenterXSlider" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" ValueChanged="GradientSlider_ValueChanged" />
                <TextBlock Name="CenterXText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="50%" />
              </Grid>
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{resources:Loc Ui_Misc_CentreY}" />
                <Slider Name="CenterYSlider" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" ValueChanged="GradientSlider_ValueChanged" />
                <TextBlock Name="CenterYText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="50%" />
              </Grid>
            </StackPanel>
          </Grid>
          <ItemsControl Name="StopList" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="34" />
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Width="32" Height="32" Padding="0" ToolTip="{Binding Hex}" Click="StopSwatch_Click">
                    <Border Width="22" Height="22" CornerRadius="4" BorderThickness="1" BorderBrush="#55FFFFFF" Background="{Binding Swatch}" />
                  </Button>
                  <Slider Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" ToolTip="{resources:Loc Ui_SessionNotify_Position}" Value="{Binding Position, Mode=TwoWay}" />
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding PositionText}" />
                  <ui:Button Grid.Column="3" Width="30" Height="30" Padding="0" Margin="4,0,0,0" Appearance="Transparent" Icon="Dismiss16" ToolTip="{resources:Loc Ui_Misc_RemoveThisColour}" Click="RemoveStop_Click" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel Margin="0,8,0,0">
            <ui:Button Name="AddStopButton" Margin="0,0,8,6" Content="{resources:Loc Ui_Misc_AddColour}" Click="AddStop_Click" />
            <ui:Button Margin="0,0,8,6" Content="{resources:Loc Ui_Misc_Reverse}" Click="ReverseStops_Click" />
            <ui:Button Margin="0,0,8,6" Content="{resources:Loc Ui_Misc_EvenSpacing}" Click="EvenStops_Click" />
            <ui:Button Margin="0,0,8,6" Content="{resources:Loc Ui_Misc_UseWindowColours}" Click="SeedStops_Click" />
          </WrapPanel>
        </StackPanel>
      </StackPanel>
    </ui:CardExpander>

    <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
      <ui:CardExpander.Header>
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="{resources:Loc Ui_Misc_AdvancedColours}" />
          <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Misc_TextControlsCardsAndBordersFaded}" />
        </StackPanel>
      </ui:CardExpander.Header>
      <ItemsControl Name="AdvancedList" ItemTemplate="{StaticResource ThemeColorTile}" ItemsPanel="{StaticResource TileGrid}">
        <ItemsControl.GroupStyle>
          <GroupStyle HeaderTemplate="{StaticResource GroupHeader}" />
        </ItemsControl.GroupStyle>
      </ItemsControl>
    </ui:CardExpander>

    <ui:CardExpander Name="CodeExpander" Margin="0,8,0,0" IsExpanded="False" Expanded="CodeExpander_Expanded">
      <ui:CardExpander.Header>
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="{resources:Loc Ui_Misc_ThemeCode}" />
          <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Misc_ForExpertsValidChangesApplyRight}" />
        </StackPanel>
      </ui:CardExpander.Header>
      <StackPanel>
        <WrapPanel Margin="0,0,0,8">
          <ui:Button Content="{resources:Loc Ui_Misc_Format}" Appearance="Secondary" Margin="0,0,8,6" Click="Format_Click" />
          <ui:Button Content="{resources:Loc Ui_Misc_InsertColour}" Appearance="Secondary" Margin="0,0,8,6" Click="PickColor_Click" />
          <ui:Button Content="{resources:Loc Ui_Misc_Copy}" Appearance="Secondary" Margin="0,0,8,6" Click="CopyCode_Click" />
          <ui:Button Content="{resources:Loc Ui_Misc_OpenInAnotherEditor}" Appearance="Secondary" Margin="0,0,8,6" ToolTip="{resources:Loc Ui_Misc_SavingThereUpdatesVoidstrapRightAway}" Click="OpenExternal_Click" />
        </WrapPanel>
        <Border Name="CodeHost" Height="320" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}" ClipToBounds="True" />
      </StackPanel>
    </ui:CardExpander>
  </StackPanel>
</UserControl>
