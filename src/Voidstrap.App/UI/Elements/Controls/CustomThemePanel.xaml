<UserControl x:Class="Voidstrap.UI.Elements.Controls.CustomThemePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Loaded="Panel_Loaded" Unloaded="Panel_Unloaded" IsVisibleChanged="Panel_IsVisibleChanged">
  <UserControl.Resources>
    <DataTemplate x:Key="ThemeColorTile">
      <Grid Margin="0,0,8,8" Opacity="{Binding RowOpacity}">
        <Button Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTip="Click to change this colour" Click="Swatch_Click">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="30" Height="30" CornerRadius="6" BorderThickness="1" BorderBrush="#55FFFFFF" Background="{Binding Swatch}" />
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Label}" />
              <TextBlock FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding DisplayHex}" />
            </StackPanel>
          </Grid>
        </Button>
        <ui:Button Width="26" Height="26" Padding="0" Margin="0,0,6,0" HorizontalAlignment="Right" VerticalAlignment="Center" Appearance="Transparent" Icon="ArrowReset24" FontSize="12" ToolTip="Use the default" Visibility="{Binding ResetVisibility}" Click="ResetColor_Click" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="GroupHeader">
      <TextBlock Margin="0,6,0,6" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Name}" />
    </DataTemplate>
    <ItemsPanelTemplate x:Key="TileGrid">
      <UniformGrid Columns="2" />
    </ItemsPanelTemplate>
  </UserControl.Resources>
  <StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ComboBox Name="ProfileBox" Grid.Column="0" Padding="10,5" VerticalAlignment="Center" ToolTip="Your saved theme profiles" SelectionChanged="ProfileBox_SelectionChanged" />
      <ui:Button Grid.Column="1" Margin="8,0,0,0" Appearance="Secondary" Content="Save" ToolTip="Save your colours to this profile" Click="ProfileSave_Click" />
      <ui:Button Name="MoreButton" Grid.Column="2" Margin="8,0,0,0" Appearance="Secondary" Content="More" ToolTip="More profile options" Click="More_Click" />
    </Grid>

    <Border Name="StatusBorder" Margin="0,8,0,0" Padding="12,8" CornerRadius="6" Visibility="Collapsed" BorderThickness="1">
      <StackPanel Orientation="Horizontal">
        <ui:SymbolIcon Name="StatusIcon" Symbol="Warning24" Margin="0,0,8,0" VerticalAlignment="Top" />
        <TextBlock Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <ItemsControl Name="ColorList" Margin="0,10,0,0" ItemTemplate="{StaticResource ThemeColorTile}" ItemsPanel="{StaticResource TileGrid}">
      <ItemsControl.GroupStyle>
        <GroupStyle HeaderTemplate="{StaticResource GroupHeader}" />
      </ItemsControl.GroupStyle>
    </ItemsControl>

    <ui:CardExpander Margin="0,4,0,0" IsExpanded="False">
      <ui:CardExpander.Header>
        <Grid>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Background gradient" />
            <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Blend up to 8 colours behind the whole app." />
          </StackPanel>
          <ui:ToggleSwitch Name="GradientToggle" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="GradientToggle_Changed" Unchecked="GradientToggle_Changed" />
        </Grid>
      </ui:CardExpander.Header>
      <StackPanel>
        <TextBlock Name="GradientOffHint" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Turn the switch on to build a gradient." />
        <StackPanel Name="GradientPanel" Visibility="Collapsed">
          <Border Name="GradientBar" Height="52" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}" />
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox Name="GradientTypeBox" Grid.Column="0" Width="120" Padding="10,5" SelectionChanged="GradientTypeBox_SelectionChanged">
              <ComboBoxItem Content="Linear" />
              <ComboBoxItem Content="Radial" />
            </ComboBox>
            <Grid Name="AnglePanel" Grid.Column="1" Margin="14,0,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" Text="Angle" />
              <Slider Name="AngleSlider" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="360" SmallChange="1" LargeChange="15" ValueChanged="GradientSlider_ValueChanged" />
              <TextBlock Name="AngleText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="45°" />
            </Grid>
            <StackPanel Name="RadialPanel" Grid.Column="1" Margin="14,0,0,0" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Size" />
                <Slider Name="RadiusSlider" Grid.Column="1" VerticalAlignment="Center" Minimum="10" Maximum="200" SmallChange="1" LargeChange="10" ValueChanged="GradientSlider_ValueChanged" />
                <TextBlock Name="RadiusText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="75%" />
              </Grid>
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Centre X" />
                <Slider Name="CenterXSlider" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" ValueChanged="GradientSlider_ValueChanged" />
                <TextBlock Name="CenterXText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="50%" />
              </Grid>
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Centre Y" />
                <Slider Name="CenterYSlider" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" ValueChanged="GradientSlider_ValueChanged" />
                <TextBlock Name="CenterYText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="50%" />
              </Grid>
            </StackPanel>
          </Grid>
          <ItemsControl Name="StopList" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="34" />
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Width="32" Height="32" Padding="0" ToolTip="{Binding Hex}" Click="StopSwatch_Click">
                    <Border Width="22" Height="22" CornerRadius="4" BorderThickness="1" BorderBrush="#55FFFFFF" Background="{Binding Swatch}" />
                  </Button>
                  <Slider Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" ToolTip="Position" Value="{Binding Position, Mode=TwoWay}" />
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding PositionText}" />
                  <ui:Button Grid.Column="3" Width="30" Height="30" Padding="0" Margin="4,0,0,0" Appearance="Transparent" Icon="Dismiss16" ToolTip="Remove this colour" Click="RemoveStop_Click" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel Margin="0,8,0,0">
            <ui:Button Name="AddStopButton" Margin="0,0,8,6" Content="Add colour" Click="AddStop_Click" />
            <ui:Button Margin="0,0,8,6" Content="Reverse" Click="ReverseStops_Click" />
            <ui:Button Margin="0,0,8,6" Content="Even spacing" Click="EvenStops_Click" />
            <ui:Button Margin="0,0,8,6" Content="Use window colours" Click="SeedStops_Click" />
          </WrapPanel>
        </StackPanel>
      </StackPanel>
    </ui:CardExpander>

    <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
      <ui:CardExpander.Header>
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="Advanced colours" />
          <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Text, controls, cards and borders. Faded ones use the normal look." />
        </StackPanel>
      </ui:CardExpander.Header>
      <ItemsControl Name="AdvancedList" ItemTemplate="{StaticResource ThemeColorTile}" ItemsPanel="{StaticResource TileGrid}">
        <ItemsControl.GroupStyle>
          <GroupStyle HeaderTemplate="{StaticResource GroupHeader}" />
        </ItemsControl.GroupStyle>
      </ItemsControl>
    </ui:CardExpander>

    <ui:CardExpander Name="CodeExpander" Margin="0,8,0,0" IsExpanded="False" Expanded="CodeExpander_Expanded">
      <ui:CardExpander.Header>
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Text="Theme code" />
          <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="For experts. Valid changes apply right away." />
        </StackPanel>
      </ui:CardExpander.Header>
      <StackPanel>
        <WrapPanel Margin="0,0,0,8">
          <ui:Button Content="Format" Appearance="Secondary" Margin="0,0,8,6" Click="Format_Click" />
          <ui:Button Content="Insert colour" Appearance="Secondary" Margin="0,0,8,6" Click="PickColor_Click" />
          <ui:Button Content="Copy" Appearance="Secondary" Margin="0,0,8,6" Click="CopyCode_Click" />
          <ui:Button Content="Open in another editor" Appearance="Secondary" Margin="0,0,8,6" ToolTip="Saving there updates Voidstrap right away." Click="OpenExternal_Click" />
        </WrapPanel>
        <Border Name="CodeHost" Height="320" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}" ClipToBounds="True" />
      </StackPanel>
    </ui:CardExpander>
  </StackPanel>
</UserControl>
