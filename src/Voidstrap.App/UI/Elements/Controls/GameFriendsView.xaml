<UserControl x:Class="Voidstrap.UI.Elements.Controls.GameFriendsView" x:Name="FriendsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:resources="clr-namespace:Voidstrap.Resources" IsVisibleChanged="OnVisibilityChanged">
  <Border x:Name="Card" Padding="14,12" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
    <StackPanel>
      <TextBlock FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Text" Value="{resources:Loc Library_Friends_Title}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ShowActivity, ElementName=FriendsView}" Value="True">
                <Setter Property="Text" Value="{resources:Loc Library_Friends_Activity}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding PlayingOnly, ElementName=FriendsView}" Value="True">
                <Setter Property="Text" Value="{resources:Loc Library_Friends_CurrentlyPlaying}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <Rectangle Height="1" Margin="0,8,0,10" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <ProgressBar x:Name="LoadingBar" Height="4" Margin="0,2,0,6" IsIndeterminate="True" Visibility="Collapsed" />
      <TextBlock Margin="0,0,0,8" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Library_Friends_SlowLoading}">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding Visibility, ElementName=LoadingBar}" Value="Visible" />
                  <Condition Binding="{Binding PlayingOnly, ElementName=FriendsView}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />
      <StackPanel x:Name="Rows" />
    </StackPanel>
  </Border>
</UserControl>
