<UserControl x:Class="Voidstrap.UI.Elements.Controls.GameAccountBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:util="clr-namespace:Voidstrap.Utility" xmlns:resources="clr-namespace:Voidstrap.Resources" Visibility="Collapsed">
  <UniformGrid Rows="1">
    <ComboBox x:Name="AccountBox" Margin="0,0,6,0" MinWidth="130" MaxWidth="220" Padding="10,3" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed" SelectionChanged="AccountBox_SelectionChanged">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <Grid Width="20" Height="20" VerticalAlignment="Center">
              <ui:SymbolIcon Symbol="PersonCircle24" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" util:DynamicRenderSystem.LazyImageSource="{Binding AvatarUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}"><Image.Clip><EllipseGeometry Center="10,10" RadiusX="10" RadiusY="10" /></Image.Clip></Image>
            </Grid>
            <TextBlock Margin="6,0,0,0" Text="{Binding Username}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <ComboBox x:Name="OutfitBox" MinWidth="130" MaxWidth="220" Padding="10,3" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="{resources:Loc Accounts_Outfits_GameTooltip}" AutomationProperties.Name="{resources:Loc Accounts_Outfits_GameTooltip}" SelectionChanged="OutfitBox_SelectionChanged">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <Grid Width="20" Height="20" VerticalAlignment="Center">
              <ui:SymbolIcon Symbol="Person24" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" util:DynamicRenderSystem.LazyImageSource="{Binding ImageUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
            </Grid>
            <TextBlock Margin="6,0,0,0" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
  </UniformGrid>
</UserControl>
