<UserControl xmlns:resources="clr-namespace:Voidstrap.Resources" x:Class="Voidstrap.UI.Elements.Controls.AccentGradientEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Unloaded="Editor_Unloaded" IsVisibleChanged="Editor_IsVisibleChanged">
  <StackPanel>
    <Border Name="PreviewBar" Height="40" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}" />
    <ItemsControl Name="StopList" Margin="0,10,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="38" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="44" />
              <ColumnDefinition Width="34" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Width="32" Height="32" Padding="0" ToolTip="{Binding Hex}" Click="StopSwatch_Click">
              <Border Width="22" Height="22" CornerRadius="4" BorderThickness="1" BorderBrush="#55FFFFFF" Background="{Binding Swatch}" />
            </Button>
            <Slider Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" ToolTip="{resources:Loc Ui_SessionNotify_Position}" Value="{Binding Position, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding PositionText}" />
            <ui:Button Grid.Column="3" Width="30" Height="30" Padding="0" Margin="4,0,0,0" Appearance="Transparent" Icon="Dismiss16" ToolTip="{resources:Loc Ui_Misc_RemoveThisColour}" Click="RemoveStop_Click" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="70" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="44" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Text="{resources:Loc Ui_ModGen_Angle}" />
      <Slider Name="AngleSlider" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="360" SmallChange="1" LargeChange="15" ValueChanged="AngleSlider_ValueChanged" />
      <TextBlock Name="AngleText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
    </Grid>
    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
      <ui:Button Name="AddStopButton" Icon="Add16" Content="{resources:Loc Ui_Misc_AddColour}" Margin="0,0,6,0" Click="AddStop_Click" />
      <ui:Button Content="{resources:Loc Ui_Misc_Reverse}" Margin="0,0,6,0" Click="ReverseStops_Click" />
      <ui:Button Content="{resources:Loc Ui_Misc_EvenSpacing}" Click="EvenStops_Click" />
    </StackPanel>
  </StackPanel>
</UserControl>
