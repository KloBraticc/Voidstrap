<UserControl x:Class="Voidstrap.UI.Elements.Controls.CommunityFeedControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:util="clr-namespace:Voidstrap.Utility" xmlns:resources="clr-namespace:Voidstrap.Resources">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,8,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ui:TextBox x:Name="SearchBox" PlaceholderText="{resources:Loc Ui_Library_CommunitySearch}" Icon="Search24" ClearButtonEnabled="True" TextChanged="SearchBox_TextChanged" />
      <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
        <ui:ProgressRing x:Name="ScanRing" Width="16" Height="16" IsIndeterminate="True" Visibility="Collapsed" />
      </StackPanel>
    </Grid>
    <TextBlock x:Name="EmptyText" Grid.Row="1" Margin="0,40,0,0" HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Library_CommunityEmpty}" Visibility="Collapsed" />
    <ListBox x:Name="FeedList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Focusable" Value="False" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <ContentPresenter />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Margin="0,0,8,10" Padding="14,12" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel>
              <TextBlock FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="{Binding GameName}" />
              <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <Border Width="28" Height="28" CornerRadius="14" ClipToBounds="True" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                  <Image Source="{Binding AvatarUrl, TargetNullValue={x:Null}}" util:DynamicRenderSystem.LinuxImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Clip>
                      <EllipseGeometry Center="14,14" RadiusX="14" RadiusY="14" />
                    </Image.Clip>
                  </Image>
                </Border>
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding AuthorName}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding CreatedAt}" />
              </StackPanel>
              <TextBlock Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Content}" />
              <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <ui:SymbolIcon FontSize="14" Symbol="ThumbLike16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Margin="5,0,14,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding UpCount}" />
                <ui:SymbolIcon FontSize="14" Symbol="ThumbDislike16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding DownCount}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
