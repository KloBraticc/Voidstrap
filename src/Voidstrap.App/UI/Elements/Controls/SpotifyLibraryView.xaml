<UserControl x:Class="Voidstrap.UI.Elements.Controls.SpotifyLibraryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:util="clr-namespace:Voidstrap.Utility" xmlns:resources="clr-namespace:Voidstrap.Resources">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:Button x:Name="SignInButton" Grid.Row="0" Margin="0,0,0,44" HorizontalAlignment="Stretch" Appearance="Primary" Icon="Person24" Visibility="Collapsed" Click="SignIn_Click" />
    <ui:TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,0,0,10" Icon="Search24" ClearButtonEnabled="True" PlaceholderText="{resources:Loc Ui_AppCode_Search}" KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged" />
 <ui:ToggleSwitch x:Name="MiniToggle" Grid.Row="0" Margin="0,0,0,10" VerticalAlignment="Bottom" Content="{resources:Loc Ui_Spotify_ShowInTopBar}" Click="MiniToggle_Click" />
    <ProgressBar x:Name="Loading" Grid.Row="1" Height="2" VerticalAlignment="Bottom" IsIndeterminate="True" Visibility="Collapsed" />
    <ui:DynamicScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
      <Grid x:Name="OpenHeader" Margin="0,0,6,8" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:Button Width="34" Height="34" Padding="0" Appearance="Transparent" Icon="ArrowLeft24" Click="Back_Click" />
        <TextBlock x:Name="OpenTitle" Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <ui:Button x:Name="PlayAllButton" Grid.Column="2" Width="34" Height="34" Padding="0" Appearance="Primary" Icon="Play24" Click="PlayAll_Click" />
      </Grid>
      <ItemsControl x:Name="ItemsList" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:Button Margin="0,0,6,6" Padding="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Appearance="Secondary" Tag="{Binding}" Click="Item_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" util:RoundedClip.Radius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
                  <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" util:DynamicRenderSystem.LazyImageSource="{Binding Image, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" />
                  <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" />
                </StackPanel>
              </Grid>
            </ui:Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </StackPanel>
    </ui:DynamicScrollViewer>
    <Border Grid.Row="3" Margin="0,10,0,0" Padding="8" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Width="44" Height="44" util:RoundedClip.Radius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}">
          <Image x:Name="NowImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
          <TextBlock x:Name="NowTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <TextBlock x:Name="NowArtist" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="PositionText" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <Slider x:Name="SeekSlider" Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" PreviewMouseLeftButtonUp="SeekSlider_MouseUp" />
          <TextBlock x:Name="DurationText" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="110" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <ui:Button x:Name="ShuffleButton" Width="34" Height="30" Padding="0" Margin="0,0,4,0" Appearance="Transparent" Icon="ArrowShuffle24" Tag="control-button-shuffle" Click="Control_Click" />
            <ui:Button x:Name="RepeatButton" Width="34" Height="30" Padding="0" Margin="0,0,4,0" Appearance="Transparent" Icon="ArrowRepeatAll24" Tag="control-button-repeat" Click="Control_Click" />
            <ui:Button x:Name="LikeButton" Width="34" Height="30" Padding="0" Margin="0,0,4,0" Appearance="Transparent" Icon="Heart24" Click="Like_Click" />
            <ui:Button Width="34" Height="30" Padding="0" Appearance="Transparent" Icon="TextBulletListLtr24" Click="Queue_Click" />
          </StackPanel>
          <ui:SymbolIcon Grid.Column="2" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="16" Symbol="Speaker224" />
          <Slider x:Name="VolumeSlider" Grid.Column="3" VerticalAlignment="Center" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" PreviewMouseLeftButtonUp="VolumeSlider_MouseUp" />
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <ui:Button Width="34" Height="34" Padding="0" Appearance="Transparent" Icon="Previous24" Tag="control-button-skip-back" Click="Control_Click" />
          <ui:Button x:Name="PlayPause" Width="38" Height="38" Padding="0" Margin="4,0" Appearance="Primary" Icon="Play24" Tag="control-button-playpause" Click="Control_Click" />
          <ui:Button Width="34" Height="34" Padding="0" Appearance="Transparent" Icon="Next24" Tag="control-button-skip-forward" Click="Control_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
