<UserControl x:Class="Voidstrap.UI.Elements.Controls.GameVoteBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:util="clr-namespace:Voidstrap.Utility" xmlns:resources="clr-namespace:Voidstrap.Resources">
  <StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ui:Button x:Name="LikeButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,6" Appearance="Transparent" Click="LikeButton_Click" ToolTip="{resources:Loc Library_Vote_Like}" AutomationProperties.Name="{resources:Loc Library_Vote_Like}">
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon x:Name="LikeIcon" Symbol="ThumbLike24" FontSize="16" VerticalAlignment="Center" />
          <TextBlock x:Name="LikesText" Margin="6,0,0,0" FontSize="14" VerticalAlignment="Center" Text="--" util:CountUpText.Format="compactplus" />
        </StackPanel>
      </ui:Button>
      <ui:Button x:Name="DislikeButton" Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,6" Appearance="Transparent" Click="DislikeButton_Click" ToolTip="{resources:Loc Library_Vote_Dislike}" AutomationProperties.Name="{resources:Loc Library_Vote_Dislike}">
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon x:Name="DislikeIcon" Symbol="ThumbDislike24" FontSize="16" VerticalAlignment="Center" />
          <TextBlock x:Name="DislikesText" Margin="6,0,0,0" FontSize="14" VerticalAlignment="Center" Text="--" util:CountUpText.Format="compactplus" />
        </StackPanel>
      </ui:Button>
    </Grid>
    <ProgressBar x:Name="RatioBar" Margin="0,6,0,0" Height="4" Minimum="0" Maximum="100" Value="0" />
    <TextBlock x:Name="StatusText" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />
  </StackPanel>
</UserControl>
