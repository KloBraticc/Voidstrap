<UserControl x:Class="Voidstrap.UI.Elements.Controls.DownloadNotificationCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Width="390" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
  <UserControl.RenderTransform>
    <TranslateTransform x:Name="CardTranslate" X="28" />
  </UserControl.RenderTransform>
  <Border Padding="14" CornerRadius="7" Background="{DynamicResource SystemFillColorSolidNeutralBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000" />
    </Border.Effect>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ui:SymbolIcon x:Name="CardIcon" Grid.Column="0" Grid.RowSpan="2" Margin="0,1,12,0" VerticalAlignment="Top" FontSize="22" Symbol="ArrowDownload24" />
      <TextBlock x:Name="CardTitle" Grid.Column="1" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
      <ui:Button x:Name="CardDismiss" Grid.Column="2" Width="30" Height="30" Margin="10,-5,-5,0" Padding="0" Appearance="Transparent" Icon="Dismiss24" ToolTip="Cancel" Click="Dismiss_Click" />
      <TextBlock x:Name="CardMessage" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
      <ProgressBar x:Name="CardProgress" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" Margin="0,10,0,0" Height="6" Minimum="0" Maximum="100" IsIndeterminate="True" />
      <ui:Button x:Name="CardAction" Grid.Column="1" Grid.Row="3" Margin="0,10,0,0" HorizontalAlignment="Left" Appearance="Secondary" Content="Cancel" Click="Dismiss_Click" />
    </Grid>
  </Border>
</UserControl>
