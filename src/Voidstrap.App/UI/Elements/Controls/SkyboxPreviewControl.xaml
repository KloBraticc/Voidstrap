<UserControl
    x:Class="Voidstrap.UI.Elements.Controls.SkyboxPreviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="Root"
    Focusable="False"
    Cursor="Hand"
    MouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
    MouseMove="OnPreviewMouseMove"
    MouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
    MouseWheel="OnPreviewMouseWheel">
  <Grid Background="#FF0D0E12" ClipToBounds="True">
    <Viewport3D x:Name="Viewport">
      <Viewport3D.Camera>
        <PerspectiveCamera x:Name="Camera" Position="0,0,3" LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="42" />
      </Viewport3D.Camera>
      <ModelVisual3D>
        <ModelVisual3D.Content>
          <Model3DGroup>
            <AmbientLight Color="#FFA9ADB6" />
            <DirectionalLight Color="#FF6B6B70" Direction="-0.45,-0.55,-0.7" />
            <DirectionalLight Color="#FF2E2E36" Direction="0.6,0.2,0.75" />
          </Model3DGroup>
        </ModelVisual3D.Content>
      </ModelVisual3D>
      <ModelVisual3D x:Name="BallVisual" />
    </Viewport3D>
    <Image x:Name="SoftwareView" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed" />
    <TextBlock
        x:Name="StatusText"
        Margin="12,0,12,10"
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        TextAlignment="Center"
        TextWrapping="Wrap"
        MaxWidth="230"
        FontSize="11.5"
        Foreground="#FFB6BAC4"
        IsHitTestVisible="False"
        Visibility="Collapsed" />
    <ui:ProgressRing
        x:Name="LoadingPanel"
        Width="26"
        Height="26"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        IsIndeterminate="True"
        IsHitTestVisible="False"
        Visibility="Collapsed" />
  </Grid>
</UserControl>
