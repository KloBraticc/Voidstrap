<UserControl
    x:Class="Voidstrap.UI.Elements.Controls.AvatarPreviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:resources="clr-namespace:Voidstrap.Resources"
    xmlns:util="clr-namespace:Voidstrap.Utility"
    x:Name="Root"
    Focusable="False"
    MouseLeftButtonDown="OnPreviewDown"
    MouseRightButtonDown="OnPreviewDown"
    MouseMove="OnPreviewMove"
    MouseLeftButtonUp="OnPreviewUp"
    MouseRightButtonUp="OnPreviewUp"
    LostMouseCapture="OnPreviewLostCapture"
    MouseWheel="OnPreviewWheel"
    SizeChanged="OnPreviewSizeChanged"
    Loaded="OnPreviewLoaded"
    Unloaded="OnPreviewUnloaded">
  <Grid x:Name="Host" ClipToBounds="True" util:RoundedClip.Radius="8">
    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" />
    <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" util:DynamicRenderSystem.LazyImageSource="{Binding BackgroundUrl, ElementName=Root, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
    <Image x:Name="FlatImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" util:DynamicRenderSystem.LazyImageSource="{Binding ImageUrl, ElementName=Root, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
    <Viewport3D x:Name="Viewport" Visibility="Collapsed" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality">
      <Viewport3D.Camera>
        <PerspectiveCamera x:Name="Camera" Position="0,0,10" LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="30" />
      </Viewport3D.Camera>
      <ModelVisual3D>
        <ModelVisual3D.Content>
          <Model3DGroup>
            <AmbientLight Color="#FFC4C4C8" />
            <DirectionalLight Color="#FF4A4A4E" Direction="-0.4,-0.5,-0.75" />
            <DirectionalLight Color="#FF2A2A2E" Direction="0.5,-0.2,0.8" />
          </Model3DGroup>
        </ModelVisual3D.Content>
      </ModelVisual3D>
      <ModelVisual3D x:Name="BackdropVisual" />
      <ModelVisual3D x:Name="AvatarVisual" />
    </Viewport3D>
    <Image x:Name="SoftwareView" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" Visibility="Collapsed" />
    <ui:Button x:Name="ResetButton" Width="30" Height="30" Margin="0,8,8,0" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Icon="ArrowReset24" Visibility="Collapsed" ToolTip="{resources:Loc Accounts_Avatar_ResetView}" AutomationProperties.Name="{resources:Loc Accounts_Avatar_ResetView}" Click="OnResetClick" />
    <ui:Button x:Name="RotateButton" Width="30" Height="30" Margin="0,8,44,0" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Icon="Pause24" Visibility="Collapsed" ToolTip="{resources:Loc Accounts_Avatar_AutoRotate}" AutomationProperties.Name="{resources:Loc Accounts_Avatar_AutoRotate}" Click="OnRotateClick" />
    <ui:ProgressRing Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" IsIndeterminate="True" IsHitTestVisible="False" Visibility="{Binding IsLoading, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
  </Grid>
</UserControl>
