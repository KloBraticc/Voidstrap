<UserControl x:Class="Voidstrap.UI.Elements.Controls.WorldServerMap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             MinHeight="240" Focusable="True" Loaded="OnLoaded" Unloaded="OnUnloaded">
  <Border x:Name="Viewport" ClipToBounds="True" CornerRadius="6" BorderThickness="1"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
          MouseLeftButtonDown="Viewport_MouseLeftButtonDown" MouseMove="Viewport_MouseMove"
          MouseLeftButtonUp="Viewport_MouseLeftButtonUp" MouseWheel="Viewport_MouseWheel">
    <Grid x:Name="Surface" Background="Transparent" SizeChanged="Surface_SizeChanged">
      <Canvas x:Name="MapLayer" Background="Transparent">
        <Path x:Name="LandPath" Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeLineJoin="Round" />
        <Path x:Name="BorderPath" Stroke="{DynamicResource SolidBackgroundFillColorBaseBrush}" StrokeLineJoin="Round" Opacity="0.7" IsHitTestVisible="False" />
      </Canvas>
      <Canvas x:Name="PinLayer" />

      <Grid Margin="8">
        <ui:TextBox x:Name="SearchBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="220" Padding="8,4,8,4" Icon="Search24"
                    PlaceholderText="Find a city or country" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,6,10,6" CornerRadius="6"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
          <TextBlock x:Name="SelectionText" FontSize="12" Text="Click a pin to choose a datacenter" />
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <ui:Button Padding="6" Margin="4,0,0,0" Icon="Location24" ToolTip="Center on selected datacenter" Click="GoToSelected_Click" />
          <ui:Button Padding="6" Margin="4,0,0,0" Icon="ZoomOut24" ToolTip="Zoom out" Click="ZoomOut_Click" />
          <ui:Button Padding="6" Margin="4,0,0,0" Icon="ZoomIn24" ToolTip="Zoom in" Click="ZoomIn_Click" />
        </StackPanel>
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="8,4,8,4" CornerRadius="6"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Orientation="Horizontal">
            <StackPanel.Resources>
              <Style TargetType="Ellipse">
                <Setter Property="Width" Value="9" />
                <Setter Property="Height" Value="9" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
              </Style>
              <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
              </Style>
            </StackPanel.Resources>
            <Ellipse Fill="{DynamicResource SystemFillColorSuccessBrush}" /><TextBlock Text="under 70 ms" />
            <Ellipse Fill="{DynamicResource SystemFillColorCautionBrush}" /><TextBlock Text="under 140 ms" />
            <Ellipse Fill="{DynamicResource SystemFillColorCriticalBrush}" /><TextBlock Text="slower" />
            <Ellipse Fill="{DynamicResource TextFillColorTertiaryBrush}" Opacity="0.5" /><TextBlock Text="blocked" Margin="0" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
