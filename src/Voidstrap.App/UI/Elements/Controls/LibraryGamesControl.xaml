<UserControl PreviewKeyDown="Root_PreviewKeyDown" x:Class="Voidstrap.UI.Elements.Controls.LibraryGamesControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:util="clr-namespace:Voidstrap.Utility" xmlns:resources="clr-namespace:Voidstrap.Resources">
  <UserControl.Resources>
    <Style x:Key="TileActionButton" TargetType="Button">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="15" Background="#73000000" BorderBrush="#40FFFFFF" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#A6000000" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="GameTileTemplate">
      <Grid x:Name="Tile" Width="{Binding TileSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,14,18" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Tile_Click">
        <Grid.RowDefinitions>
          <RowDefinition Height="{Binding TileSize, RelativeSource={RelativeSource AncestorType=UserControl}}" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border CornerRadius="10" Background="{DynamicResource ControlFillColorDefaultBrush}">
          <Border.OpacityMask>
            <VisualBrush>
              <VisualBrush.Visual>
                <Border Width="100" Height="100" CornerRadius="6" Background="Black" />
              </VisualBrush.Visual>
            </VisualBrush>
          </Border.OpacityMask>
          <Grid>
            <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" util:DynamicRenderSystem.LazyImageSource="{Binding ThumbnailUrl}" />
            <Border x:Name="Overlay" Opacity="0" IsHitTestVisible="False">
              <Border.Background>
                <LinearGradientBrush StartPoint="1,0" EndPoint="0,0.6">
                  <GradientStop Color="#66000000" Offset="0" />
                  <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <StackPanel Margin="0,8,8,0" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Vertical">
                <Button Style="{StaticResource TileActionButton}" Click="Favorite_Click" ToolTip="{resources:Loc ContextMenu_GameBrowser_Favorites}">
                  <ui:SymbolIcon Symbol="Heart24" FontSize="14" Filled="{Binding IsFavorite}" />
                </Button>
                <Button Style="{StaticResource TileActionButton}" Click="Play_Click" ToolTip="{resources:Loc Ui_Pages_Play}">
                  <ui:SymbolIcon Symbol="Play24" FontSize="14" Filled="True" />
                </Button>
                <Button Style="{StaticResource TileActionButton}" Click="View_Click" ToolTip="{resources:Loc Ui_Mods_View}">
                  <ui:SymbolIcon Symbol="Eye24" FontSize="14" />
                </Button>
                <Button Style="{StaticResource TileActionButton}" Click="More_Click" ToolTip="{resources:Loc Ui_Nav_More}">
                  <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="14" />
                </Button>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
        <TextBlock Grid.Row="1" Margin="2,8,2,0" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip="{Binding Name}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <StackPanel Grid.Row="2" Margin="2,4,2,0" Orientation="Horizontal">
          <ui:SymbolIcon Symbol="People16" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock Margin="5,0,10,0" FontSize="12" VerticalAlignment="Center" Text="{Binding PlayerCount}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <Ellipse Width="7" Height="7" Fill="#FF3FB950" VerticalAlignment="Center" Visibility="{Binding LikeVisibility}" />
          <TextBlock Margin="5,0,0,0" FontSize="12" VerticalAlignment="Center" Text="{Binding LikePercent}" Visibility="{Binding LikeVisibility}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Grid>
      <DataTemplate.Triggers>
        <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
          <Setter TargetName="Overlay" Property="Opacity" Value="1" />
          <Setter TargetName="Overlay" Property="IsHitTestVisible" Value="True" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Margin="0,4,0,0" Style="{StaticResource SearchPillBorder}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
      <ComboBox x:Name="SortBox" MinWidth="150" Style="{StaticResource SearchPillComboBox}" SelectedIndex="0" ToolTip="{resources:Loc Ui_Session_SortBy}" SelectionChanged="SortBox_SelectionChanged">
        <ComboBoxItem Content="{resources:Loc ContextMenu_ServerBrowser_Sort_Best}" />
        <ComboBoxItem Content="{resources:Loc ContextMenu_ServerBrowser_Sort_Population}" />
        <ComboBoxItem Content="{resources:Loc ContextMenu_ServerBrowser_Sort_Empty}" />
        <ComboBoxItem Content="{resources:Loc Ui_Mods_StudioPlugins_RatingLabel}" />
        <ComboBoxItem Content="{resources:Loc Common_Name}" />
      </ComboBox>
      <Rectangle Grid.Column="1" Style="{StaticResource SearchPillDivider}" />
      <ui:TextBox x:Name="SearchBox" Grid.Column="2" Style="{StaticResource SearchPillTextBox}" PlaceholderText="{resources:Loc Ui_Pages_SearchByGameNameCreatorOr}" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="2,16,0,10">
      <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{resources:Loc Ui_Home_RecommendedForYou}" />
      <ProgressBar x:Name="LoadingBar" Height="4" Width="120" HorizontalAlignment="Right" VerticalAlignment="Center" IsIndeterminate="True" Visibility="Collapsed" />
    </Grid>
    <ui:DynamicScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock x:Name="StatusText" Margin="2,4,0,0" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <ItemsControl x:Name="GamesList" Margin="0,0,-14,0" SizeChanged="GamesList_SizeChanged" ItemTemplate="{StaticResource GameTileTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </ui:DynamicScrollViewer>
  </Grid>
</UserControl>
