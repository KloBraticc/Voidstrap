<UserControl x:Class="Voidstrap.UI.Elements.Controls.OptionControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Voidstrap.UI.Elements.Controls" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:Voidstrap.UI.ViewModels" xmlns:resources="clr-namespace:Voidstrap.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Name="RootControl">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ui:CardControl Margin="0,8,0,0">
    <ui:CardControl.Header>
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Name="HeaderTextBlock" Grid.Column="0" FontSize="14" />
          <TextBlock Name="HelpLinkTextBlock" Grid.Column="1" Margin="4,0,0,0" Visibility="Collapsed">
            <Hyperlink Name="HelpLinkHyperlink" Command="{x:Static models:GlobalViewModel.OpenWebpageCommand}" TextDecorations="None" ToolTip="{x:Static resources:Strings.Menu_MoreInfo}">
              <ui:SymbolIcon Margin="0,1,0,0" Symbol="QuestionCircle48" />
            </Hyperlink>
          </TextBlock>
        </Grid>
        <local:MarkdownTextBlock x:Name="DescriptionTextBlock" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
      </StackPanel>
    </ui:CardControl.Header>
    <ContentControl.Content>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" />
        <ContentPresenter Name="InnerContentPresenter" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" />
      </Grid>
    </ContentControl.Content>
  </ui:CardControl>
</UserControl>