<ui:UiPage x:Class="Voidstrap.UI.Elements.About.Pages.SupportersPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:models="clr-namespace:Voidstrap.UI.ViewModels" xmlns:enums="clr-namespace:Voidstrap.Enums" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:resources="clr-namespace:Voidstrap.Resources" Title="AboutPage" Scrollable="True" xmlns:pages="clr-namespace:Voidstrap.UI.Elements.About.Pages" xmlns:appUi="clr-namespace:Voidstrap.UI" SizeChanged="UiPage_SizeChanged" Unloaded="UiPage_Unloaded">
  <ui:UiPage.Resources>
    <Style x:Key="SupporterCard" TargetType="{x:Type Border}">
      <Setter Property="Margin" Value="4" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StateCard" TargetType="{x:Type Border}">
      <Setter Property="Margin" Value="0,20,0,0" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <DataTemplate x:Key="SupporterCardTemplate">
      <Border Style="{StaticResource SupporterCard}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid Width="32" Height="32" VerticalAlignment="Center">
            <Ellipse Fill="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Ellipse>
              <Ellipse.Fill>
                <ImageBrush ImageSource="{Binding Image, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
              </Ellipse.Fill>
            </Ellipse>
            <Image Source="{Binding Image, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{x:Static appUi:PlatformFeatureVisibility.LinuxIntegration}">
              <Image.Clip>
                <EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16" />
              </Image.Clip>
            </Image>
          </Grid>
          <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>
    </DataTemplate>
  </ui:UiPage.Resources>
  <StackPanel Margin="0,0,18,18">
    <TextBlock Text="{x:Static resources:Strings.About_Supporters_Title}" FontWeight="SemiBold" FontSize="26" />
    <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Thank you to everyone who helps keep Voidstrap going." TextWrapping="Wrap" />
    <Border>
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Border}" BasedOn="{StaticResource StateCard}">
          <Style.Triggers>
            <DataTrigger Value="{x:Static enums:GenericTriState.Unknown}" Binding="{Binding LoadedState, Mode=OneWay}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
          <Setter Property="Visibility" Value="Collapsed" />
        </Style>
      </FrameworkElement.Style>
      <StackPanel Orientation="Horizontal">
        <ui:ProgressRing Width="22" Height="22" IsIndeterminate="True" />
        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{x:Static resources:Strings.Common_Loading}" />
      </StackPanel>
    </Border>
    <Border>
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Border}" BasedOn="{StaticResource StateCard}">
          <Style.Triggers>
            <DataTrigger Value="{x:Static enums:GenericTriState.Failed}" Binding="{Binding LoadedState, Mode=OneWay}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
          <Setter Property="Visibility" Value="Collapsed" />
        </Style>
      </FrameworkElement.Style>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:SymbolIcon Grid.Column="0" Margin="0,2,0,0" VerticalAlignment="Top" Symbol="ErrorCircle24" FontSize="22" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        <StackPanel Grid.Column="1" Margin="12,0,0,0">
          <TextBlock FontWeight="SemiBold" Text="{x:Static resources:Strings.Common_NetworkError}" />
          <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding LoadError, Mode=OneWay}" TextWrapping="Wrap" />
          <ui:Button Margin="0,10,0,0" Content="Try again" Icon="ArrowClockwise24" Command="{Binding RetryCommand, Mode=OneTime}" />
        </StackPanel>
      </Grid>
    </Border>
    <StackPanel>
      <FrameworkElement.Style>
        <Style TargetType="{x:Type StackPanel}">
          <Style.Triggers>
            <DataTrigger Value="{x:Static enums:GenericTriState.Successful}" Binding="{Binding LoadedState, Mode=OneWay}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
          <Setter Property="Visibility" Value="Collapsed" />
        </Style>
      </FrameworkElement.Style>
      <TextBlock Margin="0,22,0,10" FontSize="16" FontWeight="SemiBold" Text="Special People" />
      <ItemsControl Margin="-4,0,-4,0" Focusable="False" ItemsSource="{Binding SupporterData.Monthly.Supporters, Mode=OneWay}" ItemTemplate="{StaticResource SupporterCardTemplate}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="{Binding Columns}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</ui:UiPage>