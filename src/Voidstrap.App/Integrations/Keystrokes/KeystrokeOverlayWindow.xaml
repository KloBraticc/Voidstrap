<Window x:Class="Voidstrap.Integrations.Keystrokes.KeystrokeOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voidstrap Keystrokes"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        SizeToContent="WidthAndHeight"
        Loaded="OnOverlayLoaded"
        Closed="OnOverlayClosed">
  <Grid x:Name="RootLayout" Margin="4">
    <Grid.LayoutTransform>
      <ScaleTransform x:Name="OverlayScaleTransform" ScaleX="1.0" ScaleY="1.0" />
    </Grid.LayoutTransform>

    <ContentPresenter x:Name="ScriptHost" Visibility="Collapsed" />

    <StackPanel x:Name="OverlayMainLayout" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border x:Name="OverlayMouseCircle" Width="88" Height="88" CornerRadius="44" BorderThickness="1.25"
              Margin="0,0,14,0" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Ellipse x:Name="OverlayMouseDot" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <StackPanel x:Name="DefaultKeysPanel" Orientation="Vertical">
        <StackPanel x:Name="RowW" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
          <Border x:Name="KeyW" Width="46" Height="46" CornerRadius="8" BorderThickness="1"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
              <Border x:Name="KeyWHighlight" CornerRadius="7" Opacity="0"
                      Background="{DynamicResource SystemAccentColorPrimaryBrush}" />
              <TextBlock x:Name="KeyWText" Text="W" FontSize="15" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Grid>
          </Border>
        </StackPanel>

        <StackPanel x:Name="RowASD" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
          <Border x:Name="KeyA" Width="46" Height="46" CornerRadius="8" BorderThickness="1" Margin="0,0,3,0"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
              <Border x:Name="KeyAHighlight" CornerRadius="7" Opacity="0"
                      Background="{DynamicResource SystemAccentColorPrimaryBrush}" />
              <TextBlock x:Name="KeyAText" Text="A" FontSize="15" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Grid>
          </Border>
          <Border x:Name="KeyS" Width="46" Height="46" CornerRadius="8" BorderThickness="1" Margin="0,0,3,0"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
              <Border x:Name="KeySHighlight" CornerRadius="7" Opacity="0"
                      Background="{DynamicResource SystemAccentColorPrimaryBrush}" />
              <TextBlock x:Name="KeySText" Text="S" FontSize="15" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Grid>
          </Border>
          <Border x:Name="KeyD" Width="46" Height="46" CornerRadius="8" BorderThickness="1"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
              <Border x:Name="KeyDHighlight" CornerRadius="7" Opacity="0"
                      Background="{DynamicResource SystemAccentColorPrimaryBrush}" />
              <TextBlock x:Name="KeyDText" Text="D" FontSize="15" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Grid>
          </Border>
        </StackPanel>

        <StackPanel x:Name="RowMouse" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
          <Border x:Name="KeyLmb" Width="71" Height="46" CornerRadius="8" BorderThickness="1" Margin="0,0,3,0"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
              <Border x:Name="KeyLmbHighlight" CornerRadius="7" Opacity="0"
                      Background="{DynamicResource SystemAccentColorPrimaryBrush}" />
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="KeyLmbText" Text="LMB" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="TextLmbCps" Text="0 CPS" FontSize="10"
                           HorizontalAlignment="Center" Margin="0,1,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Grid>
          </Border>
          <Border x:Name="KeyRmb" Width="71" Height="46" CornerRadius="8" BorderThickness="1"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
              <Border x:Name="KeyRmbHighlight" CornerRadius="7" Opacity="0"
                      Background="{DynamicResource SystemAccentColorPrimaryBrush}" />
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="KeyRmbText" Text="RMB" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="TextRmbCps" Text="0 CPS" FontSize="10"
                           HorizontalAlignment="Center" Margin="0,1,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <StackPanel x:Name="RowBottom" Orientation="Horizontal" HorizontalAlignment="Center">
          <Border x:Name="KeyShift" Width="51" Height="34" CornerRadius="8" BorderThickness="1" Margin="0,0,3,0"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
              <Border x:Name="KeyShiftHighlight" CornerRadius="7" Opacity="0"
                      Background="{DynamicResource SystemAccentColorPrimaryBrush}" />
              <TextBlock x:Name="KeyShiftText" Text="SHIFT" FontSize="11" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Grid>
          </Border>
          <Border x:Name="KeySpace" Width="91" Height="34" CornerRadius="8" BorderThickness="1"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
              <Border x:Name="KeySpaceHighlight" CornerRadius="7" Opacity="0"
                      Background="{DynamicResource SystemAccentColorPrimaryBrush}" />
              <TextBlock x:Name="KeySpaceText" Text="—" FontSize="14" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Grid>
          </Border>
        </StackPanel>
      </StackPanel>

      <StackPanel x:Name="DynamicKeysPanel" Orientation="Vertical" Visibility="Collapsed" />
    </StackPanel>
  </Grid>
</Window>
