<Application x:Class="Voidstrap.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:Voidstrap.UI.Converters" xmlns:local="clr-namespace:Voidstrap" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
      <ResourceDictionary Source="UI/Style/RinUI.xaml" />
      <ResourceDictionary Source="UI/Style/Dark.xaml" />
      <ResourceDictionary Source="UI/Style/Default.xaml" />
      <ResourceDictionary Source="UI/Style/FastFlags.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="DefaultControlFocusVisualStyle" />
      <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" BasedOn="{StaticResource DefaultControlFocusVisualStyle}" />
      <FontFamily x:Key="Rubik">pack://application:,,,/Resources/Fonts/#Rubik Light</FontFamily>
      <SolidColorBrush x:Key="AccentColorSecondaryBrush" Color="{DynamicResource SystemAccentColorSecondary}" />
      <SolidColorBrush x:Key="AccentColorTertiaryBrush" Color="{DynamicResource SystemAccentColorTertiary}" />
      <Color x:Key="AccentFillColorPrimary">#80B9EE</Color>
      <SolidColorBrush x:Key="AccentFillColorPrimaryBrush" Color="#80B9EE" />
      <LinearGradientBrush x:Key="RobuxGoldBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0" Color="#FFEEDFA2" />
        <GradientStop Offset="0.59" Color="#FFA9935A" />
        <GradientStop Offset="1" Color="#FFFEE3A5" />
      </LinearGradientBrush>
      <Geometry x:Key="RobuxGoldGeometry">F1 M 21.4,4.62 A 5.2,5.2 0 0 1 24,9.12 V 17 a 5.19,5.19 0 0 1 -2.6,4.5 l -6.8,3.93 a 5.19,5.19 0 0 1 -5.2,0 L 2.6,21.48 A 5.19,5.19 0 0 1 0,17 V 9.12 a 5.2,5.2 0 0 1 2.6,-4.5 L 9.4,0.7 a 5.19,5.19 0 0 1 5.2,0 Z M 10.31,2.48 L 3.69,6.31 A 3.35,3.35 0 0 0 2,9.23 v 7.65 A 3.36,3.36 0 0 0 3.69,19.8 l 6.62,3.83 a 3.4,3.4 0 0 0 3.38,0 l 6.62,-3.83 A 3.36,3.36 0 0 0 22,16.88 V 9.23 a 3.35,3.35 0 0 0 -1.69,-2.92 L 13.69,2.48 a 3.4,3.4 0 0 0 -3.38,0 Z M 13.39,4.62 l 5.22,3 A 2.78,2.78 0 0 1 20,10 v 6 a 2.76,2.76 0 0 1 -1.39,2.4 l -5.22,3 a 2.76,2.76 0 0 1 -2.78,0 l -5.22,-3 A 2.76,2.76 0 0 1 4,16.07 V 10 A 2.78,2.78 0 0 1 5.39,7.63 l 5.22,-3 a 2.76,2.76 0 0 1 2.78,0 Z M 9,16.05 h 6 v -6 H 9 Z</Geometry>
      <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource SystemAccentColor}" />
      <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource TextOnAccentFillColorSelectedText}" />
      <Style TargetType="{x:Type FlowDocumentScrollViewer}">
        <Setter Property="SelectionBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
        <Setter Property="SelectionOpacity" Value="0.55" />
      </Style>
      <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="SelectionBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
      </Style>
      <Style TargetType="{x:Type RichTextBox}" BasedOn="{StaticResource {x:Type RichTextBox}}">
        <Setter Property="SelectionBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
      </Style>
      <Style TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
        <Setter Property="SelectionBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
      </Style>
      <Style TargetType="{x:Type Image}">
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
      </Style>
      <Style x:Key="{x:Type Hyperlink}" TargetType="{x:Type Hyperlink}">
        <Setter Property="Inline.TextDecorations" Value="None" />
        <Setter Property="Foreground" Value="{StaticResource AccentColorSecondaryBrush}" />
        <Style.Triggers>
          <Trigger Property="ContentElement.IsMouseOver" Value="True">
            <Setter Property="Foreground" Value="{StaticResource AccentColorTertiaryBrush}" />
            <Setter Property="Inline.TextDecorations" Value="Underline" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="VoidstrapDataGridCellStyle" TargetType="{x:Type DataGridCell}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type DataGridCell}">
              <Border Background="{TemplateBinding Control.Background}" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
          </DataTrigger>
          <Trigger Property="DataGridCell.IsSelected" Value="True">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="{x:Type DataGrid}" BasedOn="{StaticResource DefaultDataGridStyle}" TargetType="{x:Type DataGrid}">
        <Setter Property="DataGrid.CellStyle" Value="{StaticResource VoidstrapDataGridCellStyle}" />
      </Style>
      <converters:StringFormatConverter x:Key="StringFormatConverter" />
      <converters:WindowsOnlyImageSourceConverter x:Key="WindowsOnlyImageSourceConverter" />
      <converters:StatusLineConverter x:Key="StatusLineConverter" />
      <converters:RangeConverter x:Key="RangeConverter" />
      <converters:EnumNameConverter x:Key="EnumNameConverter" />
      <converters:CursorPreviewConverter x:Key="CursorPreviewConverter" />
      <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
