<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <AssemblyName>VoidstrapClient.Common</AssemblyName>
    <RootNamespace>VoidstrapClient.Common</RootNamespace>
    <Nullable>annotations</Nullable>
    <SupportedOSPlatformVersion>10.0.14393.0</SupportedOSPlatformVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>CS0168;CS0219;CS0649;CS0414;CS0169;CS1998;CS0162;CS0184;CS8321;CS0472;CS4014</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

</Project>
