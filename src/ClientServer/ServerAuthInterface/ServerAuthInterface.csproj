<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <AssemblyName>VoidstrapClient.ServerAuthInterface</AssemblyName>
    <RootNamespace>VoidstrapClient.ServerAuthInterface</RootNamespace>
    <Nullable>annotations</Nullable>
    <SupportedOSPlatformVersion>10.0.14393.0</SupportedOSPlatformVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TextCopy" Version="6.2.1" />
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClientCommon\ClientCommon.csproj" />
  </ItemGroup>

</Project>
