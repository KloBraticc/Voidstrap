<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/files_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/mods_info"
        android:textAppearance="@style/TextAppearance.Voidstrap.Tertiary" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/import_files"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mods_import_files"
            app:icon="@drawable/ic_arrow_import" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/import_pack"
            style="@style/Widget.Voidstrap.Button.Subtle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mods_import_pack"
            app:icon="@drawable/ic_arrow_download" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/new_folder"
            style="@style/Widget.Voidstrap.Button.Subtle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mods_new_folder"
            app:icon="@drawable/ic_folder_add" />

        <androidx.constraintlayout.helper.widget.Flow
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="import_files,import_pack,new_folder"
            app:flow_horizontalBias="0"
            app:flow_horizontalGap="8dp"
            app:flow_horizontalStyle="packed"
            app:flow_verticalGap="8dp"
            app:flow_wrapMode="chain"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/search_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/mods_search"
        app:endIconMode="clear_text"
        app:startIconDrawable="@drawable/ic_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/up"
            style="@style/Widget.Voidstrap.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/mods_up"
            app:icon="@drawable/ic_arrow_left" />

        <TextView
            android:id="@+id/breadcrumb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="start"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Voidstrap.Section" />
    </LinearLayout>

    <TextView
        android:id="@+id/files_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.Voidstrap.Caption" />
</LinearLayout>
