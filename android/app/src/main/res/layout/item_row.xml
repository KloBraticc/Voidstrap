<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/vs_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp">

    <FrameLayout
        android:id="@+id/row_tile"
        android:layout_width="@dimen/vs_icon_tile"
        android:layout_height="@dimen/vs_icon_tile"
        android:background="@drawable/vs_icon_tile">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/row_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearance="@style/Shape.Voidstrap.Card" />

        <ImageView
            android:id="@+id/row_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="?attr/vsTextSecondary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Voidstrap.RowTitle" />

        <TextView
            android:id="@+id/row_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Voidstrap.RowSummary" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/vs_icon_tile"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:textAppearance="@style/TextAppearance.Voidstrap.Tertiary"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/row_more"
        style="@style/Widget.Voidstrap.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/common_more"
        android:visibility="gone"
        app:icon="@drawable/ic_more_vertical" />

    <ImageView
        android:id="@+id/row_chevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        android:visibility="gone"
        app:tint="?attr/vsTextTertiary" />

    <com.google.android.material.radiobutton.MaterialRadioButton
        android:id="@+id/row_radio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone" />
</LinearLayout>
