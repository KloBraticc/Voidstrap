    <style name="Theme.Voidstrap" parent="Base.Theme.Voidstrap" />

    <style name="Theme.Voidstrap.Brand" parent="Base.Theme.Voidstrap">
        <item name="colorPrimary">@color/vs_p_primary</item>
        <item name="colorAccent">@color/vs_p_primary</item>
        <item name="colorOnPrimary">@color/vs_p_on_primary</item>
        <item name="colorSecondary">@color/vs_p_primary</item>
        <item name="colorOnSecondary">@color/vs_p_on_primary</item>
        <item name="colorTertiary">@color/vs_p_primary</item>
        <item name="android:textColorLink">@color/vs_p_primary</item>
        <item name="vsWindow">@color/vs_p_window</item>
        <item name="vsSidebar">@color/vs_p_sidebar</item>
        <item name="vsCard">@color/vs_p_card</item>
        <item name="vsMenu">@color/vs_p_menu</item>
        <item name="vsInput">@color/vs_p_input</item>
        <item name="vsTextPrimary">@color/vs_p_text_primary</item>
        <item name="vsTextSecondary">@color/vs_p_text_secondary</item>
        <item name="vsTextTertiary">@color/vs_p_text_tertiary</item>
    </style>

    <style name="Theme.Voidstrap.Trampoline" parent="Theme.Voidstrap">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="ThemeOverlay.Voidstrap.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Voidstrap.BottomSheet</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="ThemeOverlay.Voidstrap.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">?attr/vsMenu</item>
        <item name="colorSurfaceContainerHigh">?attr/vsMenu</item>
        <item name="shapeAppearanceOverlay">@style/Shape.Voidstrap.Overlay</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Voidstrap.Button.DialogText</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Voidstrap.Button.DialogText</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Voidstrap.Button.DialogText</item>
