<?xml version="1.0" encoding="utf-8"?>
<com.voidstrap.android.ScrollPane xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout style="@style/Voidstrap.Page">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/smart_title"
            android:textAppearance="@style/TextAppearance.Voidstrap.PageTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/smart_page_body"
            android:textAppearance="@style/TextAppearance.Voidstrap.PageSubtitle" />

        <LinearLayout
            android:id="@+id/smart_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />
    </LinearLayout>
</com.voidstrap.android.ScrollPane>
