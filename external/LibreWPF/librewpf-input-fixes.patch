+    [Fact]
+    public void WorkAvailableIsCoalescedWhileOperationsAreAlreadyQueued()
+    {
+        var dispatcher = new QueuedWpfDispatcherService();
+        var workAvailableCount = 0;
+        dispatcher.WorkAvailable += (_, _) => workAvailableCount++;
+
+        for (var i = 0; i < 10000; i++)
+        {
+            dispatcher.Post(() => { });
+        }
+
+        Assert.Equal(1, workAvailableCount);
+        Assert.True(dispatcher.HasPendingOperations);
+        Assert.True(dispatcher.ProcessPending());
+        Assert.False(dispatcher.HasPendingOperations);
+    }
+
+    [Fact]
+    public void BoundedProcessingYieldsWithOperationsRemaining()
+    {
+        var dispatcher = new QueuedWpfDispatcherService();
+        var count = 0;
+
+        for (var i = 0; i < 600; i++)
+        {
+            dispatcher.Post(() => count++);
+        }
+
+        Assert.True(dispatcher.ProcessPending(256));
+        Assert.Equal(256, count);
+        Assert.True(dispatcher.HasPendingOperations);
+
+        Assert.True(dispatcher.ProcessPending(256));
+        Assert.Equal(512, count);
+        Assert.True(dispatcher.HasPendingOperations);
+
+        Assert.True(dispatcher.ProcessPending(256));
+        Assert.Equal(600, count);
+        Assert.False(dispatcher.HasPendingOperations);
+    }
+
+    [Fact]
+    public void LargeMixedPriorityBurstRetainsPriorityAndFifoOrder()
+    {
+        var dispatcher = new QueuedWpfDispatcherService();
+        var firstNormal = -1;
+        var lastNormal = -1;
+        var firstBackground = -1;
+        var lastBackground = -1;
+        var executionIndex = 0;
+
+        for (var i = 0; i < 20000; i++)
+        {
+            var value = i;
+            dispatcher.Post(
+                () =>
+                {
+                    var index = executionIndex++;
+                    if (value == 0)
+                    {
+                        firstBackground = index;
+                    }
+                    else if (value == 19999)
+                    {
+                        lastBackground = index;
+                    }
+                },
+                WpfDispatcherPriority.Background);
+            dispatcher.Post(
+                () =>
+                {
+                    var index = executionIndex++;
+                    if (value == 0)
+                    {
+                        firstNormal = index;
+                    }
+                    else if (value == 19999)
+                    {
+                        lastNormal = index;
+                    }
+                },
+                WpfDispatcherPriority.Normal);
+        }
+
+        Assert.True(dispatcher.ProcessPending());
+        Assert.Equal(0, firstNormal);
+        Assert.Equal(19999, lastNormal);
+        Assert.Equal(20000, firstBackground);
+        Assert.Equal(39999, lastBackground);
+    }
